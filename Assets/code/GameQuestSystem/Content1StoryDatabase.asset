    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\uFF08\u7ED9\u5176\u4ED6\u4E24\u4EBA\u53D1\u6D88\u606F\uFF09\u975E\u5E38\u62B1\u6B49\uFF0C\u4ECA\u5929\u6211\u6709\u4E2A\u66F4\u8981\u7D27\u7684\u5408\u4F5C\uFF0C\u5B9E\u5728\u7A7A\u4E0D\u51FA\u65F6\u95F4\u3002\u4E0B\u6B21\u5982\u679C\u9700\u8981\u5E2E\u52A9\uFF0C\u4E00\u5B9A\u518D\u6765\u627E\u6211\uFF0C\u597D\u5417\uFF1F"
    - pageNumber: 3
      speakerName: "(\u7B2C\u4E8C\u5929\uFF09\u6C88\u9752\u79BE"
      text: "\u201C\u7ECF\u8D39\u4FDD\u4F4F\u4E86\uFF0C\u8BFE\u9898\u7EC4\u6D3B\u4E0B\u6765\u4E86\u3002\u6797\u6E21\uFF0C\u975E\u5E38\u611F\u8C22\u3002\u201D"
