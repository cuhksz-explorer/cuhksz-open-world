    targetSceneName: libraryfloor4
    fallbackTargetPosition: {x: -68.19, y: 1.64, z: 439.16}
    rewardGold: 65
    finishLocationName: "\u56FE\u4E66\u9986\u56DB\u697C"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u5973\u751F\u5BBF\u820D 7 \u53F7\u697C\u95E8\u524D"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u8D70\u51FA\u4F1E\u4E0B\uFF0C\u96E8\u6C34\u5728\u5979\u7684\u897F\u88C5\u8896\u53E3\u7559\u4E0B\u4E86\u51E0\u70B9\u6DF1\u8272\u7684\u75D5\u8FF9\u3002\u5979\u8F6C\u8FC7\u8EAB\uFF0C\u611F\u5E94\u706F\u7684\u5149\u6253\u5728\u5979\u7684\u4FA7\u8138\u4E0A\uFF0C\u82F1\u6C14\u903C\u4EBA\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5979\u505C\u987F\u4E86\u4E00\u4E0B\uFF0C\u8BED\u6C14\u4E0D\u518D\u662F\u90A3\u79CD\u516C\u4E8B\u516C\u529E\u7684\u51B7\u9759\u3002"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u8FD8\u6709\uFF0C\u6797\u6E21\u3002\u4E0D\u7528\u53EB\u6211\u5468\u603B\uFF0C\u4E5F\u4E0D\u7528\u53EB\u5B66\u59D0\u3002\u4EE5\u540E\u79C1\u4E0B\u91CC\uFF0C\u53EB\u6211\u5468\u781A\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u90A3\u665A\u56DE\u5230\u5BBF\u820D\uFF0C\u6797\u6E21\u7684\u6307\u5C16\u8FD8\u6B8B\u7559\u7740\u4F1E\u67C4\u4F20\u6765\u7684\u51C9\u610F\uFF0C\u5FC3\u53E3\u5374\u56E0\u4E3A\u90A3\u4E2A\u540D\u5B57\u53CD\u590D\u53D1\u70EB\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u6253\u5F00\u7535\u8111\uFF0C\u5C4F\u5E55\u4E0A\u8DF3\u51FA\u4E00\u4E2A\u6807\u6709\u201CZY-Private\u201D\u7684\u52A0\u5BC6\u6587\u4EF6\u5939\u3002\u90A3\u662F\u5468\u781A\u7684\u6838\u5FC3\u5E95\u724C\uFF0C\u4E5F\u662F\u5979\u4EB2\u624B\u9012\u7ED9\u6797\u6E21\u7684\u4E00\u4EFD\u6C89\u91CD\u7684\u6295\u540D\u72B6\u3002\u770B\u7740\u5C4F\u5E55\u4E0A\u95EA\u70C1\u7684\u5149\u6807\uFF0C\u6797\u6E21\u610F\u8BC6\u5230\uFF0C\u6628\u665A\u90A3\u573A\u96E8\u4E0D\u4EC5\u6DCB\u6E7F\u4E86\u8863\u89D2\uFF0C\u66F4\u5F7B\u5E95\u6253\u788E\u4E86\u5979\u4EEC\u4E4B\u95F4\u539F\u672C\u9AD8\u4F4E\u5206\u660E\u7684\u754C\u9650\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u6B21\u65E5\uFF0C19:45\u3002\u96E8\u540E\u7684\u7A7A\u6C14\u4F9D\u7136\u7C98\u7A20\uFF0C\u65E7\u56FE\u4E66\u9986\u50CF\u662F\u4E00\u5EA7\u5728\u66AE\u8272\u4E2D\u6C89\u7761\u7684\u65E7\u4E66\u51A2\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u6797\u6E21\u63A8\u5F00\u4E09\u697C\u7814\u8BA8\u5BA4\u90A3\u6247\u54AF\u5431\u4F5C\u54CD\u7684\u6728\u95E8\u3002\u767D\u70BD\u706F\u7BA1\u5728\u5BC2\u9759\u4E2D\u53D1\u51FA\u7EC6\u5FAE\u7684\u55E1\u9E23\uFF0C\u5C06\u5BA4\u5185\u67D3\u4E0A\u4E00\u5C42\u51B7\u6E05\u7684\u8272\u8C03\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u5468\u781A\u5DF2\u7ECF\u5728\u90A3\u513F\u4E86\u3002\u5979\u5378\u4E0B\u4E86\u6628\u665A\u90A3\u4EF6\u82F1\u6C14\u903C\u4EBA\u7684\u897F\u88C5\u5916\u5957\uFF0C\u53EA\u7A7F\u7740\u4E00\u4EF6\u526A\u88C1\u5229\u843D\u7684\u767D\u886C\u886B\uFF0C\u8896\u53E3\u9AD8\u9AD8\u5377\u8D77\uFF0C\u9732\u51FA\u624B\u8155\u4E0A\u90A3\u53EA\u6298\u5C04\u7740\u51B7\u5149\u7684\u94F6\u8868\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u6743\u9650\u91CC\u7684\u6570\u636E\u6211\u9884\u5BA1\u8FC7\u4E86\uFF0C\u6BD4\u6211\u60F3\u8C61\u7684\u8981\u590D\u6742\u2026\u2026\u5468\u781A\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u7B2C\u4E00\u6B21\u8131\u79BB\u201C\u5B66\u59D0\u201D\u8FD9\u4E2A\u79F0\u547C\uFF0C\u6797\u6E21\u611F\u5230\u4E00\u79CD\u5FAE\u5999\u7684\u3001\u8D8A\u8FC7\u8FB9\u754C\u7684\u50ED\u8D8A\u611F\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u5468\u781A\u6572\u51FB\u952E\u76D8\u7684\u624B\u6307\u505C\u987F\u4E86\u4E00\u79D2\u3002\u5979\u62AC\u8D77\u5934\uFF0C\u90A3\u53CC\u9510\u5229\u7684\u7738\u5B50\u91CC\u892A\u53BB\u4E86\u6628\u665A\u7684\u8BD5\u63A2\u4E0E\u67D4\u548C\uFF0C\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u4E00\u79CD\u8FD1\u4E4E\u6B8B\u9177\u7684\u4E13\u6CE8\u3002"
    - pageNumber: 13
      speakerName: "\u5468\u781A"
      text: "\u65E2\u7136\u770B\u4E86\u5E95\u724C\uFF0C\u5C31\u610F\u5473\u7740\u4F60\u5DF2\u7ECF\u4E0B\u4E0D\u4E86\u684C\u4E86\u3002"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u5BA1\u8BA1\u6F14\u793A\u5C31\u5728\u660E\u5929\u4E0A\u5348\u3002\u5982\u679C\u4F60\u8FD8\u6CA1\u51C6\u5907\u597D\u8DDF\u6211\u4E00\u8D77\u5728\u8FD9\u4E2A\u7CFB\u7EDF\u91CC\u51FF\u51FA\u4E00\u4E2A\u6D1E\uFF0C\u73B0\u5728\u53CD\u6094\u8FD8\u6765\u5F97\u53CA\u3002"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u65E2\u7136\u6211\u6765\u4E86\uFF0C\u5C31\u6CA1\u6253\u7B97\u7A7A\u7740\u624B\u56DE\u53BB\u3002\u5F00\u59CB\u5427\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u5468\u781A\u6CA1\u6709\u518D\u8BF4\u8BDD\uFF0C\u53EA\u662F\u5C06\u9762\u524D\u7684\u526F\u5C4F\u5E55\u8F6C\u5230\u4E86\u6797\u6E21\u7684\u65B9\u5411\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u968F\u7740\u4E24\u53F0\u7B14\u8BB0\u672C\u7535\u8111\u540C\u65F6\u53D1\u51FA\u9AD8\u901F\u8FD0\u8F6C\u7684\u8702\u9E23\u58F0\uFF0C\u90A3\u573A\u539F\u672C\u5E26\u6709\u66A7\u6627\u4F59\u6E29\u7684\u9082\u9005\uFF0C\u77AC\u95F4\u88AB\u51B0\u51B7\u7684\u4EE3\u7801\u4E0E\u7D27\u8FEB\u7684\u5BA1\u8BA1\u671F\u9650\u5207\u5272\u6210\u4E86\u9AD8\u5F3A\u5EA6\u7684\u9759\u9ED8\u534F\u540C\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u6CA1\u6709\u591A\u4F59\u7684\u8C03\u60C5\uFF0C\u4E24\u4EBA\u7684\u624B\u901F\u90FD\u5F88\u5FEB\u3002\u6797\u6E21\u5728\u5199\u811A\u672C\u6293\u53D6\u5224\u4F8B\u6570\u636E\uFF0C\u5468\u781A\u5728\u5FEB\u901F\u7B5B\u9009\u6CD5\u6761\u3002"
    - pageNumber: 19
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u628A 2024 \u5E74\u90A3\u51E0\u4E2A\u5173\u4E8E\u5927\u6570\u636E\u6740\u719F\u7684\u5377\u5B97\u5355\u72EC\u62C9\u51FA\u6765\u3002\u6211\u9700\u8981\u770B\u4ED6\u4EEC\u662F\u600E\u4E48\u5B9A\u4E49\u2018\u7B97\u6CD5\u516C\u5E73\u2019\u7684\u3002\u201D"
    - pageNumber: 20
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5DF2\u7ECF\u540C\u6B65\u5230\u4F60\u7684\u5171\u4EAB\u6587\u6863\u4E86\u3002\u987A\u4FBF\uFF0C\u6211\u5199\u4E86\u4E2A\u81EA\u52A8\u5173\u8054\u811A\u672C\uFF0C\u5E2E\u4F60\u628A\u90A3\u4E9B\u6CD5\u6761\u548C\u6211\u4EEC\u7684\u5E95\u5C42\u67B6\u6784\u505A\u4E86\u5339\u914D\u3002\u201D"
    - pageNumber: 21
      speakerName: "\u5468\u781A"
      text: "\u201C\u8C22\u4E86\u3002\u8DDF\u4F60\u5E72\u6D3B\uFF0C\u6211\u80FD\u7701\u6389\u8BB8\u591A\u529B\u6C14\u3002\u201D"
    - pageNumber: 22
      speakerName: 
      text: "\u5468\u781A\u7684\u624B\u673A\u5728\u684C\u9762\u4E0A\u53D1\u51FA\u6C89\u95F7\u7684\u9707\u52A8\u3002\u6765\u7535\u663E\u793A\u662F\uFF1A\u8D75\u5B87\uFF08\u5B66\u4EE3\u4F1A\u5E38\u59D4\uFF09\u3002\u8FD9\u4EBA\u4E4B\u524D\u4E00\u76F4\u4EE5\u201C\u5E2E\u516C\u53F8\u7533\u8BF7\u573A\u5730\u201D\u4E3A\u7531\u7EA0\u7F20\u5468\u781A\u3002"
    - pageNumber: 23
      speakerName: "\u8D75\u5B87"
      text: "\u201C\u5468\u781A\uFF0C\u8FD8\u6CA1\u5FD9\u5B8C\uFF1F\u542C\u8BF4\u4F60\u660E\u5929\u7684\u5BA1\u8BA1\u6F14\u793A\u8FD8\u6CA1\u8FC7\u5185\u5BA1\u3002\u6B63\u597D\u6211\u8BA4\u8BC6\u6821\u62DB\u529E\u7684\u8001\u5E08\uFF0C\u53EA\u8981\u4F60\u90A3\u4EFD\u62A5\u544A\u91CC\u80FD\u5E2E\u6211\u628A\u2018\u6821\u56ED\u521B\u4E1A\u5178\u8303\u2019\u7684\u6BD4\u4F8B\u63D0\u4E00\u7248\uFF0C\u573A\u5730\u7684\u4E8B\u6211\u53EF\u4EE5\u5E2E\u4F60\u641E\u5B9A\u3002\u201D"
    - pageNumber: 24
      speakerName: 
      text: "\u8D75\u5B87\u7684\u58F0\u97F3\u5728\u7A7A\u65F7\u6C89\u95F7\u7684\u7814\u8BA8\u5BA4\u91CC\u663E\u5F97\u683C\u5916\u523A\u8033\uFF0C\u90A3\u79CD\u5E26\u7740\u9ECF\u817B\u611F\u7684\u4F18\u8D8A\u611F\uFF0C\u4EFF\u4F5B\u987A\u7740\u65E0\u7EBF\u7535\u4FE1\u53F7\u722C\u5230\u4E86\u529E\u516C\u684C\u4E0A\u3002\u5468\u781A\u6572\u51FB\u952E\u76D8\u7684\u8282\u594F\u6CA1\u6709\u53D8\uFF0C\u4F46\u6797\u6E21\u6CE8\u610F\u5230\u5979\u63E1\u7740\u9F20\u6807\u7684\u6307\u5C16\u56E0\u4E3A\u7528\u529B\u800C\u5FAE\u5FAE\u6CDB\u767D\u3002"
