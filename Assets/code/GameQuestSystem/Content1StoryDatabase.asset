      text: "\u4E66\u9662\u4F11\u606F\u5BA4 / 23:00.\u7A97\u5916\u7684\u66B4\u96E8\u58F0\u63A9\u76D6\u4E86\u8D70\u5ECA\u7684\u52A8\u9759\u3002\u6797\u6E21\u521A\u8D76\u5B8C\u81EA\u5DF1\u7684ddl\uFF0C\u63C9\u7740\u773C\u775B\u5728\u5165\u7761\u524D\u67E5\u770B\u624B\u673A\uFF0C\u53D1\u73B0\u4E09\u4E2A\u670B\u53CB\u7126\u6025\u7684\u6C42\u52A9\u77ED\u4FE1\uFF1A\u6C88\u9752\u79BE\u7684\u79D1\u7814\u540D\u989D\u3001\u5468\u781A\u7684\u5B9E\u4E60\u3001\u987E\u6F84\u7684\u516C\u76CA\u9879\u76EE\u3002"
    - pageNumber: 2
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6570\u636E\u5904\u7406\u7A0B\u5E8F\u51FA\u95EE\u9898\u4E86\u3002\u4E00\u8DD1\u5230\u6700\u540E\u7684\u6570\u636E\u6C47\u603B\u9636\u6BB5\u5C31\u76F4\u63A5\u5D29\u6E83\u3002\u6211\u53EA\u9700\u8981\u4F60\u5E2E\u6211\u4EEC\u987A\u4E00\u904D\u6700\u57FA\u7840\u7684\u6570\u636E\u5FAA\u73AF\uFF0C\u627E\u51FA\u90A3\u4E2A\u5361\u6B7B\u7A0B\u5E8F\u7684\u6B7B\u7ED3\u3002\u5982\u679C\u660E\u65E9\u516D\u70B9\u524D\u8DD1\u4E0D\u901A\uFF0C\u8BFE\u9898\u7EC4\u5927\u4E09\u8FD9\u4E00\u5E74\u7684\u7ECF\u8D39\u76F4\u63A5\u6E05\u96F6\u3002\u7B97\u6211\u6B20\u4F60\u4E00\u4E2A\u4EBA\u60C5\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u6709\u4EBA\u773C\u7EA2\u6211\u4EEC\u7684\u9879\u76EE\uFF0C\u6B63\u5728\u7528\u673A\u5668\u4EBA\u811A\u672C\u75AF\u72C2\u4E0B\u8F7D\u6211\u4EEC\u7F51\u7AD9\u91CC\u7684\u6838\u5FC3\u6570\u636E\u3002\u4ED6\u4EEC\u60F3\u8D76\u5728\u660E\u5929\u6211\u4EEC\u8DDF\u6295\u8D44\u4EBA\u89C1\u9762\u4E4B\u524D\uFF0C\u628A\u6211\u4EEC\u7684\u5E95\u724C\u5168\u5077\u8D70\u3002\u4F60\u73B0\u5728\u80FD\u5E2E\u6211\u5199\u4E00\u4E2A\u62E6\u622A\u7A0B\u5E8F\uFF0C\u628A\u90A3\u4E9B\u673A\u5668\u4EBA\u7684\u5047\u6D41\u91CF\u8E22\u51FA\u53BB\u5417\uFF1F\u597D\u5904\u4E0D\u4F1A\u5C11\u4E86\u4F60\u3002"
    - pageNumber: 4
      speakerName: "\u987E\u6F84"
      text: "\u201C\u6797\u6E21\u2026\u2026\u6211\u7684\u516C\u76CA\u8BA1\u5212\u88AB\u6253\u56DE\u6765\u4E86\u3002\u8BC4\u5BA1\u8BF4\u6211\u4EEC\u7684\u53D9\u4E8B\u592A\u5355\u8584\u3002\u5982\u679C\u4ECA\u665A\u4E0D\u80FD\u91CD\u5199\u51FA\u4E00\u4EFD\u6709\u611F\u67D3\u529B\u7684\u7533\u8BF7\u4E66\uFF0C\u8FD9\u9879\u76EE\u5C31\u5F7B\u5E95\u9EC4\u4E86\u3002\u4F60\u7B54\u5E94\u8FC7\u4F1A\u5E2E\u6211\u6539\u5B9A\u7A3F\u7684\uFF0C\u5BF9\u5417\uFF1F\u201D"
    choices:
    - label: "\u9009\u62E9\u6C88\u9752\u79BE"
      targetDocumentId: M3-4-2a
    - label: "\u9009\u62E9\u5468\u781A"
