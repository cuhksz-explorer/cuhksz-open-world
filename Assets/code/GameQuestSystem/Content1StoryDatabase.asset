    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u8D70\u5ECA\u91CC\uFF0C\u522B\u7684\u7EC4\u6B63\u5728\u6B22\u547C\u96C0\u8DC3\uFF0C\u8BA8\u8BBA\u7740\u53BB\u54EA\u91CC\u5E86\u795D\u62FF\u5230\u4E86\u6EE1\u5206\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u56DE\u5934\u770B\u4E86\u4E00\u773C\u8EAB\u540E\u90A3\u4E2A\u72ED\u5C0F\u7684\u8BA8\u8BBA\u5BA4\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5979\u5F00\u59CB\u610F\u8BC6\u5230\uFF0C\u6709\u4E9B\u9009\u62E9\u5728\u5F53\u4E0B\u53EA\u662F\u4E00\u4E2A\u5206\u6570\u503C\uFF0C\u4F46\u5728\u672A\u6765\uFF0C\u5B83\u4F1A\u53D8\u6210\u4F60\u6027\u683C\u91CC\u7684\u4E00\u9053\u88C2\u7EB9\uFF0C\u6216\u8005\u4E00\u5757\u575A\u786C\u7684\u57FA\u77F3\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u7EE9\u70B9\u7684\u98CE\u66B4\u624D\u521A\u521A\u5F00\u59CB\uFF0C\u800C\u5979\uFF0C\u5DF2\u7ECF\u7AD9\u5728\u4E86\u6F29\u6DA1\u7684\u4E2D\u5FC3\u3002"
    choices: []
  - documentId: M1-3-1
    title: M1-3-1
    sourceAssetPath: Assets/content1/M1/M1-3-1.docx
    chapterId: M1
