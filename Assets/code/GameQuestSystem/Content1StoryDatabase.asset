      text: "\u4F60\u8BF4\u5F97\u5BF9\uFF0C\u6C88\u9752\u79BE\u3002\u6CA1\u5FC5\u8981\u5728\u7B2C\u4E00\u5B66\u671F\u5C31\u53BB\u649E\u5357\u5899\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u679C\u65AD\u53D6\u6D88\u4E86\u300A\u96F6\u548C\u903B\u8F91\u300B\u7684\u52FE\u9009\uFF0C\u70B9\u51FB\u4E86\u300A\u6218\u7565\u51B3\u7B56\u7BA1\u7406\u300B\u7684\u786E\u8BA4\u952E\u3002\u9875\u9762\u8DF3\u8F6C\uFF0C\u201C\u9009\u8BFE\u6210\u529F\u201D\u7684\u7EFF\u8272\u63D0\u793A\u6846\u4EAE\u8D77\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u547C\u2026\u2026\u62FF\u5230\u4E86\u3002"
    - pageNumber: 4
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u660E\u667A\u3002\u5982\u679C\u4F60\u9009\u4E86\u90A3\u95E8\u602A\u8BFE\uFF0C\u6211\u4E0B\u5468\u53EF\u80FD\u5C31\u5F97\u5728\u5FC3\u7406\u54A8\u8BE2\u5BA4\u95E8\u53E3\u63A5\u4F60\u4E86\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u5BBF\u820D\u91CC\u7684\u6C14\u6C1B\u7F13\u548C\u4E86\u4E00\u4E9B\u3002\u6797\u6E21\u770B\u7740\u90A3\u4EFD\u56DB\u5E73\u516B\u7A33\u7684\u8BFE\u8868\uFF0C\u867D\u7136\u611F\u5230\u4E00\u79CD\u8E0F\u5B9E\uFF0C\u4F46\u5FC3\u91CC\u67D0\u4E2A\u89D2\u843D\u5374\u50CF\u662F\u4E00\u6247\u88AB\u5173\u4E0A\u7684\u7A97\u6237\uFF0C\u900F\u4E0D\u8FDB\u98CE\u3002"
    choices: []
