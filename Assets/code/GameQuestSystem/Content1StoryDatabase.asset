      text: "\u4EBA\u5DE5\u667A\u80FD\u7CFB\u529E\u516C\u697C / \u4E0B\u5348 15:30"
    - pageNumber: 2
      speakerName: 
      text: "\u8D70\u5ECA\u91CC\u56DE\u8361\u7740\u9694\u58C1\u673A\u623F\u670D\u52A1\u5668\u6563\u70ED\u98CE\u6247\u7684\u4F4E\u9891\u55E1\u55E1\u58F0\u3002\u4E00\u5E74\u4E00\u5EA6\u7684\u201C\u56FD\u5BB6\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u76F4\u63A8\u540D\u989D\u201D\u9009\u62D4\u8FDB\u5165\u4E86\u6700\u540E\u7684\u52A0\u8BD5\u9636\u6BB5\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u9648\u6559\u6388\u76EF\u7740\u5C4F\u5E55\u4E0A\u7684\u7EC8\u7AEF\u754C\u9762\u3002\u4ED6\u8F93\u5165\u4E86\u4E00\u6BB5\u6781\u4E3A\u590D\u6742\u7684\u884C\u4E1A\u672F\u8BED\u63D0\u95EE\uFF0C\u4F5C\u4E3A\u7CFB\u91CC\u7684\u5B66\u672F\u6743\u5A01\uFF0C\u4ED6\u5BF9\u672C\u79D1\u751F\u80FD\u505A\u5230\u8FD9\u79CD\u7A0B\u5EA6\u7684\u5DE5\u7A0B\u843D\u5730\u611F\u5230\u610F\u5916\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u4E09\u79D2\u540E\uFF0C\u7CFB\u7EDF\u4E0D\u4EC5\u7ED9\u51FA\u4E86\u7CBE\u51C6\u7684\u56DE\u7B54\uFF0C\u8FD8\u9644\u5E26\u4E86\u51FA\u5904\u7684\u672C\u5730\u6587\u732E\u6EAF\u6E90\u3002\u4F5C\u4E3A\u7CFB\u91CC\u7684\u5B66\u672F\u6743\u5A01\uFF0C\u4ED6\u5BF9\u672C\u79D1\u751F\u80FD\u505A\u5230\u8FD9\u79CD\u7A0B\u5EA6\u7684\u5DE5\u7A0B\u843D\u5730\u611F\u5230\u610F\u5916\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u6211\u5199\u4E86\u4E00\u5957\u57FA\u4E8E RAG\uFF08\u68C0\u7D22\u589E\u5F3A\u751F\u6210\uFF09\u7684\u81EA\u52A8\u5316\u5904\u7406\u811A\u672C\uFF0C\u628A\u60A8\u5B9E\u9A8C\u5BA4\u8FC7\u53BB\u4E94\u5E74\u7684\u975E\u7ED3\u6784\u5316\u6587\u6863\u5168\u505A\u4E86\u5411\u91CF\u5316\u5207\u7247\uFF0C\u63A5\u5728\u672C\u5730\u6A21\u578B\u4E0A\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u9648\u5BFC\uFF0C\u6211\u77E5\u9053\u6211\u7684\u7406\u8BBA\u63A8\u5BFC\u8FD8\u4E0D\u591F\u6DF1\uFF0C\u4F46\u6211\u80FD\u4FDD\u8BC1\uFF0C\u60A8\u7684\u56E2\u961F\u5728\u5904\u7406\u90A3\u4E9B\u5E9E\u6742\u7684\u539F\u59CB\u8BED\u6599\u65F6\uFF0C\u6548\u7387\u80FD\u5927\u5927\u63D0\u5347\u3002"
    - pageNumber: 7
      speakerName: "\u9648\u6559\u6388"
      text: "\u4F60\u7684\u5DE5\u7A0B\u654F\u9510\u5EA6\u548C\u843D\u5730\u80FD\u529B\u786E\u5B9E\u6BD4\u540C\u5C4A\u5B66\u751F\u6210\u719F\u3002\u5148\u628A\u7533\u8BF7\u8868\u548C\u6D4B\u8BD5\u62A5\u544A\u4EA4\u5230\u9662\u529E\u738B\u8001\u5E08\u90A3\u91CC\u53BB\uFF0C\u5177\u4F53\u7684\u63A8\u8350\u540D\u5355\u660E\u65E9\u6211\u4EEC\u4F1A\u5728\u78B0\u5934\u4F1A\u4E0A\u5B9A\u4E0B\u6765\u3002"
