      text: "\u7B14\u8BB0\u672C\u7535\u8111\u7684\u98CE\u6247\u9010\u6E10\u5E73\u606F\u4E0B\u6765\u3002\u82CF\u6C90\u762B\u5012\u5728\u6905\u5B50\u4E0A\uFF0C\u8D75\u6893\u7487\u6B63\u5728\u75AF\u72C2\u52A0\u7FA4\uFF0C\u6881\u5609\u4E00\u5DF2\u7ECF\u5728\u5BF9\u7167\u65B0\u7684\u8BFE\u8868\u8D2D\u4E70\u6559\u6750\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u9760\u5728\u6905\u80CC\u4E0A\uFF0C\u770B\u7740\u5C4F\u5E55\u4E0A\u90A3\u4E2A\u9759\u9759\u8EBA\u7740\u7684\u3001\u7F16\u7801\u5947\u602A\u7684\u8BFE\u7A0B\u3002\u5979\u611F\u89C9\u5230\uFF0C\u4ECE\u5979\u6309\u4E0B\u786E\u8BA4\u952E\u7684\u90A3\u4E00\u523B\u8D77\uFF0C\u67D0\u79CD\u770B\u4E0D\u89C1\u7684\u9F7F\u8F6E\u5DF2\u7ECF\u5F00\u59CB\u8F6C\u52A8\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u8FD9\u6240\u5B66\u6821\u7684\u9009\u8BFE\u7CFB\u7EDF\u4ECE\u4E0D\u53EA\u662F\u4E3A\u4E86\u5B89\u6392\u65F6\u95F4\uFF0C\u5B83\u66F4\u50CF\u662F\u4E00\u573A\u5BF9\u7075\u9B42\u7684\u521D\u6B21\u6807\u4EF7\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6709\u4EBA\u9009\u62E9\u4E86\u901A\u5F80\u91D1\u5854\u7684\u5B89\u5168\u697C\u68AF\uFF0C\u6709\u4EBA\u9009\u62E9\u4E86\u8DF3\u8FDB\u90A3\u7247\u672A\u540D\u7684\u6DF1\u6D77\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u800C\u6797\u6E21\u77E5\u9053\uFF0C\u65E0\u8BBA\u9009\u4E86\u54EA\u6761\u8DEF\uFF0C\u8FD9\u4E2A\u540D\u4E3A\u201C\u7EE9\u70B9\u98CE\u66B4\u201D\u7684\u6F29\u6DA1\uFF0C\u90FD\u5DF2\u7ECF\u5C06\u5979\u5F7B\u5E95\u5377\u5165\u5176\u4E2D\u3002"
    choices: []
  - documentId: M1-2-1
    title: M1-2-1
    sourceAssetPath: Assets/content1/M1/M1-2-1.docx
    chapterId: M1
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m1_2_1
    npcId: "npc_\u8D75\u6893\u7487"
    locationId: computerroom_m1_2_1
    targetSceneName: computerroom
    fallbackTargetPosition: {x: -3.91, y: 0.95, z: -20.67}
    rewardGold: 25
    finishLocationName: "\u673A\u623F/\u9009\u8BFE\u7CFB\u7EDF"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u508D\u665A\u516D\u70B9\u534A\uFF0C\u7814\u8BA8\u697C 402 \u8BA8\u8BBA\u5BA4\u3002\u7A97\u5916\uFF0C\u9F99\u5C97\u7684\u591C\u8272\u6B63\u4E00\u70B9\u70B9\u541E\u566C\u6389\u5929\u8FB9\u6700\u540E\u4E00\u62B9\u4F59\u6656\u3002\u8BA8\u8BBA\u5BA4\u5185\uFF0C\u767D\u70BD\u706F\u7BA1\u53D1\u51FA\u6781\u5176\u7EC6\u5FAE\u7684\u55E1\u9E23\u58F0\uFF0C\u684C\u4E0A\u6563\u4E71\u7740\u6253\u5370\u51FA\u6765\u7684\u8BBA\u6587\u8349\u7A3F\u548C\u51E0\u74F6\u5DF2\u7ECF\u559D\u5149\u4E86\u7684\u80FD\u91CF\u996E\u6599\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u8FD9\u662F\u300A\u57FA\u7840\u6570\u636E\u5206\u6790\u300B\u7684\u7B2C\u4E00\u573A\u5C0F\u7EC4\u5C55\u793A\u3002\u4EFB\u52A1\u4E0D\u96BE\uFF0C\u4F46\u8981\u6C42\u6781\u9AD8\uFF0C\u800C\u6797\u6E21\u6240\u5728\u7684\u5C0F\u7EC4\uFF0C\u73B0\u5728\u7684\u6C14\u6C1B\u6BD4\u5BA4\u5916\u7684\u6E29\u5EA6\u8FD8\u8981\u51B7\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6797\u89C1\u9E7F\u63A8\u4E86\u63A8\u773C\u955C\uFF0C\u6307\u5C16\u6572\u51FB\u7740\u952E\u76D8\uFF0C\u5C4F\u5E55\u4E0A\u7684\u6563\u70B9\u56FE\u51CC\u4E71\u5F97\u50CF\u662F\u4E00\u573A\u707E\u96BE\u3002\u5979\u662F\u5C0F\u7EC4\u91CC\u7684\u6280\u672F\u6838\u5FC3\uFF0C\u4E5F\u662F\u6700\u4E0D\u80FD\u5BB9\u5FCD\u7455\u75B5\u7684\u4EBA\u3002"
    - pageNumber: 4
      speakerName: "\u82CF\u6C90"
      text: "\u6211\u2026\u2026\u6211\u53EF\u4EE5\u5C1D\u8BD5\u518D\u8C03\u4E00\u4E0B\u53C2\u6570\uFF0C\u4F46\u6211\u6700\u8FD1\u793E\u56E2\u90A3\u8FB9\u7684\u6821\u5E86\u665A\u4F1A\u5F69\u6392\u6392\u5F97\u592A\u6EE1\u4E86\uFF0C\u6211\u771F\u7684\u6709\u70B9\u71AC\u4E0D\u52A8\u4E86\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u82CF\u6C90\u7684\u58F0\u97F3\u7EC6\u82E5\u868A\u868B\uFF0C\u5979\u4F4E\u7740\u5934\uFF0C\u773C\u7736\u91CC\u5E03\u6EE1\u4E86\u7EA2\u4E1D\u3002\u4F5C\u4E3A\u7EC4\u91CC\u6700\u968F\u548C\u4F46\u4E5F\u6700\u5BB9\u6613\u88AB\u7410\u4E8B\u62D6\u7D2F\u7684\u4EBA\uFF0C\u5979\u5DF2\u7ECF\u5230\u4E86\u5D29\u6E83\u7684\u8FB9\u7F18\u3002"
    - pageNumber: 6
      speakerName: "\u8D75\u6893\u7487"
      text: "\u884C\u4E86\uFF0C\u5927\u5BB6\u90FD\u522B\u5728\u8FD9\u4E2A\u7834\u6A21\u578B\u4E0A\u6D6A\u8D39\u65F6\u95F4\u4E86\u3002\u6211\u5DF2\u7ECF\u5F04\u5230\u4E00\u4E2A\u201C\u73B0\u6210\u201D\u7684\u89E3\u51B3\u65B9\u6848\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u8D75\u6893\u7487\u4ECE\u80CC\u5305\u91CC\u638F\u51FA\u4E00\u4E2A\u95EA\u5B58\u76D8\uFF0C\u8F7B\u8F7B\u6254\u5728\u684C\u5B50\u4E2D\u592E\u3002\u5979\u7684\u8138\u4E0A\u5E26\u7740\u4E00\u79CD\u80DC\u5238\u5728\u63E1\u7684\u4ECE\u5BB9\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u8D75\u6893\u7487\uFF0C\u4F60\u662F\u8BF4\u6211\u4EEC\u8981\u2026\u2026\u201C\u501F\u7528\u201D\u522B\u4EBA\u7684\u6210\u679C\uFF1F"
    - pageNumber: 9
      speakerName: "\u8D75\u6893\u7487"
      text: "\u6797\u6E21\uFF0C\u522B\u8BF4\u5F97\u90A3\u4E48\u96BE\u542C\u3002\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u8FD9\u53EB\u201C\u7AD9\u5728\u5DE8\u4EBA\u7684\u80A9\u8180\u4E0A\u201D\u3002\u5B66\u957F\u628A\u8FD9\u4E2A\u7ED9\u6211\u7684\u65F6\u5019\uFF0C\u5C31\u662F\u9ED8\u8BA4\u6211\u4EEC\u53EF\u4EE5\u53C2\u8003\u7684\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u53C2\u8003\u548C\u642C\u8FD0\u662F\u4E24\u56DE\u4E8B\u3002\u8D75\u6893\u7487\uFF0C\u5982\u679C\u88AB\u67E5\u91CD\u7CFB\u7EDF\u6293\u5230\u5E95\u5C42\u903B\u8F91\u7684\u4E00\u81F4\u6027\uFF0C\u8FD9\u4E0D\u4EC5\u662F\u8FD9\u95E8\u8BFE\u6302\u79D1\u7684\u95EE\u9898\uFF0C\u8FD9\u53EB\u5B66\u672F\u4E0D\u7AEF\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u8D75\u6893\u7487\u51B7\u7B11\u4E00\u58F0"
    - pageNumber: 12
      speakerName: "\u8D75\u6893\u7487"
      text: "\u67E5\u91CD\uFF1F\u6211\u6539\u4E86\u53D8\u91CF\u540D\uFF0C\u91CD\u65B0\u6392\u4E86\u7248\uFF0C\u8FDE\u6CE8\u91CA\u90FD\u91CD\u5199\u4E86\u3002\u53EA\u8981\u6211\u4EEC\u4E0D\u8BF4\uFF0C\u8C01\u77E5\u9053\uFF1F"
    - pageNumber: 13
      speakerName: 
      text: "\u7A7A\u6C14\u77AC\u95F4\u51DD\u56FA\u4E86\u3002\u82CF\u6C90\u770B\u7740\u767D\u677F\u4E0A\u7684\u5012\u8BA1\u65F6\uFF0C\u53C8\u770B\u4E86\u770B\u8D75\u6893\u7487\u624B\u91CC\u90A3\u4E2A\u95EA\u5B58\u76D8\uFF0C\u773C\u795E\u91CC\u95EA\u8FC7\u4E00\u4E1D\u52A8\u6447\u3002"
    - pageNumber: 14
      speakerName: "\u82CF\u6C90"
      text: "\u8981\u4E0D\u2026\u2026\u6211\u4EEC\u7A0D\u5FAE\u501F\u9274\u4E00\u70B9\u70B9\uFF1F\u53EA\u8981\u628A\u6838\u5FC3\u7B97\u6CD5\u7684\u90E8\u5206\u81EA\u5DF1\u6539\u4E00\u4E0B\uFF0C\u5E94\u8BE5\u2026\u2026\u5E94\u8BE5\u6CA1\u5173\u7CFB\u5427\uFF1F"
    - pageNumber: 15
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u6539\u4E86\u6838\u5FC3\u5C31\u4E0D\u53EB\u501F\u9274\u4E86\u3002\u6797\u6E21\uFF0C\u4F60\u662F\u7EC4\u957F\uFF0C\u4F60\u8BF4\u8BDD\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u4E09\u53CC\u773C\u775B\u540C\u65F6\u770B\u5411\u6797\u6E21\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u6797\u89C1\u9E7F\u7684\u773C\u795E\u91CC\u5E26\u7740\u4E00\u79CD\u6700\u540E\u7684\u5014\u5F3A\u548C\u671F\u5F85\uFF0C\u8D75\u6893\u7487\u5219\u5145\u6EE1\u4E86\u6311\u8845\u4E0E\u8BF1\u60D1\uFF0C\u800C\u82CF\u6C90\u53EA\u5269\u4E0B\u6E34\u671B\u89E3\u8131\u7684\u75B2\u60EB\u3002"
    choices:
    - label: "\u9ED8\u8BB8\u6377\u5F84"
      targetDocumentId: M1-2-2A
    - label: "\u575A\u5B88\u539F\u5219"
      targetDocumentId: M1-2-2B
  - documentId: M1-2-2A
    title: M1-2-2A
    sourceAssetPath: Assets/content1/M1/M1-2-2A.docx
