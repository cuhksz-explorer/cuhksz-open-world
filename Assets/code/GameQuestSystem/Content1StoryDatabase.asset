    - pageNumber: 2
      speakerName: "\u695A\u5929"
      text: "\u660E\u767D\u3002\u867D\u7136\u662F\u91CD\u590D\u52B3\u52A8\uFF0C\u4F46\u5927\u5382\u7684\u6D41\u7A0B\u7BA1\u7406\u786E\u5B9E\u80FD\u78E8\u7EC3\u4EBA\u7684\u804C\u4E1A\u7D20\u517B\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4F1A\u5229\u7528\u4E0B\u73ED\u65F6\u95F4\u7EE7\u7EED\u7814\u7A76\u6211\u7684\u63D2\u4EF6\u6A21\u578B\uFF0C\u4F46\u6211\u9700\u8981\u8FD9\u7B14\u94B1\uFF0C\u4E5F\u9700\u8981\u8FD9\u4E2A\u6807\u7B7E\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\uFF08\u6691\u5047\uFF09\u6797\u6E21\u8FDB\u5165\u4E86\u5FEB\u8282\u594F\u7684\u5546\u4E1A\u73AF\u5883\uFF0C\u867D\u7136\u6BCF\u5929\u88AB\u7410\u788E\u7684\u6807\u6CE8\u548C\u6E05\u6D17\u5DE5\u4F5C\u586B\u6EE1\uFF0C\u4F46\u5979\u7684\u94F6\u884C\u5361\u4F59\u989D\u8FC5\u901F\u589E\u957F\uFF0C\u5E76\u5728\u672A\u6765\u7684\u6821\u62DB\u5B63\u83B7\u5F97\u4E86\u4E00\u4E2A\u6781\u5177\u7ADE\u4E89\u529B\u7684\u201C\u5927\u5382\u80CC\u4E66\u201D\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u7136\u800C\uFF0C\u5F53\u591C\u5E55\u964D\u4E34\uFF0C\u52A0\u73ED\u7684\u5979\u6709\u65F6\u4E5F\u4F1A\u5728\u4E0D\u7B26\u5408\u81EA\u8EAB\u80FD\u529B\u7684\u5DE5\u4F5C\u4E2D\u4F53\u4F1A\u5230\u5DE8\u5927\u7684\u7A7A\u865A\u611F\u3002"
    choices: []
