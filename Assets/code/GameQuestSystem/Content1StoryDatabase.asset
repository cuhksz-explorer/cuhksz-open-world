      speakerName: 
      text: "\u5E08\u5144\u8D70\u540E\uFF0C\u56FE\u4E66\u9986\u91CD\u65B0\u5F52\u4E8E\u5B81\u9759\u3002\u6C88\u9752\u79BE\u6CA1\u6709\u7ACB\u523B\u5F00\u59CB\u5DE5\u4F5C\uFF0C\u4ED6\u770B\u7740\u5BF9\u9762\u53C8\u91CD\u65B0\u4F4E\u4E0B\u5934\u753B\u77E9\u9635\u7684\u6797\u6E21\uFF0C\u7A81\u7136\u5F00\u53E3\uFF1A"
    - pageNumber: 2
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6797\u6E21\u3002\u5728\u8FD9\u4E2A\u5B66\u6821\u91CC\uFF0C\u5927\u5BB6\u90FD\u60F3\u6765\u8E6D\u6211\u4E00\u70B9\u4FBF\u5229\uFF1B\u5982\u679C\u6211\u62D2\u7EDD\uFF0C\u4ED6\u4EEC\u5C31\u4F1A\u89C9\u5F97\u6211\u4E0D\u901A\u4EBA\u60C5\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u4ED6\u505C\u987F\u4E86\u4E00\u4E0B\uFF0C\u6E05\u51B7\u7684\u76EE\u5149\u91CC\u591A\u4E86\u4E00\u4EFD\u771F\u5B9E\u7684\u6E29\u5EA6\uFF1A"
    - pageNumber: 4
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4F60\u662F\u7B2C\u4E00\u4E2A\uFF0C\u613F\u610F\u5750\u5728\u6211\u5BF9\u9762\uFF0C\u5E2E\u6211\u6321\u6389\u8FD9\u4E9B\u65E0\u610F\u4E49\u6D88\u8017\u7684\u4EBA\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u56E0\u4E3A\u4F60\u66F4\u9002\u5408\u7EAF\u7CB9\u7684\u903B\u8F91\u548C\u7B97\u6CD5\u3002\u5982\u679C\u8FDE\u4F60\u7684\u4E13\u6CE8\u90FD\u88AB\u90A3\u4E9B\u70C2\u89C4\u77E9\u78E8\u5E73\u4E86\uFF0C\u90A3\u5C31\u592A\u53EF\u60DC\u4E86\u3002\u6211\u4E0D\u5E0C\u671B\u6211\u7684\u670B\u53CB\u53EA\u80FD\u5F53\u4E00\u4E2A\u4E00\u76F4\u59A5\u534F\u7684\u8001\u597D\u4EBA\u3002\u201D"
    - pageNumber: 6
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u90A3\u4F60\u53EF\u80FD\u4F1A\u6709\u70B9\u5403\u4E8F\u3002\u56E0\u4E3A\u6211\u867D\u7136\u4E0D\u6B20\u4ED6\u4EEC\u7684\u4EBA\u60C5\uFF0C\u4F46\u6211\u4ECE\u6765\u4E0D\u559C\u6B22\u6B20\u961F\u53CB\u7684\u3002\u201D"
    - pageNumber: 7
      speakerName: 
      text: "\u4ED6\u987A\u624B\u628A\u65C1\u8FB9\u7684\u4E00\u76D2\u8584\u8377\u7CD6\u63A8\u5230\u6797\u6E21\u624B\u8FB9\u3002\u52A8\u4F5C\u5F88\u8F7B\u3002"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u7EE7\u7EED\u5427\u3002\u4ECA\u665A\u4E89\u53D6\u628A\u6295\u5F71\u964D\u7EF4\u7684\u521D\u6B65\u6A21\u578B\u5EFA\u51FA\u6765\u3002\u5982\u679C\u6709\u54EA\u91CC\u63A8\u5BFC\u5361\u4F4F\u4E86\u2026\u2026\u4F60\u53EF\u4EE5\u968F\u65F6\u4E2D\u65AD\u6211\u7684\u8FDB\u7A0B\u3002\u201D"
    - pageNumber: 9
      speakerName: "\u6797\u6E21"
      text: "\u201C\u653E\u5FC3\uFF0C\u6211\u4E00\u5411\u5F88\u5C11\u5361\u58F3\u3002\u201D"
    choices: []
  - documentId: M2-3-1
    title: M2-3-1
    sourceAssetPath: Assets/content1/M2/M2-3-1.docx
    chapterId: M2
    category: 0
