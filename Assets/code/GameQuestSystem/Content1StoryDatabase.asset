    - pageNumber: 2
      speakerName: 
      text: "\u5C4F\u5E55\u4E0A\u8DF3\u51FA\u201CK.O.\u201D\u3002\u6797\u6E21\u677E\u5F00\u6447\u6746\uFF0C\u8F6C\u5934\u770B\u7740\u5468\u781A\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u201C\u4F60\u7684\u76F4\u89C9\u786E\u5B9E\u5F88\u5F3A\uFF0C\u4F46\u6211\u4F1A\u9884\u5224\u3002\u627F\u8BA9\u4E86\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u5468\u781A\u770B\u7740\u7070\u6389\u7684\u5C4F\u5E55\u6123\u4E86\u4E00\u79D2\uFF0C\u7136\u540E\u8F6C\u8FC7\u5934\u770B\u7740\u6797\u6E21\uFF0C\u4E0D\u4EC5\u6CA1\u6709\u751F\u6C14\uFF0C\u53CD\u800C\u7B11\u51FA\u4E86\u58F0\u3002\u5979\u559C\u6B22\u8FD9\u79CD\u88AB\u540C\u7B49\u5B9E\u529B\u5802\u5802\u6B63\u6B63\u51FB\u8D25\u7684\u611F\u89C9\u3002"
    - pageNumber: 5
      speakerName: "\u5468\u781A"
      text: "\u201C\u7B97\u4F60\u72E0\uFF0C\u8FDE\u6253\u4E2A\u6E38\u620F\u90FD\u8FD9\u4E48\u7528\u8111\u5B50\u3002\u518D\u6765\u4E00\u5C40\u3002\u201D"
