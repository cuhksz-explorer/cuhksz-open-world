      text: "\u6797\u6E21\u5728\u6700\u540E\u65F6\u523B\u9009\u62E9\u53BB\u5904\u7406\u5BFC\u5E08\u6216\u82CF\u7136\u7684\u4E8B\uFF0C\u5BFC\u81F4\u56E2\u961F\u5728\u51B3\u8D5B\u4E2D\u56E0\u4E3A\u4E3B\u8BB2\u4EBA\u548C\u6838\u5FC3\u6280\u672F\u9AA8\u5E72\u7F3A\u5E2D\uFF0C\u73B0\u573A\u6F14\u793A\u5F7B\u5E95\u5931\u8D25\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u961F\u4F0D\u65E0\u7F18\u5956\u9879\u3002\u695A\u5929\u548C\u590F\u6797\u5BF9\u6B64\u8868\u793A\u6781\u5EA6\u6124\u6012\u3002\u6797\u6E21\u867D\u7136\u4FDD\u4F4F\u4E86\u79D1\u7814\u8D44\u6E90\u3001\u6551\u4E0B\u4E86\u82CF\u7136\uFF0C\u4F46\u5728\u8FD9\u652F\u78E8\u5408\u4E86\u8BB8\u4E45\u7684\u56E2\u961F\u91CC\u5F7B\u5E95\u5931\u53BB\u4E86\u4FE1\u4EFB\uFF0C\u4E09\u4EBA\u5C31\u6B64\u6563\u4F19\uFF0C\u518D\u65E0\u4EA4\u96C6\u3002"
