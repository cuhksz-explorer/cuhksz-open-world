      text: "\u6DF1\u5733\u6E7E\u516C\u56ED / \u5BD2\u5047 \u508D\u665A 17:30"
    - pageNumber: 2
      speakerName: 
      text: "\u5BD2\u5047\u7684\u5357\u56FD\u6D77\u6EE8\uFF0C\u7A7A\u6C14\u91CC\u6CA1\u6709\u523A\u9AA8\u7684\u51B7\uFF0C\u53EA\u6709\u50CF\u51B0\u9547\u6C14\u6CE1\u6C34\u4E00\u6837\u7684\u6E05\u723D\u3002\u8FDC\u5904\u7684\u7EA2\u6811\u6797\u5728\u843D\u65E5\u4E0B\u53D8\u6210\u6DF1\u7D2B\u8272\uFF0C\u6D77\u9762\u4E0A\u5076\u5C14\u8DF3\u51FA\u4E00\u4E24\u53EA\u60CA\u6270\u6C34\u6CE2\u7684\u98DE\u9C7C\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6C88\u9752\u79BE\u4ECA\u5929\u7A7F\u4E86\u4E00\u4EF6\u5F88\u666E\u901A\u7684\u6DF1\u84DD\u8272\u8FDE\u5E3D\u886B\uFF0C\u80CC\u7740\u4ED6\u5E73\u65F6\u88C5\u7535\u8111\u7684\u9ED1\u8272\u53CC\u80A9\u5305\u3002"
    - pageNumber: 4
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6211\u67E5\u4E86\u6F6E\u6C50\u8868\uFF0C\u8FD9\u4E2A\u70B9\u9000\u6F6E\uFF0C\u662F\u770B\u9ED1\u8138\u7435\u9E6D\u6700\u597D\u7684\u65F6\u5019\u3002\u4E0D\u8FC7\uFF0C\u6BD4\u8D77\u76EF\u7740\u90A3\u4E9B\u968F\u65F6\u4F1A\u98DE\u8D70\u7684\u9E1F\uFF0C\u6211\u89C9\u5F97\u5728\u6808\u9053\u4E0A\u5439\u5439\u98CE\u66F4\u7B26\u5408\u2018\u5047\u671F\u2019\u7684\u5B9A\u4E49\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6C88\u5B66\u957F\uFF0C\u6211\u8FD8\u4EE5\u4E3A\u4F60\u4F1A\u62FF\u7740\u7ECF\u7EAC\u5EA6\u4EEA\u6765\u627E\u6700\u4F73\u89C2\u666F\u4F4D\u5462\u3002\u201D"
    - pageNumber: 6
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u65E2\u7136\u662F\u548C\u4F60\u51FA\u6765\uFF0C\u2018\u968F\u6027\u2019\u53EF\u80FD\u624D\u662F\u76EE\u524D\u7684\u6700\u9AD8\u4F18\u5148\u7EA7\u3002\u201D"
    - pageNumber: 7
      speakerName: 
      text: "\u4E24\u4EBA\u6324\u5230\u4E00\u4E2A\u5356\u5496\u55B1\u9C7C\u86CB\u7684\u5C0F\u644A\u524D\u3002\u6797\u6E21\u719F\u7EC3\u5730\u4E70\u4E86\u4E24\u4E32\uFF0C\u9012\u7ED9\u6C88\u9752\u79BE\u4E00\u4E32\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u6C88\u9752\u79BE\u663E\u7136\u5F88\u5C11\u5728\u8857\u8FB9\u5403\u8FD9\u79CD\u9700\u8981\u62FF\u7740\u7AF9\u7B7E\u3001\u5E26\u7740\u6D53\u90C1\u9171\u6C41\u7684\u98DF\u7269\u3002\u4ED6\u8868\u73B0\u5F97\u6781\u5176\u5C0F\u5FC3\uFF0C\u8BD5\u56FE\u7528\u4E00\u79CD\u5F88\u7AEF\u6B63\u7684\u59FF\u6001\u53BB\u54AC\u90A3\u4E2A\u5706\u6EDA\u6EDA\u7684\u9C7C\u86CB\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u6D77\u9762\u4E0A\u7A81\u7136\u522E\u8D77\u4E00\u9635\u8F83\u5927\u7684\u4FA7\u98CE\u3002"
    - pageNumber: 10
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u5C0F\u5FC3\u98CE\u2014\u2014\u201D"
    - pageNumber: 11
      speakerName: 
      text: "\u4ED6\u4E0B\u610F\u8BC6\u5730\u4FA7\u8FC7\u8EAB\uFF0C\u5E2E\u6797\u6E21\u6321\u4F4F\u90A3\u80A1\u5F3A\u52B2\u7684\u6D77\u98CE\u3002\u56E0\u4E3A\u52A8\u4F5C\u5E45\u5EA6\u6709\u70B9\u5927\uFF0C\u4ED6\u624B\u91CC\u90A3\u6839\u7528\u6765\u624E\u9C7C\u86CB\u7684\u7AF9\u7B7E\u4E0D\u5C0F\u5FC3\u5212\u8FC7\u4E86\u4ED6\u4FA7\u8170\u7684\u8863\u6446\uFF0C\u7559\u4E0B\u4E00\u9053\u6D45\u6D45\u7684\u5496\u55B1\u9171\u75D5\u8FF9\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u6C88\u9752\u79BE\u6709\u4E9B\u5C40\u4FC3\u5730\u4ECE\u515C\u91CC\u638F\u51FA\u4E00\u5F20\u6E7F\u7EB8\u5DFE\uFF0C\u53CD\u590D\u64E6\u62ED\uFF0C\u7ED3\u679C\u53CD\u800C\u628A\u6C61\u70B9\u6655\u5F97\u66F4\u5927\u4E86\u4E00\u5708\u3002\u6797\u6E21\u5012\u662F\u5F88\u5C11\u89C1\u5230\u4ED6\u50CF\u73B0\u5728\u8FD9\u6837\u5C40\u4FC3\u3002"
    - pageNumber: 13
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6211\u2026\u2026\u6211\u5E73\u65F6\u5F88\u5C11\u9047\u5230\u8FD9\u79CD\u60C5\u51B5\u3002\u8FD9\u4EF6\u8863\u670D\u53EF\u80FD\u6D17\u4E0D\u5E72\u51C0\u4E86\u3002\u201D"
    - pageNumber: 14
      speakerName: 
      text: "\u6797\u6E21\u7B11\u7740\u62C9\u4F4F\u4ED6\u7684\u624B\u8155\uFF0C\u963B\u6B62\u4ED6\u7EE7\u7EED\u7CDF\u8E4B\u90A3\u4EF6\u8863\u670D\u3002"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u201C\u522B\u64E6\u4E86\uFF0C\u6C88\u9752\u79BE\u3002\u518D\u64E6\u4F60\u5C31\u628A\u8863\u670D\u64E6\u7834\u4E86\u3002\u65E2\u7136\u5F04\u810F\u4E86\uFF0C\u90A3\u5C31\u5E72\u8106\u5F53\u6210\u8FD9\u6B21\u65C5\u884C\u7684\u7EAA\u5FF5\u7AE0\u597D\u4E86\u3002\u8D70\uFF0C\u6211\u5E26\u4F60\u53BB\u4E70\u4EF6\u65B0\u7684\u3002\u201D"
    - pageNumber: 16
      speakerName: 
      text: "\u6C88\u9752\u79BE\u88AB\u5979\u62C9\u7740\u624B\u8155\u5F80\u524D\u8D70\uFF0C\u76EE\u5149\u843D\u5728\u6797\u6E21\u62C9\u7740\u4ED6\u7684\u6307\u5C16\u4E0A\uFF0C\u8033\u6735\u5C16\u6084\u6084\u7EA2\u900F\u4E86\u3002\u4ED6\u7B2C\u4E00\u6B21\u89C9\u5F97\uFF0C\u8BA1\u5212\u88AB\u6253\u4E71\u597D\u50CF\u4E5F\u4E0D\u662F\u90A3\u4E48\u96BE\u4EE5\u63A5\u53D7\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u5728\u4EBA\u6F6E\u62E5\u6324\u7684\u5546\u573A\u91CC\uFF0C\u4F60\u7ED9\u6C88\u9752\u79BE\u6311\u4E86\u4E00\u4EF6\u5370\u7740\u670B\u514B\u56FE\u6848\u7684\u536B\u8863\u3002\u770B\u7740\u5728\u8BD5\u8863\u955C\u524D\u663E\u5F97\u6709\u4E9B\u7B28\u62D9\u3001\u4E00\u76F4\u5728\u626F\u8863\u89D2\u7684\u4ED6\uFF0C\u4F60\u51B3\u5B9A\u600E\u4E48\u505A\uFF1F"
    choices:
    - label: "\u6E29\u67D4\u7684\u6574\u7406"
      targetDocumentId: M2-3-2-A
    - label: "\u6076\u4F5C\u5267\u7684\u5938\u5956"
      targetDocumentId: "M2-3-2a\u6C88"
  - documentId: M2-3-2-A
    title: M2-3-2-A
    sourceAssetPath: Assets/content1/M2/M2-3-2-A.docx
    chapterId: M2
    category: 0
    isRootTask: 0
    isBranchDocument: 1
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m2_3_2_a
    npcId: story_trigger
    locationId: 
    targetSceneName: 
    fallbackTargetPosition: {x: 0, y: 0, z: 0}
    rewardGold: 65
    finishLocationName: 
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u542C\u7740\u7535\u8BDD\u90A3\u5934\u81EA\u4EE5\u4E3A\u662F\u7684\u7B79\u7801\uFF0C\u80F8\u53E3\u6CDB\u8D77\u4E00\u9635\u751F\u7406\u6027\u7684\u4E0D\u9002\u3002\u5979\u6CA1\u6709\u8BD5\u56FE\u62A2\u593A\u8BDD\u8BED\u6743\uFF0C\u800C\u662F\u5728\u6587\u6863\u7684\u516C\u7528\u6279\u6CE8\u680F\u91CC\u98DE\u5FEB\u5730\u6572\u4E0B\u4E00\u884C\u7EA2\u5B57\uFF0C\u5E76\u7CBE\u51C6\u5730\u63A8\u9001\u5230\u5468\u781A\u7684\u4E3B\u5C4F\u5E55\u4E2D\u5FC3\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u7684\u76EE\u5149\u5728\u90A3\u884C\u7EA2\u5B57\u4E0A\u505C\u7559\u4E86\u534A\u79D2\uFF0C\u539F\u672C\u7D27\u7EF7\u7684\u5507\u89D2\u7ADF\u7136\u5FAE\u5FAE\u4E0A\u626C\u4E86\u4E00\u4E2A\u51E0\u4E4E\u4E0D\u53EF\u5BDF\u89C9\u7684\u5F27\u5EA6\u3002\u5979\u5BF9\u7740\u7535\u8BDD\u90A3\u5934\u51B7\u6DE1\u5730\u5F00\u53E3\uFF1A\u201C\u8D75\u5E38\u59D4\uFF0C\u2018\u5178\u8303\u2019\u7684\u6BD4\u4F8B\u662F\u7B97\u51FA\u6765\u7684\uFF0C\u4E0D\u662F\u5199\u51FA\u6765\u7684\u3002\u573A\u5730\u7684\u4E8B\uFF0C\u6211\u770B\u8FD8\u662F\u6309\u6D41\u7A0B\u516C\u529E\u5427\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u5229\u843D\u5730\u6302\u65AD\u7535\u8BDD\u540E\uFF0C\u7814\u8BA8\u5BA4\u9677\u5165\u4E86\u77ED\u6682\u7684\u6B7B\u5BC2\u3002\u6797\u6E21\u5408\u4E0A\u7535\u8111\uFF0C\u76EE\u5149\u6E05\u4EAE\u5730\u76F4\u89C6\u7740\u5468\u781A\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u5468\u781A\uFF0C\u4F60\u7684\u65B9\u6848\u5DF2\u7ECF\u5B8C\u6210\u95ED\u73AF\u4E86\uFF0C\u903B\u8F91\u4E0A\u5B83\u662F\u81EA\u6D3D\u7684\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u4E3A\u4E86\u4E00\u4E2A\u4E34\u65F6\u7684\u573A\u5730\u53BB\u63A5\u53D7\u8FD9\u79CD\u4E0D\u5E73\u7B49\u7684\u5229\u76CA\u4E92\u6362\uFF0C\u9664\u4E86\u8BA9\u4F60\u80CC\u4E0A\u8FD8\u4E0D\u5B8C\u7684\u4EBA\u60C5\u503A\uFF0C\u8FD8\u4F1A\u6BC1\u6389\u8FD9\u5957\u7B97\u6CD5\u7684\u7EAF\u7CB9\u6027\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u4E0D\u9700\u8981\u90A3\u79CD\u201C\u6551\u4E16\u4E3B\u201D\uFF0C\u4F60\u53EA\u9700\u8981\u76F8\u4FE1\u6211\u4EEC\u624B\u91CC\u7684\u6570\u636E\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u5468\u781A\u770B\u7740\u6797\u6E21\uFF0C\u90A3\u79CD\u773C\u795E\u50CF\u662F\u7B2C\u4E00\u6B21\u91CD\u65B0\u5BA1\u89C6\u81EA\u5DF1\u7684\u5408\u4F19\u4EBA\u3002\u5979\u6CA1\u6709\u53CD\u9A73\u8FD9\u79CD\u7565\u5E26\u50ED\u8D8A\u7684\u6307\u70B9\uFF0C\u53CD\u800C\u611F\u5230\u4E00\u79CD\u4E45\u8FDD\u7684\u3001\u4E0D\u7528\u72EC\u81EA\u80CC\u8D1F\u51B3\u7B56\u538B\u529B\u7684\u8F7B\u76C8\u611F\u3002"
    choices: []
  - documentId: M2-3-2-B
    title: M2-3-2-B
    sourceAssetPath: Assets/content1/M2/M2-3-2-B.docx
    chapterId: M2
