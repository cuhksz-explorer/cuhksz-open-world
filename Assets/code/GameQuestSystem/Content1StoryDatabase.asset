    finishLocationName: "\u6821\u5916\u5267\u60C5\u89E6\u53D1\u70B9"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u51AC\u65E5\u5348\u540E\u7684\u9633\u5149\u6536\u655B\u4E86\u71E5\u70ED\uFF0C\u5E26\u7740\u4E00\u79CD\u6E05\u900F\u7684\u51B7\u610F\u3002\u4E2D\u73AF\u7684\u8857\u5934\u6302\u6EE1\u4E86\u8FCE\u63A5\u65B0\u5E74\u7684\u706F\u9970\uFF0C\u7A7A\u6C14\u91CC\u98D8\u7740\u8089\u6842\u5496\u5561\u548C\u86CB\u631E\u7684\u9999\u6C14\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u4ECA\u5929\u7A7F\u4E86\u4E00\u4EF6\u8D28\u611F\u6781\u4F73\u7684\u71D5\u9EA6\u8272\u7F8A\u7ED2\u5927\u8863\uFF0C\u5185\u642D\u4E00\u4EF6\u6DF1\u8272\u9AD8\u9886\u6BDB\u8863\uFF0C\u957F\u53D1\u88AB\u6D77\u98CE\u5439\u5F97\u7565\u663E\u51CC\u4E71\uFF0C\u5374\u591A\u4E86\u4E00\u4EFD\u5E73\u65F6\u5728\u5B9E\u9A8C\u5BA4\u89C1\u4E0D\u5230\u7684\u6E29\u67D4\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF0C\u6839\u636E\u6211\u7684\u6D4B\u7B97\uFF0C\u6211\u4EEC\u73B0\u5728\u5E94\u8BE5\u53BB\u4E2D\u73AF\u7801\u5934\u6392\u961F\uFF0C\u8FD9\u6837\u624D\u80FD\u5728\u5012\u6570\u5F00\u59CB\u524D\uFF0C\u5360\u636E\u7EF4\u6E2F\u6E21\u8F6E\u7684\u6700\u4F73\u89C2\u6D4B\u4F4D\u3002\u4F46\u4F60\u5E26\u6211\u8D70\u7684\u8FD9\u6761\u4E0A\u5761\u8DEF\uFF0C\u6B63\u5728\u8BA9\u6211\u4EEC\u504F\u79BB\u7801\u5934\u81F3\u5C11\u4E00\u70B9\u4E8C\u516C\u91CC\u3002\u201D"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5468\u8001\u677F\uFF0C\u65E2\u7136\u4F60\u628A\u5143\u65E6\u4EA4\u7ED9\u6211\u6765\u5B89\u6392\uFF0C\u90A3\u7B2C\u4E00\u6761\u51C6\u5219\u5C31\u662F\uFF1A\u4E0D\u8981\u5728\u5047\u671F\u91CC\u8C08\u8BBA\u2018\u6D4B\u7B97\u2019\u548C\u2018\u52A8\u7EBF\u2019\u3002\u4F60\u662F\u60F3\u53BB\u7801\u5934\u8DDF\u4E09\u4E07\u4EBA\u4E00\u8D77\u6324\u6210\u6C99\u4E01\u9C7C\u7F50\u5934\uFF0C\u8FD8\u662F\u60F3\u8DDF\u6211\u53BB\u8FD9\u6761\u5DF7\u5B50\u91CC\uFF0C\u627E\u90A3\u4E2A\u5168\u9999\u6E2F\u6700\u597D\u73A9\u7684\u673A\u5173\u5E97\uFF1F\u201D"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\uFF08\u987A\u624B\u9012\u8FC7\u53BB\u4E00\u4E2A\u70ED\u817E\u817E\u7684\u7EB8\u888B\uFF09\u201C\u7B97\u4E86\uFF0C\u6211\u5148\u7528\u8FD9\u4E2A\u9E21\u86CB\u4ED4\u5835\u4F4F\u4F60\u7684\u5634\u5427\u3002\u201D"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u770B\u7740\u51ED\u7A7A\u51FA\u73B0\u5728\u624B\u91CC\u7684\u9E21\u86CB\u4ED4\uFF0C\u65E0\u5948\u5730\u7B11\u4E86\u7B11\u3002\u90A3\u79CD\u5728\u5B9E\u9A8C\u5BA4\u91CC\u65E0\u5904\u4E0D\u5728\u7684\u638C\u63A7\u6B32\uFF0C\u5728\u8FD9\u4E00\u523B\u7ADF\u7136\u88AB\u6307\u5C16\u4F20\u6765\u7684\u5FAE\u70EB\u70ED\u5EA6\u6D88\u89E3\u5F97\u5E72\u5E72\u51C0\u51C0\u3002\u5979\u53D1\u73B0\u81EA\u5DF1\u7ADF\u7136\u4E00\u70B9\u4E5F\u4E0D\u53CD\u611F\u8FD9\u79CD\u201C\u88AB\u52A8\u504F\u822A\u201D\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u4E24\u4EBA\u5750\u5728\u4E86\u4E00\u53F0\u6709\u4E9B\u5E74\u5934\u7684\u6E2F\u5F0F\u8857\u673A\u524D\u3002\u6797\u6E21\u539F\u672C\u4EE5\u4E3A\uFF0C\u50CF\u5468\u781A\u8FD9\u79CD\u4E60\u60EF\u4E86\u8FD0\u7B79\u5E37\u5E44\u7684\u4EBA\uFF0C\u73A9\u8FD9\u79CD\u7EAF\u9760\u53CD\u5E94\u7684\u6E38\u620F\u4F1A\u7A0D\u5FAE\u6709\u4E9B\u751F\u758F\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u4F46\u5979\u9519\u4E86\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u6E38\u620F\u5F00\u59CB\u7684\u77AC\u95F4\uFF0C\u5468\u781A\u7684\u64CD\u4F5C\u6781\u5176\u5177\u6709\u4FB5\u7565\u6027\u3002\u5979\u4E0D\u8BB0\u590D\u6742\u7684\u8FDE\u62DB\uFF0C\u5B8C\u5168\u51ED\u501F\u51FA\u8272\u7684\u76F4\u89C9\u548C\u538B\u8FEB\u611F\u6781\u5F3A\u7684\u8D70\u4F4D\uFF0C\u628A\u6797\u6E21\u7684\u89D2\u8272\u903C\u5230\u4E86\u5C4F\u5E55\u89D2\u843D\u3002\u5979\u7684\u624B\u901F\u5F88\u5FEB\uFF0C\u6447\u6746\u88AB\u63A8\u5F97\u5494\u5494\u4F5C\u54CD\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5468\u8001\u677F\uFF0C\u5728\u6E38\u620F\u91CC\u4E5F\u8FD9\u4E48\u559C\u6B22\u628A\u4EBA\u903C\u5230\u6B7B\u89D2\uFF1F\u4F60\u7684\u6253\u6CD5\u592A\u6FC0\u8FDB\u4E86\uFF0C\u5B8C\u5168\u4E0D\u7559\u540E\u8DEF\u3002\u201D"
    - pageNumber: 11
      speakerName: "\u5468\u781A"
      text: "\u201C\u9632\u5B88\u8D62\u4E0D\u4E86\u6E38\u620F\u3002\u5728\u6211\u7684\u89C4\u5219\u91CC\uFF0C\u53EA\u8981\u8FDB\u653B\u7684\u6536\u76CA\u5927\u4E8E\u88AB\u53CD\u6740\u7684\u98CE\u9669\uFF0C\u90A3\u5C31\u662F\u6700\u4F18\u89E3\u3002\u6797\u6E21\uFF0C\u4F60\u518D\u9000\u5C31\u6CA1\u8840\u4E86\u3002\u201D"
    - pageNumber: 12
      speakerName: 
      text: "\u6B64\u65F6\u53CC\u65B9\u7684\u8840\u6761\u90FD\u89C1\u4E86\u5E95\uFF0C\u8FDB\u5165\u4E86\u6700\u540E\u7684\u8D5B\u70B9\u5C40\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u9762\u5BF9\u80DC\u8D1F\u6B32\u7206\u68DA\u7684\u5468\u781A\uFF0C\u4F60\u51B3\u5B9A\u7528\u4EC0\u4E48\u65B9\u5F0F\u7ED3\u675F\u8FD9\u5C40\u6E38\u620F\uFF1F"
    choices:
    - label: "\u7CBE\u51C6\u8BA1\u7B97"
      targetDocumentId: "M2-4-1\u6C88"
    - label: "\u65E0\u8D56\u6253\u6CD5"
      targetDocumentId: M2-4-2-A
  - documentId: "M2-4-1\u6C88"
    title: "M2-4-1\u6C88"
    sourceAssetPath: "Assets/content1/M2/M2-4-1\u6C88.docx"
