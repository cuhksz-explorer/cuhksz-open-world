    pages:
    - pageNumber: 1
      speakerName: 
      text: M2-4-1\u6C88
    - pageNumber: 1
      speakerName: 
      text: "\u843D\u5730\u7A97\u5916\u662F\u5E73\u5B89\u91D1\u878D\u4E2D\u5FC3\u7684\u6DF1\u84DD\u8272\u706F\u706B\u3002\u4ECE\u56FE\u4E66\u9986\u51FA\u6765\u7684\u4E24\u4EBA\uFF0C\u8EAB\u4E0A\u8FD8\u5E26\u7740\u4E00\u70B9\u6CA1\u6563\u53BB\u7684\u5026\u610F\uFF0C\u8FD9\u79CD\u75B2\u60EB\u53CD\u800C\u8BA9\u4EBA\u53D8\u5F97\u5766\u8BDA\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u9760\u5728\u6905\u80CC\u4E0A\uFF0C\u886C\u886B\u6263\u5B50\u89E3\u5F00\u4E86\u4E00\u9897\uFF0C\u5934\u53D1\u6B64\u523B\u7565\u663E\u51CC\u4E71\uFF0C\u8FD9\u8BA9\u4ED6\u770B\u8D77\u6765\u5C11\u4E86\u70B9\u201C\u8DDD\u79BB\u611F\u201D\u3002"
    - pageNumber: 3
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6211\u672C\u6765\u60F3\u5F85\u5230\u51CC\u6668\uFF0C\u4F46\u4E00\u8F6C\u5934\u770B\u4F60\u5728\u90A3\u513F\u5BF9\u7740\u4EE3\u7801\u53D1\u5446\uFF0C\u6211\u5C31\u77E5\u9053\u8BE5\u5E26\u4F60\u51FA\u6765\u4E86\u3002\u518D\u5F85\u4E0B\u53BB\uFF0C\u54B1\u4FE9\u90FD\u5F97\u75AF\u3002\u201D"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6240\u4EE5\u4F60\u8FD9\u662F\u5728\u5173\u5FC3\u6211\uFF0C\u8FD8\u662F\u5355\u7EAF\u81EA\u5DF1\u60F3\u7FD8\u73ED\u4E86\uFF1F\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u6C88\u9752\u79BE\u8033\u6735\u53C8\u7EA2\u4E86\uFF0C\u559D\u4E86\u4E00\u5927\u53E3\u9E21\u5C3E\u9152\uFF0C\u88AB\u545B\u5F97\u54B3\u55FD\u4E86\u4E24\u58F0\uFF0C\u9152\u6C14\u7A0D\u7A0D\u722C\u4E0A\u8138\u3002"
    - pageNumber: 6
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u662F\u6211\u60F3\u8DDF\u4F60\u5355\u72EC\u5F85\u4F1A\u513F\uFF0C\u8FD9\u4E2A\u7406\u7531\u591F\u76F4\u63A5\u5417\uFF1F\u201D"
    - pageNumber: 7
      speakerName: 
      text: "\u6C88\u9752\u79BE\u7684\u624B\u673A\u9707\u4E2A\u4E0D\u505C\uFF0C\u4ED6\u4E00\u8FB9\u5904\u7406\u7D27\u6025\u7535\u8BDD\uFF0C\u4E00\u8FB9\u628A\u5E73\u677F\u63A8\u7ED9\u4F60\u3002"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6797\u6E21\uFF0C\u5E2E\u6211\u786E\u8BA4\u4E00\u4E0B\u521A\u624D\u53D1\u5230\u4F60\u90AE\u7BB1\u7684\u90A3\u4E2A\u8FDB\u5EA6\u8868\u3002\u201D"
    - pageNumber: 9
      speakerName: 
      text: "\u4F60\u5212\u4E86\u4E00\u4E0B\uFF0C\u5374\u56E0\u4E3A\u624B\u52BF\u8BEF\u89E6\uFF0C\u76F4\u63A5\u5207\u8FDB\u4E86\u4E00\u4E2A\u7F6E\u9876\u7684\u4FBF\u7B7E\u3002\u90A3\u4E0D\u662F\u4EC0\u4E48\u5B9E\u9A8C\u6570\u636E\uFF0C\u800C\u662F\u4E00\u7BC7\u7BC7\u7B80\u77ED\u5374\u6E05\u6670\u7684\u3001\u5173\u4E8E\u4F60\u7684\u201C\u89C2\u5BDF\u65E5\u8BB0\u201D\uFF1A"
    - pageNumber: 10
      speakerName: 
      text: "[12\u670812\u65E5] > \u4EE5\u540E\u53BB\u5B9E\u9A8C\u5BA4\u5F97\u7ED9\u5979\u5E26\u8584\u8377\u7CD6\u3002\u5979\u5199\u4E0D\u51FA\u4EE3\u7801\u65F6\u4F1A\u76B1\u7709\u5934\uFF0C\u5403\u9897\u7CD6\u5FC3\u60C5\u5C31\u597D\u3002"
    - pageNumber: 11
      speakerName: 
      text: "[1\u67085\u65E5] > \u5979\u4ECA\u5929\u7A7F\u4E86\u90A3\u4EF6\u6DF1\u7EFF\u8272\u7684\u536B\u8863\u3002\u6211\u53D1\u73B0\u6211\u7ADF\u7136\u80FD\u8BB0\u8D77\u5979\u7A7F\u8FC7\u7684\u6BCF\u4E00\u4EF6\u8863\u670D\uFF0C\u8FD9\u592A\u5947\u602A\u4E86\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u6C88\u9752\u79BE\u6302\u65AD\u7535\u8BDD\u8F6C\u8FC7\u5934\uFF0C\u521A\u597D\u649E\u89C1\u4F60\u76EF\u7740\u90A3\u4E00\u9875\u8BB0\u5F55\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u90A3\u4E00\u77AC\u95F4\uFF0C\u4ED6\u5927\u8111\u8FC7\u8F7D\u4E86\u3002\u4ED6\u4E0B\u610F\u8BC6\u60F3\u53BB\u62FF\u5E73\u677F\uFF0C\u624B\u4F38\u5230\u4E00\u534A\u5374\u50F5\u4F4F\u4E86\uFF0C\u8033\u6839\u7EA2\u5F97\u624E\u773C\u3002"
    - pageNumber: 14
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u2026\u2026\u6211\u539F\u672C\u6CA1\u6253\u7B97\u8BA9\u4F60\u770B\u5230\u7684\u3002\u6211\u53EA\u662F\u4E60\u60EF\u628A\u5728\u610F\u7684\u4E8B\u60C5\u90FD\u8BB0\u4E0B\u6765\uFF0C\u6015\u81EA\u5DF1\u5FD9\u8D77\u6765\u4F1A\u5FD8\u4E86\u7167\u987E\u2026\u2026\u670B\u53CB\u7684\u5FC3\u60C5\u3002\u201D"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6C88\u5B66\u957F\uFF0C\u4F60\u5728\u80CC\u5730\u91CC\u8FD9\u4E48\u5173\u6CE8\u6211\uFF0C\u8FD9\u8BA9\u6211\u538B\u529B\u5F88\u5927\u554A\u3002\u201D"
    - pageNumber: 16
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4E0D\u662F\u5173\u6CE8\uFF0C\u662F\u5FCD\u4E0D\u4F4F\u3002\u6797\u6E21\uFF0C\u6211\u7684\u4EBA\u751F\u672C\u6765\u89C4\u5212\u5F97\u5F88\u6B7B\u677F\uFF0C\u4F46\u4F60\u51FA\u73B0\u540E\uFF0C\u6240\u6709\u7684\u8BA1\u5212\u90FD\u4E71\u4E86\u3002\u6211\u53D1\u73B0\uFF0C\u6211\u6839\u672C\u6CA1\u6CD5\u628A\u4F60\u4ECE\u6211\u7684\u8111\u5B50\u91CC\u632A\u51FA\u53BB\u3002\u201D"
    - pageNumber: 17
      speakerName: 
      text: "\u4ED6\u5E76\u6CA1\u6709\u7B49\u4E0B\u4E00\u6B21\u673A\u4F1A\uFF0C\u800C\u662F\u4ECE\u5305\u91CC\u638F\u51FA\u4E00\u5F20\u521A\u624D\u5728\u5B9E\u9A8C\u5BA4\u6253\u5370\u51FA\u6765\u7684\u9879\u76EE\u62D3\u6251\u56FE\uFF0C\u9012\u5230\u4F60\u9762\u524D\u3002"
    - pageNumber: 18
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4F60\u770B\u8FD9\u91CC\uFF0C\u8FD9\u4E2A\u6838\u5FC3\u8FD0\u884C\u6A21\u5757\u7684\u547D\u540D\u3002\u201D"
    - pageNumber: 19
      speakerName: 
      text: "\u4F60\u51D1\u8FD1\u770B\uFF0C\u5728\u90A3\u4E2A\u51B3\u5B9A\u6574\u4E2A\u7A0B\u5E8F\u80FD\u5426\u8DD1\u901A\u7684\u6700\u5173\u952E\u4F4D\u7F6E\uFF0C\u4ED6\u8D77\u4E86\u4E00\u4E2A\u540D\u5B57\uFF1AAlways_With_Lin\u3002"
    - pageNumber: 20
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u8FD9\u4E2A\u6A21\u5757\u53EA\u8981\u8FD0\u884C\uFF0C\u8FD9\u4E2A\u540D\u5B57\u5C31\u6C38\u8FDC\u5728\u8FD9\u513F\u3002\u6211\u4EE5\u524D\u89C9\u5F97\u627F\u8BFA\u5F88\u865A\uFF0C\u4F46\u6211\u60F3\u628A\u6211\u7684\u672A\u6765\u548C\u4F60\u7ED1\u5728\u4E00\u8D77\uFF0C\u8FD9\u662F\u6211\u80FD\u60F3\u5230\u7684\u3001\u6700\u8BA4\u771F\u7684\u544A\u767D\u3002\u201D"
    choices:
    - label: "\u786E\u5B9A\u6027\u7B54\u6848\u3010\u604B\u7231\u7EBF\u3011"
      targetDocumentId: M2-4-2-A
    - label: "\u66F4\u957F\u4E45\u7684\u9ED8\u5951 \u3010\u53CB\u60C5\u7EBF\u3011"
      targetDocumentId: "M2-4-2a\u6C88"
