    - pageNumber: 2
      speakerName: "\u9648\u6559\u6388"
      text: "\u7B54\u8FA9\u6211\u770B\u4E86\uFF0C\u8868\u73B0\u5F97\u5F88\u7A33\u3002\u73B0\u5728\u627E\u4F60\u6765\uFF0C\u662F\u60F3\u6700\u540E\u786E\u8BA4\u4E00\u4E0B\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u7684\u8FDB\u7EC4\u534F\u8BAE\u3002\u540D\u989D\u6211\u7ED9\u4F60\u7559\u4E0B\u4E86\uFF0C\u4F46\u6709\u4E2A\u6761\u4EF6\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u610F\u5473\u7740\u6211\u8FD9\u534A\u5E74\u7684\u6240\u6709\u6838\u5FC3\u4EA7\u51FA\uFF0C\u5728\u540D\u4E49\u4E0A\u90FD\u4E0D\u5C5E\u4E8E\u6211\u4E2A\u4EBA\u3002"
    - pageNumber: 4
      speakerName: "\u9648\u6559\u6388"
      text: "\u8FD9\u662F\u4E00\u4E2A\u5E73\u53F0\u7684\u95E8\u7968\u94B1\u3002\u4F60\u60F3\u6E05\u695A\uFF0C\u4E0B\u5348\u4E24\u70B9\u4E4B\u524D\u7ED9\u6211\u7B54\u590D\uFF0C\u4E0D\u7136\u6211\u5F88\u96BE\u5728\u63A8\u8350\u4FE1\u4E0A\u7B7E\u5B57\u3002"
