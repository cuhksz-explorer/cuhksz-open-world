    finishLocationName: "\u56FE\u4E66\u9986\u4E94\u697C\u9732\u53F0"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u5B66\u6821\u56FE\u4E66\u9986\u4E94\u697C\u9732\u53F0 / \u508D\u665A
        18:30"
    - pageNumber: 2
      speakerName: 
      text: "\u8FDC\u5904\u7684\u843D\u65E5\u4F59\u6656\u628A\u884C\u653F\u697C\u7684\u8F6E\u5ED3\u9540\u4E86\u4E00\u5C42\u91D1\u3002\u6797\u6E21\u9762\u524D\u653E\u7740\u4E24\u4EFD\u521A\u6253\u5370\u51FA\u6765\u7684\u5B9E\u4E60\u5F55\u53D6\u610F\u5411\u4E66\uFF0C\u5FAE\u98CE\u628A\u7EB8\u5F20\u5439\u5F97\u6C99\u6C99\u4F5C\u54CD\u3002\u8FD9\u662F\u5927\u4E8C\u8FD9\u4E2A\u6691\u5047\u6700\u91CD\u8981\u7684\u4E24\u4E2A\u53BB\u5904\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u695A\u5929\u62CE\u7740\u4E24\u676F\u5976\u8336\u8D70\u8FC7\u6765\uFF0C\u628A\u5176\u4E2D\u4E00\u74F6\u9012\u7ED9\u6797\u6E21\uFF0C\u987A\u52BF\u626B\u4E86\u4E00\u773C\u684C\u4E0A\u7684\u4E24\u4EFD\u5408\u540C\u3002"
    - pageNumber: 4
      speakerName: "\u695A\u5929"
      text: "\u542C\u8BF4\u4F60\u4E0B\u5348\u9762\u5B8C\u4E86\u6700\u540E\u4E00\u5BB6\u3002\u8FD9\u5C31\u662F\u7EC8\u9009\u540D\u5355\u4E86\uFF1F"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u55EF\u3002\u4E00\u4EFD\u662F\u6052\u521B\u79D1\u6280\u7684\u5B9E\u4E60\uFF0C\u4E00\u4EFD\u662F\u9752\u9E1F\u516C\u53F8\u7684\u9879\u76EE\u3002"
    - pageNumber: 6
      speakerName: "\u695A\u5929"
      text: "\u6052\u521B\u90A3\u662F\u5927\u5382\u7684\u5916\u5305\u6838\u5FC3\u7EC4\uFF0C\u7ED9\u5927\u4E8C\u5B9E\u4E60\u751F\u5F00\u4E00\u4E2A\u6708\u516B\u5343\u7684\u85AA\u6C34\uFF0C\u5728\u54B1\u4EEC\u7CFB\u5DF2\u7ECF\u662F\u5929\u82B1\u677F\u4E86\u3002\u4E0D\u8FC7\u6211\u4E5F\u542C\u5B66\u957F\u8BF4\u4E86\uFF0C\u8FDB\u53BB\u5C31\u662F\u5F53\u201C\u6807\u6CE8\u6C11\u5DE5\u201D\uFF0C\u6BCF\u5929\u5904\u7406\u51E0\u4E07\u6761\u8425\u9500\u6570\u636E\uFF0C\u7EAF\u7CB9\u662F\u62FF\u4F53\u529B\u6362\u94B1\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u4EEC\u90A3\u786E\u5B9E\u53EA\u7ED9\u5B9E\u4E60\u751F\u5E72\u810F\u6D3B\uFF0C\u4F46\u662F\u8FD9\u7B14\u5B9E\u4E60\u8D39\u786E\u5B9E\u80FD\u4E3A\u5341\u56DB\u4E07\u7684\u5B66\u8D39\u51CF\u8F7B\u538B\u529B\u3002"
    - pageNumber: 8
      speakerName: "\u695A\u5929"
      text: "\u90A3\u9752\u9E1F\u90A3\u8FB9\u5462\uFF1F\u600E\u4E48\u6CA1\u542C\u8FC7\u8FD9\u4E2A\u4F01\u4E1A\uFF1F"
    - pageNumber: 9
      speakerName: "\u695A\u5929"
      text: "\u4E09\u5343\u5757\u94B1\uFF0C\u4F60\u53EA\u80FD\u70B9\u62FC\u597D\u996D\u4E86\u3002\u4F46\u8FD9\u6D3B\u513F\u786E\u5B9E\u5F88\u7406\u60F3\u4E3B\u4E49\uFF0C\u4F60\u662F\u53BB\u7ED9\u4EBA\u5BB6\u5F53\u67B6\u6784\u5E08\uFF0C\u4E0D\u662F\u53BB\u5F53\u87BA\u4E1D\u9489\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u624B\u673A\u9707\u52A8\u4E86\u4E00\u4E0B\uFF0C\u5468\u781A\u7684\u6D88\u606F\u8DF3\u4E86\u51FA\u6765\u3002"
    - pageNumber: 11
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6797\u6E21\uFF0C\u9752\u9E1F\u5B9E\u9A8C\u5BA4\u7684\u90A3\u4E2A\u8D1F\u8D23\u4EBA\u4EE5\u524D\u662F\u6211\u7684\u5B66\u957F\uFF0C\u4ED6\u7684\u6280\u672F\u55C5\u89C9\u975E\u5E38\u654F\u9510\u3002\u5982\u679C\u4F60\u60F3\u5728\u5927\u6A21\u578B\u5E94\u7528\u5C42\u6709\u771F\u6B63\u7684\u5EFA\u6811\uFF0C\u8FD9\u91CC\u53EF\u80FD\u6BD4\u5728\u6052\u521B\u90A3\u680B\u79D1\u6280\u56ED\u7684\u5927\u697C\u91CC\u80FD\u5B66\u5230\u7684\u4E1C\u897F\u591A\u5F97\u591A\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u6797\u6E21\u95ED\u4E0A\u773C\uFF0C\u5728\u5FC3\u91CC\u62E8\u52A8\u7740\u90A3\u51E0\u4E2A\u4EE3\u8868\u672A\u6765\u7684\u6ED1\u5757\u3002"
    choices:
