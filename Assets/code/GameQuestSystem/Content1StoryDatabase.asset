    pages:
    - pageNumber: 1
      speakerName: 
      text: M2-2-2a\u6C88
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u5408\u4E0A\u8349\u7A3F\u672C\uFF0C\u8F6C\u8FC7\u5934\uFF0C\u5E73\u9759\u5730\u770B\u5411\u90A3\u4F4D\u5E08\u5144\u3002\u5979\u7684\u8BED\u6C14\u5E76\u4E0D\u5C16\u9510\uFF0C\u5374\u5E26\u7740\u4E00\u79CD\u4E0D\u5BB9\u53CD\u9A73\u7684\u4E13\u4E1A\u611F\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5E08\u5144\uFF0C\u6211\u4EEC\u7684\u6BD4\u8D5B\u6A21\u578B\u4E3A\u4E86\u5F15\u5165\u968F\u673A\u6027\uFF0C\u5E95\u5C42\u52A0\u4E86\u975E\u786E\u5B9A\u6027\u7684\u968F\u673A\u79CD\u5B50\u3002\u5982\u679C\u7528\u6211\u4EEC\u73B0\u5728\u7684\u73AF\u5883\u53BB\u5957\u4F60\u7684\u751F\u5316\u6570\u636E\uFF0C\u8DD1\u51FA\u6765\u7684\u7ED3\u679C\u662F\u4E0D\u53EF\u9006\u7684\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u6838\u5FC3\u671F\u520A\u76F2\u5BA1\u4E00\u65E6\u8981\u6C42\u4F60\u63D0\u4F9B\u590D\u73B0\u4EE3\u7801\uFF0C\u4F60\u7684\u6570\u636E\u5C31\u6210\u4E86\u5B64\u8BC1\u3002\u4E3A\u4E86\u7701\u8FD9\u534A\u5C0F\u65F6\uFF0C\u53BB\u62C5\u6570\u636E\u65E0\u6CD5\u590D\u73B0\u7684\u5B66\u672F\u98CE\u9669\uFF0C\u8FD9\u7B14\u8D26\u903B\u8F91\u4E0A\u7B97\u4E0D\u901A\u5427\uFF1F\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u5E08\u5144\u6123\u4F4F\u4E86\uFF0C\u4ED6\u663E\u7136\u4E0D\u6562\u4E3A\u4E86\u8D76\u65F6\u95F4\u53BB\u5192\u201C\u5B66\u672F\u9020\u5047\u201D\u7684\u98CE\u9669\uFF0C\u8138\u8272\u53D8\u4E86\u53D8\uFF0C\u627E\u4E2A\u501F\u53E3\u6536\u62FE\u4E1C\u897F\u8D70\u4E86\u3002\u6C88\u9752\u79BE\u770B\u7740\u6797\u6E21\u7528\u6700\u4E25\u8C28\u7684\u201C\u590D\u73B0\u5E38\u8BC6\u201D\u5175\u4E0D\u8840\u5203\u5730\u903C\u9000\u4E86\u5BF9\u65B9\uFF0C\u773C\u5E95\u6D6E\u73B0\u51FA\u4E00\u62B9\u6781\u6DE1\u7684\u7B11\u610F\u3002"
    choices: []
