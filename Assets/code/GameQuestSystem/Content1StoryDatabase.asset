    fallbackTargetPosition: {x: 24.908428, y: 0.656, z: -37.074}
    rewardGold: 65
    finishLocationName: "TXC\u884C\u653F\u697C/\u7814\u8BA8\u5BA4"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u793E\u56E2\u6559\u5BA4\u7684\u95E8\u5408\u4E0A\u4E4B\u540E\uFF0C\u8D70\u5ECA\u91CC\u53EA\u5269\u4E0B\u6D88\u9632\u6307\u793A\u724C\u5E7D\u7EFF\u7684\u5FAE\u5149\u3002\u6797\u89C1\u9E7F\u7ED9\u6797\u6E21\u53D1\u6765\u4E00\u6761\u6781\u77ED\u7684\u6D88\u606F\uFF1A\u300C\u7814\u8BA8\u5BA4\u3002\u73B0\u5728\u3002\u300D"
    - pageNumber: 2
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u4F60\u4E0D\u89C9\u5F97\u6211\u4EEC\u521A\u624D\u90FD\u5728\u6F14\u540C\u4E00\u573A\u620F\u5417\uFF1F\u8D75\u627F\u52CB\u9700\u8981\u821E\u53F0\uFF0C\u793E\u56E2\u9700\u8981\u4F53\u9762\uFF0C\u800C\u4F60\u9700\u8981\u4E00\u4E2A\u7B54\u6848\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u53EB\u6211\u6765\uFF0C\u662F\u60F3\u8BA9\u6211\u5E2E\u4F60\u4FDD\u5BC6\uFF0C\u8FD8\u662F\u60F3\u8BA9\u6211\u76F8\u4FE1\u5236\u5EA6\u8FD8\u80FD\u81EA\u6211\u4FEE\u590D\uFF1F"
    - pageNumber: 4
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u5BA1\u8BA1\u5982\u679C\u53EA\u5269\u4E0B\u300C\u63ED\u53D1\u300D\uFF0C\u793E\u56E2\u5C31\u53EA\u5269\u6050\u60E7\uFF1B\u5982\u679C\u53EA\u5269\u4E0B\u300C\u906E\u76D6\u300D\uFF0C\u5C31\u53EA\u5269\u9A97\u5B50\u3002\u6211\u60F3\u77E5\u9053\u2014\u2014\u4F60\u4F1A\u628A\u4ECA\u665A\u7684\u6570\u5B57\u5E26\u53BB\u54EA\u91CC\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u7814\u8BA8\u5BA4\u7684\u767D\u677F\u8FD8\u7559\u7740\u4E0B\u5348\u8BA8\u8BBA\u8D5B\u9898\u65F6\u7684\u6B8B\u5F71\u3002\u7A97\u5916\u6CA1\u6709\u89C2\u4F17\uFF0C\u53EA\u6709\u7A7A\u8C03\u7684\u4F4E\u9E23\uFF0C\u50CF\u67D0\u79CD\u8010\u5FC3\u7684\u8D28\u95EE\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4F1A\u628A\u590D\u5370\u4EF6\u7559\u7ED9\u4F60\u3002\u4F46\u4E0B\u4E00\u6B21\uFF0C\u8981\u8D70\u7A0B\u5E8F\u3002\u516C\u5F00\u4E0D\u662F\u7F9E\u8FB1\uFF0C\u662F\u8BA9\u613F\u610F\u7559\u4E0B\u7684\u4EBA\u8FD8\u5750\u5F97\u4F4F\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u2026\u2026\u597D\u3002\u81F3\u5C11\u4ECA\u665A\uFF0C\u6211\u4EEC\u8FD8\u613F\u610F\u5750\u5728\u540C\u4E00\u5F20\u684C\u5B50\u524D\u3002"
    choices: []
