      text: "\u4E5D\u6708\u521D\u7684\u6DF1\u5733\uFF0C\u6E7F\u70ED\u7684\u7A7A\u6C14\u5373\u4FBF\u9694\u7740\u5BBF\u820D\u7684\u73BB\u7483\u7A97\u4E5F\u4EFF\u4F5B\u80FD\u6E17\u900F\u8FDB\u6765\u3002\u5B66\u52E4\u4E66\u9662\u7684\u5BBF\u820D\u5185\uFF0C\u56DB\u53F0\u9AD8\u6027\u80FD\u7B14\u8BB0\u672C\u7535\u8111\u7684\u6563\u70ED\u98CE\u6247\u540C\u65F6\u53D1\u51FA\u4F4E\u6C89\u7684\u8F70\u9E23\uFF0C\u50CF\u662F\u5728\u4E3A\u5373\u5C06\u5230\u6765\u7684\u6218\u4E89\u6696\u573A\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u5750\u5728\u4E66\u684C\u524D\uFF0C\u53F3\u624B\u98DF\u6307\u65E0\u610F\u8BC6\u5730\u8F7B\u6263\u7740\u9F20\u6807\u3002\u5C4F\u5E55\u4E0A\u7684\u6559\u52A1\u7CFB\u7EDF\u9875\u9762\u505C\u7559\u5728\u201C\u9009\u8BFE\u5165\u53E3\u201D\uFF0C\u5012\u8BA1\u65F6\u8DF3\u52A8\u7740\uFF1A00:12\u3002"
    - pageNumber: 3
      speakerName: "\u82CF\u6C90"
      text: "\u6211\u624B\u5FC3\u5168\u662F\u6C57\u2026\u2026\u771F\u7684\uFF0C\u5982\u679C\u62A2\u4E0D\u5230\u90A3\u95E8\u300A\u8D22\u52A1\u4F1A\u8BA1\u5BFC\u8BBA\u300B\uFF0C\u6211\u8FD9\u5B66\u671F\u7684\u6240\u6709\u5148\u4FEE\u8BFE\u8BA1\u5212\u5168\u90FD\u8981\u4F5C\u5E9F\u4E86\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u82CF\u6C90\u7684\u58F0\u97F3\u5728\u53D1\u6296\u3002\u4F5C\u4E3A\u5BA4\u53CB\u4E2D\u6027\u683C\u6700\u6E29\u548C\u7684\u4E00\u4E2A\uFF0C\u5979\u6B64\u523B\u8138\u4E0A\u7684\u7126\u8651\u51E0\u4E4E\u8981\u6EA2\u51FA\u6765\u3002"
    - pageNumber: 5
      speakerName: "\u8D75\u6893\u7487"
      text: "\u522B\u5728\u90A3\u513F\u81EA\u5DF1\u5413\u81EA\u5DF1\u4E86\u3002\u82CF\u6C90\uFF0C\u542C\u6211\u7684\uFF0C\u5148\u628A\u9875\u9762\u5237\u51FA\u6765\u3002\u62A2\u8BFE\u8FD9\u79CD\u4E8B\uFF0C\u62FC\u7684\u662F\u7F51\u901F\u548C\u624B\u901F\uFF0C\u4E0D\u662F\u4F60\u7684\u5B66\u4E60\u8BA1\u5212\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u8D75\u6893\u7487\u63A8\u4E86\u63A8\u9F3B\u6881\u4E0A\u7684\u9ED1\u6846\u773C\u955C\uFF0C\u5979\u5DF2\u7ECF\u5173\u6389\u4E86\u6240\u6709\u5360\u7528\u5E26\u5BBD\u7684\u7A0B\u5E8F\uFF0C\u751A\u81F3\u62D4\u6389\u4E86\u5BBF\u820D\u91CC\u552F\u4E00\u7684\u8DEF\u7531\u5668\uFF0C\u6539\u4E3A\u76F4\u63A5\u4F7F\u7528\u6709\u7EBF\u8FDE\u63A5\u3002"
    - pageNumber: 7
      speakerName: "\u6881\u5609\u4E00"
      text: "\u62A2\u4E0D\u5230\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u5927\u4E0D\u4E86\u53BB\u6C42\u6559\u6388\u52A0\u4F4D\u3002\u867D\u7136\u90A3\u6982\u7387\u6BD4\u4E2D\u5F69\u7968\u8FD8\u4F4E\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u6881\u5609\u4E00\u4F9D\u65E7\u51B7\u9759\u5F97\u6709\u4E9B\u523B\u8584\uFF0C\u5979\u5934\u4E5F\u4E0D\u62AC\u5730\u6574\u7406\u7740\u81EA\u5DF1\u7684\u9884\u9009\u6E05\u5355\uFF0C\u90A3\u4E0A\u9762\u6BCF\u4E00\u5206\u3001\u6BCF\u4E00\u79D2\u7684\u6392\u8BFE\u90FD\u7CBE\u51C6\u5F97\u50CF\u662F\u4E00\u5F20\u5DE5\u4E1A\u6D41\u7A0B\u56FE\u3002"
    - pageNumber: 9
      speakerName: "\u5012\u8BA1\u65F6\u5F52\u96F6\u300209"
      text: "00:00\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u731B\u5730\u6309\u4E0B F5 \u952E\u3002\u539F\u672C\u767D\u8272\u7684\u9875\u9762\u77AC\u95F4\u5361\u6B7B\uFF0C\u90A3\u4E2A\u65CB\u8F6C\u7684\u52A0\u8F7D\u5706\u5708\u4EFF\u4F5B\u662F\u67D0\u79CD\u547D\u8FD0\u7684\u8F6C\u76D8\uFF0C\u5728\u6BCF\u4E2A\u4EBA\u7D27\u7F29\u7684\u77B3\u5B54\u4E2D\u8F6C\u52A8\u3002"
    - pageNumber: 11
      speakerName: "\u82CF\u6C90"
      text: "\u5361\u4F4F\u4E86\uFF01\u6551\u547D\uFF01\u6211\u7684\u9875\u9762\u6253\u4E0D\u5F00\u4E86\uFF01"
    - pageNumber: 12
      speakerName: "\u8D75\u6893\u7487"
      text: "\u522B\u4E71\u52A8\uFF01\u7B49\u5B83\u81EA\u5DF1\u8DF3\u51FA\u6765\uFF01"
    - pageNumber: 13
      speakerName: 
      text: "\u4E94\u79D2\u949F\u540E\uFF0C\u6797\u6E21\u7684\u9875\u9762\u7387\u5148\u8DF3\u8F6C\u3002\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u8BFE\u7A0B\u5217\u8868\u50CF\u662F\u4E00\u9053\u9053\u5F85\u9009\u7684\u730E\u7269\u3002"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "\u7EBF\u4EE3\u5DF2\u7ECF\u6CA1\u4E86\u2026\u2026\u597D\u5FEB\u3002"
    - pageNumber: 15
      speakerName: 
      text: "\u6797\u6E21\u7684\u624B\u6307\u98DE\u5FEB\u79FB\u52A8\uFF0C\u7A81\u7136\uFF0C\u4E24\u95E8\u8BFE\u7A0B\u5728\u5979\u7684\u9884\u9009\u51B2\u7A81\u5217\u8868\u91CC\u649E\u5728\u4E86\u4E00\u8D77\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u53E6\u4E00\u95E8\u662F\u300A\u96F6\u548C\u903B\u8F91\u4E0E\u4EBA\u7C7B\u884C\u4E3A\u300B\uFF0C\u4E3B\u8BB2\u6559\u6388\u662F\u4E00\u4E2A\u4ECE\u672A\u542C\u8BF4\u8FC7\u7684\u540D\u5B57\u3002\u8FD9\u95E8\u8BFE\u6CA1\u6709\u5F80\u5E74\u8BC4\u5206\uFF0C\u6CA1\u6709\u8BFE\u7EB2\u9884\u89C8\uFF0C\u552F\u4E00\u5438\u5F15\u6797\u6E21\u7684\u662F\u90A3\u4E2A\u8BE1\u5F02\u7684\u8BFE\u7A0B\u7F16\u7801\uFF1AMAT000\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u624B\u673A\u5728\u684C\u9762\u4E0A\u6025\u4FC3\u5730\u8DF3\u52A8\u4E86\u4E00\u4E0B\u3002\u662F\u6C88\u9752\u79BE\u3002"
    - pageNumber: 18
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5361\u4E86\u5417\u3002"
    - pageNumber: 19
      speakerName: "\u6797\u6E21"
      text: "\u5361\u3002\u8FD8\u6709\u51B2\u7A81\u3002"
    - pageNumber: 20
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u53D1\u6211\u622A\u56FE\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u6797\u6E21\u98DE\u5FEB\u5730\u4F20\u8FC7\u4E00\u5F20\u7167\u7247\u3002\u4E09\u79D2\u949F\u540E\uFF0C\u5BF9\u8BDD\u6846\u5F39\u51FA\u4E86\u6C88\u9752\u79BE\u6807\u5FD7\u6027\u7684\u7B80\u6D01\u56DE\u590D\u3002"
    - pageNumber: 22
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5220\u6389\u90A3\u4E2A MAT000\u3002"
    - pageNumber: 23
      speakerName: "\u6797\u6E21"
      text: "\u4E3A\u4EC0\u4E48\uFF1F\u8FD9\u95E8\u8BFE\u7684\u540D\u5B57\u770B\u8D77\u6765\u2026\u2026\u5F88\u6709\u610F\u601D\u3002"
    - pageNumber: 24
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5728\u8FD9\u6240\u5B66\u6821\u91CC\uFF0C\u201C\u6709\u610F\u601D\u201D\u5F80\u5F80\u662F\u4F4E\u7EE9\u70B9\u7684\u4EE3\u540D\u8BCD\u3002\u6211\u67E5\u4E86\u90A3\u4E2A\u7F16\u7801\uFF0C\u4E0D\u662F\u5E38\u89C4\u8BFE\u7A0B\u5E8F\u5217\u3002\u6CA1\u6709\u6570\u636E\u652F\u6301\u7684\u8BFE\uFF0C\u5C31\u662F\u7EAF\u7CB9\u7684\u8D4C\u535A\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u53EF\u300A\u6218\u7565\u51B3\u7B56\u300B\u7684\u8BFE\u7EB2\u6211\u5927\u4E00\u5C31\u81EA\u5B66\u5F97\u5DEE\u4E0D\u591A\u4E86\u3002"
    - pageNumber: 26
      speakerName: 
      text: "\u6C88\u9752\u79BE\u7684\u8BDD\u50CF\u662F\u4E00\u628A\u624B\u672F\u5200\uFF0C\u76F4\u63A5\u5207\u5F00\u4E86\u6797\u6E21\u5FC3\u4E2D\u90A3\u4E2A\u540D\u4E3A\u201C\u6C42\u77E5\u6B32\u201D\u548C\u201C\u7EE9\u70B9\u201D\u7684\u7EA0\u7ED3\u3002"
    - pageNumber: 27
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u8981\u7A33\uFF0C\u5C31\u5220 MAT000\u3002\u8981\u90A3\u79CD\u4E0D\u53EF\u63A7\u7684\u201C\u7A7A\u95F4\u201D\uFF0C\u5C31\u7559\u7740\u5B83\u3002\u4F46\u8FD9\u5B66\u671F\u7684\u538B\u529B\u53EF\u80FD\u4F1A\u8D85\u51FA\u4F60\u7684\u91CF\u7A0B\u3002\u4F60\u81EA\u5DF1\u9009\u3002"
    - pageNumber: 28
      speakerName: "\u82CF\u6C90"
      text: "\u6797\u6E21\uFF01\u5FEB\u70B9\u554A\uFF01\u518D\u4E0D\u70B9\u5C31\u90FD\u6CA1\u4E86\uFF01"
    - pageNumber: 29
      speakerName: "\u8D75\u6893\u7487"
      text: "\u522B\u7BA1\u90A3\u4E9B\u6CA1\u7528\u7684\u4E86\uFF0C\u5148\u628A\u80FD\u62FF\u5206\u7684\u5360\u4F4F\uFF01"
