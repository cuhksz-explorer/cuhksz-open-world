    pages:
    - pageNumber: 1
      speakerName: 
      text: M2-3-3\u6C88
    - pageNumber: 1
      speakerName: 
      text: "\u5929\u8272\u5F7B\u5E95\u6697\u4E86\u4E0B\u6765\uFF0C\u201C\u6625\u7B0B\u201D\u548C\u4E07\u8C61\u5929\u5730\u7684\u706F\u706B\u4EAE\u8D77\u3002\u4E24\u4EBA\u5750\u5728\u6808\u9053\u7684\u77F3\u51F3\u4E0A\uFF0C\u4E00\u4EBA\u624B\u91CC\u62FF\u7740\u4E00\u74F6\u5728\u8D85\u5E02\u4E70\u7684\u9E21\u5C3E\u9152\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u4E00\u76F4\u4F4E\u5934\u6263\u7740\u9E21\u5C3E\u9152\u7684\u62C9\u73AF\uFF0C\u4E00\u526F\u6B32\u8A00\u53C8\u6B62\u7684\u6837\u5B50\u3002\u8FC7\u4E86\u5F88\u4E45\uFF0C\u4ED6\u624D\u4ECE\u80CC\u5305\u91CC\u62FF\u51FA\u4E00\u4E2A\u5305\u88C5\u5F97\u5F88\u7B80\u964B\u3001\u751A\u81F3\u7EB8\u89D2\u90FD\u6709\u4E9B\u6298\u75D5\u7684\u5C0F\u76D2\u5B50\u3002"
    - pageNumber: 3
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u521A\u624D\u2026\u2026\u5728\u8DEF\u8FB9\u770B\u5230\u7684\u3002\u90A3\u4E2A\u5E97\u4E3B\u8BF4\u8FD9\u53EB\u624B\u5DE5\u98CE\u94C3\u3002\u6211\u89C9\u5F97\u58F0\u97F3\u633A\u597D\u542C\u7684\uFF0C\u4E5F\u6CA1\u4EC0\u4E48\u522B\u7684\u610F\u601D\u2026\u2026\u5C31\u662F\u89C9\u5F97\u4F60\u53EF\u80FD\u4F1A\u559C\u6B22\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u63A5\u8FC7\u76D2\u5B50\u6253\u5F00\uFF0C\u91CC\u9762\u662F\u4E00\u4E2A\u5F88\u6734\u7D20\u7684\u5C0F\u98CE\u94C3\u3002\u770B\u5F97\u51FA\u6765\uFF0C\u8FD9\u7EDD\u5BF9\u4E0D\u662F\u4EC0\u4E48\u540D\u724C\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u4F60\u5077\u5077\u6298\u56DE\u53BB\u4E70\u7684\uFF1F\u201D"
    - pageNumber: 6
      speakerName: 
      text: "\u6C88\u9752\u79BE\u8033\u6735\u53C8\u7EA2\u4E86\uFF0C\u559D\u4E86\u4E00\u5927\u53E3\u9E21\u5C3E\u9152\uFF0C\u88AB\u545B\u5F97\u54B3\u55FD\u4E86\u4E24\u58F0\uFF0C\u9152\u6C14\u7A0D\u7A0D\u722C\u4E0A\u8138\u3002"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u2026\u2026\u987A\u8DEF\u800C\u5DF2\u3002\u6211\u4E0D\u64C5\u957F\u6311\u8FD9\u4E9B\u4E1C\u897F\uFF0C\u5982\u679C\u2026\u2026\u5982\u679C\u4F60\u89C9\u5F97\u4E0D\u597D\u770B\uFF0C\u4F60\u53EF\u4EE5\u81EA\u5DF1\u6311\u4E00\u4E2A\uFF0C\u6211\u6765\u4ED8\u94B1\u3002\u201D"
    - pageNumber: 8
      speakerName: 
      text: "\u6797\u6E21\u628A\u98CE\u94C3\u63D0\u8D77\u6765\uFF0C\u5728\u665A\u98CE\u4E2D\u6643\u4E86\u6643\uFF0C\u53D1\u51FA\u6E05\u4EAE\u7684\u58F0\u97F3"
    - pageNumber: 9
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u5F88\u559C\u6B22\uFF0C\u6C88\u9752\u79BE\u3002\u4F60\u5C45\u7136\u77E5\u9053\u6211\u4ECE\u5C0F\u5C31\u559C\u6B22\u98CE\u94C3\u3002\u201D"
    - pageNumber: 10
      speakerName: 
      text: "\u6C88\u9752\u79BE\u8F6C\u8FC7\u5934\uFF0C\u770B\u7740\u5728\u706F\u706B\u6620\u7167\u4E0B\u7B11\u5BB9\u707F\u70C2\u7684\u6797\u6E21\u3002\u8FD9\u4E00\u523B\uFF0C\u4ED6\u8111\u5B50\u91CC\u90A3\u4E9B\u590D\u6742\u7684\u903B\u8F91\u5168\u90FD\u6D88\u5931\u4E86\u3002\u4ED6\u53EA\u89C9\u5F97\uFF0C\u51B7\u51B7\u7684\u665A\u98CE\u5439\u5728\u8138\u4E0A\uFF0C\u7ADF\u7136\u80FD\u54C1\u51FA\u751C\u3002"
    choices: []
  - documentId: M2-4-1
