    - pageNumber: 2
      speakerName: "\u695A\u5929"
      text: "\u5468\u781A\uFF1F\u90A3\u4E2A\u641E\u884C\u653F\u7684\uFF1F\u4ED6\u8FDE\u4EE3\u7801\u90FD\u770B\u4E0D\u61C2\u5427\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u4E0D\u9700\u8981\u770B\u61C2\u4EE3\u7801\uFF0C\u4ED6\u53EA\u9700\u8981\u770B\u61C2\u8FD9\u5957\u7CFB\u7EDF\u7684\u5E94\u7528\u524D\u666F\u3002\u5468\u781A\u73B0\u5728\u6B63\u5904\u5728\u5B66\u751F\u4F1A\u6362\u5C4A\u7684\u5173\u952E\u671F\uFF0C\u4ED6\u6025\u9700\u4E00\u4E2A\u91CD\u91CF\u7EA7\u6BD4\u8D5B\u7684\u5956\u9879\u6765\u589E\u52A0\u7B79\u7801\u3002\u6211\u628A\u6838\u5FC3\u6210\u5458\u7684\u7F72\u540D\u6743\u5206\u7ED9\u4ED6\uFF0C\u4ED6\u7EDD\u5BF9\u613F\u610F\u8FDE\u591C\u80CC\u4E0B\u6211\u4EEC\u7684\u8DEF\u6F14\u7A3F\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u7528\u7CBE\u51C6\u7684\u5229\u76CA\u4EA4\u6362\u62C9\u6765\u4E86\u5468\u781A\u3002\u5468\u781A\u6781\u5177\u717D\u52A8\u6027\u548C\u73B0\u5B9E\u538B\u8FEB\u611F\u7684\u6F14\u8BB2\u98CE\u683C\uFF0C\u5B8C\u7F8E\u63A9\u76D6\u4E86\u4ED6\u5728\u6280\u672F\u5E95\u5C42\u7684\u751F\u758F\uFF0C\u7528\u6C14\u573A\u786C\u751F\u751F\u7838\u5F00\u4E86\u4E00\u6761\u664B\u7EA7\u4E4B\u8DEF\u3002"
    choices: []
