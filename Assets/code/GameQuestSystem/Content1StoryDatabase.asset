      text: M2-2-2b\u6C88
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u7406\u4F1A\u5E08\u5144\uFF0C\u800C\u662F\u76F4\u63A5\u6234\u4E0A\u8033\u673A\uFF0C\u628A\u5176\u4E2D\u4E00\u53EA\u585E\u8FDB\u6C88\u9752\u79BE\u7684\u8033\u6735\u91CC"
    - pageNumber: 2
      speakerName: 
      text: "\u60A0\u626C\u7684\u767D\u566A\u97F3\u77AC\u95F4\u9694\u7EDD\u4E86\u5916\u754C\u3002\u6797\u6E21\u5BF9\u6C88\u9752\u79BE\u505A\u4E86\u4E00\u4E2A\u201C\u7EE7\u7EED\u201D\u7684\u624B\u52BF\uFF0C\u7136\u540E\u8F6C\u5934\u5BF9\u5E08\u5144\u505A\u4E86\u4E2A\u7981\u58F0\u7684\u53E3\u578B\uFF0C\u773C\u795E\u91CC\u5199\u6EE1\u4E86\u62D2\u7EDD\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5E08\u5144\u5C34\u5C2C\u5730\u79BB\u5F00\u540E\uFF0C\u6C88\u9752\u79BE\u6458\u4E0B\u8033\u673A\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u542C\u4E0D\u5F97\u4ED6\u8FD9\u6837\u538B\u69A8\u4F60\u3002\u6C88\u9752\u79BE\uFF0C\u4F60\u53EA\u7BA1\u4FDD\u6301\u4F60\u7684\u7EAF\u7CB9\uFF0C\u90A3\u4E9B\u6742\u97F3\uFF0C\u6211\u53EF\u4EE5\u5E2E\u4F60\u8FC7\u6EE4\u6389\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u7ED3\u679C"
      text: "\u6C88\u9752\u79BE\u7B2C\u4E00\u6B21\u610F\u8BC6\u5230\uFF0C\u8FD9\u4E2A\u201C\u53D8\u91CF\u201D\u8FDB\u5165\u4ED6\u7684\u751F\u6D3B\u540E\uFF0C\u5E76\u6CA1\u6709\u5E26\u6765\u4ED6\u62C5\u5FC3\u7684\u6DF7\u4E71\uFF0C\u53CD\u800C\u7ED9\u4E86\u4ED6\u524D\u6240\u672A\u6709\u7684\u5B89\u5B81\u3002"
    choices: []
