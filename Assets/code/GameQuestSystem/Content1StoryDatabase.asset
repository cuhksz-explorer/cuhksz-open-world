  - documentId: M0-1-3
    title: M0-1-3
    sourceAssetPath: Assets/content1/M0/M0-1-3.docx
    chapterId: M0
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m0_1_3
    npcId: "npc_\u8FCE\u65B0\u5B66\u957F"
    locationId: m0_dorm_uppergarden
    targetSceneName: uppergarden
    fallbackTargetPosition: {x: 350.13, y: 44.51, z: -625.67}
    rewardGold: 25
    finishLocationName: "\u4E0A\u56ED\u5BBF\u820D\u533A"
    pages:
    - pageNumber: 1
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u5475\uFF0C\u633A\u6709\u7CBE\u795E\u3002\u53BB\u5BBF\u820D\u5427\uFF0C\u4E0A\u56ED\u7684\u8DEF\u53EF\u4E0D\u597D\u8D70\uFF0C\u8BB0\u5F97\u4FDD\u62A4\u597D\u4F60\u7684\u819D\u76D6\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u62D6\u7740\u884C\u674E\uFF0C\u8E0F\u4E0A\u4E86\u901A\u5F80\u4E0A\u56ED\u7684\u7535\u68AF\u3002\u968F\u7740\u9AD8\u5EA6\u722C\u5347\uFF0C\u6559\u5B66\u697C\u7684\u8F6E\u5ED3\u5728\u89C6\u91CE\u4E2D\u7F29\u5C0F\uFF0C\u800C\u8FDC\u5904\u7684\u5927\u6D77\u5374\u53D8\u5F97\u6E05\u6670\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5BBF\u820D\u697C\u4E0B\uFF0C\u4E00\u4F4D\u624E\u7740\u5229\u843D\u9A6C\u5C3E\u3001\u62FF\u7740\u8BB0\u4E8B\u672C\u7684\u963F\u59E8\u6B63\u5B88\u5728\u95F8\u673A\u53E3\u3002"
    - pageNumber: 4
      speakerName: "\u5BBF\u7BA1\u963F\u59E8"
      text: "\u7AD9\u4F4F\uFF0C\u5237\u5361\u3002\u65B0\u6765\u7684\uFF1F"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u963F\u59E8\u597D\uFF0C\u6211\u662F C\u5EA7402 \u7684\u6797\u6E21\u3002"
    - pageNumber: 6
      speakerName: "\u5BBF\u7BA1\u963F\u59E8"
      text: "\u540D\u5B57\u5BF9\u4E0A\u4E86\u3002\u8FD9\u662F\u5BDD\u5BA4\u94A5\u5319\u3002\u542C\u597D\u4E86\uFF0C\u5BBF\u820D\u91CC\u7981\u6B62\u4F7F\u7528\u5927\u529F\u7387\u7535\u5668\uFF0C\u665A\u4E0A\u5341\u4E8C\u70B9\u540E\u5173\u5927\u95E8\u3002\u8FD8\u6709\uFF0C\u4F60\u8981\u662F\u60F3\u5728\u8FD9\u91CC\u6DF7\u65E5\u5B50\uFF0C\u8D81\u65E9\u6362\u4E2A\u5730\u65B9\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u2026\u2026\u5728\u8FD9\u91CC\u6DF7\u65E5\u5B50\u5F88\u96BE\u5417\uFF1F"
    - pageNumber: 8
      speakerName: "\u5BBF\u7BA1\u963F\u59E8"
      text: "\u6BCF\u5929\u65E9\u4E0A\u516D\u70B9\uFF0C\u8FD9\u680B\u697C\u5C31\u4F1A\u6709\u4EBA\u8D77\u5E8A\u80CC\u5355\u8BCD\u3002\u51CC\u6668\u4E09\u70B9\uFF0C\u8D70\u5ECA\u91CC\u8FD8\u6709\u4EBA\u5728\u8BA8\u8BBA\u5C0F\u7EC4\u4F5C\u4E1A\u3002\u4F60\u89C9\u5F97\u5462\uFF1F"
    - pageNumber: 9
      speakerName: 
      text: "\u963F\u59E8\u4E0D\u518D\u7406\u4F1A\u4ED6\uFF0C\u4F4E\u5934\u7EE7\u7EED\u6838\u5BF9\u540D\u5355\u3002\u6797\u6E21\u8D70\u8FDB\u623F\u95F4\uFF0C\u72ED\u7A84\u4F46\u6574\u6D01\u7684\u7A7A\u95F4\u5C06\u662F\u5979\u672A\u6765\u56DB\u5E74\u7684\u636E\u70B9\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u5979\u5750\u5230\u4E66\u684C\u524D\uFF0C\u6309\u63D0\u793A\u638F\u51FA\u624B\u673A\uFF0C\u626B\u63CF\u4E86\u684C\u89D2\u7684\u4E8C\u7EF4\u7801\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u201C\u6B22\u8FCE\u4F7F\u7528\u6821\u56ED\u667A\u80FD\u7CFB\u7EDF\u3002\u8BF7\u7ED1\u5B9A\u60A8\u7684\u4E2A\u4EBA\u8EAB\u4EFD\uFF0C\u7CFB\u7EDF\u5C06\u4E3A\u60A8\u81EA\u52A8\u751F\u6210\u9996\u5468\u8BFE\u8868\u3002\u201D"
    - pageNumber: 12
      speakerName: 
      text: "\u968F\u7740\u5C4F\u5E55\u4E0A\u7684\u8FDB\u5EA6\u6761\u8DF3\u52A8\uFF0C\u6797\u6E21\u8F93\u5165\u4E86\u81EA\u5DF1\u7684\u80CC\u666F\u8D44\u6599\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u5979\u7684\u6BCF\u4E00\u4E2A\u9009\u62E9\u2014\u2014\u662F\u5BF9\u5B66\u672F\u7684\u6E34\u671B\uFF0C\u8FD8\u662F\u5BF9\u793E\u4EA4\u7684\u5411\u5F80\uFF0C\u4EA6\u6216\u662F\u5BF9\u672A\u6765\u7684\u8FF7\u832B\uFF0C\u90FD\u88AB\u8F6C\u5316\u6210\u4E86\u4E00\u4E32\u4E32\u4E8C\u8FDB\u5236\u4EE3\u7801\u3002"
    - pageNumber: 14
      speakerName: "\u3010\u7CFB\u7EDF\u63D0\u793A"
      text: "\u8BFE\u8868\u7ED1\u5B9A\u6210\u529F\u3002\u3011"
    - pageNumber: 15
      speakerName: 
      text: "\u6797\u6E21\u770B\u7740\u5C4F\u5E55\u4E0A\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u8272\u5757\uFF1A\u5FAE\u79EF\u5206\u3001\u7ECF\u6D4E\u5B66\u5BFC\u8BBA\u3001\u901A\u8BC6\u8BFE\u3001\u7814\u8BA8\u4F1A\u2026\u2026\u8FD9\u4E9B\u8272\u5757\u4EA4\u7EC7\u5728\u4E00\u8D77\uFF0C\u50CF\u662F\u4E00\u9053\u9053\u65E0\u5F62\u7684\u6805\u680F\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u7A97\u5916\uFF0C\u843D\u65E5\u7684\u4F59\u6656\u5C06\u6D77\u9762\u67D3\u6210\u4E86\u6DF1\u7D2B\u8272\u3002\u8FD9\u5C31\u662F\u201C\u672A\u540D\u4E4B\u6D77\u201D\uFF0C\u5B89\u9759\u5F97\u8BA9\u4EBA\u5FC3\u60CA\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u624B\u673A\u7A81\u7136\u9707\u52A8\u4E86\u4E00\u4E0B\uFF0C\u662F\u4E00\u6761\u6765\u81EA\u6821\u56ED\u8BBA\u575B\u7684\u63A8\u9001\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u201C\u65B0\u7684\u4E00\u5C4A\u5230\u6E2F\u4E86\u3002\u4F60\u4EEC\u542C\u8BF4\u4E86\u5417\uFF1F\u5173\u4E8E\u949F\u697C\u4E0B\u90A3\u4E2A\u2018\u7B2C\u96F6\u8BFE\u2019\u7684\u4F20\u95FB\u2026\u2026\u201D"
    - pageNumber: 19
      speakerName: 
      text: "\u6797\u6E21\u76B1\u4E86\u76B1\u7709\uFF0C\u6B63\u60F3\u70B9\u5F00\u8BE6\u60C5\uFF0C\u5C4F\u5E55\u5374\u7A81\u7136\u95EA\u70C1\u4E86\u4E00\u4E0B\uFF0C\u5F52\u4E8E\u6F06\u9ED1\u3002"
    - pageNumber: 20
      speakerName: 
      text: "\u90A3\u662F\u7CFB\u7EDF\u8FC7\u8F7D\uFF0C\u8FD8\u662F\u67D0\u79CD\u672A\u77E5\u7684\u5E72\u6270\uFF1F\u5979\u62AC\u8D77\u5934\uFF0C\u770B\u89C1\u7A97\u6237\u73BB\u7483\u6620\u51FA\u81EA\u5DF1\u7684\u8138\uFF0C\u90A3\u5F20\u5E74\u8F7B\u7684\u3001\u5199\u6EE1\u4E0D\u786E\u5B9A\u6027\u7684\u8138\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u62A5\u5230\u65E5\u7ED3\u675F\u4E86\u3002\u4F46\u5BF9\u6797\u6E21\u6765\u8BF4\uFF0C\u771F\u6B63\u7684\u6D77\u5578\u624D\u521A\u521A\u5F00\u59CB\u3002"
    choices: []
  - documentId: M0-2-1
    title: M0-2-1
    sourceAssetPath: Assets/content1/M0/M0-2-1.docx
    chapterId: M0
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m0_2_1
    npcId: "npc_\u6C88\u9752\u79BE"
    locationId: m0_library_reading
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1014.69, y: 14.22, z: 979.67}
    rewardGold: 25
    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u516B\u6708\u7684\u6DF1\u5733\uFF0C\u7A7A\u6C14\u4E2D\u4EFF\u4F5B\u84B8\u817E\u7740\u4E00\u5C42\u7A00\u8584\u7684\u51B7\u6C14\uFF0C\u5374\u53C8\u5728\u9633\u5149\u4E0B\u8FC5\u901F\u5316\u4E3A\u6E7F\u70ED\u7684\u6F6E\u6C14\u3002\u6797\u6E21\u7AD9\u5728\u540D\u4E3A\u201C\u9F99\u7FD4\u5927\u9053\u201D\u7684\u957F\u5ECA\u4E2D\u592E\uFF0C\u53F3\u624B\u7D27\u7D27\u6293\u7740\u624B\u673A\uFF0C\u6307\u5C16\u56E0\u4E3A\u7528\u529B\u800C\u5FAE\u5FAE\u6CDB\u767D\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u624B\u673A\u5C4F\u5E55\u4E0A\u7684\u5BFC\u822A\u8F6F\u4EF6\u6B63\u5728\u75AF\u72C2\u201C\u8E66\u8FEA\u201D\uFF0C\u4EE3\u8868\u5979\u4F4D\u7F6E\u7684\u84DD\u8272\u5706\u70B9\u5728\u51E0\u680B\u7D27\u6328\u7740\u7684\u7070\u767D\u8272\u5927\u697C\u4E4B\u95F4\u8DF3\u8DC3\uFF0C\u4EFF\u4F5B\u5728\u5632\u7B11\u5979\u8FD9\u4E2A\u521A\u5165\u6821\u7684\u65B0\u4EBA\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u660E\u660E\u663E\u793A\u5DF2\u7ECF\u5230\u4E86\uFF0C\u53EF\u6211\u9762\u524D\u4E3A\u4EC0\u4E48\u53EA\u6709\u4E00\u5835\u5899\u2026\u2026\u884C\u653F\u697C\u5230\u5E95\u662F\u5728\u8FD9\u4E00\u5C42\uFF0C\u8FD8\u662F\u5728\u90A3\u6761\u8BE5\u6B7B\u7684\u659C\u5761\u4E0B\u9762\uFF1F"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u6709\u4E9B\u70E6\u8E81\u5730\u64A9\u8D77\u6C57\u6E7F\u7684\u5218\u6D77\u3002\u6E2F\u4E2D\u6DF1\u7684\u6821\u56ED\u4F9D\u5C71\u800C\u5EFA\uFF0C\u8FD9\u79CD\u53F0\u5730\u5F0F\u7684\u5EFA\u7B51\u7ED3\u6784\u5BF9\u65B0\u624B\u6781\u4E0D\u53CB\u597D\u2014\u2014\u4F60\u4EE5\u4E3A\u81EA\u5DF1\u7AD9\u5728\u4E00\u697C\uFF0C\u5176\u5B9E\u4F60\u662F\u5728\u522B\u4EBA\u7684\u4E94\u697C\uFF1B\u4F60\u4EE5\u4E3A\u884C\u653F\u697C\u8FD1\u5728\u54AB\u5C3A\uFF0C\u5176\u5B9E\u5B83\u548C\u4F60\u4E4B\u95F4\u9694\u7740\u4E00\u4E2A\u9700\u8981\u5237\u5361\u624D\u80FD\u901A\u8FC7\u7684\u5B66\u9662\u5185\u90E8\u8FDE\u5ECA\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u6B64\u65F6\u6B63\u662F\u4E0B\u8BFE\u65F6\u95F4\uFF0C\u5468\u56F4\u7684\u5B66\u751F\u6B65\u5C65\u98DE\u5FEB\uFF0C\u4ED6\u4EEC\u5927\u591A\u6234\u7740\u964D\u566A\u8033\u673A\uFF0C\u773C\u795E\u9501\u5B9A\u5728\u659C\u524D\u65B9\u7684\u67D0\u4E2A\u865A\u7A7A\u70B9\uFF0C\u4EFF\u4F5B\u6BCF\u4E2A\u4EBA\u90FD\u5728\u8D76\u5F80\u4E00\u573A\u5173\u4E4E\u751F\u6B7B\u7684\u5B66\u672F\u4F1A\u8BAE\u3002\u6797\u6E21\u89C9\u5F97\uFF0C\u81EA\u5DF1\u50CF\u662F\u8FD9\u4E2A\u7CBE\u5BC6\u8FD0\u4F5C\u7684\u9F7F\u8F6E\u7EC4\u91CC\uFF0C\u552F\u4E00\u4E00\u4E2A\u5361\u4F4F\u7684\u96F6\u4EF6\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5728\u8F6C\u8FC7\u7B2C\u4E09\u4E2A\u9519\u8BEF\u7684\u62D0\u89D2\u540E\uFF0C\u6797\u6E21\u505C\u5728\u4E86\u56FE\u4E66\u9986\u65C1\u7684\u516C\u5171\u9605\u8BFB\u533A\u3002\u8FD9\u91CC\u5206\u6563\u5750\u7740\u51E0\u4E2A\u6B63\u5728\u4F11\u606F\u6216\u5DE5\u4F5C\u7684\u5B66\u751F\uFF0C\u4E09\u80A1\u622A\u7136\u4E0D\u540C\u7684\u6C14\u573A\u5F15\u8D77\u4E86\u5979\u7684\u6CE8\u610F\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u90A3\u4E2A\u2026\u2026\u540C\u5B66\uFF0C\u6253\u6270\u4E00\u4E0B\u3002\u8BF7\u95EE\u884C\u653F\u697C\u7684\u6863\u6848\u5BA4\u662F\u987A\u7740\u8FD9\u6761\u8DEF\u8D70\u5417\uFF1F"
    - pageNumber: 8
      speakerName: 
      text: "\u7537\u751F\u6CA1\u6709\u7ACB\u523B\u62AC\u5934\uFF0C\u800C\u662F\u5148\u5728\u5C4F\u5E55\u4E0A\u753B\u5B8C\u4E86\u4E00\u4E2A\u91CD\u70B9\uFF0C\u624D\u5E73\u7A33\u5730\u8F6C\u8FC7\u89C6\u7EBF\u3002\u6C88\u9752\u79BE\u7684\u773C\u795E\u5F88\u6E05\u6F88\uFF0C\u5374\u5E26\u7740\u4E00\u79CD\u62D2\u7EDD\u8FC7\u5EA6\u793E\u4EA4\u7684\u514B\u5236\u3002"
    - pageNumber: 9
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u4F60\u8D70\u53CD\u4E86\u3002\u884C\u653F\u697C\u5728\u90A3\u4E2A\u65B9\u5411\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u4ED6\u7528\u7535\u5BB9\u7B14\u6307\u5411\u7A97\u5916\u7684\u4E00\u5EA7\u8FDE\u5ECA\u3002"
    - pageNumber: 11
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5BFC\u822A\u5728\u8FD9\u91CC\u4F1A\u6709 20 \u7C73\u5DE6\u53F3\u7684\u5782\u76F4\u504F\u5DEE\u3002\u56E0\u4E3A\u8FD9\u91CC\u662F\u4E09\u5C42\u5E73\u53F0\uFF0C\u800C\u884C\u653F\u697C\u7684\u5165\u53E3\u5728\u4E8C\u5C42\u3002\u5982\u679C\u4F60\u987A\u7740\u8FD9\u6761\u8DEF\u8D70\uFF0C\u4F60\u4F1A\u649E\u4E0A\u77E5\u65B0\u697C\u7684\u5B9E\u9A8C\u5BA4\u540E\u95E8\u3002"
    - pageNumber: 12
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u8DEF\u7EBF\u53EF\u4EE5\u7B97\u51FA\u6765\uFF0C\u4EBA\u751F\u4E0D\u884C\u3002\u4F46\u81F3\u5C11\uFF0C\u522B\u5728\u7B2C\u4E00\u5929\u5C31\u8F93\u7ED9\u5BFC\u822A\u7CFB\u7EDF\u7684\u504F\u5DEE\u503C\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u6797\u6E21\u6B63\u6123\u795E\u4E8E\u5BF9\u65B9\u7684\u4E25\u8C28\uFF0C\u53F3\u4FA7\u7A81\u7136\u4F20\u6765\u4E00\u9635\u8F7B\u5FEB\u7684\u811A\u6B65\u58F0\u3002\u90A3\u662F\u4E00\u4E2A\u7A7F\u7740\u4FEE\u8EAB\u897F\u88C5\u9A6C\u7532\u3001\u957F\u53D1\u5E72\u7EC3\u5730\u675F\u5728\u8111\u540E\u7684\u5973\u751F\u3002\u5979\u6B63\u628A\u51E0\u4EFD\u793E\u56E2\u62DB\u65B0\u7684\u5BA3\u4F20\u518C\u53E0\u5F97\u6574\u6574\u9F50\u9F50\uFF0C\u8F6C\u5934\u770B\u5411\u6797\u6E21\u65F6\uFF0C\u8138\u4E0A\u77AC\u95F4\u6D6E\u73B0\u51FA\u4E00\u79CD\u6070\u5230\u597D\u5904\u7684\u6E29\u6696\u7B11\u5BB9\u3002"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u9752\u79BE\uFF0C\u522B\u603B\u7528\u4F60\u7684\u201C\u504F\u5DEE\u503C\u7406\u8BBA\u201D\u5413\u552C\u65B0\u540C\u5B66\u3002\u4F60\u770B\u8FD9\u4F4D\u5B66\u59B9\uFF0C\u5DF2\u7ECF\u5FEB\u88AB\u8FD9\u51E0\u680B\u697C\u7ED5\u6655\u4E86\u3002"
    - pageNumber: 15
      speakerName: 
      text: "\u5973\u751F\u8D70\u8FC7\u6765\uFF0C\u975E\u5E38\u81EA\u7136\u5730\u4ECE\u515C\u91CC\u638F\u51FA\u4E00\u5F20\u5E26\u6709\u6821\u56ED\u5FAE\u7F29\u5730\u56FE\u7684\u7CBE\u7F8E\u4E66\u7B7E\uFF0C\u9012\u5230\u4E86\u6797\u6E21\u624B\u91CC\u3002"
    - pageNumber: 16
      speakerName: "\u5468\u781A"
      text: "\u4F60\u597D\uFF0C\u6211\u662F\u5468\u781A\u3002\u884C\u653F\u697C\u73B0\u5728\u786E\u5B9E\u4E0D\u597D\u8D70\uFF0C\u90A3\u8FB9\u6B63\u5728\u7B79\u5907\u660E\u5929\u7684\u6821\u5E86\u6D3B\u52A8\uFF0C\u597D\u51E0\u4E2A\u8DEF\u53E3\u90FD\u88AB\u4E34\u65F6\u5C01\u4E86\u3002\u54EA\u6015\u4F60\u6709\u6700\u51C6\u7684\u5BFC\u822A\uFF0C\u4E5F\u7ED5\u4E0D\u8FC7\u90A3\u5806\u65BD\u5DE5\u56F4\u680F\u3002"
    - pageNumber: 17
      speakerName: "\u5468\u781A"
      text: "\u4E0D\u8FC7\uFF0C\u6211\u521A\u597D\u8981\u53BB\u884C\u653F\u697C\u627E\u90A3\u91CC\u7684\u8001\u5E08\u7B7E\u4E00\u4EFD\u793E\u56E2\u9884\u7B97\u3002\u6797\u6E21\uFF0C\u8FD9\u5C31\u662F\u6211\u8981\u6559\u4F60\u7684\u7B2C\u4E00\u4EF6\u4E8B\u2014\u2014\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u6700\u5FEB\u7684\u6377\u5F84\u6C38\u8FDC\u4E0D\u5728\u5C4F\u5E55\u91CC\uFF0C\u800C\u662F\u5728\u4EBA\u8109\u91CC\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u6797\u6E21\u63E1\u7740\u90A3\u679A\u4E66\u7B7E\uFF0C\u8FD8\u6CA1\u6765\u5F97\u53CA\u5F00\u53E3\uFF0C\u4E00\u9635\u5FEB\u95E8\u58F0\u4ECE\u4E0D\u8FDC\u5904\u7684\u7EFF\u690D\u540E\u4F20\u6765\u3002\u4E00\u4E2A\u7559\u7740\u5FAE\u5377\u77ED\u53D1\u7684\u7537\u751F\u6B63\u8DE8\u5750\u5728\u957F\u51F3\u80CC\u4E0A\uFF0C\u4E13\u6CE8\u5730\u8C03\u6574\u7740\u5355\u53CD\u76F8\u673A\u7684\u7126\u8DDD\uFF0C\u955C\u5934\u5BF9\u7740\u4E00\u53EA\u6B63\u5728\u884C\u653F\u697C\u8FDE\u5ECA\u6276\u624B\u4E0A\u6652\u592A\u9633\u7684\u6A58\u732B\u3002"
    - pageNumber: 19
      speakerName: "\u987E\u6F84"
      text: "\u4F60\u4EEC\u4E24\u4E2A\uFF0C\u4E00\u4E2A\u60F3\u628A\u5B66\u59B9\u53D8\u6210\u8BA1\u7B97\u5668\uFF0C\u4E00\u4E2A\u60F3\u628A\u5B66\u59B9\u53D8\u6210\u901A\u8BAF\u5F55\u3002\u80FD\u4E0D\u80FD\u8BA9\u5979\u5148\u770B\u4E00\u773C\u4ECA\u5929\u7684\u706B\u70E7\u4E91\uFF1F"
    - pageNumber: 20
      speakerName: 
      text: "\u987E\u6F84\u653E\u4E0B\u76F8\u673A\uFF0C\u5BF9\u7740\u6797\u6E21\u7728\u4E86\u7728\u773C\uFF0C\u90A3\u53CC\u773C\u775B\u91CC\u900F\u7740\u4E00\u79CD\u672A\u7ECF\u4FEE\u9970\u7684\u5C11\u5E74\u6C14\u3002"
    - pageNumber: 21
      speakerName: "\u987E\u6F84"
      text: "\u884C\u653F\u697C\u5C31\u5728\u90A3\u513F\uFF0C\u8DD1\u4E0D\u6389\u7684\u3002\u4F46\u5982\u679C\u4F60\u73B0\u5728\u6025\u7740\u8D76\u8FC7\u53BB\uFF0C\u4F60\u4F1A\u9519\u8FC7\u8FD9\u6240\u5B66\u6821\u6700\u6D6A\u6F2B\u7684\u4E00\u5206\u949F\u2014\u2014\u5915\u9633\u6B63\u597D\u7A7F\u8FC7\u8FDE\u5ECA\u7F1D\u9699\u7684\u90A3\u4E00\u523B\u3002"
    - pageNumber: 22
      speakerName: "\u987E\u6F84"
      text: "\u6797\u6E21\uFF0C\u5982\u679C\u5927\u5BB6\u90FD\u5728\u8D76\u8DEF\uFF0C\u8C01\u6765\u62AC\u5934\u770B\u5929\uFF1F"
    - pageNumber: 23
      speakerName: 
      text: "\u4E09\u4E2A\u4EBA\uFF0C\u4E09\u79CD\u622A\u7136\u4E0D\u540C\u7684\u6001\u5EA6\u3002\u6C88\u9752\u79BE\u4EE3\u8868\u7740\u6781\u81F4\u7684\u903B\u8F91\u4E0E\u6548\u7387\uFF0C\u5468\u781A\u4EE3\u8868\u7740\u590D\u6742\u7684\u4EBA\u8109\u4E0E\u535A\u5F08\uFF0C\u800C\u987E\u6F84\u5219\u4EE3\u8868\u7740\u90A3\u79CD\u5728\u7D27\u8FEB\u8282\u594F\u4E2D\u5076\u5C14\u6F0F\u6389\u7684\u547C\u5438\u611F\u3002"
    - pageNumber: 24
      speakerName: 
      text: "\u6797\u6E21\u7AD9\u5728\u4ED6\u4EEC\u4E2D\u95F4\uFF0C\u624B\u4E2D\u7684\u624B\u673A\u5C4F\u5E55\u56E0\u4E3A\u7535\u91CF\u4E0D\u8DB3\u800C\u5FAE\u5FAE\u53D1\u6697\u3002\u5979\u610F\u8BC6\u5230\uFF0C\u8FD9\u4E0D\u4EC5\u4EC5\u662F\u5E26\u8DEF\u7684\u95EE\u9898\u3002\u5728\u6B65\u5165\u8FD9\u7247\u201C\u672A\u540D\u4E4B\u6D77\u201D\u7684\u7B2C\u4E00\u5929\uFF0C\u5979\u5FC5\u987B\u51B3\u5B9A\uFF0C\u81EA\u5DF1\u8981\u4EE5\u4EC0\u4E48\u6837\u7684\u59FF\u6001\u6E38\u4E0B\u53BB\u3002"
    choices:
    - label: "\u8FFD\u6C42\u903B\u8F91\u6548\u7387"
      targetDocumentId: M0-2-2-A
    - label: "\u5BFB\u627E\u4EBA\u8109\u6377\u5F84"
      targetDocumentId: M0-2-2-B
    - label: "\u62AC\u5934\u53D1\u73B0\u98CE\u666F"
      targetDocumentId: M0-2-2-C
  - documentId: M0-2-2-A
    title: M0-2-2-A
    sourceAssetPath: Assets/content1/M0/M0-2-2-A.docx
    chapterId: M0
    category: 0
    isRootTask: 0
    isBranchDocument: 1
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m0_2_2_a
    npcId: "npc_\u6C88\u9752\u79BE"
    locationId: seminar_room_placeholder
    targetSceneName: learning room
    fallbackTargetPosition: {x: 24.908428, y: 0.656, z: -37.074}
    rewardGold: 25
    finishLocationName: "TXC\u884C\u653F\u697C/\u7814\u8BA8\u5BA4"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\u2026\u2026\u6211\u8FD8\u662F\u60F3\u9760\u81EA\u5DF1\u8D70\u8FC7\u53BB\u3002\u80FD\u4E0D\u80FD\u9EBB\u70E6\u4F60\uFF0C\u628A\u90A3\u4E2A\u201C\u5782\u76F4\u504F\u5DEE\u201D\u7684\u907F\u5F00\u8DEF\u5F84\u518D\u8BE6\u7EC6\u544A\u8BC9\u6211\u4E00\u4E0B\uFF1F"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u539F\u672C\u5DF2\u7ECF\u6253\u7B97\u91CD\u65B0\u6295\u5165\u5230\u8BBA\u6587\u4E2D\uFF0C\u542C\u5230\u8FD9\u53E5\u8BDD\uFF0C\u4ED6\u7684\u624B\u6307\u5728\u5C4F\u5E55\u4E0A\u5FAE\u5FAE\u505C\u987F\u3002\u4ED6\u62AC\u8D77\u5934\uFF0C\u91CD\u65B0\u5BA1\u89C6\u4E86\u4E00\u4E0B\u8FD9\u4E2A\u770B\u8D77\u6765\u6709\u4E9B\u72FC\u72C8\u3001\u4F46\u773C\u795E\u5014\u5F3A\u7684\u5B66\u59B9\u3002"
    - pageNumber: 3
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u65E2\u7136\u4F60\u9009\u62E9\u4E86\u6700\u8003\u9A8C\u903B\u8F91\u7684\u65B9\u5F0F\u3002\u90A3\u6211\u4E0D\u4ECB\u610F\u6F14\u793A\u4E00\u904D\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6C88\u9752\u79BE\u5229\u843D\u5730\u5408\u4E0A\u5E73\u677F\uFF0C\u8D77\u8EAB\u3002\u4ED6\u7684\u52A8\u4F5C\u6CA1\u6709\u4E00\u4E1D\u591A\u4F59\uFF0C\u8FDE\u53CC\u80A9\u5305\u7684\u80A9\u5E26\u90FD\u88AB\u8C03\u6574\u5230\u4E86\u53D7\u529B\u6700\u5747\u5300\u7684\u9AD8\u5EA6\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u6797\u6E21\u7D27\u7D27\u8DDF\u5728\u6C88\u9752\u79BE\u8EAB\u540E\u3002\u6C88\u9752\u79BE\u5E76\u6CA1\u6709\u8D70\u90A3\u4E9B\u5BBD\u9614\u7684\u5927\u9053\uFF0C\u800C\u662F\u5E26\u7740\u5979\u7A7F\u8FC7\u4E86\u4E00\u95F4\u7A7A\u65F7\u7684\u7814\u8BA8\u5BA4\u4FA7\u95E8\uFF0C\u8FDB\u5165\u4E86\u4E00\u90E8\u5E73\u65F6\u5F88\u5C11\u6709\u4EBA\u6CE8\u610F\u5230\u7684\u8F7D\u8D27\u7535\u68AF\u3002"
    - pageNumber: 6
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u8FD9\u91CC\u76F4\u8FBE\u4E8C\u5C42\u5E73\u53F0\uFF0C\u907F\u5F00\u4EBA\u6D41\u9AD8\u5CF0\u3002\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u516C\u5171\u8DEF\u5F84\u5F80\u5F80\u662F\u6700\u8017\u65F6\u7684\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\uFF0C\u4F60\u5E73\u65F6\u5BF9\u6240\u6709\u4E8B\u60C5\u90FD\u8FD9\u4E48\u2026\u2026\u4E25\u8C28\u5417\uFF1F\u6211\u770B\u5230\u4F60\u521A\u624D\u5728\u770B\u5168\u82F1\u6587\u7684\u8BBA\u6587\uFF0C\u662F\u5927\u51E0\u7684\u8BFE\u7A0B\uFF1F"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5927\u4E8C\u7684\u79D1\u7814\u52A9\u7406\u9879\u76EE\u800C\u5DF2\u3002\u8FD9\u4E0D\u662F\u4E25\u8C28\uFF0C\u8FD9\u662F\u751F\u5B58\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u6C88\u9752\u79BE\u8D70\u51FA\u7535\u68AF\uFF0C\u6B65\u4F10\u5E73\u7A33\u5F97\u50CF\u662F\u5728\u6B65\u8FDB\u7535\u673A\u9A71\u52A8\u3002\u6797\u6E21\u770B\u7740\u4ED6\u7684\u80CC\u5F71\uFF0C\u611F\u5230\u4E00\u79CD\u8FD1\u4E4E\u538B\u8FEB\u7684\u79E9\u5E8F\u611F\u3002"
    - pageNumber: 10
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u4F60\u8981\u660E\u767D\uFF0C\u8FD9\u6240\u5B66\u6821\u672C\u8D28\u4E0A\u662F\u4E00\u4E2A\u8D44\u6E90\u5206\u914D\u7CFB\u7EDF\u3002\u7EE9\u70B9\u3001\u79D1\u7814\u540D\u989D\u3001\u63A8\u8350\u4FE1\uFF0C\u90FD\u662F\u6709\u9650\u7684\u3002\u5982\u679C\u4F60\u4E0D\u80FD\u50CF\u7BA1\u7406\u4F60\u7684\u8DEF\u5F84\u4E00\u6837\u7BA1\u7406\u4F60\u7684\u65F6\u95F4\uFF0C\u4F60\u5F88\u5FEB\u5C31\u4F1A\u53D1\u73B0\uFF0C\u4F60\u7684\u5750\u6807\u8F74\u4E0A\u53EA\u5269\u4E0B\u4E00\u7247\u6DF7\u4E71\u3002"
    - pageNumber: 11
      speakerName: "\u6797\u6E21"
      text: "\u6DF7\u4E71\u2026\u2026\u662F\u6307\u90A3\u4E9B\u6CA1\u6CD5\u88AB\u8BA1\u7B97\u51FA\u6765\u7684\u4E1C\u897F\u5417\uFF1F"
    - pageNumber: 12
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6BD4\u5982\u60C5\u7EEA\uFF0C\u6BD4\u5982\u591A\u4F59\u7684\u793E\u4EA4\uFF0C\u6BD4\u5982\u5BF9\u672A\u6765\u7684\u65E0\u6548\u5E7B\u60F3\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u5979\u4EEC\u5230\u8FBE\u884C\u653F\u697C\u529E\u4E8B\u5927\u5385\u65F6\uFF0C\u65F6\u95F4\u4E0D\u591A\u4E0D\u5C11\uFF0C\u6B63\u597D\u8FC7\u53BB\u4E86\u4E09\u5206\u949F\u3002\u6C88\u9752\u79BE\u6CA1\u6709\u966A\u6797\u6E21\u53BB\u6392\u957F\u961F\uFF0C\u800C\u662F\u5E26\u5979\u8D70\u5230\u4E00\u4E2A\u4E0D\u592A\u8D77\u773C\u7684\u81EA\u52A9\u4E00\u4F53\u673A\u524D\u3002"
    - pageNumber: 14
      speakerName: 
      text: "\u6797\u6E21\u6309\u7167\u4ED6\u7684\u6307\u793A\u64CD\u4F5C\uFF0C\u679C\u7136\uFF0C\u4E0D\u5230\u4E94\u5206\u949F\uFF0C\u5979\u5C31\u62FF\u5230\u4E86\u539F\u672C\u53EF\u80FD\u9700\u8981\u6392\u961F\u4E00\u5C0F\u65F6\u7684\u6863\u6848\u3002\u5F53\u5979\u8D70\u51FA\u7A97\u53E3\u65F6\uFF0C\u6C88\u9752\u79BE\u8FD8\u7B49\u5728\u4E0D\u8FDC\u5904\u7684\u7ACB\u67F1\u65C1\uFF0C\u624B\u91CC\u7FFB\u770B\u7740\u624B\u673A\u4E0A\u7684\u65E5\u7A0B\u8868\u3002"
    - pageNumber: 15
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u529E\u597D\u4E86\uFF1F\u90A3\u5C31\u53BB\u5403\u996D\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u5B66\u751F\u4E2D\u5FC3\u98DF\u5802\u4E8C\u5C42\u3002\u8FD9\u91CC\u662F\u8457\u540D\u7684\u201C\u5B66\u9738\u533A\u201D\uFF0C\u6C88\u9752\u79BE\u9009\u4E86\u4E00\u4E2A\u6781\u5176\u5B89\u9759\u7684\u89D2\u843D\u4F4D\u5B50\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u9910\u76D8\u91CC\u7684\u98DF\u7269\u88AB\u4ED6\u7EC6\u81F4\u5730\u5206\u6210\u4E86\u86CB\u767D\u8D28\u3001\u78B3\u6C34\u548C\u7EF4\u751F\u7D20\u4E09\u4E2A\u533A\u57DF\uFF0C\u6BCF\u4E00\u53E3\u4F3C\u4E4E\u90FD\u5480\u56BC\u5F97\u6B21\u6570\u76F8\u7B49\u3002\u6797\u6E21\u770B\u7740\u4ED6\uFF0C\u89C9\u5F97\u4ED6\u6574\u4E2A\u4EBA\u5C31\u50CF\u4E00\u53F0\u7CBE\u5BC6\u8FD0\u8F6C\u7684\u8BA1\u7B97\u673A\u3002"
    - pageNumber: 18
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\uFF0C\u521A\u624D\u90A3\u4E2A\u5468\u781A\u5B66\u59D0\u8BF4\uFF0C\u8BA4\u8BC6\u4EBA\u6BD4\u8BA4\u8BC6\u8DEF\u91CD\u8981\uFF0C\u4F60\u89C9\u5F97\u5462\uFF1F"
    - pageNumber: 19
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5468\u781A\u90A3\u79CD\u65B9\u5F0F\uFF0C\u662F\u5728\u628A\u8D4C\u6CE8\u62BC\u5728\u53D8\u91CF\u4E0A\u3002\u4EBA\u7684\u60C5\u7EEA\u3001\u5229\u76CA\u3001\u7ACB\u573A\u90FD\u662F\u4E0D\u7A33\u5B9A\u7684\u53D8\u91CF\u3002\u800C\u6211\uFF0C\u53EA\u76F8\u4FE1\u5B9A\u91CF\u3002"
    - pageNumber: 20
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6797\u6E21\uFF0C\u5728\u8FD9\u91CC\uFF0C\u4F60\u4F1A\u9047\u5230\u5F88\u591A\u8BD5\u56FE\u62C9\u4F60\u5165\u4F19\u7684\u4EBA\u3002\u4F46\u4F60\u6700\u7EC8\u8981\u4F9D\u9760\u7684\uFF0C\u662F\u4F60\u5728\u6DF1\u591C\u91CC\u72EC\u81EA\u89E3\u5F00\u7684\u90A3\u9053\u9898\uFF0C\u548C\u4F60\u90A3\u5F20\u6CA1\u6709\u6C34\u5206\u7684\u6210\u7EE9\u5355\u3002"
    - pageNumber: 21
      speakerName: "\u6797\u6E21"
      text: "\u6211\u660E\u767D\u4E86\u2026\u2026\u867D\u7136\u611F\u89C9\u538B\u529B\u6709\u70B9\u5927\u3002"
    - pageNumber: 22
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u538B\u529B\u662F\u7CFB\u7EDF\u7684\u53CD\u9988\u3002\u65E2\u7136\u9009\u62E9\u4E86\u8FD9\u91CC\uFF0C\u5C31\u4E0D\u8981\u671F\u5F85\u8212\u9002\u533A\u3002"
    - pageNumber: 23
      speakerName: 
      text: "\u6C88\u9752\u79BE\u559D\u5B8C\u6700\u540E\u4E00\u53E3\u51B0\u7F8E\u5F0F\uFF0C\u52A8\u4F5C\u5229\u843D\u5730\u7AD9\u8D77\u8EAB\u3002"
    - pageNumber: 24
      speakerName: 
      text: "\u4ED6\u7559\u4E0B\u4E00\u4E2A\u7B80\u6D01\u7684\u80CC\u5F71\uFF0C\u6D88\u5931\u5728\u901A\u5411\u6559\u5B66\u533A\u7684\u65CB\u8F6C\u95E8\u540E\u3002\u6797\u6E21\u5750\u5728\u4F4D\u5B50\u4E0A\uFF0C\u4F4E\u5934\u770B\u7740\u81EA\u5DF1\u88AB\u6C88\u9752\u79BE\u201C\u6559\u5BFC\u201D\u5F97\u6574\u6574\u9F50\u9F50\u7684\u9910\u76D8\uFF0C\u7A81\u7136\u89C9\u5F97\uFF0C\u5728\u8FD9\u4E2A\u5145\u6EE1\u4E0D\u786E\u5B9A\u7684\u6821\u56ED\u91CC\uFF0C\u8FD9\u79CD\u51B7\u51B0\u51B0\u7684\u79E9\u5E8F\u611F\uFF0C\u7ADF\u7136\u5E26\u7ED9\u4E86\u5979\u4E00\u79CD\u524D\u6240\u672A\u6709\u7684\u8E0F\u5B9E\u3002"
    choices: []
  - documentId: M0-2-2-B
    title: M0-2-2-B
    sourceAssetPath: Assets/content1/M0/M0-2-2-B.docx
    chapterId: M0
    category: 0
    isRootTask: 0
    isBranchDocument: 1
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m0_2_2_b
    npcId: "npc_\u5468\u781A"
    locationId: admin_placeholder
    targetSceneName: undergarden
    fallbackTargetPosition: {x: 1310.01, y: 16.19, z: 987.22}
    rewardGold: 25
    finishLocationName: "\u884C\u653F\u697C"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u770B\u7740\u5468\u781A\u9012\u8FC7\u6765\u7684\u90A3\u679A\u5E26\u6709\u5FAE\u7F29\u5730\u56FE\u7684\u7CBE\u7F8E\u4E66\u7B7E\uFF0C\u53C8\u770B\u4E86\u770B\u624B\u673A\u5C4F\u5E55\u4E0A\u90A3\u4E2A\u4F9D\u7136\u5728\u4E71\u8DF3\u7684\u84DD\u8272\u5706\u70B9\u3002\u5468\u781A\u7684\u7B11\u5BB9\u91CC\u6709\u4E00\u79CD\u8BA9\u4EBA\u65E0\u6CD5\u62D2\u7EDD\u7684\u786E\u5B9A\u611F\uFF0C\u90A3\u662F\u957F\u671F\u638C\u63A7\u67D0\u79CD\u79E9\u5E8F\u7684\u4EBA\u624D\u4F1A\u6709\u7684\u795E\u6001\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u5468\u5B66\u59D0\u2026\u2026\u90A3\u5C31\u9EBB\u70E6\u4F60\u4E86\u3002\u65E2\u7136\u5BFC\u822A\u4E0D\u7BA1\u7528\uFF0C\u6211\u8FD8\u662F\u76F8\u4FE1\u201C\u5730\u5934\u86C7\u201D\u6BD4\u8F83\u597D\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u660E\u667A\u7684\u51B3\u5B9A\u3002\u987A\u4FBF\u8BF4\u4E00\u53E5\uFF0C\u8FD9\u4E2A\u8BCD\u5728\u6E2F\u4E2D\u6DF1\u53EB\u201C\u793E\u4EA4\u8FBE\u4EBA\u201D\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5468\u781A\u975E\u5E38\u81EA\u7136\u5730\u63A5\u8FC7\u4E86\u6797\u6E21\u624B\u91CC\u6C89\u91CD\u7684\u5E06\u5E03\u5305\uFF0C\u867D\u7136\u6797\u6E21\u8BD5\u56FE\u63A8\u8F9E\uFF0C\u4F46\u5979\u53EA\u662F\u8F7B\u5DE7\u5730\u4E00\u4FA7\u8EAB\uFF0C\u7528\u4E00\u79CD\u98D2\u723D\u4F46\u53C8\u4E0D\u5BB9\u7F6E\u7591\u7684\u529B\u9053\u63A5\u4E86\u8FC7\u53BB\u3002"
    - pageNumber: 5
      speakerName: "\u5468\u781A"
      text: "\u5973\u5B69\u5B50\u5728\u5F00\u5B66\u7B2C\u4E00\u5929\u4E0D\u8BE5\u628A\u81EA\u5DF1\u5F04\u5F97\u6EE1\u5934\u5927\u6C57\u3002\u8DDF\u6211\u6765\uFF0C\u6211\u4EEC\u8981\u8D70\u7684\u8DEF\u867D\u7136\u7A0D\u5FAE\u7ED5\u4E00\u70B9\uFF0C\u4F46\u5168\u7A0B\u90FD\u6709\u7A7A\u8C03\uFF0C\u800C\u4E14\u98CE\u666F\u4E0D\u9519\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u5E26\u7740\u6797\u6E21\u8D70\u8FDB\u4E86\u4E00\u90E8\u884C\u653F\u697C\u4FA7\u9762\u7684\u89C2\u5149\u7535\u68AF\u3002\u968F\u7740\u9AD8\u5EA6\u722C\u5347\uFF0C\u4E0B\u56ED\u7684\u666F\u81F4\u4E00\u89C8\u65E0\u4F59\u3002"
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u770B\u5230\u4E0B\u9762\u90A3\u4E9B\u5728\u9F99\u7FD4\u5927\u9053\u4E0A\u9876\u7740\u70C8\u65E5\u6392\u961F\u7684\u540C\u5B66\u4E86\u5417\uFF1F\u6C88\u9752\u79BE\u4F1A\u544A\u8BC9\u4ED6\u4EEC\uFF0C\u90A3\u662F\u901A\u5F80\u6210\u529F\u7684\u5FC5\u7ECF\u4E4B\u8DEF\u3002\u4F46\u6211\u4F1A\u544A\u8BC9\u4F60\uFF0C\u90A3\u662F\u7531\u4E8E\u4FE1\u606F\u5DEE\u5BFC\u81F4\u7684\u65E0\u6548\u635F\u8017\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u59D0\uFF0C\u4F60\u521A\u624D\u8BF4\u884C\u653F\u5927\u697C\u7684\u8DEF\u88AB\u5C01\u4E86\uFF0C\u6211\u4EEC\u8981\u600E\u4E48\u8FC7\u53BB\uFF1F"
    - pageNumber: 9
      speakerName: "\u5468\u781A"
      text: "\u8FD9\u5C31\u662F\u6211\u5E26\u4F60\u6765\u8FD9\u513F\u7684\u539F\u56E0\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u7535\u68AF\u505C\u5728\u4E86\u4E00\u4E2A\u88C5\u9970\u4F18\u96C5\u7684\u5496\u5561\u5385\u5C42\u3002\u5468\u781A\u9886\u7740\u6797\u6E21\u7A7F\u8FC7\u51E0\u5F20\u8C08\u7B11\u98CE\u751F\u7684\u5361\u5EA7\uFF0C\u5F84\u76F4\u8D70\u5411\u89D2\u843D\u91CC\u4E00\u4E2A\u6B63\u6234\u7740\u8001\u82B1\u955C\u770B\u62A5\u7EB8\u7684\u4E2D\u5E74\u4EBA\u3002"
    - pageNumber: 11
      speakerName: "\u5468\u781A"
      text: "\u6797\u8001\u5E08\uFF0C\u597D\u4E45\u4E0D\u89C1\u3002\u60A8\u7684\u90A3\u7BC7\u5173\u4E8E\u533A\u57DF\u7ECF\u6D4E\u7684\u8BBA\u6587\u6211\u62DC\u8BFB\u4E86\uFF0C\u6570\u636E\u6A21\u578B\u505A\u5F97\u771F\u6F02\u4EAE\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u88AB\u79F0\u4E3A\u6797\u8001\u5E08\u7684\u4EBA\u653E\u4E0B\u62A5\u7EB8\uFF0C\u9732\u51FA\u7B11\u5BB9\uFF0C\u663E\u7136\u5BF9\u5468\u781A\u7684\u51FA\u73B0\u5E76\u4E0D\u610F\u5916\u3002"
    - pageNumber: 13
      speakerName: "\u5468\u781A"
      text: "\u8FD9\u662F\u6797\u6E21\uFF0C\u6211\u65B0\u5E26\u7684\u5B66\u59B9\u3002\u5979\u8FD9\u4EBA\u505A\u4E8B\u7279\u522B\u8BA4\u771F\uFF0C\u4E3A\u4E86\u9886\u4E2A\u6863\u6848\u5728\u697C\u4E0B\u8F6C\u4E86\u4E09\u5708\u90FD\u4E0D\u80AF\u8D70\u6377\u5F84\u3002\u6211\u60F3\u7740\uFF0C\u65E2\u7136\u60A8\u5728\u8FD9\u513F\u559D\u5496\u5561\uFF0C\u80FD\u4E0D\u80FD\u987A\u624B\u5E2E\u5979\u628A\u6863\u6848\u7B7E\u4E86\uFF1F\u514D\u5F97\u5979\u518D\u53BB\u90A3\u8FB9\u7A97\u53E3\u6652\u592A\u9633\u3002"
    - pageNumber: 14
      speakerName: 
      text: "\u4E0D\u5230\u4E24\u5206\u949F\uFF0C\u6797\u6E21\u5728\u5468\u781A\u7684\u8C08\u7B11\u95F4\u5C31\u62FF\u5230\u4E86\u539F\u672C\u9700\u8981\u6392\u961F\u4E00\u5C0F\u65F6\u7684\u5B66\u7C4D\u786E\u8BA4\u5355\u3002\u8D70\u51FA\u5496\u5561\u5385\u65F6\uFF0C\u6797\u6E21\u89C9\u5F97\u81EA\u5DF1\u50CF\u662F\u5728\u770B\u4E00\u573A\u795E\u5947\u7684\u8868\u6F14\u3002"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u59D0\u2026\u2026\u4F60\u5C31\u8FD9\u6837\u5E2E\u6211\u529E\u597D\u4E86\uFF1F\u6211\u751A\u81F3\u90FD\u6CA1\u770B\u5230\u529E\u4E8B\u7A97\u53E3\u3002"
    - pageNumber: 16
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u5728\u8FD9\u4E2A\u6821\u56ED\u91CC\uFF0C\u6700\u5FEB\u7684\u8DEF\u5F84\u4E0D\u662F\u5BFC\u822A\u753B\u51FA\u7684\u76F4\u7EBF\uFF0C\u800C\u662F\u4F60\u624B\u673A\u901A\u8BAF\u5F55\u91CC\u7684\u540D\u5B57\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u5468\u781A\u5E26\u7740\u6797\u6E21\u6765\u5230\u4E86\u4E50\u5929\u697C\u4E8C\u697C\u7684\u4E00\u5BB6\u7CBE\u81F4\u9910\u5385\u3002\u8FD9\u91CC\u6CA1\u6709\u697C\u4E0B\u98DF\u5802\u90A3\u79CD\u5608\u6742\uFF0C\u7A7A\u6C14\u4E2D\u6D41\u6DCC\u7740\u8F7B\u67D4\u7684\u7235\u58EB\u4E50\u3002"
    - pageNumber: 18
      speakerName: "\u5468\u781A"
      text: "\u7B2C\u4E00\u987F\u996D\uFF0C\u6211\u8BF7\u5BA2\u3002\u522B\u6025\u7740\u62D2\u7EDD\uFF0C\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u62D2\u7EDD\u522B\u4EBA\u7684\u597D\u610F\u5F80\u5F80\u610F\u5473\u7740\u62D2\u7EDD\u4E00\u4E2A\u6F5C\u5728\u7684\u673A\u4F1A\u3002"
    - pageNumber: 19
      speakerName: 
      text: "\u9910\u684C\u4E0A\uFF0C\u5468\u781A\u4F18\u96C5\u5730\u5207\u5F00\u725B\u6392\uFF0C\u76EE\u5149\u65F6\u4E0D\u65F6\u626B\u8FC7\u9910\u5385\u91CC\u7684\u5176\u4ED6\u4EBA\uFF0C\u5076\u5C14\u70B9\u5934\u793A\u610F\u3002"
    - pageNumber: 20
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u6C88\u9752\u79BE\u4F1A\u6559\u4F60\u5982\u4F55\u89E3\u9898\uFF0C\u4F46\u6211\u4F1A\u6559\u4F60\u5982\u4F55\u89E3\u4EBA\u3002\u5728\u8FD9\u4E2A\u5730\u65B9\uFF0C\u4F60\u662F\u8C01\u56FA\u7136\u91CD\u8981\uFF0C\u4F46\u4F60\u8BA4\u8BC6\u8C01\uFF0C\u5F80\u5F80\u51B3\u5B9A\u4E86\u4F60\u80FD\u8D70\u591A\u8FDC\u3002"
    - pageNumber: 21
      speakerName: "\u6797\u6E21"
      text: "\u542C\u8D77\u6765\u2026\u2026\u8FD9\u50CF\u662F\u4E00\u4E2A\u7F29\u5C0F\u7248\u7684\u540D\u5229\u573A\u3002"
    - pageNumber: 22
      speakerName: "\u5468\u781A"
      text: "\u4F60\u53EF\u4EE5\u8BF4\u5F97\u66F4\u6709\u6E29\u5EA6\u4E00\u70B9\uFF0C\u53EB\u201C\u5171\u540C\u6210\u957F\u4F53\u201D\u3002\u53EA\u8981\u4F60\u613F\u610F\uFF0C\u6211\u53EF\u4EE5\u5E26\u4F60\u8FDB\u5165\u6700\u6838\u5FC3\u7684\u5708\u5B50\u3002"
    - pageNumber: 23
      speakerName: 
      text: "\u5468\u781A\u628A\u4E00\u676F\u51B0\u9547\u8354\u679D\u996E\u63A8\u5230\u6797\u6E21\u9762\u524D\uFF0C\u5979\u7684\u773C\u795E\u91CC\u900F\u7740\u4E00\u79CD\u6210\u5E74\u4EBA\u7684\u777F\u667A\u4E0E\u538B\u8FEB\u611F\u3002\u6797\u6E21\u63E1\u7740\u676F\u5B50\uFF0C\u770B\u7740\u5468\u781A\u5FD9\u788C\u5730\u5728\u5FAE\u4FE1\u4E0A\u5904\u7406\u7740\u5404\u79CD\u6D88\u606F\uFF0C\u5979\u610F\u8BC6\u5230\uFF0C\u81EA\u5DF1\u4F3C\u4E4E\u63A5\u89E6\u5230\u4E86\u8FD9\u6240\u5B66\u6821\u6700\u9690\u79D8\u3001\u4E5F\u6700\u8BF1\u4EBA\u7684\u8FD0\u884C\u6CD5\u5219\u3002"
    choices: []
  - documentId: M0-2-2-C
    title: M0-2-2-C
    sourceAssetPath: Assets/content1/M0/M0-2-2-C.docx
    chapterId: M0
    category: 0
    isRootTask: 0
    isBranchDocument: 1
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m0_2_2_c
    npcId: "npc_\u987E\u6F84"
    locationId: admin_placeholder
    targetSceneName: undergarden
    fallbackTargetPosition: {x: 1310.01, y: 16.19, z: 987.22}
    rewardGold: 25
    finishLocationName: "\u884C\u653F\u697C"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u6700\u7EC8\u8FD8\u662F\u88AB\u987E\u6F84\u955C\u5934\u91CC\u7684\u90A3\u53EA\u6A58\u732B\u6253\u52A8\u4E86\u3002\u6BD4\u8D77\u6C88\u9752\u79BE\u7684\u51B7\u5CFB\u548C\u5468\u781A\u7684\u7CBE\u660E\uFF0C\u8FD9\u4E2A\u5750\u5728\u957F\u51F3\u80CC\u4E0A\u7684\u7537\u751F\u8EAB\u4E0A\u6709\u4E00\u79CD\u4E0E\u8FD9\u4E2A\u7D27\u7EF7\u6821\u56ED\u683C\u683C\u4E0D\u5165\u7684\u677E\u5F1B\u611F\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u987E\u5B66\u957F\u2026\u2026\u6211\u60F3\u53BB\u770B\u770B\u90A3\u7247\u80FD\u770B\u5230\u706B\u70E7\u4E91\u7684\u8349\u576A\u3002\u5176\u5B9E\uFF0C\u6211\u4E5F\u89C9\u5F97\u73B0\u5728\u7684\u4E91\u633A\u597D\u770B\u7684\u3002"
    - pageNumber: 3
      speakerName: "\u987E\u6F84"
      text: "\u54C8\u54C8\uFF0C\u6211\u5C31\u77E5\u9053\uFF01\u6797\u6E21\uFF0C\u4F60\u8EAB\u4E0A\u6709\u90A3\u79CD\u8FD8\u6CA1\u88AB\u8FD9\u5806\u7070\u767D\u8272\u5927\u697C\u540C\u5316\u7684\u7075\u6C14\u3002\u5FEB\uFF0C\u5149\u7EBF\u6700\u597D\u7684\u65F6\u95F4\u53EA\u6709\u4E94\u5206\u949F\uFF01"
    - pageNumber: 4
      speakerName: 
      text: "\u987E\u6F84\u731B\u5730\u8DF3\u4E0B\u957F\u51F3\uFF0C\u80CC\u8D77\u90A3\u4E2A\u522B\u6EE1\u5FBD\u7AE0\u7684\u65E7\u5E06\u5E03\u5305\u3002\u4ED6\u6CA1\u6709\u5E26\u6797\u6E21\u8D70\u90A3\u4E9B\u88AB\u7A7A\u8C03\u51B7\u6C14\u586B\u6EE1\u7684\u8FDE\u5ECA\uFF0C\u800C\u662F\u63A8\u5F00\u4E86\u4E00\u6247\u901A\u5F80\u5BA4\u5916\u7684\u5C0F\u95E8\u3002"
    - pageNumber: 5
      speakerName: "\u987E\u6F84"
      text: "\u6C88\u9752\u79BE\u4F1A\u5E26\u4F60\u8D70\u76F4\u7EBF\uFF0C\u5468\u781A\u4F1A\u5E26\u4F60\u8D70\u91D1\u7EBF\u3002\u4F46\u6211\u5E26\u4F60\u8D70\u7684\u8DEF\uFF0C\u662F\u6709\u98CE\u7684\u8DEF\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u4ED6\u4EEC\u8E0F\u4E0A\u4E86\u4E00\u6761\u94FA\u6EE1\u788E\u77F3\u7684\u5C0F\u5F84\u3002\u8DEF\u65C1\u79CD\u6EE1\u4E86\u8302\u5BC6\u7684\u51E4\u51F0\u6728\uFF0C\u7531\u4E8E\u53F0\u5730\u5EFA\u7B51\u7684\u9AD8\u5EA6\u5DEE\uFF0C\u8FD9\u91CC\u7684\u53F0\u9636\u867D\u7136\u6709\u4E9B\u9661\u5CED\uFF0C\u4F46\u6BCF\u8F6C\u8FC7\u4E00\u4E2A\u5F2F\uFF0C\u89C6\u91CE\u90FD\u4F1A\u7A81\u7136\u5F00\u9614\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\uFF0C\u624B\u673A\u5BFC\u822A\u8BF4\u8FD9\u91CC\u662F\u6B7B\u8DEF\u2026\u2026"
    - pageNumber: 8
      speakerName: "\u987E\u6F84"
      text: "\u5BFC\u822A\u4E0D\u61C2\u4EC0\u4E48\u662F\u751F\u6D3B\u3002\u4F60\u770B\uFF0C\u4ECE\u8FD9\u513F\u7ED5\u8FC7\u53BB\uFF0C\u662F\u5B66\u6821\u7684\u8001\u6821\u533A\u7559\u4E0B\u7684\u77F3\u51F3\u3002\u5750\u5728\u8FD9\u91CC\uFF0C\u4F60\u80FD\u542C\u5230\u6E56\u8FB9\u7684\u98CE\u58F0\uFF0C\u90A3\u662F\u884C\u653F\u697C\u91CC\u6C38\u8FDC\u542C\u4E0D\u5230\u7684\u58F0\u97F3\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u4ED6\u4EEC\u6765\u5230\u4E86\u4E00\u7247\u659C\u5761\u8349\u576A\u3002\u5915\u9633\u6B64\u65F6\u6B63\u7A7F\u8FC7\u4E24\u680B\u6559\u5B66\u697C\u4E4B\u95F4\u7684\u5DE8\u5927\u7F1D\u9699\uFF0C\u5C06\u6574\u7247\u7EFF\u5730\u67D3\u6210\u4E86\u707F\u70C2\u7684\u91D1\u7D2B\u8272\u3002\u6797\u6E21\u4E0D\u81EA\u89C9\u5730\u505C\u4E0B\u4E86\u811A\u6B65\uFF0C\u773C\u524D\u7684\u666F\u8C61\u8BA9\u5979\u51E0\u4E4E\u5FD8\u8BB0\u4E86\u5F00\u5B66\u62A5\u5230\u7684\u75B2\u60EB\u3002"
    - pageNumber: 10
      speakerName: "\u987E\u6F84"
      text: "\u6797\u6E21\uFF0C\u4F60\u8981\u8BB0\u4F4F\uFF0C\u8FD9\u91CC\u7684\u5EFA\u7B51\u518D\u786C\uFF0C\u4E91\u4E5F\u662F\u8F6F\u7684\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u987E\u6F84\u4ECE\u5305\u91CC\u7FFB\u51FA\u4E24\u4E2A\u4FBF\u5229\u5E97\u4E70\u7684\u539A\u5207\u5410\u53F8\u996D\u56E2\uFF0C\u5206\u7ED9\u6797\u6E21\u4E00\u4E2A\uFF0C\u7136\u540E\u76F4\u63A5\u5E2D\u5730\u800C\u5750\u3002"
    - pageNumber: 12
      speakerName: "\u987E\u6F84"
      text: "\u6863\u6848\u5BA4\u7684\u6797\u8001\u5E08\u73B0\u5728\u80AF\u5B9A\u5728\u559D\u8336\uFF0C\u54B1\u4EEC\u7B49\u4ED6\u559D\u5B8C\u518D\u53BB\u3002\u73B0\u5728\uFF0C\u8FD9\u7247\u706B\u70E7\u4E91\u662F\u4F60\u7684\u3002"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\uFF0C\u4F60\u6BCF\u5929\u90FD\u8FD9\u4E48\u2026\u2026\u81EA\u5728\u5417\uFF1F"
    - pageNumber: 14
      speakerName: "\u987E\u6F84"
      text: "\u81EA\u5728\u662F\u8981\u4ED8\u51FA\u4EE3\u4EF7\u7684\u3002\u6C88\u9752\u79BE\u4F1A\u7B11\u6211\u6D6A\u8D39\u65F6\u95F4\uFF0C\u5468\u781A\u4F1A\u89C9\u5F97\u6211\u6CA1\u6709\u4EF7\u503C\u3002\u4F46\u6211\u603B\u89C9\u5F97\uFF0C\u5982\u679C\u4E00\u4E2A\u4EBA\u8FDE\u773C\u524D\u7684\u665A\u971E\u90FD\u7559\u4E0D\u4F4F\uFF0C\u90A3\u4ED6\u8FD8\u80FD\u7559\u4F4F\u4EC0\u4E48\uFF1F"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u6211\u539F\u672C\u4EE5\u4E3A\uFF0C\u6765\u5230\u8FD9\u91CC\u5C31\u662F\u4E3A\u4E86\u50CF\u6C88\u5B66\u59D0\u90A3\u6837\uFF0C\u53D8\u6210\u4E00\u4E2A\u5B8C\u7F8E\u7684\u70B9\u3002"
    - pageNumber: 16
      speakerName: "\u987E\u6F84"
      text: "\u522B\u3002\u8FD9\u4E16\u754C\u4E0D\u7F3A\u5B8C\u7F8E\u7684\u70B9\uFF0C\u7F3A\u7684\u662F\u6709\u6E29\u5EA6\u7684\u4EBA\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u6797\u6E21\u5B66\u7740\u987E\u6F84\u7684\u6837\u5B50\u5750\u5728\u8349\u5730\u4E0A\uFF0C\u6495\u5F00\u996D\u56E2\u7684\u5305\u88C5\u7EB8\u3002\u54B8\u54B8\u7684\u6D77\u98CE\u4ECE\u5927\u9E4F\u6E7E\u7684\u65B9\u5411\u5439\u6765\uFF0C\u63A0\u8FC7\u5979\u7684\u53D1\u68A2\u3002\u5728\u8FD9\u4E00\u523B\uFF0C\u90A3\u4E9B\u7D27\u8FEB\u7684\u8BFE\u8868\u3001\u590D\u6742\u7684\u793E\u4EA4\u3001\u6C89\u91CD\u7684\u6863\u6848\uFF0C\u4F3C\u4E4E\u90FD\u9000\u8FDC\u4E86\u4E00\u4E9B\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u5979\u770B\u7740\u987E\u6F84\u4E3E\u8D77\u76F8\u673A\uFF0C\u5BF9\u7740\u5730\u5E73\u7EBF\u6309\u4E0B\u5FEB\u95E8\u3002\u5915\u9633\u5C06\u4ED6\u7684\u8F6E\u5ED3\u52FE\u52D2\u51FA\u4E00\u9053\u91D1\u8FB9\uFF0C\u4E5F\u8BA9\u6797\u6E21\u5728\u8FD9\u4E2A\u5145\u6EE1\u538B\u529B\u7684\u6821\u56ED\u91CC\uFF0C\u7B2C\u4E00\u6B21\u627E\u5230\u4E86\u4E00\u79CD\u7C7B\u4F3C\u201C\u5BB6\u201D\u7684\u547C\u5438\u8282\u594F\u3002"
    - pageNumber: 19
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\u2026\u2026\u8C22\u8C22\u4F60\u5E26\u6211\u6765\u8FD9\u513F\u3002"
    - pageNumber: 20
      speakerName: "\u987E\u6F84"
      text: "\u8C22\u4EC0\u4E48\u3002\u7B49\u4F1A\u513F\u53BB\u9886\u6863\u6848\u7684\u65F6\u5019\uFF0C\u5982\u679C\u8001\u5E08\u95EE\u4F60\u4E3A\u4EC0\u4E48\u8FDF\u5230\uFF0C\u4F60\u5C31\u544A\u8BC9\u4ED6\u2014\u2014\u4F60\u53BB\u6355\u83B7\u5915\u9633\u4E86\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u6797\u6E21\u7B11\u4E86\u51FA\u6765\uFF0C\u90A3\u662F\u5979\u62A5\u5230\u4EE5\u6765\u6700\u8F7B\u677E\u7684\u4E00\u4E2A\u7B11\u5BB9\u3002"
    choices: []
  - documentId: M0-3-1
    title: M0-3-1
    sourceAssetPath: Assets/content1/M0/M0-3-1.docx
    chapterId: M0
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m0_3_1
    npcId: story_trigger
    locationId: m0_dorm_uppergarden
    targetSceneName: uppergarden
    fallbackTargetPosition: {x: 350.13, y: 44.51, z: -625.67}
    rewardGold: 25
    finishLocationName: "\u4E0A\u56ED\u5BBF\u820D\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u51CC\u6668 0:24\u3002\u4E0A\u56ED\u5BBF\u820D\u533A\u7684\u706F\u5149\u5DF2\u7ECF\u7184\u706D\u4E86\u5927\u534A\uFF0C\u53EA\u6709\u96F6\u661F\u7684\u7A97\u6237\u8FD8\u900F\u51FA\u75B2\u60EB\u7684\u51B7\u767D\u5149\uFF0C\u90A3\u662F\u8FD8\u6CA1\u7ED3\u675F\u7684\u5C0F\u7EC4\u9884\u4E60\uFF0C\u6216\u662F\u6DF1\u591C\u7684\u8DE8\u65F6\u533A\u7F51\u8BFE\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u8EBA\u5728\u5E8A\u4E0A\uFF0C\u957F\u8FBE\u4E00\u5929\u7684\u5954\u6CE2\u8BA9\u5979\u7684\u53CC\u817F\u9635\u9635\u53D1\u9178\u3002\u5979\u5408\u4E0A\u773C\uFF0C\u8111\u6D77\u91CC\u5374\u4E0D\u505C\u56DE\u54CD\u7740\u6C88\u9752\u79BE\u7684\u201C\u5750\u6807\u201D\u3001\u5468\u781A\u7684\u201C\u4EBA\u8109\u201D\u548C\u987E\u6F84\u7684\u201C\u4E91\u201D\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5728\u8FD9\u4E2A\u540D\u4E3A\u6E2F\u4E2D\u6DF1\u7684\u7CBE\u5BC6\u7CFB\u7EDF\u91CC\uFF0C\u6BCF\u4E2A\u4EBA\u4F3C\u4E4E\u90FD\u627E\u5230\u4E86\u4E00\u79CD\u81EA\u6D3D\u7684\u59FF\u6001\uFF0C\u552F\u72EC\u5979\uFF0C\u50CF\u662F\u4E00\u4E2A\u8FD8\u6CA1\u88AB\u5199\u5165\u7A0B\u5E8F\u7684\u7A7A\u5B57\u7B26\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5C31\u5728\u7761\u610F\u5373\u5C06\u5408\u62E2\u7684\u4E00\u77AC\uFF0C\u6795\u8FB9\u7684\u624B\u673A\u53D1\u51FA\u4E86\u77ED\u4FC3\u800C\u6C89\u95F7\u7684\u9707\u52A8\u3002"
    - pageNumber: 5
      speakerName: "\u5C4F\u5E55\u9876\u7AEF\u6D6E\u73B0\u51FA\u4E00\u884C\u5B57"
      text: "\u6B22\u8FCE\u767B\u9646\u533F\u540D\u8BBA\u575B\u201C\u672A\u540D\u4E4B\u6D77\u201D\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u5947\u602A\uFF0C\u6211\u4EC0\u4E48\u65F6\u5019\u4E0B\u8F7D\u8FC7\u8FD9\u4E2A\u4E1C\u897F\uFF1F\u662F\u6821\u56ED\u7F51\u81EA\u52A8\u63A8\u9001\u7684\u5417\uFF1F"
    - pageNumber: 7
      speakerName: 
      text: "\u5979\u8BD5\u56FE\u5378\u8F7D\uFF0C\u624B\u6307\u89E6\u78B0\u5230\u56FE\u6807\u7684\u77AC\u95F4\uFF0C\u5C4F\u5E55\u5374\u7A81\u7136\u6697\u4E86\u4E0B\u53BB\u3002\u7D27\u63A5\u7740\uFF0C\u4E00\u884C\u53C8\u4E00\u884C\u5E7D\u7EFF\u8272\u7684\u4EE3\u7801\u50CF\u7011\u5E03\u4E00\u6837\u5782\u843D\uFF0C\u6700\u7EC8\u91CD\u7EC4\u4E3A\u4E00\u4E2A\u7B80\u6D01\u5230\u8FD1\u4E4E\u7B80\u964B\u7684\u7248\u5757\u2014\u2014\u201C\u7B2C\u96F6\u8BFE\u201D\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u6797\u6E21\u7684\u624B\u6307\u50F5\u4F4F\u4E86\u3002\u5979\u60F3\u8D77\u4E86\u4ECA\u5929\u5728\u62A5\u5230\u70B9\u65F6\uFF0C\u90A3\u4E2A\u8FCE\u65B0\u5B66\u957F\u6700\u540E\u610F\u5473\u6DF1\u957F\u7684\u773C\u795E\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u5979\u6DF1\u5438\u4E00\u53E3\u6C14\uFF0C\u5F00\u59CB\u5728\u90A3\u4E9B\u95EA\u70C1\u7684\u5E16\u5B50\u4E2D\u5BFB\u627E\u771F\u76F8\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u70B9\u5F00\u4E86\u7B2C\u4E00\u4E2A\u88AB\u7F6E\u9876\u7684\u7EA2\u5B57\u5E16\u5B50\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u5E16\u5B50\u7684\u6B63\u6587\u53EA\u6709\u4E00\u6BB5\u7B80\u77ED\u7684\u5F55\u97F3\u8F6C\u6587\u5B57\uFF1A\u201C\u4ED6\u4E0D\u662F\u9000\u5B66\uFF0C\u4E5F\u4E0D\u662F\u51FA\u56FD\u3002\u4ED6\u5728\u6700\u540E\u4E00\u5802\u5FAE\u79EF\u5206\u8BFE\u7ED3\u675F\u540E\uFF0C\u6CA1\u6709\u8D70\u5411\u56FE\u4E66\u9986\uFF0C\u800C\u662F\u8D70\u5411\u4E86\u949F\u697C\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u76D1\u63A7\u663E\u793A\u4ED6\u8FDB\u5165\u4E86\u949F\u697C\u7684\u9634\u5F71\uFF0C\u4F46\u6CA1\u6709\u4EFB\u4F55\u4E00\u4E2A\u6444\u50CF\u5934\u62CD\u5230\u4ED6\u51FA\u6765\u3002\u7B2C\u4E8C\u5929\uFF0C\u4ED6\u7684\u5BBF\u820D\u5E8A\u4F4D\u7A7A\u4E86\uFF0C\u6559\u52A1\u7CFB\u7EDF\u91CC\u4ED6\u7684\u540D\u5B57\u53D8\u6210\u4E86\u4E00\u4E32\u4E71\u7801\u3002\u7CFB\u7EDF\u8BA4\u5B9A\u4ED6\u2018\u4E0D\u7B26\u5408\u8FD0\u884C\u903B\u8F91\u2019\u3002\u5927\u5BB6\u8FD8\u5728\u8C08\u8BBA\u4ED6\u7684\u6210\u529F\uFF0C\u5374\u6CA1\u4EBA\u8BB0\u5F97\u4ED6\u7684\u957F\u76F8\u3002\u201D"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u4E0D\u7B26\u5408\u2026\u2026\u8FD0\u884C\u903B\u8F91\uFF1F"
    - pageNumber: 14
      speakerName: 
      text: "\u6797\u6E21\u611F\u5230\u4E00\u80A1\u51C9\u610F\u4ECE\u6307\u5C16\u8513\u5EF6\u5F00\u6765\u3002\u8FD9\u4E0D\u50CF\u662F\u666E\u901A\u7684\u90FD\u5E02\u4F20\u8BF4\uFF0C\u66F4\u50CF\u662F\u4E00\u79CD\u7CFB\u7EDF\u6027\u7684\u62B9\u9664\u3002"
    - pageNumber: 15
      speakerName: 
      text: "\u5979\u7EE7\u7EED\u5411\u4E0B\u6ED1\u52A8\uFF0C\u70B9\u5F00\u4E86\u7B2C\u4E8C\u4E2A\u5E16\u5B50\u3002\u5E16\u5B50\u7684\u914D\u56FE\u662F\u4E00\u5F20\u6A21\u7CCA\u7684\u6DF1\u591C\u7167\u7247\uFF0C\u949F\u697C\u5728\u9ED1\u6697\u4E2D\u626D\u66F2\u6210\u4E00\u4E2A\u602A\u8BDE\u7684\u5F62\u72B6\u3002"
    - pageNumber: 16
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5982\u679C\u4F60\u5728\u51CC\u6668\u56DB\u70B9\uFF0C\u542C\u5230\u4E86\u56DB\u58F0\u949F\u54CD\uFF0C\u8BF7\u7ACB\u523B\u505C\u6B62\u4F60\u7684\u547C\u5438\u3002\u201D"
    - pageNumber: 17
      speakerName: 
      text: "\u5E16\u5B50\u7684\u56DE\u5E16\u533A\u5F02\u5E38\u8BE1\u5F02\u3002\u6709\u4EBA\u8BF4\uFF1A\u201C\u6211\u542C\u5230\u4E86\u3002\u90A3\u4E0D\u662F\u949F\u58F0\uFF0C\u662F\u6709\u4EBA\u5728\u6DF1\u6C34\u91CC\u6572\u51FB\u73BB\u7483\u7684\u58F0\u97F3\u3002\u201D\u8FD8\u6709\u4EBA\u8BF4\uFF1A\u201C\u90A3\u662F\u4E0B\u8BFE\u94C3\u3002\u7B2C\u96F6\u8BFE\u7684\u6559\u6388\u4ECE\u6765\u4E0D\u70B9\u540D\uFF0C\u4ED6\u53EA\u6311\u9009\u90A3\u4E9B\u2018\u5FEB\u8981\u88C2\u5F00\u7684\u4EBA\u2019\u3002\u5982\u679C\u4F60\u611F\u5230\u538B\u529B\u5927\u5230\u7075\u9B42\u5FEB\u8981\u6EA2\u51FA\u6765\uFF0C\u4F60\u5C31\u4F1A\u770B\u5230\u90A3\u6247\u95E8\u3002\u201D"
    - pageNumber: 18
      speakerName: 
      text: "\u5E16\u5B50\u7684\u56DE\u5E16\u533A\u5F02\u5E38\u8BE1\u5F02\u3002\u6709\u4EBA\u8BF4\uFF1A\u201C\u6211\u542C\u5230\u4E86\u3002\u90A3\u4E0D\u662F\u949F\u58F0\uFF0C\u662F\u6709\u4EBA\u5728\u6DF1\u6C34\u91CC\u6572\u51FB\u73BB\u7483\u7684\u58F0\u97F3\u3002\u201D\u8FD8\u6709\u4EBA\u8BF4\uFF1A\u201C\u90A3\u662F\u4E0B\u8BFE\u94C3\u3002\u7B2C\u96F6\u8BFE\u7684\u6559\u6388\u4ECE\u6765\u4E0D\u70B9\u540D\uFF0C\u4ED6\u53EA\u6311\u9009\u90A3\u4E9B\u2018\u5FEB\u8981\u88C2\u5F00\u7684\u4EBA\u2019\u3002\u5982\u679C\u4F60\u611F\u5230\u538B\u529B\u5927\u5230\u7075\u9B42\u5FEB\u8981\u6EA2\u51FA\u6765\uFF0C\u4F60\u5C31\u4F1A\u770B\u5230\u90A3\u6247\u95E8\u3002\u201D"
    - pageNumber: 19
      speakerName: 
      text: "\u5F53\u6797\u6E21\u5237\u5230\u7B2C\u4E09\u4E2A\u5E16\u5B50\u65F6\uFF0C\u5979\u7684\u547C\u5438\u5F7B\u5E95\u51DD\u56FA\u4E86\u3002\u90A3\u4E2A\u5E16\u5B50\u7684\u6807\u9898\u7ADF\u7136\u662F\uFF1A\u300A\u81F4\u6797\u6E21\uFF1A\u4E0D\u8981\u8BD5\u56FE\u5BFB\u627E\u5750\u6807\u3002\u300B"
    - pageNumber: 20
      speakerName: "\u5E16\u5B50\u91CC\u53EA\u6709\u4E00\u53E5\u8BDD"
      text: "\u201C\u6C88\u9752\u79BE\u7ED9\u4F60\u7684\u90AE\u4EF6\u5730\u5740\u662F\u5047\u7684\uFF0C\u5468\u781A\u7ED9\u4F60\u7684\u4E66\u7B7E\u91CC\u85CF\u7740\u76D1\u542C\uFF0C\u987E\u6F84\u5E26\u4F60\u770B\u7684\u4E91\u662F\u5E7B\u89C9\u3002\u6797\u6E21\uFF0C\u6765\u627E\u6211\u3002\u6211\u5728\u7CFB\u7EDF\u7684\u88C2\u7F1D\u91CC\u7B49\u4F60\u3002\u201D"
    - pageNumber: 21
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u4E0D\u53EF\u80FD\u2026\u2026\u4ED6\u4EEC\u600E\u4E48\u4F1A\u77E5\u9053\u6211\u7684\u540D\u5B57\uFF1F\u8C01\u5728\u53D1\u8FD9\u4E9B\u4E1C\u897F\uFF1F"
    - pageNumber: 22
      speakerName: 
      text: "\u5C31\u5728\u8FD9\u65F6\uFF0C\u624B\u673A\u5C4F\u5E55\u7A81\u7136\u88AB\u4E00\u5F20\u5DE8\u5927\u7684\u9ED1\u8272\u5BF9\u8BDD\u6846\u8986\u76D6\u3002\u4E00\u4E2A\u540D\u4E3A\u201CNull\u201D\u7684\u7528\u6237\u5934\u50CF\u4EAE\u4E86\u8D77\u6765\uFF0C\u90A3\u662F\u4E00\u5F20\u6CA1\u6709\u4EFB\u4F55\u4E94\u5B98\u7684\u7A7A\u767D\u9762\u5B54\u3002"
    - pageNumber: 23
      speakerName: Null
      text: "\u4E09\u6761\u788E\u7247\uFF0C\u4F60\u5DF2\u7ECF\u770B\u5B8C\u4E86\u3002\u6797\u6E21\uFF0C\u6B22\u8FCE\u6765\u5230\u771F\u5B9E\u7684\u6E2F\u4E2D\u6DF1\u3002"
    - pageNumber: 24
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u662F\u8C01\uFF1F\u4F60\u600E\u4E48\u77E5\u9053\u6211\u7684\u540D\u5B57\uFF1F\u8FD9\u4E9B\u5E16\u5B50\u662F\u4F60\u53D1\u7684\u5417\uFF1F"
    - pageNumber: 25
      speakerName: Null
      text: "\u6211\u662F\u8C01\u5E76\u4E0D\u91CD\u8981\u3002\u91CD\u8981\u7684\u662F\uFF0C\u4F60\u521A\u624D\u5728\u5BFB\u627E\u4EC0\u4E48\uFF1F\u662F\u5BFB\u627E\u4E00\u79CD\u5F52\u5C5E\u611F\uFF0C\u8FD8\u662F\u5728\u5BFB\u627E\u4E00\u79CD\u9003\u79BB\u7684\u65B9\u5F0F\uFF1F"
    - pageNumber: 26
      speakerName: Null
      text: "\u6C88\u9752\u79BE\u3001\u5468\u781A\u3001\u987E\u6F84\u2026\u2026\u4ED6\u4EEC\u662F\u8FD9\u4E2A\u7CFB\u7EDF\u7684\u4E09\u4E2A\u652F\u70B9\u3002\u4ED6\u4EEC\u8868\u73B0\u51FA\u67D0\u79CD\u6781\u7AEF\uFF0C\u662F\u4E3A\u4E86\u63A9\u76D6\u7CFB\u7EDF\u5185\u6838\u7684\u8352\u8C2C\u3002"
    - pageNumber: 27
      speakerName: Null
      text: "\u4F60\u4EE5\u4E3A\u4F60\u5728\u9009\u8DEF\uFF0C\u5176\u5B9E\u4F60\u53EA\u662F\u5728\u9009\u62E9\u88AB\u54EA\u4E00\u79CD\u65B9\u5F0F\u6D88\u51CF\u3002"
    - pageNumber: 28
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4E0D\u660E\u767D\u4F60\u5728\u8BF4\u4EC0\u4E48\u3002\u6211\u53EA\u662F\u6765\u4E0A\u5927\u5B66\u7684\uFF0C\u6211\u60F3\u62FF\u597D\u7EE9\u70B9\uFF0C\u4EA4\u597D\u670B\u53CB\uFF0C\u7136\u540E\u627E\u4EFD\u597D\u5DE5\u4F5C\u3002"
    - pageNumber: 29
      speakerName: Null
      text: "\u5475\u5475\uFF0C\u597D\u6807\u51C6\u7684\u4E00\u5957\u6A21\u677F\u3002\u4F46\u6797\u6E21\uFF0C\u4F60\u89C9\u5F97\u4F60\u8FD9\u79CD\u201C\u4E0D\u7A33\u5B9A\u56E0\u5B50\u201D\uFF0C\u771F\u7684\u80FD\u5728\u90A3\u5957\u6A21\u677F\u91CC\u6D3B\u8FC7\u5927\u4E00\u5417\uFF1F"
    - pageNumber: 30
      speakerName: Null
      text: "\u770B\u770B\u4F60\u7684\u53CC\u624B\u3002\u5728\u6C88\u9752\u79BE\u7684\u903B\u8F91\u91CC\uFF0C\u4F60\u662F\u591A\u4F59\u7684\u504F\u5DEE\uFF1B\u5728\u5468\u781A\u7684\u7F51\u91CC\uFF0C\u4F60\u662F\u5C1A\u5F85\u8BC4\u4F30\u7684\u8D44\u6E90\uFF1B\u5728\u987E\u6F84\u7684\u68A6\u91CC\uFF0C\u4F60\u662F\u966A\u886C\u7684\u89C2\u4F17\u3002"
    - pageNumber: 31
      speakerName: Null
      text: "\u53EA\u6709\u6211\uFF0C\u628A\u4F60\u5F53\u505A\u4E00\u4E2A\u201C\u53D8\u91CF\u201D\u3002"
    - pageNumber: 32
      speakerName: Null
      text: "\u73B0\u5728\uFF0C\u505A\u4E00\u4E2A\u51B3\u5B9A\u3002"
    - pageNumber: 33
      speakerName: Null
      text: "\u3010\u5173\u6CE8\u3011\u6211\u3002\u6211\u4F1A\u5E26\u4F60\u53BB\u770B\u770B\u90A3\u4E9B\u88AB\u62B9\u6389\u7684\u4EBA\u7559\u4E0B\u7684\u75D5\u8FF9\uFF0C\u53BB\u542C\u542C\u949F\u697C\u91CC\u771F\u6B63\u7684\u58F0\u97F3\u3002\u4F46\u4EE3\u4EF7\u662F\uFF0C\u4F60\u53EF\u80FD\u4F1A\u5931\u53BB\u90A3\u79CD\u201C\u65E0\u77E5\u7684\u5E78\u798F\u201D\u3002\u4F60\u4F1A\u5F00\u59CB\u8D28\u7591\u6BCF\u4E00\u5802\u8BFE\u3001\u6BCF\u4E00\u573A\u8003\u8BD5\uFF0C\u751A\u81F3\u6BCF\u4E00\u4E2A\u5BF9\u4F60\u5FAE\u7B11\u7684\u4EBA\u3002"
    - pageNumber: 34
      speakerName: Null
      text: "\u6797\u6E21\uFF0C\u4F60\u60F3\u505A\u4E00\u4E2A\u6E05\u9192\u7684\u75AF\u5B50\uFF0C\u8FD8\u662F\u4E00\u4E2A\u5FEB\u4E50\u7684\u5080\u5121\uFF1F"
    - pageNumber: 35
      speakerName: 
      text: "\u6797\u6E21\u7D27\u7D27\u54AC\u7740\u4E0B\u5507\uFF0C\u6307\u5C16\u60AC\u505C\u5728\u5C4F\u5E55\u4E0A\u65B9\u3002"
    - pageNumber: 36
      speakerName: 
      text: "\u5BBF\u820D\u7A97\u5916\uFF0C\u8FDC\u5904\u949F\u697C\u7684\u5F71\u5B50\u5728\u6708\u5149\u4E0B\u88AB\u62C9\u5F97\u6781\u957F\u3002\u5728\u8FD9\u4E00\u77AC\u95F4\uFF0C\u5979\u4EFF\u4F5B\u771F\u7684\u542C\u5230\u4E86\u67D0\u79CD\u7EC6\u5FAE\u7684\u3001\u50CF\u662F\u6307\u7532\u5212\u8FC7\u73BB\u7483\u7684\u523A\u8033\u58F0\u54CD\uFF0C\u4ECE\u5927\u5730\u7684\u6DF1\u5904\u4F20\u6765\u3002"
    - pageNumber: 37
      speakerName: 
      text: "\u90A3\u79CD\u6C88\u9752\u79BE\u65E0\u6CD5\u8BA1\u7B97\u3001\u5468\u781A\u65E0\u6CD5\u4E70\u65AD\u3001\u987E\u6F84\u65E0\u6CD5\u7F8E\u5316\u7684\u4E0D\u5B89\u611F\uFF0C\u50CF\u6D77\u6F6E\u4E00\u6837\u6DF9\u6CA1\u4E86\u5979\u3002"
    - pageNumber: 38
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u8FD9\u771F\u7684\u662F\u4E00\u573A\u6E38\u620F\u2026\u2026\u6211\u62D2\u7EDD\u6309\u7167\u4F60\u4EEC\u5199\u597D\u7684\u653B\u7565\u8D70\u3002"
    - pageNumber: 39
      speakerName: 
      text: "\u6797\u6E21\u6DF1\u6DF1\u5438\u4E86\u4E00\u53E3\u6C14\uFF0C\u5C06\u624B\u6307\u91CD\u91CD\u5730\u70B9\u5411\u4E86\u90A3\u4E2A\u3010\u5173\u6CE8\u3011\u6309\u94AE\u3002"
    - pageNumber: 40
      speakerName: Null
      text: "\u2026\u2026\u5F88\u6709\u8DA3\u3002"
    - pageNumber: 41
      speakerName: Null
      text: "\u606D\u559C\u4F60\uFF0C\u6797\u6E21\u3002\u4F60\u521A\u521A\u4EB2\u624B\u6740\u6B7B\u4E86\u4F60\u7684\u201C\u5E73\u9759\u751F\u6D3B\u201D\u3002"
    - pageNumber: 42
      speakerName: Null
      text: "\u7B2C\u4E00\u8BFE\u7684\u9884\u4E60\u9898\u5DF2\u7ECF\u53D1\u5230\u4F60\u7684\u90AE\u7BB1\u4E86\u3002\u4E0D\u8981\u53BB\u884C\u653F\u697C\u9886\u6863\u6848\u4E86\uFF0C\u53BB\u770B\u770B\u90A3\u4E2A\u88AB\u5C01\u6B7B\u7684\u65E7\u6863\u6848\u5BA4\uFF0C\u90A3\u91CC\u6709\u5173\u4E8E\u4F60\u81EA\u5DF1\u7684\u2026\u2026\u521D\u6B21\u8BB0\u8F7D\u3002"
    - pageNumber: 43
      speakerName: Null
      text: "\u665A\u5B89\uFF0C\u6797\u6E21\u3002\u795D\u4F60\u4ECA\u665A\u4E0D\u8981\u68A6\u89C1\u4EE3\u7801\u3002"
    - pageNumber: 44
      speakerName: 
      text: "\u624B\u673A\u5C4F\u5E55\u77AC\u95F4\u6062\u590D\u4E86\u6B63\u5E38\u3002\u90A3\u4E2A\u8BE1\u5F02\u7684\u56FE\u6807\u6D88\u5931\u4E86\uFF0C\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u4E00\u6761\u5E73\u9759\u7684\u7CFB\u7EDF\u63A8\u9001\uFF1A\u201C\u660E\u5929\u4E0A\u8BFE\u65F6\u95F4\uFF1A08:30\uFF0C\u8BF7\u4E0D\u8981\u8FDF\u5230\u3002\u201D"
    - pageNumber: 45
      speakerName: 
      text: "\u6797\u6E21\u762B\u5012\u5728\u5E8A\u4E0A\uFF0C\u5FC3\u810F\u8DF3\u52A8\u5F97\u5267\u70C8\u5230\u8BA9\u5979\u611F\u5230\u75BC\u75DB\u3002"
    - pageNumber: 46
      speakerName: 
      text: "\u7A97\u5916\uFF0C\u5FAE\u98CE\u5439\u8FC7\uFF0C\u51E4\u51F0\u6728\u7684\u53F6\u5B50\u6C99\u6C99\u4F5C\u54CD\u3002\u6797\u6E21\u77E5\u9053\uFF0C\u4ECE\u8FD9\u4E00\u523B\u8D77\uFF0C\u8FD9\u7247\u201C\u672A\u540D\u4E4B\u6D77\u201D\u5BF9\u5979\u800C\u8A00\uFF0C\u5DF2\u7ECF\u5F7B\u5E95\u53D8\u5F97\u6CE2\u8BE1\u4E91\u8C32\u3002"
    - pageNumber: 47
      speakerName: "\u3010\u5E8F\u7AE0"
      text: "\u5B8C\u3011"
    choices: []
