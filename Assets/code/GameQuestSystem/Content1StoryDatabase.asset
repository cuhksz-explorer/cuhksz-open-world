    isBranchDocument: 0
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m2_3_3
    npcId: "npc_\u5468\u781A"
    locationId: offcampus_placeholder
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1359.02, y: 16.19, z: 1085.17}
    rewardGold: 65
    finishLocationName: "\u6821\u5916\u5267\u60C5\u89E6\u53D1\u70B9"
    pages:
    - pageNumber: 1
      speakerName: "\u5468\u781A"
      text: "\u201C\u5728\u8FD9\u4E2A\u5B66\u6821\u91CC\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\uFF0C\u5750\u5728\u6211\u5BF9\u9762\uFF0C\u8DDF\u6211\u8C08\u2018\u903B\u8F91\u7EAF\u7CB9\u6027\u2019\u7684\u4EBA\u3002\u201D"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u53EA\u662F\u4E0D\u60F3\u6D6A\u8D39\u65F6\u95F4\u5728\u4F4E\u6548\u7387\u7684\u535A\u5F08\u4E0A\u3002\u5468\u781A\uFF0C\u4F60\u5176\u5B9E\u4E0D\u9700\u8981\u628A\u81EA\u5DF1\u88C5\u5728\u90A3\u4E2A\u65E0\u61C8\u53EF\u51FB\u7684\u58F3\u5B50\u91CC\uFF0C\u81F3\u5C11\u5728\u6211\u9762\u524D\u4E0D\u7528\u3002\u201D"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u201C\u5982\u679C\u4F60\u4E0B\u6B21\u80FD\u65E9\u70B9\u53D1\u73B0\u90A3\u4E2A\u903B\u8F91\u6F0F\u6D1E\uFF0C\u6211\u53EF\u80FD\u786E\u5B9E\u80FD\u5C11\u88C5\u4E00\u4F1A\u513F\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u5979\u7AD9\u8D77\u8EAB\uFF0C\u987A\u624B\u628A\u539F\u672C\u653E\u5728\u684C\u5B50\u4E2D\u95F4\u7684\u4E00\u74F6\u672A\u5F00\u5C01\u7684\u6C34\u6ED1\u5230\u6797\u6E21\u9762\u524D\u3002"
    - pageNumber: 5
      speakerName: "\u5468\u781A"
      text: "\u201C\u56DE\u5BDD\u5BA4\u5427\uFF0C\u6797\u6E21\u3002\u660E\u5929\u4E0A\u5348\u5341\u70B9\u7684\u6F14\u793A\uFF0C\u6211\u4EEC\u53BB\u7ED9\u90A3\u4E9B\u53EA\u61C2\u5229\u76CA\u4EA4\u6362\u7684\u5BB6\u4F19\u4E00\u70B9\u2018\u903B\u8F91\u7EAF\u7CB9\u6027\u2019\u7684\u9707\u64BC\u3002\u201D"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u201C\u7136\u540E\u5462\uFF1F\u7B49\u9879\u76EE\u843D\u5730\uFF0C\u5468\u603B\u6253\u7B97\u600E\u4E48\u5956\u52B1\u4F60\u7684\u9996\u5E2D\u5408\u4F5C\u4F19\u4F34\uFF1F\u201D"
    - pageNumber: 7
      speakerName: 
      text: "\u5468\u781A\u770B\u5411\u7A97\u5916\u6C89\u5BC2\u7684\u6821\u56ED\uFF0C\u5634\u89D2\u52FE\u8D77\u4E00\u4E2A\u7F55\u89C1\u7684\u3001\u6709\u4E9B\u5371\u9669\u7684\u5F27\u5EA6\u3002"
    - pageNumber: 8
      speakerName: "\u5468\u781A"
      text: "\u201C\u7B49\u671F\u672B\u5468\u7ED3\u675F\uFF0C\u6211\u4EEC\u9700\u8981\u4E00\u6B21\u2026\u2026\u5F7B\u5E95\u7684\u3001\u4E0D\u53EF\u8BA1\u7B97\u7684\u504F\u822A\u3002\u201D"
    - pageNumber: 9
      speakerName: 
      text: "\u968F\u7740\u6700\u540E\u4E00\u4EFD\u5BA1\u8BA1\u62A5\u544A\u5728\u6821\u65B9\u5927\u5385\u901A\u8FC7\uFF0C\u671F\u672B\u5468\u7684\u785D\u70DF\u7EC8\u4E8E\u5728\u6DF1\u6E2F\u8FB9\u754C\u7684\u51AC\u96E8\u4E2D\u6563\u53BB\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u90A3\u4E00\u5468\uFF0C\u6797\u6E21\u548C\u5468\u781A\u51E0\u4E4E\u6CA1\u6709\u79C1\u4E0B\u7684\u4EA4\u6D41\uFF0C\u5979\u4EEC\u5728\u6C47\u62A5\u73B0\u573A\u914D\u5408\u9ED8\u5951\uFF0C\u50CF\u4E24\u90E8\u4E25\u4E1D\u5408\u7F1D\u7684\u673A\u5668\uFF0C\u6A2A\u626B\u4E86\u6240\u6709\u7684\u8D28\u7591\u3002\u5F53\u6797\u6E21\u4EE5\u4E3A\u5979\u4EEC\u7684\u5173\u7CFB\u4F1A\u968F\u7740\u9879\u76EE\u7684\u7ED3\u675F\u800C\u91CD\u65B0\u56DE\u5F52\u201C\u5408\u4F19\u4EBA\u201D\u7684\u5E73\u6DE1\u65F6\uFF0C\u5143\u65E6\u524D\u5915\uFF0C\u5979\u6536\u5230\u4E86\u4E00\u6761\u5750\u6807\u5B9A\u4F4D\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u6CA1\u6709\u6587\u5B57\u8BF4\u660E\uFF0C\u53EA\u6709\u4E00\u5F20\u901A\u5F80\u9999\u6E2F\u4E2D\u73AF\u7684\u76F4\u901A\u5DF4\u7968\u6839\u3002"
    choices: []
  - documentId: "M2-3-3\u6C88"
