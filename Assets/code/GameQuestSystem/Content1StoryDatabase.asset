    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u62D2\u7EDD\u4E86\u9738\u738B\u6761\u6B3E\uFF0C\u8F6C\u8EAB\u79BB\u5F00\u529E\u516C\u5BA4\u3002\u5F20\u6559\u6388\u679C\u65AD\u628A\u4EFB\u52A1\u4EA4\u7ED9\u4E86\u7814\u4E09\u7684\u5B66\u957F\u3002\u5B66\u957F\u4EC5\u7528\u4E86\u51E0\u5929\u65F6\u95F4\uFF0C\u5728\u8FD9\u4E2A\u6846\u67B6\u4E0A\u5957\u4E86\u4E00\u4E2A\u65B0\u58F3\uFF0C\u987A\u5229\u62FF\u4E0B\u4E86\u8D44\u65B9\u7684\u767E\u4E07\u7EA7\u9879\u76EE\u548C\u4E24\u7BC7\u6838\u5FC3\u671F\u520A\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u53EA\u80FD\u770B\u7740\u539F\u672C\u5C5E\u4E8E\u81EA\u5DF1\u7684\u5927\u597D\u524D\u666F\u548C\u884C\u4E1A\u540D\u58F0\uFF0C\u6210\u4E86\u522B\u4EBA\u5C65\u5386\u4E0A\u6700\u95EA\u4EAE\u7684\u4E00\u7B14\uFF0C\u81EA\u5DF1\u5374\u5728\u8FD9\u4E2A\u8BFE\u9898\u7EC4\u91CC\u5F7B\u5E95\u5931\u53BB\u4E86\u4F4D\u7F6E\u3002"
    choices: []
  - documentId: M4-4-5
    title: M4-4-5
    sourceAssetPath: Assets/content1/M4/M4-4-5 1.docx
