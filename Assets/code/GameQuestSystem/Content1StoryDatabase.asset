    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4EEC\u4E0D\u7528\u90A3\u4E2A\u76D8\u3002\u6536\u8D77\u6765\u5427\uFF0C\u6893\u7487\u3002"
    - pageNumber: 2
      speakerName: "\u8D75\u6893\u7487"
      text: "\u6797\u6E21\uFF01\u4F60\u75AF\u4E86\u5417\uFF1F\u73B0\u5728\u662F\u665A\u4E0A\u4E03\u70B9\uFF0C\u79BB\u622A\u6B62\u53EA\u5269\u4E94\u5C0F\u65F6\uFF01\u5982\u679C\u4E0D\u6284\u2026\u2026\u4E0D\u53C2\u8003\uFF0C\u6211\u4EEC\u660E\u5929\u53EA\u80FD\u4EA4\u51FA\u4E00\u5806\u5783\u573E\uFF01"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u89C1\u9E7F\uFF0C\u5982\u679C\u4F60\u73B0\u5728\u91CD\u6784\u5E95\u5C42\u903B\u8F91\uFF0C\u6700\u5FEB\u8981\u591A\u4E45\uFF1F"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u89C1\u9E7F\u731B\u5730\u62AC\u8D77\u5934\uFF0C\u90A3\u53CC\u75B2\u60EB\u7684\u773C\u775B\u91CC\u77AC\u95F4\u71C3\u8D77\u4E86\u4E00\u7C07\u706B\u82D7\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u4E09\u5C0F\u65F6\u3002\u53EA\u8981\u82CF\u6C90\u80FD\u5E2E\u6211\u628A\u5269\u4E0B\u7684\u6570\u636E\u6807\u8BB0\u505A\u5B8C\uFF0C\u6211\u53EF\u4EE5\u901A\u5BB5\u8DD1\u6A21\u578B\u3002"
    - pageNumber: 6
      speakerName: "\u82CF\u6C90"
      text: "\u6211\u505A\uFF01\u6211\u4E0D\u53BB\u5F69\u6392\u4E86\uFF0C\u6211\u7559\u4E0B\u6765\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u6B21\u65E5\u7684\u7B54\u8FA9\u3002"
    - pageNumber: 8
      speakerName: "\u6559\u6388"
      text: "\u867D\u7136\u5B8C\u6210\u5EA6\u7A0D\u663E\u7C97\u7CD9\uFF0C\u751A\u81F3\u6709\u51E0\u4E2A\u6A21\u578B\u62DF\u5408\u7684\u9519\u8BEF\u2026\u2026\u4F46\u6211\u770B\u51FA\u4E86\u4F60\u4EEC\u7684\u601D\u8003\u8F68\u8FF9\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u6559\u6388\u5408\u4E0A\u7B14\u8BB0\u672C\uFF0C\u9732\u51FA\u4E00\u4E2A\u96BE\u5F97\u7684\u5FAE\u7B11\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u8D70\u51FA\u6559\u5BA4\u65F6\uFF0C\u9633\u5149\u6D12\u5728\u6797\u89C1\u9E7F\u5982\u91CA\u91CD\u8D1F\u7684\u8138\u4E0A\u3002"
    - pageNumber: 11
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u6797\u6E21\uFF0C\u8C22\u8C22\u4F60\u3002\u6628\u665A\u2026\u2026\u6211\u771F\u7684\u4EE5\u4E3A\u4F60\u4F1A\u9009\u90A3\u4E2A\u76D8\u3002"
    choices: []
