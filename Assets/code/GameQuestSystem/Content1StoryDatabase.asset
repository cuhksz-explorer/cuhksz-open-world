    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u6211\u6765\u81EA\u4E00\u4E2A\u666E\u901A\u7684\u5BB6\u5EAD\uFF0C\u6CA1\u4EC0\u4E48\u60CA\u5929\u52A8\u5730\u7684\u80CC\u666F\uFF0C\u4E5F\u6CA1\u4EC0\u4E48\u503C\u5F97\u4F60\u52A8\u7528\u7CBE\u5BC6\u6A21\u578B\u53BB\u8BA1\u7B97\u7684\u5E95\u724C\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u907F\u5F00\u5468\u781A\u7684\u89C6\u7EBF\uFF0C\u5979\u7684\u8BED\u6C14\u5766\u8361\u5F97\u50CF\u662F\u4E00\u573A\u5728\u9633\u5149\u4E0B\u7684\u644A\u724C\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4E4B\u6240\u4EE5\u80FD\u548C\u4F60\u5E76\u80A9\u8D70\u5728\u8FD9\u4E00\u628A\u4F1E\u4E0B\uFF0C\u9760\u7684\u662F\u6211\u81EA\u5DF1\u7684\u80FD\u529B\uFF0C\u662F\u6211\u5728\u6DF1\u591C\u91CC\u5199\u8FC7\u7684\u6BCF\u4E00\u884C\u4EE3\u7801\u3001\u71AC\u8FC7\u7684\u6BCF\u4E00\u4E2A\u5927\u521B\u9879\u76EE\u3002\u5468\u781A\uFF0C\u6211\u60F3\u548C\u4F60\u804A\u7684\u662F\u672A\u6765\uFF0C\u800C\u4E0D\u662F\u90A3\u4E2A\u5DF2\u7ECF\u88AB\u5199\u6B7B\u7684\u51FA\u8EAB\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5468\u781A\u6123\u4F4F\u4E86\uFF0C\u5979\u90A3\u53CC\u4E60\u60EF\u4E86\u5BA1\u89C6\u5BF9\u65B9\u8D44\u4EA7\u4E0E\u80CC\u666F\u7684\u773C\u775B\u91CC\uFF0C\u9632\u5907\u611F\u50CF\u662F\u88AB\u8FD9\u573A\u5927\u96E8\u6D17\u5237\u6389\u4E86\u4E00\u5C42\u3002\u5979\u770B\u7740\u6797\u6E21\uFF0C\u4EFF\u4F5B\u5728\u770B\u4E00\u4E2A\u4ECE\u539F\u59CB\u8352\u91CE\u91CC\u8D64\u624B\u7A7A\u62F3\u95EF\u51FA\u6765\u7684\u5F02\u7C7B\u3002"
    - pageNumber: 5
      speakerName: "\u5468\u781A"
      text: "\u2026\u2026\u666E\u901A\u7684\u5BB6\u5EAD\uFF1F\u5475\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u53D1\u51FA\u4E00\u58F0\u77ED\u4FC3\u7684\u7B11\u3002\u5979\u7A81\u7136\u4F38\u51FA\u5DE6\u624B\uFF0C\u91CD\u91CD\u5730\u62CD\u4E86\u62CD\u6797\u6E21\u7684\u80A9\u8180\uFF0C\u90A3\u529B\u9053\u5F88\u6C89\uFF0C\u5E26\u7740\u4E00\u79CD\u4ECE\u672A\u6709\u8FC7\u7684\u8BA4\u53EF\u3002"
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u6211\u89C1\u8FC7\u592A\u591A\u7A7F\u7740\u540D\u724C\u897F\u88C5\u5374\u6EE1\u5FC3\u7B97\u8BA1\u7684\u5080\u5121\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\u6562\u5728\u6211\u9762\u524D\u628A\u201C\u666E\u901A\u201D\u4E24\u4E2A\u5B57\u8BF4\u5F97\u8FD9\u4E48\u6709\u5E95\u6C14\u7684\u4EBA\u3002\u6797\u6E21\uFF0C\u5982\u679C\u4E0D\u8BA1\u7B97\u80CC\u666F\uFF0C\u90A3\u6211\u4EEC\u5C31\u53EA\u7B97\u672A\u6765\u3002"
    - pageNumber: 8
      speakerName: "\u5468\u781A"
      text: "\u65E2\u7136\u662F\u767D\u624B\u8D77\u5BB6\u7684\u540C\u7C7B\uFF0C\u90A3\u5C31\u628A\u4F1E\u62FF\u7A33\u4E00\u70B9\u3002\u63A5\u4E0B\u6765\u6211\u4EEC\u8981\u8D62\u7684\u4E1C\u897F\uFF0C\u53EF\u4E0D\u4EC5\u4EC5\u662F\u4E00\u4E2A\u6821\u7EA7\u9879\u76EE\u3002"
    choices: []
  - documentId: M2-2-2-B
    title: M2-2-2-B
    sourceAssetPath: Assets/content1/M2/M2-2-2-B.docx
    chapterId: M2
    category: 0
    isRootTask: 0
    isBranchDocument: 1
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m2_2_2_b
    npcId: "npc_\u5468\u781A"
    locationId: m0_library_reading
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1014.69, y: 14.22, z: 979.67}
    rewardGold: 65
    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4E0D\u5E0C\u671B\u201C\u5BB6\u5EAD\u201D\u6210\u4E3A\u4F60\u8BA1\u7B97\u6211\u7684\u53C2\u6570\uFF0C\u66F4\u4E0D\u5E0C\u671B\u5B83\u6210\u4E3A\u4F60\u7ED9\u6211\u8D34\u4E0A\u7684\u6807\u7B7E\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u505C\u4E0B\u811A\u6B65\uFF0C\u5728\u72ED\u7A84\u7684\u4F1E\u4E0B\u731B\u5730\u8F6C\u8EAB\uFF0C\u76F4\u89C6\u5468\u781A\u7684\u773C\u775B\u3002\u96E8\u58F0\u5728\u8FD9\u4E00\u523B\u4EFF\u4F5B\u88AB\u9694\u7EDD\u5728\u4E86\u67D0\u79CD\u7EDD\u5BF9\u9886\u57DF\u4E4B\u5916\uFF0C\u6797\u6E21\u80FD\u611F\u89C9\u5230\u5468\u781A\u8EAB\u4E0A\u4F20\u6765\u7684\u3001\u5FAE\u5FAE\u7D0A\u4E71\u7684\u70ED\u5EA6\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u4F60\u771F\u7684\u60F3\u4E86\u89E3\u6211\uFF0C\u4E0D\u5E94\u8BE5\u53BB\u7FFB\u6211\u7684\u6863\u6848\uFF0C\u6216\u8005\u5728\u90A3\u5806\u51B7\u51B0\u51B0\u7684\u6570\u636E\u91CC\u5BFB\u627E\u7B54\u6848\u3002\u4F60\u5E94\u8BE5\u5728\u8FD9\u91CC\u2014\u2014"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u8DE8\u524D\u534A\u6B65\uFF0C\u8DDD\u79BB\u8FD1\u5230\u4E24\u4EBA\u7684\u8863\u895F\u51E0\u4E4E\u8D34\u5728\u4E00\u8D77\u3002\u5979\u4F38\u51FA\u6307\u5C16\uFF0C\u865A\u865A\u5730\u6307\u4E86\u6307\u5468\u781A\u7684\u5FC3\u53E3\uFF0C\u58F0\u97F3\u4F4E\u6C89\u800C\u5145\u6EE1\u4FB5\u7565\u6027\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u2014\u2014\u4EB2\u81EA\u6765\u786E\u8BA4\uFF0C\u6211\u5230\u5E95\u662F\u4E00\u4E2A\u4EC0\u4E48\u6837\u7684\u53D8\u91CF\u3002\u4F60\u6562\u5417\uFF0C\u5468\u5B66\u59D0\uFF1F"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u5F7B\u5E95\u6123\u5728\u4E86\u539F\u5730\u3002\u90A3\u4E2A\u4E00\u5411\u6E38\u5203\u6709\u4F59\u3001\u628A\u4E00\u5207\u73A9\u5F04\u4E8E\u80A1\u638C\u4E4B\u95F4\u7684\u793E\u4EA4\u5929\u624D\uFF0C\u5728\u8FD9\u4E00\u77AC\u95F4\uFF0C\u77B3\u5B54\u5267\u70C8\u5730\u6536\u7F29\u4E86\u4E00\u4E0B\u3002\u5979\u611F\u5230\u4E00\u79CD\u4ECE\u672A\u6709\u8FC7\u7684\u5931\u63A7\u611F\u4ECE\u6307\u5C16\u8513\u5EF6\u5F00\u6765\u3002"
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u2026\u2026\u4F60\u75AF\u4E86\u5417\uFF1F"
    - pageNumber: 8
      speakerName: 
      text: "\u5468\u781A\u53D1\u51FA\u4E00\u58F0\u4F4E\u4F4E\u7684\u7B11\u58F0\uFF0C\u90A3\u7B11\u58F0\u91CC\u5E26\u7740\u51E0\u5206\u5371\u9669\u3002\u5979\u6CA1\u6709\u9000\u7F29\uFF0C\u53CD\u800C\u5F80\u524D\u8FC8\u4E86\u534A\u6B65\uFF0C\u9F3B\u5C16\u51E0\u4E4E\u62B5\u4F4F\u4E86\u6797\u6E21\u7684\u989D\u5934\u3002\u4F1E\u4E0B\u7684\u7A7A\u95F4\u56E0\u4E3A\u5979\u7684\u903C\u8FD1\u800C\u663E\u5F97\u8FD1\u4E4E\u7A92\u606F\u3002"
    - pageNumber: 9
      speakerName: "\u5468\u781A"
      text: "\u6CA1\u6709\u4EBA\u6562\u5728\u6211\u7684\u535A\u5F08\u573A\u91CC\u53CD\u5BA2\u4E3A\u4E3B\u3002\u6797\u6E21\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\u3002\u65E2\u7136\u4F60\u60F3\u8BA9\u6211\u4EB2\u81EA\u786E\u8BA4\uFF0C\u90A3\u4F60\u5C31\u5F97\u505A\u597D\u51C6\u5907\u3002"
    - pageNumber: 10
      speakerName: "\u5468\u781A"
      text: "\u5982\u679C\u6700\u540E\u53D1\u73B0\u4F60\u662F\u4E00\u4E2A\u65E0\u6CD5\u88AB\u6D88\u5316\u7684\u53D8\u91CF\uFF0C\u6211\u53EF\u662F\u4F1A\u2026\u2026\u628A\u4F60\u62C6\u89E3\u5F97\u4E00\u70B9\u4E0D\u5269\u7684\u3002"
    choices: []
  - documentId: "M2-2-2a\u6C88"
    title: "M2-2-2a\u6C88"
    sourceAssetPath: "Assets/content1/M2/M2-2-2a\u6C88.docx"
