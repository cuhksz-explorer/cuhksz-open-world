    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u76F4\u63A5\u4F38\u624B\u63E1\u4F4F\u4E86\u4ED6\u90A3\u53EA\u653E\u5728\u684C\u4E0A\u3001\u5FAE\u5FAE\u53D1\u6296\u7684\u624B\uFF0C\u6307\u5C16\u63D2\u8FDB\u4ED6\u7684\u6307\u7F1D\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u201C\u6C88\u9752\u79BE\uFF0C\u4E0D\u7528\u518D\u5199\u4EC0\u4E48\u8BB0\u5F55\u4E86\u3002\u6211\u4E5F\u60F3\u8DDF\u4F60\u5728\u4E00\u8D77\uFF0C\u4E0D\u4EC5\u4EC5\u662F\u5728\u5B9E\u9A8C\u5BA4\u91CC\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u6C88\u9752\u79BE\u53CD\u624B\u63E1\u5F97\u6781\u7D27\uFF0C\u4F4E\u58F0\u56DE\u4E86\u4E00\u53E5\uFF1A\u201C\u597D\uFF0C\u8BF4\u8BDD\u7B97\u8BDD\u3002\u201D"
