    finishLocationName: "\u4E0A\u56ED\u5BBF\u820D\u533A"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u4E0D\uFF0C\u6211\u4E0D\u80FD\u505C\u3002\u6C88\u9752\u79BE\uFF0C\u5E2E\u6211\u770B\u770B\u8FD9\u4E2A\u903B\u8F91\u6F0F\u6D1E\u3002\u53EA\u8981\u89E3\u5F00\u8FD9\u4E00\u5173\uFF0C\u6211\u5C31\u80FD\u7761\u4E2A\u5B89\u7A33\u89C9\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u6C89\u9ED8\u4E86\u7247\u523B\u3002\u4ED6\u90A3\u53CC\u6DF1\u9083\u7684\u773C\u775B\u91CC\u95EA\u8FC7\u4E00\u4E1D\u590D\u6742\u7684\u60C5\u7EEA\uFF0C\u4F3C\u4E4E\u60F3\u529D\u963B\uFF0C\u4F46\u6700\u7EC8\u4ED6\u53EA\u662F\u62C9\u8FD1\u4E86\u6905\u5B50\u3002"
    - pageNumber: 3
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u65E2\u7136\u8FD9\u662F\u4F60\u7684\u8BA1\u7B97\u7ED3\u679C\uFF0C\u90A3\u5C31\u6491\u4F4F\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6C88\u9752\u79BE\u62FF\u51FA\u4E86\u81EA\u5DF1\u7684\u5E73\u677F\uFF0C\u5728\u6797\u6E21\u7684\u4EE3\u7801\u65C1\u5212\u51FA\u51E0\u9053\u51CC\u5389\u7684\u7EA2\u7EBF\u3002\u4ED6\u7684\u6307\u5C16\u5076\u5C14\u78B0\u5230\u6797\u6E21\u7684\u624B\u80CC\uFF0C\u6E29\u5EA6\u51B7\u5F97\u60CA\u4EBA\u3002"
    - pageNumber: 5
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u7B2C\u4E09\u884C\u548C\u7B2C\u4E03\u884C\u903B\u8F91\u51B2\u7A81\u3002\u65E2\u7136\u8981\u6297\uFF0C\u5C31\u522B\u5E26\u60C5\u7EEA\uFF0C\u628A\u5927\u8111\u5F53\u6210\u5904\u7406\u5668\uFF0C\u53EA\u8FD0\u884C\u903B\u8F91\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u63A5\u4E0B\u6765\u7684\u4E09\u4E2A\u5C0F\u65F6\uFF0C\u6797\u6E21\u611F\u5230\u4E16\u754C\u5728\u8FDC\u53BB\u3002\u5979\u7684\u611F\u5B98\u5728\u6536\u7F29\uFF0C\u53EA\u5269\u4E0B\u5C4F\u5E55\u4E0A\u7684\u6570\u5B57\u548C\u6C88\u9752\u79BE\u51B0\u51B7\u3001\u7CBE\u51C6\u7684\u6307\u4EE4\u3002\u5979\u7684\u592A\u9633\u7A74\u9690\u9690\u4F5C\u75DB\uFF0C\u63E1\u7740\u9F20\u6807\u7684\u624B\u5F00\u59CB\u8F7B\u5FAE\u98A4\u6296\u3002"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u89E3\u5F00\u4E86\u3002\u4F46\u6797\u6E21\uFF0C\u4F60\u7684\u5FC3\u7387\u5F88\u5FEB\uFF0C\u547C\u5438\u9891\u7387\u4E5F\u4E0D\u5BF9\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u6CA1\u4E8B\u2026\u2026\u6211\u8D62\u4E86\uFF0C\u4E0D\u662F\u5417\uFF1F"
    - pageNumber: 9
      speakerName: 
      text: "\u6797\u6E21\u770B\u7740\u8DD1\u901A\u7684\u7A0B\u5E8F\uFF0C\u8138\u4E0A\u9732\u51FA\u4E00\u62B9\u60E8\u767D\u7684\u5FAE\u7B11\u3002\u6C88\u9752\u79BE\u770B\u7740\u5979\uFF0C\u7709\u5934\u5FAE\u5FAE\u76B1\u8D77\uFF0C\u773C\u795E\u91CC\u900F\u51FA\u4E00\u79CD\u62C5\u5FE7\uFF0C\u4F46\u4ED6\u6700\u7EC8\u53EA\u662F\u9012\u7ED9\u5979\u4E00\u5F20\u6E7F\u7EB8\u5DFE\u3002"
    - pageNumber: 10
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u4F60\u6CA1\u8D62\uFF0C\u4F60\u53EA\u662F\u9884\u652F\u4E86\u660E\u5929\u7684\u4F53\u529B\u3002\u8D70\u5427\uFF0C\u6211\u9001\u4F60\u56DE\u5BBF\u820D\u3002"
    choices: []
  - documentId: M1-3-3
