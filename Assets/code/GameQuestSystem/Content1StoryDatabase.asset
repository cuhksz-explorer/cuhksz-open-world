    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u5B8C\u5168\u4E0D\u6309\u5957\u8DEF\u51FA\u724C\uFF0C\u653E\u5F03\u4E86\u590D\u6742\u7684\u8FDE\u62DB\uFF0C\u5F00\u59CB\u75AF\u72C2\u6309\u540C\u4E00\u4E2A\u201C\u4E0B\u8E72\u626B\u817F\u201D\u7684\u57FA\u7840\u6309\u952E\u3002\u8FD9\u62DB\u867D\u7136\u4F24\u5BB3\u4F4E\uFF0C\u4F46\u6781\u5176\u8D56\u76AE\uFF0C\u4E13\u7834\u5468\u781A\u7684\u8D77\u624B\u5F0F\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u770B\u7740\u81EA\u5DF1\u7684\u89D2\u8272\u88AB\u6797\u6E21\u7528\u540C\u4E00\u62DB\u8FDE\u7EED\u7ECA\u5012\u4E09\u6B21\uFF0C\u5468\u781A\u7EC8\u4E8E\u5FCD\u4E0D\u4F4F\u8F6C\u8FC7\u5934\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF01\u4F60\u6562\u4E0D\u6562\u6362\u4E2A\u6309\u952E\uFF1F\u8FD9\u7B97\u4EC0\u4E48\u6253\u6CD5\uFF1F\u201D"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u201C\u4E0D\u7BA1\u62DB\u5F0F\u591A\u8001\u5957\uFF0C\u7BA1\u7528\u5C31\u884C\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u7B11\u7740\u56DE\u7B54\u9053\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u88AB\u8FD9\u79CD\u6BEB\u65E0\u6280\u672F\u542B\u91CF\u7684\u201C\u6D41\u6C13\u6253\u6CD5\u201D\u6C14\u7B11\u4E86\u3002\u5979\u5F7B\u5E95\u629B\u5F00\u4E86\u5E73\u65F6\u7684\u7A33\u91CD\uFF0C\u5F00\u59CB\u5728\u673A\u53F0\u4E0A\u8DDF\u6797\u6E21\u4E92\u76F8\u201C\u4E71\u6309\u201D\u6597\u6C14\uFF0C\u4E24\u4EBA\u7B11\u4F5C\u4E00\u56E2\uFF0C\u6C14\u6C1B\u53D8\u5F97\u6781\u5176\u8F7B\u677E\u81EA\u7136\u3002"
    choices: []
  - documentId: "M2-4-2a\u6C88"
