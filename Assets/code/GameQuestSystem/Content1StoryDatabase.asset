    finishLocationName: "\u4EBA\u5DE5\u667A\u80FD\u7CFB\u529E\u516C\u697C"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u9662\u529E\u6863\u6848\u5BA4\u7684\u95E8\u534A\u63A9\u7740\u3002\u6797\u6E21\u62FF\u7740\u7533\u8BF7\u8868\u8D70\u8FC7\u53BB\u65F6\uFF0C\u6B63\u542C\u5230\u540C\u95E8\u9646\u660E\u7684\u58F0\u97F3\u3002"
    - pageNumber: 2
      speakerName: "\u9646\u660E"
      text: "\u738B\u8001\u5E08\uFF0C\u90A3\u8FD9\u4EFD\u6750\u6599\u5C31\u8F9B\u82E6\u60A8\u5F52\u6863\u4E86\u3002\u8FD9\u5468\u672B\u6211\u7238\u8BF4\u8BF7\u9648\u6559\u6388\u53BB\u90CA\u533A\u7684\u5EA6\u5047\u6751\u6563\u6563\u5FC3\uFF0C\u987A\u4FBF\u8C08\u8C08\u4E0B\u4E2A\u5B63\u5EA6\u4E91\u670D\u52A1\u5668\u7684\u7EED\u8D39\uFF0C\u60A8\u4E5F\u4E00\u8D77\u53BB\u5427\u3002"
    - pageNumber: 3
      speakerName: "\u738B\u8001\u5E08"
      text: "\u884C\u4E86\uFF0C\u4F60\u7684\u540D\u5355\u6211\u90FD\u6392\u597D\u4E86\u3002\u4F60\u8D76\u7D27\u56DE\u53BB\u51C6\u5907\u4E0B\u5468\u7684\u8FDB\u7EC4\u6750\u6599\uFF0C\u5230\u4E86\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u8DDF\u7740\u5B66\u957F\u6DF7\u6DF7\u7ECF\u9A8C\uFF0C\u522B\u7ED9\u9648\u6559\u6388\u60F9\u4E8B\u5C31\u884C\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u9646\u660E\u63A8\u95E8\u51FA\u6765\uFF0C\u8FCE\u9762\u649E\u89C1\u6797\u6E21\uFF0C\u8868\u60C5\u7A0D\u5FAE\u50F5\u786C\u4E86\u4E00\u4E0B\uFF0C\u6577\u884D\u5730\u6253\u4E86\u4E2A\u62DB\u547C\u4FBF\u5306\u5306\u79BB\u5F00\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u8868\u5934\u662F\u201C\u56FD\u5BB6\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u63A8\u8350\u6C47\u603B\uFF08\u7EC8\u7A3F\uFF09\u201D\uFF0C\u552F\u4E00\u7684\u540D\u989D\u90A3\u4E00\u680F\uFF0C\u8D6B\u7136\u5370\u7740\u9646\u660E\u7684\u540D\u5B57\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u738B\u8001\u5E08\uFF0C\u9648\u5BFC\u521A\u624D\u8BF4\u540D\u5355\u660E\u65E9\u624D\u5B9A\u3002"
    - pageNumber: 7
      speakerName: "\u738B\u8001\u5E08"
      text: "\u54E6\uFF0C\u8FD9\u4E2A\u662F\u9884\u6392\u7248\u3002\u6797\u6E21\u554A\uFF0C\u80FD\u5199\u51E0\u4E2A\u597D\u7528\u7684\u63D2\u4EF6\u5DE5\u5177\u633A\u597D\uFF0C\u4F46\u662F\u53BB\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u66F4\u770B\u91CD\u5B66\u751F\u7684\u7EFC\u5408\u8D44\u6E90\u6574\u5408\u80FD\u529B\u3002\u8868\u683C\u653E\u8FD9\u5427\uFF0C\u6709\u6D88\u606F\u4F1A\u901A\u77E5\u4F60\u7684\u3002"
    choices:
    - label: "\u8C08\u5224\u535A\u5F08"
      targetDocumentId: M4-2-3a
    - label: "\u786C\u521A\u5230\u5E95"
      targetDocumentId: M4-2-3b
