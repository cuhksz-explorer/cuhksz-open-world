    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u62FF\u8D77\u7B14\uFF0C\u5728\u9009\u5B9A\u7684\u90A3\u4EFD\u610F\u5411\u4E66\u4E0A\u7B7E\u4E0B\u4E86\u81EA\u5DF1\u7684\u540D\u5B57\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u65E2\u7136\u505A\u51FA\u4E86\u9009\u62E9\uFF0C\u5C31\u6CA1\u5FC5\u8981\u56DE\u5934\u770B\u4E86\u3002"
    - pageNumber: 3
      speakerName: "\u695A\u5929"
      text: "\u795D\u4F60\u597D\u8FD0\uFF0C\u5E0C\u671B\u4E0B\u4E2A\u5B66\u671F\u5F00\u5B66\u7684\u65F6\u5019\uFF0C\u4F60\u8FD8\u6CA1\u88AB\u8FD9\u4E24\u79CD\u751F\u6D3B\u91CC\u7684\u4EFB\u4F55\u4E00\u79CD\u7ED9\u538B\u57AE\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5B66\u6821\u5927\u793C\u5802\u5916 / \u4E0A\u5348 08:30"
    - pageNumber: 5
      speakerName: 
      text: "\u793C\u5802\u5916\u7684\u7535\u5B50\u5C4F\u4E0A\u6EDA\u52A8\u7740\u201C\u521B\u6295\u676F\u201D\u51B3\u8D5B\u7684\u540D\u5355\u3002\u7A7A\u6C14\u91CC\u900F\u7740\u4E00\u79CD\u53EA\u6709\u5728\u5927\u578B\u8D5B\u4E8B\u5F53\u5929\u624D\u4F1A\u6709\u7684\u7D27\u7EF7\u611F\u3002\u6797\u6E21\u7684\u624B\u673A\u5907\u5FD8\u5F55\u91CC\u585E\u6EE1\u4E86\u65E5\u7A0B\u63D0\u9192\uFF0C\u4E09\u4E2A\u65F6\u95F4\u8282\u70B9\u50CF\u4E09\u5EA7\u5927\u5C71\u4E00\u6837\u538B\u5728\u8FD9\u4E00\u5929\u7684\u523B\u5EA6\u8868\u4E0A\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u793C\u5802\u5185\u7684\u51B7\u6C14\u5F00\u5F97\u5F88\u8DB3\uFF0C\u6797\u6E21\u548C\u961F\u53CB\u4EEC\u7AD9\u5728\u540E\u53F0\uFF0C\u80FD\u6E05\u695A\u5730\u542C\u5230\u524D\u53F0\u8BC4\u59D4\u7280\u5229\u7684\u63D0\u95EE\u58F0\u3002"
    - pageNumber: 7
      speakerName: "\u695A\u5929"
      text: "\u521A\u624D\u90A3\u4E00\u7EC4\u88AB\u95EE\u5230\u4E86\u6A21\u578B\u7684\u53EF\u89E3\u91CA\u6027\u95EE\u9898\uFF0C\u76F4\u63A5\u54D1\u706B\u4E86\u3002\u6797\u6E21\uFF0C\u5F85\u4F1A\u5982\u679C\u6709\u4EBA\u63EA\u7740\u6211\u4EEC\u65E0\u76D1\u7763\u5B66\u4E60\u7684\u9ED1\u76D2\u903B\u8F91\u4E0D\u653E\uFF0C\u4F60\u6253\u7B97\u600E\u4E48\u63A5\uFF1F"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4F1A\u628A\u91CD\u70B9\u653E\u5728\u7ED3\u679C\u7684\u9C81\u68D2\u6027\u4E0A\u3002\u53EA\u8981\u805A\u7C7B\u7684\u4E1A\u52A1\u903B\u8F91\u80FD\u81EA\u6D3D\uFF0C\u5185\u90E8\u7684\u6743\u91CD\u5206\u914D\u53EF\u4EE5\u4F5C\u4E3A\u540E\u7EED\u4F18\u5316\u7684\u65B9\u5411\uFF0C\u800C\u4E0D\u662F\u5F53\u4E0B\u7684\u963B\u788D\u3002\u590F\u6797\uFF0C\u4EA4\u4E92\u6F14\u793A\u51C6\u5907\u597D\u4E86\u5417\uFF1F"
    - pageNumber: 9
      speakerName: "\u590F\u6797"
      text: "\u653E\u5FC3\uFF0C\u5B9E\u65F6\u70ED\u529B\u56FE\u5DF2\u7ECF\u6302\u8F7D\u597D\u4E86\uFF0C\u53EA\u8981\u4F60\u4E00\u53D1\u6307\u4EE4\uFF0C\u6211\u5C31\u76F4\u63A5\u6295\u5C4F\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u5404\u4F4D\uFF0C\u8D70\u5230\u8FD9\u4E00\u6B65\u4E0D\u5BB9\u6613\u3002\u5F85\u4F1A\u4E0A\u53BB\uFF0C\u5C31\u6309\u6211\u4EEC\u6392\u7EC3\u6700\u7A33\u7684\u90A3\u4E00\u7248\u6765\u3002"
    choices: []
