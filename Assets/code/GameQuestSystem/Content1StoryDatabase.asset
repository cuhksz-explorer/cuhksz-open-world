    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u8D70\u4E0A\u524D\uFF0C\u81EA\u7136\u5730\u4F38\u51FA\u624B\uFF0C\u5E2E\u4ED6\u7406\u4E86\u7406\u65B0\u8863\u670D\u7684\u62BD\u7EF3\uFF0C\u987A\u4FBF\u628A\u4ED6\u7684\u9886\u53E3\u629A\u5E73\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u201C\u8FD9\u4EF6\u5F88\u9002\u5408\u4F60\uFF0C\u6C88\u9752\u79BE\u3002\u522B\u603B\u7A7F\u90A3\u4E9B\u7070\u7070\u9ED1\u9ED1\u7684\uFF0C\u5076\u5C14\u8FD9\u6837\u770B\u8D77\u6765\u2026\u2026\u5F88\u6709\u671D\u6C14\u3002\u522B\u52A8\uFF0C\u9886\u5B50\u7FFB\u8FDB\u53BB\u4E86\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u6C88\u9752\u79BE\u6574\u4E2A\u4EBA\u5C4F\u4F4F\u4E86\u547C\u5438\uFF0C\u50F5\u5728\u90A3\u91CC\u4E00\u52A8\u4E0D\u52A8\uFF0C\u50CF\u4E2A\u88AB\u5B9A\u683C\u7684\u77F3\u50CF\u3002\u4ED6\u80FD\u95FB\u5230\u6797\u6E21\u8EAB\u4E0A\u6DE1\u6DE1\u7684\u6D17\u53D1\u6C34\u5473\uFF0C\u773C\u795E\u6839\u672C\u4E0D\u6562\u548C\u6797\u6E21\u5BF9\u89C6\uFF0C\u53EA\u662F\u76EF\u7740\u811A\u5C16\uFF0C\u5C0F\u58F0\u8BF4\uFF1A\u201C\u2026\u2026\u4F60\u89C9\u5F97\u597D\u770B\u5C31\u884C\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u6C88\u9752\u79BE\u5728\u5FC3\u91CC\u9ED8\u9ED8\u8BB0\u4E0B\u4E86\u8FD9\u4EF6\u8863\u670D\u7684\u89E6\u611F\u3002\u5728\u4ED6\u539F\u672C\u53EA\u6709\u9ED1\u767D\u7070\u7684\u4E16\u754C\u91CC\uFF0C\u7B2C\u4E00\u6B21\u88AB\u6D82\u4E0A\u4E86\u4E00\u79CD\u660E\u4EAE\u7684\u989C\u8272\u3002"
    choices: []
  - documentId: "M2-3-2b\u6C88"
