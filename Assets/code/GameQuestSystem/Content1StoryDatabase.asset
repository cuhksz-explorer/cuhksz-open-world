    - pageNumber: 2
      speakerName: 
      text: "\u5979\u5927\u53E3\u5598\u7740\u6C14\uFF0C\u6C57\u6C34\u6D78\u900F\u4E86\u886C\u886B\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u624B\u673A\u9707\u52A8\u4E86\u4E00\u4E0B\uFF0C\u662F\u6210\u7EE9\u67E5\u8BE2\u7CFB\u7EDF\u53D1\u6765\u7684\u90AE\u4EF6\u901A\u77E5\uFF1A\u201C\u60A8\u7684\u671F\u4E2D\u6210\u7EE9\u5355\u5DF2\u751F\u6210\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u770B\u7740\u5C4F\u5E55\uFF0C\u5FC3\u8DF3\u9010\u6E10\u5E73\u7A33\u3002"
    - pageNumber: 5
      speakerName: "\u5979\u7B2C\u4E00\u6B21\u6DF1\u523B\u5730\u610F\u8BC6\u5230"
      text: "\u6210\u7EE9\u5355\u4F1A\u8BF4\u8BDD\uFF0C\u4F46\u5B83\u6C38\u8FDC\u4E0D\u4F1A\u8BF4\u771F\u8BDD\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5B83\u662F\u8FD9\u4E2A\u7CFB\u7EDF\u7684\u6CE8\u811A\uFF0C\u5374\u4E0D\u5E94\u8BE5\u662F\u5979\u4EBA\u751F\u7684\u6807\u9898\u3002"
    choices: []
  - documentId: M1-5-1
