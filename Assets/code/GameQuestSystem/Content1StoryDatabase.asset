    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u884C\u653F\u697C 304 \u7814\u8BA8\u5BA4 / \u4E0B\u5348 14:00"
    - pageNumber: 2
      speakerName: 
      text: "\u695A\u5929\u76EF\u7740\u5C4F\u5E55\u4E0A\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u6570\u636E\u96C6\uFF0C\u7709\u5934\u7D27\u9501\u3002\u4ED6\u662F\u7EDF\u8BA1\u7CFB\u51FA\u4E86\u540D\u7684\u6781\u5BA2\uFF0C\u88AB\u6797\u6E21\u62C9\u6765\u8D1F\u8D23\u6570\u636E\u6E05\u6D17\u548C\u5E95\u5C42\u67B6\u6784\u3002"
    - pageNumber: 3
      speakerName: "\u695A\u5929"
      text: "\u8FD9\u6279\u5F00\u6E90\u7684\u7528\u6237\u884C\u4E3A\u6570\u636E\u592A\u6742\u4E86\uFF0C\u7F3A\u5931\u503C\u5F88\u591A\u3002\u5982\u679C\u6211\u4EEC\u5F3A\u884C\u505A\u5206\u7C7B\uFF0C\u8DD1\u51FA\u6765\u7684\u8BEF\u5DEE\u7387\u4F1A\u9AD8\u5F97\u79BB\u8C31\uFF0C\u5230\u65F6\u5019\u8FDE\u521D\u5BA1\u90FD\u8FC7\u4E0D\u4E86\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u6240\u4EE5\u6211\u4EEC\u524D\u671F\u4E0D\u9884\u8BBE\u6807\u7B7E\u3002\u65E2\u7136\u673A\u5668\u5B66\u4E60\u5305\u542B\u4E86\u65E0\u76D1\u7763\u5B66\u4E60\u8FD9\u4E2A\u5927\u7C7B\uFF0C\u6211\u4EEC\u5C31\u76F4\u63A5\u8D70\u805A\u7C7B\u5206\u6790\u7684\u8DEF\u7EBF\uFF0C\u8BA9\u7B97\u6CD5\u81EA\u5DF1\u53BB\u6293\u53D6\u6F5C\u5728\u7684\u7279\u5F81\u5173\u8054\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u6570\u636E\u7684\u5C40\u90E8\u5207\u5272\u548C\u6E05\u6D17\u4EA4\u7ED9\u4F60\uFF0C\u53EA\u8981\u5E95\u5EA7\u5E72\u51C0\uFF0C\u540E\u7EED\u7684\u6A21\u578B\u5C31\u4E0D\u4F1A\u5D29\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u590F\u6797\u5728\u65C1\u8FB9\u6572\u7740\u6570\u4F4D\u677F\uFF0C\u5979\u662F\u4EA4\u4E92\u8BBE\u8BA1\u4E13\u4E1A\u7684\uFF0C\u8D1F\u8D23\u628A\u6570\u636E\u6A21\u578B\u8F6C\u5316\u4E3A\u76F4\u89C2\u7684\u53EF\u89C6\u5316\u56FE\u8868\u3002"
    - pageNumber: 7
      speakerName: "\u590F\u6797"
      text: "\u65E0\u76D1\u7763\u805A\u7C7B\u7684\u7ED3\u679C\u6211\u53EF\u4EE5\u7528\u52A8\u6001\u6563\u70B9\u56FE\u548C\u70ED\u529B\u56FE\u505A\u51FA\u6765\u3002\u4F46\u8BF4\u5B9E\u8BDD\uFF0C\u8FD9\u5957\u6280\u672F\u65B9\u6848\u592A\u786C\u6838\u4E86\u3002\u8BC4\u59D4\u7EC4\u91CC\u6709\u4E00\u534A\u662F\u5546\u5B66\u9662\u7684\u6559\u6388\u548C\u5916\u8058\u6295\u8D44\u4EBA\uFF0C\u4ED6\u4EEC\u4E0D\u60F3\u542C\u7B97\u6CD5\u63A8\u5BFC\uFF0C\u8C01\u6765\u7ED9\u4ED6\u4EEC\u8BB2\u8FD9\u5957\u6A21\u578B\u80FD\u89E3\u51B3\u4EC0\u4E48\u5B9E\u9645\u95EE\u9898\uFF1F"
    - pageNumber: 8
      speakerName: 
      text: "\u7814\u8BA8\u5BA4\u7684\u95E8\u88AB\u63A8\u5F00\uFF0C\u5927\u4E09\u7684\u5B59\u54F2\u62CE\u7740\u7535\u8111\u5305\u8D70\u8FDB\u6765\u3002\u4ED6\u662F\u5546\u5B66\u9662\u7684\u8FA9\u8BBA\u961F\u961F\u957F\u3002"
    - pageNumber: 9
      speakerName: "\u6797\u6E21"
      text: "\u8DDD\u79BB\u521D\u7A3F\u622A\u6B62\u8FD8\u6709\u4E0D\u5230\u4E09\u5929\u3002\u695A\u5929\u5361\u4F4F\u6570\u636E\u6E90\uFF0C\u590F\u6797\u505A\u524D\u7AEF\u56FE\u8868\uFF0C\u5B59\u54F2\u660E\u665A\u4EA4\u7B2C\u4E00\u7248\u5546\u4E1A\u8BA1\u5212\u4E66\u548C\u8DEF\u6F14\u7A3F\u3002\u65F6\u95F4\u5F88\u7D27\uFF0C\u5927\u5BB6\u8FD9\u51E0\u5929\u968F\u65F6\u4FDD\u6301\u5728\u7EBF\u3002"
    choices: []
