    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u5927\u65B9\u5730\u628A\u5E73\u677F\u63A8\u56DE\u53BB\uFF0C\u62FF\u676F\u5B50\u8F7B\u8F7B\u78B0\u4E86\u4E00\u4E0B\u4ED6\u7684\u624B\u81C2\uFF0C\u7B11\u5F97\u707F\u70C2\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u201C\u65E2\u7136\u4EE3\u7801\u90FD\u5199\u4E86\u6211\u7684\u540D\u5B57\uFF0C\u90A3\u4EE5\u540E\u6211\u7684\u9EBB\u70E6\u4F60\u53EF\u5F97\u7BA1\u3002\u6C88\u9752\u79BE\uFF0C\u80FD\u6709\u4F60\u8FD9\u4E48\u4E2A\u61C2\u6211\u7684\u642D\u6863\uFF0C\u611F\u89C9\u771F\u4E0D\u9519\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u6C88\u9752\u79BE\u5148\u662F\u6123\u4E86\u4E00\u79D2\uFF0C\u968F\u5373\u9732\u51FA\u4E00\u4E2A\u91CA\u7136\u4E14\u6E29\u67D4\u7684\u7B11\uFF0C\u70B9\u5934\u9053\uFF1A\u201C\u53EA\u8981\u4F60\u9700\u8981\uFF0C\u6211\u4E00\u76F4\u90FD\u5728\u3002\u201D"
    choices: []
  - documentId: M2-4-3
