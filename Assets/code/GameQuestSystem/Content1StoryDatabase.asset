    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u4E0A\u5348\u5341\u70B9\uFF0C\u5B66\u52E4\u4E66\u9662\u5BBF\u820D\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u56DB\u53F0\u7B14\u8BB0\u672C\u7535\u8111\u540C\u65F6\u4EAE\u7740\uFF0C\u539F\u672C\u70ED\u95F9\u7684\u5BBF\u820D\u9677\u5165\u4E86\u4E00\u79CD\u8BE1\u5F02\u7684\u6B7B\u5BC2\u3002\u7A97\u5916\uFF0C\u51E4\u51F0\u6728\u7684\u53F6\u5B50\u88AB\u98CE\u5439\u5F97\u6C99\u6C99\u54CD\uFF0C\u5374\u63A9\u76D6\u4E0D\u4F4F\u5BA4\u5185\u6025\u4FC3\u7684\u547C\u5438\u58F0\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u201C\u6210\u7EE9\u67E5\u8BE2\u201D\u90A3\u4E2A\u84DD\u8272\u7684\u6309\u94AE\uFF0C\u6B64\u523B\u50CF\u662F\u901A\u5F80\u5929\u5802\u6216\u5730\u72F1\u7684\u673A\u5173\u3002"
    - pageNumber: 4
      speakerName: "\u82CF\u6C90"
      text: "\u6211\u2026\u2026\u6211\u4E0D\u6562\u70B9\u3002\u5982\u679C\u90A3\u95E8\u4F1A\u8BA1\u6CA1\u53CA\u683C\uFF0C\u6211\u4E0B\u5B66\u671F\u7684\u5956\u5B66\u91D1\u5C31\u5F7B\u5E95\u6CA1\u620F\u4E86\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u82CF\u6C90\u8737\u7F29\u5728\u6905\u5B50\u91CC\uFF0C\u624B\u6307\u5728\u89E6\u63A7\u677F\u4E0A\u60AC\u505C\u4E86\u5F88\u4E45\uFF0C\u6700\u7EC8\u95ED\u4E0A\u773C\u72E0\u72E0\u5730\u6309\u4E86\u4E0B\u53BB\u3002"
    - pageNumber: 6
      speakerName: "\u82CF\u6C90"
      text: "\u547C\u2026\u20263.1\u3002\u8C22\u5929\u8C22\u5730\uFF0C\u6211\u5C45\u7136\u6D3B\u4E0B\u6765\u4E86\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u8D75\u6893\u7487\u8F6C\u5934\u770B\u5411\u6797\u6E21\uFF0C\u8BED\u6C14\u91CC\u5E26\u7740\u4E00\u4E1D\u82E5\u6709\u82E5\u65E0\u7684\u8BD5\u63A2\u3002"
    - pageNumber: 8
      speakerName: "\u6881\u5609\u4E00"
      text: "3.95\u3002\u8FD8\u662F\u5DEE\u4E00\u70B9\u3002"
    - pageNumber: 9
      speakerName: "\u6797\u6E21"
      text: "\u6211\u7684\u4E5F\u51FA\u6765\u4E86\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u770B\u7740\u5C4F\u5E55\u3002\u90A3\u4E00\u4E32\u6570\u5B57\u5728\u7ECF\u5386\u8FC7\u201C\u5747\u5206\u5E7B\u5F71\u201D\u7684\u535A\u5F08\u540E\uFF0C\u4F3C\u4E4E\u53D8\u5F97\u4E0D\u518D\u90A3\u4E48\u523A\u773C\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u624B\u673A\u9707\u52A8\u3002\u6C88\u9752\u79BE\u7684\u4FE1\u606F\u5982\u7EA6\u800C\u81F3\u3002"
    - pageNumber: 12
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5206\u62FF\u5230\u4E86\uFF1F"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u62FF\u5230\u4E86\u30023.x\u3002"
    - pageNumber: 14
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6BD4\u6211\u9884\u60F3\u7684\u9AD8\u4E00\u70B9\u3002\u8FD9\u610F\u5473\u7740\u4F60\u8FD8\u6CA1\u88AB\u90A3\u95E8\u602A\u8BFE\u62D6\u57AE\u3002"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u4F46\u300A\u96F6\u53F7\u8BFE\u7A0B\u300B\u6CA1\u6709\u51FA\u5206\uFF0C\u8FD9\u6B63\u5E38\u5417\uFF1F"
    - pageNumber: 16
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u4E0D\u6B63\u5E38\u624D\u662F\u6B63\u5E38\u7684\u3002\u8FD9\u610F\u5473\u7740\u4F60\u8FD8\u6CA1\u901A\u8FC7\u5B83\u7684\u201C\u6700\u7EC8\u9608\u503C\u201D\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u8FD8\u6CA1\u7B49\u6797\u6E21\u56DE\u590D\uFF0C\u5C4F\u5E55\u7A81\u7136\u88AB\u4E00\u4E2A\u65B0\u7684\u6765\u7535\u754C\u9762\u8986\u76D6\u3002\u6765\u7535\u4EBA\uFF1A\u5468\u781A\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u8FD9\u662F\u6797\u6E21\u62A5\u5230\u4EE5\u6765\uFF0C\u7B2C\u4E00\u6B21\u63A5\u5230\u8FD9\u4F4D\u793E\u4EA4\u6838\u5FC3\u7684\u6B63\u5F0F\u7535\u8BDD\u3002"
    - pageNumber: 19
      speakerName: "\u6797\u6E21"
      text: "\u5582\uFF1F"
    - pageNumber: 20
      speakerName: "\u5468\u781A"
      text: "\u6210\u7EE9\u51FA\u6765\u4E86\uFF1F\u522B\u7D27\u5F20\uFF0C\u6211\u4E0D\u662F\u6765\u67E5\u5C97\u7684\u3002"
    - pageNumber: 21
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u6211\u770B\u5230\u4E86\u4F60\u5728\u5C0F\u7EC4\u4F5C\u4E1A\u7B54\u8FA9\u65F6\u7684\u8868\u73B0\u3002\u867D\u7136\u5206\u6570\u4E0D\u662F\u5168\u9662\u7B2C\u4E00\uFF0C\u4F46\u4F60\u7684\u601D\u7EF4\u65B9\u5F0F\u5F88\u7279\u522B\u3002"
    - pageNumber: 22
      speakerName: "\u5468\u781A"
      text: "\u4F60\u73B0\u5728\u7684\u5206\uFF0C\u591F\u4E0D\u591F\u8FDB\u66F4\u5927\u7684\u5C40\uFF1F"
    - pageNumber: 23
      speakerName: "\u6797\u6E21"
      text: "\u4EC0\u4E48\u610F\u601D\uFF1F"
    - pageNumber: 24
      speakerName: "\u5468\u781A"
      text: "\u5982\u679C\u4F60\u53EA\u76EF\u7740\u90A3\u5F20\u7EB8\u4E0A\u7684\u6570\u5B57\uFF0C\u4F60\u9876\u591A\u53EA\u80FD\u6210\u4E3A\u4E00\u4E2A\u9AD8\u7EA7\u96F6\u4EF6\u3002\u4F46\u5982\u679C\u4F60\u60F3\u6210\u4E3A\u90A3\u4E2A\u8BBE\u8BA1\u673A\u5668\u7684\u4EBA\uFF0C\u4F60\u9700\u8981\u4E00\u4E9B\u6210\u7EE9\u5355\u7ED9\u4E0D\u4E86\u4F60\u7684\u4E1C\u897F\u3002"
    - pageNumber: 25
      speakerName: 
      text: "\u7535\u8BDD\u90A3\u5934\u7684\u58F0\u97F3\u505C\u987F\u4E86\u4E00\u4E0B\uFF0C\u5E26\u7740\u4E00\u79CD\u6210\u719F\u4E14\u5371\u9669\u7684\u5438\u5F15\u529B\u3002"
    - pageNumber: 26
      speakerName: "\u5468\u781A"
      text: "\u4F60\u6709\u6F5C\u529B\u3002\u4F46\u4F60\u8FD8\u6CA1\u5F00\u59CB\u5B66\u4F1A\u5982\u4F55\u4F7F\u7528\u5B83\u3002"
    - pageNumber: 27
      speakerName: "\u5468\u781A"
      text: "\u660E\u5929\u4E0B\u5348\u56DB\u70B9\uFF0C\u884C\u653F\u697C\u9876\u5C42\u5496\u5561\u5385\u3002\u6211\u6709\u4EFD\u6709\u8DA3\u7684\u9879\u76EE\u5EFA\u8BAE\u4E66\uFF0C\u53EA\u7ED9\u90A3\u4E9B\u6562\u4E8E\u5728\u6EE1\u5206\u4E4B\u5916\u5BFB\u627E\u7B54\u6848\u7684\u4EBA\u770B\u3002"
    - pageNumber: 28
      speakerName: 
      text: "\u7535\u8BDD\u6302\u65AD\u4E86\u3002\u6797\u6E21\u62AC\u5934\u770B\u5411\u5BBF\u820D\u7684\u7A97\u5916\uFF0C\u5915\u9633\u6B63\u628A\u77E5\u65B0\u697C\u7684\u526A\u5F71\u62C9\u5F97\u6781\u957F\u3002"
    - pageNumber: 29
      speakerName: 
      text: "\u7B2C\u4E00\u7AE0\u7684\u785D\u70DF\u6B63\u5728\u6563\u53BB\uFF0C\u4F46\u771F\u6B63\u7684\u98CE\u66B4\u4F3C\u4E4E\u624D\u521A\u521A\u915D\u917F\u3002"
    - pageNumber: 30
      speakerName: "\u3010\u7B2C\u4E00\u7AE0"
      text: "\u5B8C\u3011"
    choices: []
