    - pageNumber: 2
      speakerName: "\u82CF\u7136"
      text: "\u6797\u6E21\uFF0C\u4F60\u73B0\u5728\u4EBA\u5728\u54EA\uFF1F\u51FA\u5927\u9EBB\u70E6\u4E86\u3002"
    - pageNumber: 3
      speakerName: "\u82CF\u7136"
      text: "\u6211\u7684\u90A3\u4E2A\u201C\u5927\u5B66\u751F\u9690\u6027\u793E\u4EA4\u9694\u79BB\u8C03\u67E5\u201D\u7684\u56FD\u521B\u9879\u76EE\uFF0C\u4ECA\u5929\u4E0B\u5348\u521A\u4EA4\u4E0A\u53BB\uFF0C\u5C31\u88AB\u6821\u5B66\u672F\u59D4\u5458\u4F1A\u7684\u8BC4\u5BA1\u7EC4\u5361\u4F4F\u4E86\uFF0C\u8FD8\u53D1\u4E86\u7591\u4F3C\u5B66\u672F\u4E0D\u7AEF\u7684\u542C\u8BC1\u901A\u77E5\u3002"
    - pageNumber: 4
      speakerName: "\u82CF\u7136"
      text: "\u4ED6\u4EEC\u8BF4\u7533\u62A5\u4E66\u91CC\u5D4C\u7684\u90A3\u4E2A\u793E\u4EA4\u56FE\u8C31\u805A\u7C7B\u7B97\u6CD5\u592A\u4E13\u4E1A\u4E86\uFF0C\u6839\u672C\u4E0D\u53EF\u80FD\u662F\u793E\u4F1A\u5B66\u672C\u79D1\u751F\u80FD\u5199\u51FA\u6765\u7684\uFF0C\u6000\u7591\u6211\u82B1\u94B1\u96C7\u4E86\u5916\u5305\u6570\u636E\u516C\u53F8\u4EE3\u505A\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4E4B\u524D\u7ED9\u8FC7\u4F60\u4E00\u4EFD\u8BE6\u7EC6\u7684\u5E95\u5C42\u903B\u8F91\u8BF4\u660E\u4E66\uFF0C\u4F60\u62FF\u90A3\u4E2A\u53BB\u5BF9\u5CD9\u89E3\u91CA\u4E0D\u901A\u5417\uFF1F"
    - pageNumber: 6
      speakerName: "\u82CF\u7136"
      text: "\u8BC4\u59D4\u91CC\u5750\u7740\u8BA1\u7B97\u673A\u7CFB\u7684\u4E13\u5BB6\uFF0C\u4E00\u76F4\u5728\u8FFD\u95EE\u5E95\u5C42\u7684\u6807\u7B7E\u6620\u5C04\u548C\u6CE8\u610F\u529B\u673A\u5236\u3002\u6211\u53EA\u80FD\u89E3\u91CA\u793E\u4F1A\u5B66\u7684\u8C03\u67E5\u7ED3\u8BBA\uFF0C\u6839\u672C\u7B54\u4E0D\u4E0A\u4EE3\u7801\u903B\u8F91\u3002"
    - pageNumber: 7
      speakerName: "\u82CF\u7136"
      text: "\u6797\u6E21\uFF0C\u4F60\u80FD\u4E0D\u80FD\u8FC7\u6765\u4E00\u8D9F\u6821\u529E\uFF1F\u5C31\u5341\u5206\u949F\uFF0C\u5E2E\u6211\u8BC1\u660E\u8FD9\u4E2A\u7B97\u6CD5\u662F\u4F60\u4F5C\u4E3A\u6280\u672F\u652F\u6301\u5E2E\u6211\u5199\u7684\uFF0C\u4E0D\u662F\u4EC0\u4E48\u5546\u4E1A\u5916\u5305\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u7531\u4E8E\u4F53\u529B\u4E0E\u5730\u7406\u4F4D\u7F6E\u7684\u51B2\u7A81\uFF0C\u4F60\u53EA\u80FD\u5728\u4EE5\u4E0B\u4E09\u4EF6\u4E8B\u4E2D\u5B8C\u6210\u4E24\u4EF6\uFF0C\u5FC5\u987B\u5F7B\u5E95\u653E\u5F03\u4E00\u4EF6\u3002"
    choices:
    - label: "\u653E\u5F03\u4E0A\u5348\u7ADE\u8D5B"
      targetDocumentId: M4-4-3a
    - label: "\u653E\u5F03\u4E2D\u5348\u9762\u8C08"
      targetDocumentId: M4-4-3b
    - label: "\u653E\u5F03\u665A\u4E0A\u7535\u8BDD"
      targetDocumentId: M4-4-3c
