      text: M2-1-1\u6C88\u9752\u79BE
    - pageNumber: 1
      speakerName: 
      text: "TA3\u697C\xB7\u697C\u68AF\u95F4 / \u665A\u4E0A 18:15"
    - pageNumber: 2
      speakerName: 
      text: "\u4E00\u573A\u7A81\u5982\u5176\u6765\u7684\u5C40\u90E8\u8DF3\u95F8\uFF0C\u5BFC\u81F4\u6559\u5B66\u697C\u5168\u9762\u505C\u7535\u3002\u5E94\u6025\u7167\u660E\u706F\u6563\u53D1\u7740\u5FAE\u5149\u3002\u6CA1\u6709\u4E86\u670D\u52A1\u5668\u98CE\u6247\u7684\u8F70\u9E23\uFF0C\u6574\u680B\u5927\u697C\u9677\u5165\u4E86\u4E00\u79CD\u4EE4\u4EBA\u8033\u9E23\u7684\u5B89\u9759\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6797\u6E21\u521A\u5199\u5B8Caie1902\u7684\u4E00\u4E2A\u6838\u5FC3\u6A21\u5757\uFF0C\u8FD8\u6CA1\u4FDD\u5B58\uFF0C\u5C4F\u5E55\u5C31\u9ED1\u4E86\u3002\u5979\u5E26\u7740\u4E00\u4E1D\u65E0\u5948\u8D70\u51FA\u673A\u623F\uFF0C\u63A8\u5F00\u5E94\u6025\u697C\u68AF\u95F4\u7684\u9632\u706B\u95E8\uFF0C\u51C6\u5907\u4E0B\u697C\u53BB\u770B\u770B\u60C5\u51B5\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u501F\u7740\u5E94\u6025\u706F\u5149\uFF0C\u5979\u770B\u5230\u62D0\u89D2\u7684\u53F0\u9636\u4E0A\u5750\u7740\u4E00\u4E2A\u4EBA\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u6C88\u9752\u79BE\u3002\u4ED6\u6CA1\u6709\u50CF\u5176\u4ED6\u56E0\u4E3A\u505C\u7535\u800C\u70E6\u8E81\u7684\u4EBA\u90A3\u6837\u62B1\u6028\uFF0C\u4E5F\u6CA1\u6709\u72C2\u5237\u624B\u673A\u3002\u4ED6\u53EA\u662F\u5B89\u9759\u5730\u5750\u5728\u53F0\u9636\u4E0A\uFF0C\u671B\u7740\u5BF9\u9762\u5265\u843D\u7684\u767D\u5899\uFF0C\u50CF\u662F\u5728\u4E13\u5FC3\u601D\u8003\u4EC0\u4E48\u4E8B\u60C5\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u53EA\u662F\u89C9\u5F97\u7CFB\u7EDF\u5E94\u8BE5\u66F4\u5305\u5BB9\uFF0C\u73B0\u5B9E\u4E2D\u603B\u6709\u610F\u5916\u3002\u201D"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4EE3\u7801\u4E0D\u9700\u8981\u6E29\u60C5\uFF0C\u5B83\u9700\u8981\u7684\u662F\u9C81\u68D2\u6027\u3002\u4F60\u8BD5\u56FE\u53D6\u60A6\u6240\u6709\u5F02\u5E38\u6570\u636E\u7684\u7ED3\u679C\uFF0C\u5C31\u662F\u8BA9\u6574\u4E2A\u7A0B\u5E8F\u5728\u8FD0\u884C\u6548\u7387\u4E0A\u5F7B\u5E95\u5931\u6548\u3002\u8FD9\u4E0D\u662F\u5728\u5199\u7A0B\u5E8F\uFF0C\u662F\u5728\u5199\u2018\u613F\u671B\u6E05\u5355\u2019\u3002\u201D"
    - pageNumber: 8
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u62AC\u5934\u4E89\u8BBA\uFF0C\u800C\u662F\u6C89\u9ED8\u5730\u5220\u6389\u4E86\u90A3\u51E0\u6392\u5197\u4F59\u903B\u8F91\uFF0C\u5F15\u5165\u4E86\u4E00\u4E2A\u6781\u5176\u7B80\u6D01\u7684\u60E9\u7F5A\u51FD\u6570\uFF0C\u91CD\u65B0\u6309\u4E0B\u4E86\u8FD0\u884C\u952E\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u770B\u7740\u5C4F\u5E55\u4E0A\u77AC\u95F4\u63D0\u5347\u7684\u8FD0\u884C\u901F\u5EA6\uFF0C\u6C88\u9752\u79BE\u7B2C\u4E00\u6B21\u8BA4\u771F\u6253\u91CF\u4E86\u8FD9\u4E2A\u5927\u4E00\u65B0\u751F\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6C88\u5B66\u957F\uFF0C\u5982\u679C\u4F60\u73B0\u5728\u6B63\u5728\u8111\u5B50\u91CC\u590D\u76D8\u4EE3\u7801\uFF0C\u6211\u8D70\u8FC7\u53BB\u4F1A\u6253\u65AD\u4F60\u7684\u601D\u8DEF\u5417\uFF1F\u201D"
    - pageNumber: 11
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4E0D\u4F1A\u3002\u505C\u7535\u521A\u597D\u5361\u5728\u4E86\u6211\u8DD1\u4E86\u4E00\u4E2A\u661F\u671F\u7684\u9879\u76EE\u8FDB\u5EA6\u4E0A\u3002\u6211\u53EA\u662F\u5728\u8D81\u7740\u8FD9\u70B9\u5B89\u9759\uFF0C\u628A\u521A\u624D\u5D29\u6389\u7684\u903B\u8F91\u91CD\u65B0\u7406\u987A\u4E00\u904D\u3002\u201D"
    - pageNumber: 12
      speakerName: "\u6797\u6E21"
      text: "\u201C\u770B\u6765\u4F60\u7684\u81EA\u6211\u4FEE\u590D\u80FD\u529B\u6BD4\u5B66\u6821\u7684\u5907\u7528\u7535\u6E90\u5FEB\u591A\u4E86\u3002\u7406\u987A\u4E86\u5417\uFF1F\u201D"
    - pageNumber: 13
      speakerName: 
      text: "\u6CA1\u6709\u7535\u8111\uFF0C\u6CA1\u6709\u7F51\u7EDC\uFF0C\u5728\u8FD9\u4E2A\u5E7D\u95ED\u7684\u697C\u68AF\u95F4\u91CC\uFF0C\u4E24\u4EBA\u53EA\u80FD\u901A\u8FC7\u6700\u539F\u59CB\u7684\u65B9\u5F0F\u5BF9\u8BDD\u3002"
    - pageNumber: 14
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5DEE\u4E0D\u591A\u4E86\u3002\u5176\u5B9E\u6211\u521A\u624D\u5728\u60F3\uFF0C\u8FD9\u79CD\u7A81\u53D1\u72B6\u51B5\u5C31\u662F\u6211\u5E73\u65F6\u6700\u8BA8\u538C\u7684\u4E1C\u897F\u3002\u6211\u559C\u6B22\u751F\u6D3B\u6709\u8FF9\u53EF\u5FAA\uFF0C\u559C\u6B22\u5F85\u5728\u5B9E\u9A8C\u5BA4\u91CC\uFF0C\u56E0\u4E3A\u90A3\u91CC\u7684\u73AF\u5883\u662F\u53EF\u63A7\u7684\u3002"
    - pageNumber: 15
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5916\u754C\u7684\u793E\u4EA4\u3001\u610F\u5916\u3001\u5BD2\u6684\u2026\u2026\u8FD9\u4E9B\u4E0D\u53EF\u63A7\u7684\u56E0\u7D20\u592A\u591A\u4E86\uFF0C\u4F1A\u6D88\u8017\u6389\u4EBA\u5F88\u5927\u7684\u7CBE\u529B\u3002"
    - pageNumber: 16
      speakerName: "\u6797\u6E21"
      text: "\u6240\u4EE5\u4F60\u628A\u81EA\u5DF1\u7684\u751F\u6D3B\u7CBE\u7B80\u5230\u4E86\u6781\u81F4\uFF1F\u9664\u4E86\u673A\u623F\u5C31\u662F\u5BDD\u5BA4\uFF0C\u5C4F\u853D\u6389\u6240\u6709\u4F60\u89C9\u5F97\u2018\u6CA1\u6548\u7387\u2019\u7684\u4E8B\u60C5\uFF1F"
    - pageNumber: 17
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u8FD9\u5BF9\u6211\u6765\u8BF4\u662F\u6700\u8212\u670D\u3001\u6700\u7701\u529B\u7684\u65B9\u5F0F\u3002\u6392\u9664\u6389\u610F\u5916\uFF0C\u751F\u6D3B\u624D\u80FD\u4E00\u76F4\u4FDD\u6301\u7A33\u5B9A\u3002\u201D"
    - pageNumber: 18
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6C88\u5B66\u957F\uFF0C\u7A33\u5B9A\u786E\u5B9E\u5F88\u597D\u3002\u4F46\u4F60\u5E94\u8BE5\u4E5F\u77E5\u9053\uFF0C\u5982\u679C\u4E00\u4E2A\u4EBA\u6C38\u8FDC\u5F85\u5728\u81EA\u5DF1\u89C9\u5F97\u6700\u8212\u670D\u3001\u6700\u53EF\u63A7\u7684\u5708\u5B50\u91CC\uFF0C\u62D2\u7EDD\u4EFB\u4F55\u610F\u5916\u548C\u53D8\u5316\uFF0C\u90A3\u4ED6\u786E\u5B9E\u4E0D\u4F1A\u51FA\u9519\u2014\u2014\u4F46\u4ED6\u4E5F\u5C31\u6C38\u8FDC\u505C\u5728\u90A3\u513F\u4E86\uFF0C\u627E\u4E0D\u5230\u66F4\u597D\u7684\u8DEF\u3002\u201D"
    - pageNumber: 19
      speakerName: 
      text: "\u6C88\u9752\u79BE\u7684\u773C\u795E\u5FAE\u5FAE\u52A8\u4E86\u4E00\u4E0B\u3002\u4ED6\u8F6C\u8FC7\u5934\uFF0C\u8BA4\u771F\u5730\u770B\u7740\u6797\u6E21\u3002"
    - pageNumber: 20
      speakerName: "\u6797\u6E21"
      text: "\u201C\u4E3A\u4E86\u6253\u7834\u773C\u524D\u7684\u74F6\u9888\uFF0C\u6709\u65F6\u5019\u7CFB\u7EDF\u662F\u9700\u8981\u4E3B\u52A8\u5F15\u5165\u4E00\u70B9\u2018\u6DF7\u4E71\u2019\u548C\u2018\u610F\u5916\u2019\u7684\u3002\u6C88\u9752\u79BE\uFF0C\u4F60\u7684\u751F\u6D3B\u592A\u6309\u90E8\u5C31\u73ED\u4E86\uFF0C\u7A33\u5B9A\u5F97\u2026\u2026\u6709\u70B9\u53EF\u60DC\u3002\u201D"
    - pageNumber: 21
      speakerName: 
      text: "\u9762\u5BF9\u6C88\u9752\u79BE\u6784\u5EFA\u7684\u201C\u7EDD\u5BF9\u7406\u667A\u9632\u7EBF\u201D\uFF0C\u4F60\u6253\u7B97\u4EE5\u4EC0\u4E48\u8EAB\u4EFD\u6210\u4E3A\u90A3\u4E2A\u6253\u7834\u4ED6\u7A33\u5B9A\u72B6\u6001\u7684\u201C\u610F\u5916\u201D\uFF1F"
