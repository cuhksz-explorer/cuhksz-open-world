    finishLocationName: "\u56FE\u4E66\u9986\u4E00\u697C\xB7\u7535\u8111\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u56FE\u4E66\u9986\u7535\u8111\u533A,\u6DF1\u591C 23:20\uFF0C\u65C1\u8FB9\u65E9\u5DF2\u65E0\u4EBA\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u6B63\u5728\u8C03\u8BD5csc1002\u7684\u5927\u4F5C\u4E1A\u3002\u4E3A\u4E86\u9632\u6B62\u7A0B\u5E8F\u62A5\u9519\uFF0C\u5979\u5199\u4E86\u5927\u91CF\u7684\u5D4C\u5957\u903B\u8F91\u6765\u5904\u7406\u6781\u7AEF\u60C5\u51B5\u3002\u6C88\u9752\u79BE\u8DEF\u8FC7\u6253\u5370\u8D44\u6599\uFF0C\u5728\u5979\u7684\u5C4F\u5E55\u540E\u505C\u4E0B\u4E86\u811A\u6B65\u3002\u4ED6\u5012\u662F\u7B2C\u4E00\u6B21\u89C1\u51991002\u4E0D\u7528AI\u7684\u5934\u94C1\u5927\u4E00\u65B0\u751F\u3002"
    - pageNumber: 3
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4F60\u5199\u4E86\u592A\u591A\u7684\u4F8B\u5916\u5224\u65AD\u3002\u4F60\u8BD5\u56FE\u7528\u7B97\u6CD5\u53BB\u5B89\u629A\u6BCF\u4E00\u4E2A\u53EF\u80FD\u51FA\u9519\u7684\u8F93\u5165\uFF0C\u8FD9\u8BA9\u4F60\u7684\u4EE3\u7801\u53D8\u5F97\u975E\u5E38\u81C3\u80BF\u3002\u201D"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u53EA\u662F\u89C9\u5F97\u7CFB\u7EDF\u5E94\u8BE5\u66F4\u5305\u5BB9\uFF0C\u73B0\u5B9E\u4E2D\u603B\u6709\u610F\u5916\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4EE3\u7801\u4E0D\u9700\u8981\u6E29\u60C5\uFF0C\u5B83\u9700\u8981\u7684\u662F\u9C81\u68D2\u6027\u3002\u4F60\u8BD5\u56FE\u53D6\u60A6\u6240\u6709\u5F02\u5E38\u6570\u636E\u7684\u7ED3\u679C\uFF0C\u5C31\u662F\u8BA9\u6574\u4E2A\u7A0B\u5E8F\u5728\u8FD0\u884C\u6548\u7387\u4E0A\u5F7B\u5E95\u5931\u6548\u3002\u8FD9\u4E0D\u662F\u5728\u5199\u7A0B\u5E8F\uFF0C\u662F\u5728\u5199\u2018\u613F\u671B\u6E05\u5355\u2019\u3002\u201D"
    - pageNumber: 6
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u62AC\u5934\u4E89\u8BBA\uFF0C\u800C\u662F\u6C89\u9ED8\u5730\u5220\u6389\u4E86\u90A3\u51E0\u6392\u5197\u4F59\u903B\u8F91\uFF0C\u5F15\u5165\u4E86\u4E00\u4E2A\u6781\u5176\u7B80\u6D01\u7684\u60E9\u7F5A\u51FD\u6570\uFF0C\u91CD\u65B0\u6309\u4E0B\u4E86\u8FD0\u884C\u952E\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u770B\u7740\u5C4F\u5E55\u4E0A\u77AC\u95F4\u63D0\u5347\u7684\u8FD0\u884C\u901F\u5EA6\uFF0C\u6C88\u9752\u79BE\u7B2C\u4E00\u6B21\u8BA4\u771F\u6253\u91CF\u4E86\u8FD9\u4E2A\u5927\u4E00\u65B0\u751F\u3002"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6797\u6E21\uFF0C\u4F60\u7684\u4EE3\u7801\u6BD4\u4F60\u7684\u95EE\u9898\u6210\u719F\u3002\u201D"
    - pageNumber: 9
      speakerName: 
      text: "\u5B66\u6821\u5496\u5561\u9986\u89D2\u843D\uFF0C\u5468\u781A\u6B63\u5904\u4E8E\u5979\u521D\u521B\u516C\u53F8\u7684\u7B2C\u4E00\u4E2A\u5BD2\u51AC\u3002\u4E00\u5BB6\u8D44\u65B9\u6001\u5EA6\u50B2\u6162\uFF0C\u8BD5\u56FE\u5229\u7528\u5408\u540C\u6F0F\u6D1E\u538B\u4F4E\u5979\u4EEC\u7684\u4F30\u503C\u3002\u5468\u781A\u7A7F\u7740\u526A\u88C1\u5229\u843D\u7684\u897F\u88C5\uFF0C\u663E\u7136\u662F\u521A\u5F00\u8FC7\u4F1A\uFF0C\u6B63\u5728\u7535\u8BDD\u91CC\u51B7\u9759\u5730\u4E0E\u5BF9\u65B9\u535A\u5F08\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u5750\u5728\u90BB\u5EA7\uFF0C\u542C\u5230\u4E86\u51E0\u4E2A\u5173\u952E\u8BCD\u3002\u5979\u5728\u5E73\u677F\u4E0A\u98DE\u5FEB\u5730\u641C\u7D22\u6574\u7406\uFF0C\u5C06\u4E00\u4EFD\u5173\u4E8E\u8BE5\u8D44\u65B9\u5386\u53F2\u8FDD\u7EA6\u884C\u4E3A\u7684\u7B80\u62A5\u63A8\u5230\u4E86\u5468\u781A\u9762\u524D\u3002"
    - pageNumber: 11
      speakerName: "\u5468\u781A"
      text: "\u201C\u5927\u4E00\u65B0\u751F\u73B0\u5728\u90FD\u4E0D\u53BB\u53C2\u52A0\u8054\u8C0A\uFF0C\u6539\u884C\u505A\u5546\u4E1A\u80CC\u8C03\u4E86\uFF1F\u201D"
    - pageNumber: 12
      speakerName: "\u6797\u6E21"
      text: "\u201C\u8054\u8C0A\u592A\u4F4E\u6548\u4E86\u3002\u5468\u5B66\u59D0\uFF0C\u8FD9\u4EFD\u6E05\u5355\u80FD\u5E2E\u4F60\u5728\u8FD9\u573A\u8C08\u5224\u91CC\u62FF\u56DE\u4E3B\u52A8\u6743\u3002\u201D"
    - pageNumber: 13
      speakerName: "\u5468\u781A"
      text: "\u201C\u60F3\u8981\u4EC0\u4E48\u56DE\u62A5\uFF1F\u5B9E\u4E60\u8BC1\u660E\uFF0C\u8FD8\u662F\u7EFC\u6D4B\u52A0\u5206\uFF1F\u201D"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u9700\u8981\u8FDB\u5165\u4F60\u4EEC\u516C\u53F8\u90A3\u4E2A\u8131\u654F\u540E\u7684\u5E95\u5C42\u6570\u636E\u5E93\uFF0C\u6211\u60F3\u8981\u771F\u5B9E\u7684\u5BA1\u8BA1\u6837\u672C\u3002\u6211\u63D0\u4F9B\u5F39\u836F\uFF0C\u4F60\u8D1F\u8D23\u8D62\uFF0C\u5404\u53D6\u6240\u9700\u3002\u201D"
    - pageNumber: 15
      speakerName: 
      text: "\u5468\u781A\u9732\u51FA\u4E86\u4E00\u4E2A\u5145\u6EE1\u6218\u610F\u7684\u5FAE\u7B11\u3002"
    - pageNumber: 16
      speakerName: "\u5468\u781A"
      text: "\u201C\u591F\u76F4\u63A5\u3002\u5728\u8FD9\u4E2A\u5B66\u6821\u91CC\uFF0C\u5927\u90E8\u5206\u5927\u4E00\u5B66\u751F\u53EA\u60F3\u88AB\u6211\u5173\u7167\uFF0C\u800C\u4F60\uFF0C\u60F3\u8DDF\u6211\u5750\u5230\u540C\u4E00\u5F20\u724C\u684C\u4E0A\u3002\u201D"
    - pageNumber: 17
      speakerName: 
      text: "\u64CD\u573A\u8FB9\u7684\u62DB\u65B0\u644A\u4F4D\uFF0C\u987E\u6F84\u5B88\u5728\u201C\u8FDC\u5C71\u652F\u6559\u56E2\u201D\u7684\u644A\u4F4D\u524D\uFF0C\u6574\u7406\u7740\u4E00\u53E0\u539A\u539A\u7684\u5B69\u5B50\u6765\u4FE1\u3002\u56E0\u4E3A\u7F3A\u4E4F\u201C\u53EF\u91CF\u5316\u7684\u6210\u679C\u201D\uFF0C\u793E\u56E2\u9762\u4E34\u88AB\u7F29\u51CF\u7ECF\u8D39\u7684\u56F0\u5883\u3002\u4ED6\u795E\u8272\u6E29\u6DA6\u4F46\u5E26\u7740\u4E00\u4E1D\u4E0D\u6613\u5BDF\u89C9\u7684\u843D\u5BDE\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u6797\u6E21\u7AD9\u5728\u644A\u4F4D\u524D\u770B\u4E86\u5F88\u4E45\uFF0C\u6CA1\u6709\u62FF\u4F20\u5355\uFF0C\u800C\u662F\u76F4\u63A5\u6253\u5F00\u7535\u8111\uFF0C\u5C55\u793A\u4E86\u4E00\u5F20\u5979\u6839\u636E\u4FE1\u4EF6\u9AD8\u9891\u8BCD\u6C47\u751F\u6210\u7684\u201C\u5FC3\u7406\u6210\u957F\u70ED\u529B\u56FE\u201D\u3002"
    - pageNumber: 19
      speakerName: "\u6797\u6E21"
      text: "\u201C\u987E\u5B66\u957F\uFF0C\u60C5\u6000\u662F\u6700\u5BB9\u6613\u88AB\u6D88\u89E3\u7684\u4E1C\u897F\uFF0C\u56E0\u4E3A\u5B83\u65E0\u6CD5\u88AB\u9A8C\u8BC1\u3002\u4F46\u6211\u628A\u4F60\u7684\u2018\u7406\u60F3\u2019\u505A\u6210\u4E86\u56FE\u8868\u3002\u201D"
    - pageNumber: 20
      speakerName: "\u987E\u6F84"
      text: "\u201C\u2026\u2026\u6211\u4E00\u76F4\u4EE5\u4E3A\u8FD9\u4E9B\u6587\u5B57\u91CC\u7684\u611F\u60C5\u662F\u6CA1\u6CD5\u88AB\u8BA1\u7B97\u7684\u3002\u201D"
    - pageNumber: 21
      speakerName: "\u6797\u6E21"
      text: "\u201C\u8BA1\u7B97\u662F\u4E3A\u4E86\u4FDD\u62A4\u5B83\u4EEC\u3002\u6CA1\u6709\u9AA8\u67B6\u7684\u7406\u60F3\uFF0C\u5728\u73B0\u5B9E\u7684\u8003\u6838\u9762\u524D\u4E00\u6345\u5C31\u7834\u3002\u201D"
    choices: []
  - documentId: M2-1-1
    title: M2-1-1
    sourceAssetPath: Assets/content1/M2/M2-1-1.docx
