    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u9648\u5BFC\uFF0C\u6211\u521A\u624D\u5728\u9662\u529E\u770B\u5230\u4E86\u7EFC\u5408\u8BC4\u4F30\u7684\u7EC8\u7A3F\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u9646\u660E\u8FDE\u62A5\u9519\u65E5\u5FD7\u90FD\u770B\u4E0D\u61C2\u3002\u5982\u679C\u4ED6\u5728\u91CD\u70B9\u5B9E\u9A8C\u5BA4\u671F\u95F4\uFF0C\u60A8\u7684\u81EA\u52A8\u5316\u6570\u636E\u7BA1\u7EBF\u65AD\u4E86\uFF0C\u8C01\u6765\u4FEE\uFF1F"
    - pageNumber: 4
      speakerName: "\u9648\u6559\u6388"
      text: "\u4F60\u60F3\u8BF4\u4EC0\u4E48\uFF1F"
    - pageNumber: 5
      speakerName: 
      text: "\u6797\u6E21\u7528\u6781\u5176\u6210\u719F\u7684\u5229\u76CA\u7F6E\u6362\u903B\u8F91\uFF0C\u7CBE\u51C6\u62FF\u634F\u4E86\u5BFC\u5E08\u7684\u75DB\u70B9\u3002\u9648\u6559\u6388\u88AB\u8FD9\u79CD\u8D85\u4E4E\u5E74\u9F84\u7684\u73B0\u5B9E\u4E0E\u51B7\u9759\u6253\u52A8\uFF0C\u9876\u7740\u538B\u529B\u4FEE\u6539\u4E86\u540D\u5355\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u6797\u6E21\u6210\u529F\u62FF\u5230\u4E86\u540D\u989D\uFF0C\u4F46\u4EE3\u4EF7\u662F\u5979\u5FC5\u987B\u80CC\u8D1F\u6781\u5176\u7E41\u91CD\u7684\u201C\u6253\u53CC\u4EFD\u5DE5\u201D\u7684\u9AD8\u538B\u751F\u6D3B\uFF0C\u66F4\u4E0D\u7528\u8BF4\u8FD8\u8981\u517C\u987E\u5B66\u4E1A\uFF0C\u5927\u4E8C\u5C31\u5728\u5B66\u6821\u5F53\u4E0A\u4E86\u725B\u9A6C\u3002"
    choices: []
