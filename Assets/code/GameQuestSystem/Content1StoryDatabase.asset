    rewardGold: 25
    finishLocationName: "\u56FE\u4E66\u9986\u4E00\u697C"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u51CC\u6668\u4E00\u70B9\u5341\u4E94\u5206\uFF0C\u65E7\u56FE\u4E66\u9986\u3002\u767D\u70BD\u706F\u7684\u5149\u6253\u5728\u684C\u9762\u4E0A\uFF0C\u767D\u5F97\u6709\u4E9B\u6643\u773C\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u56F4\u662F\u7FFB\u52A8\u7EB8\u5F20\u7684\u6C99\u6C99\u58F0\u548C\u538B\u6291\u7684\u54B3\u55FD\u58F0\u3002\u5728\u8FD9\u4E2A\u88AB\u79F0\u4E3A\u201C\u4E0D\u591C\u57CE\u201D\u7684\u89D2\u843D\uFF0C\u7A7A\u6C14\u4E2D\u5F25\u6F2B\u7740\u4E00\u79CD\u540D\u4E3A\u201C\u7EE9\u70B9\u201D\u7684\u7126\u8651\u611F\uFF0C\u7C98\u7A20\u5F97\u8BA9\u4EBA\u5598\u4E0D\u8FC7\u6C14\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6797\u6E21\u76EF\u7740\u5C4F\u5E55\u4E0A\u7684\u6570\u636E\u6A21\u578B\uFF0C\u90A3\u4E9B\u5B57\u7B26\u5728\u773C\u524D\u8DF3\u52A8\uFF0C\u6E10\u6E10\u6A21\u7CCA\u6210\u4E00\u7247\u6742\u4E71\u7684\u91CD\u5F71\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u2026\u2026\u6CA1\u6551\u4E86\u5417\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u4F4E\u58F0\u5462\u5583\uFF0C\u6307\u5C16\u4E0D\u81EA\u89C9\u5730\u5728\u684C\u9762\u4E0A\u5212\u52A8\u3002\u5C31\u5728\u8FD9\u65F6\uFF0C\u4E00\u74F6\u51B0\u51B7\u7684\u65E0\u7CD6\u9ED1\u5496\u5561\u8F7B\u8F7B\u6572\u4E86\u6572\u5979\u7684\u624B\u80CC\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u6C88\u9752\u79BE\u4E0D\u77E5\u4EC0\u4E48\u65F6\u5019\u7AD9\u5728\u4E86\u684C\u8FB9\u3002\u5979\u4F9D\u7136\u7A7F\u7740\u90A3\u4EF6\u4E00\u4E1D\u4E0D\u82DF\u7684\u767D\u886C\u886B\uFF0C\u957F\u53D1\u6574\u9F50\u5730\u675F\u5728\u8111\u540E\uFF0C\u773C\u795E\u6E05\u9192\u5F97\u8FD1\u4E4E\u51B7\u9177\u3002"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u4F60\u5728\u770B\u522B\u4EBA\u7684\u5206\u3002"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u90A3\u5C31\u522B\u770B\u3002\u6570\u636E\u53EA\u80FD\u63CF\u8FF0\u8FC7\u53BB\uFF0C\u4E0D\u80FD\u51B3\u5B9A\u4F60\u7684\u4E0B\u4E00\u884C\u4EE3\u7801\u600E\u4E48\u5199\u3002"
    - pageNumber: 9
      speakerName: "\u6797\u6E21"
      text: "\u505A\u4E0D\u5230\u3002\u53EA\u8981\u95ED\u4E0A\u773C\uFF0C\u6211\u6EE1\u8111\u5B50\u90FD\u662F\u6392\u540D\uFF0C\u90FD\u662F\u90A3\u4E9B\u6BD4\u6211\u8D77\u6B65\u66F4\u65E9\u7684\u4EBA\u3002\u6211\u611F\u89C9\u81EA\u5DF1\u5FEB\u8981\u2026\u2026\u88C2\u5F00\u4E86\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6C88\u9752\u79BE\u62C9\u5F00\u6905\u5B50\u5750\u5728\u5979\u5BF9\u9762\uFF0C\u6CA1\u6709\u50AC\u5979\u56DE\u53BB\u590D\u4E60\uFF0C\u4E5F\u6CA1\u6709\u5B89\u6170\uFF0C\u53EA\u662F\u5E73\u9759\u5730\u770B\u7740\u5979\u3002"
    - pageNumber: 11
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u4E24\u4E2A\u9009\u62E9\u3002\u8981\u4E48\u5F3A\u884C\u505C\u6B62\u3002\u8981\u4E48\uFF0C\u627E\u4EBA\u5E2E\u4F60\u505C\u4E0B\u6765\u3002"
