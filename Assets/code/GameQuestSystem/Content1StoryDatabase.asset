    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u5F20\u5BFC\uFF0C\u6211\u4EEC\u4E4B\u524D\u8BF4\u597D\u8FD9\u4E2A\u5DE5\u5177\u7684\u5E95\u5C42\u903B\u8F91\u4F1A\u4F5C\u4E3A\u5F00\u6E90\u9879\u76EE\u653E\u5230\u793E\u533A\u91CC\u7684\u3002"
    - pageNumber: 3
      speakerName: "\u5F20\u6559\u6388"
      text: "\u8D44\u65B9\u8981\u6C42\u7EDD\u5BF9\u7684\u6280\u672F\u72EC\u5360\u3002\u5982\u679C\u4F60\u540C\u610F\u4E70\u65AD\u4EA4\u51FA\u6E90\u7801\uFF0C\u4E0D\u4EC5\u80FD\u62FF\u5230\u4E00\u7B14\u4E30\u539A\u7684\u62A5\u916C\uFF0C\u8FD8\u80FD\u4F5C\u4E3A\u6838\u5FC3\u6210\u5458\u6302\u540D\u4E24\u7BC7\u9876\u520A\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u6E21"
      text: "\u4E5F\u5C31\u662F\u8BF4\uFF0C\u6211\u5FC5\u987B\u5F7B\u5E95\u653E\u5F03\u5BF9\u8FD9\u6BB5\u4EE3\u7801\u7684\u63A7\u5236\u6743\uFF0C\u5E76\u4E14\u7B7E\u4FDD\u5BC6\u534F\u8BAE\u3002"
    - pageNumber: 5
      speakerName: "\u5F20\u6559\u6388"
      text: "\u79D1\u7814\u9700\u8981\u5411\u73B0\u5B9E\u4F4E\u5934\u3002\u4F60\u4E0D\u7B7E\u4E5F\u6CA1\u5173\u7CFB\uFF0C\u7EC4\u91CC\u7814\u4E09\u7684\u5B66\u957F\u5B8C\u5168\u53EF\u4EE5\u7167\u7740\u4F60\u7684\u6846\u67B6\u91CD\u5199\u4E00\u4E2A\u63A5\u53E3\u3002\u53EA\u662F\u5C5E\u4E8E\u4F60\u7684\u540D\u58F0\u548C\u7EA2\u5229\uFF0C\u5C31\u5F97\u8BA9\u7ED9\u522B\u4EBA\u4E86\u3002\u4E0B\u5348\u4E24\u70B9\u8D44\u65B9\u4EE3\u8868\u5C31\u5230\uFF0C\u4F60\u81EA\u5DF1\u51B3\u5B9A\u3002"
    choices: []
