      text: "\u6797\u6E21\uFF0C\u8FD9\u4E2A\u70B9\u8FD8\u5728\u7EFC\u5408\u697C\uFF0C\u770B\u6765\u90A3\u6761\u5E16\u5B50\u786E\u5B9E\u8BA9\u4F60\u633A\u7761\u4E0D\u7740\u7684\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u627F\u52CB\u5B66\u957F\uFF0C\u5176\u5B9E\u4F60\u4E5F\u633A\u8F9B\u82E6\u3002\u4ECE\u56FE\u4E66\u9986\u8DD1\u5230tx\uFF0C\u8FD8\u8981\u6765\u661F\u5DF4\u514B\uFF0C\u5C31\u4E3A\u4E86\u53D1\u4E00\u7BC7\u6D41\u8A00\uFF1F"
    - pageNumber: 6
      speakerName: "\u8D75\u627F\u52CB"
      text: "\u5361\u56ED\u8FD9\u79CD\u5730\u65B9\uFF0C\u771F\u76F8\u4E0D\u91CD\u8981\uFF0C\u91CD\u8981\u7684\u662F\u5927\u5BB6\u60F3\u770B\u4EC0\u4E48\u3002\u53EA\u8981\u5927\u5BB6\u89C9\u5F97\u4F60\u7684\u4EBA\u683C\u6709\u7455\u75B5\uFF0C\u90A3\u4EFD\u8D26\u5355\u7684\u771F\u5B9E\u6027\u81EA\u7136\u5C31\u6CA1\u4EBA\u4FE1\u4E86\u3002\u8FD9\u53EB\u516C\u5173\uFF0C\u61C2\u5417\uFF1F"
    - pageNumber: 7
