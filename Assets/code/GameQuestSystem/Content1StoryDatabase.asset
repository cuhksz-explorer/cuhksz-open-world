    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u6491\u4F1E\u7684\u624B\u5FAE\u5FAE\u4E00\u987F\uFF0C\u968F\u5373\u53D1\u51FA\u4E00\u58F0\u8F7B\u7B11\u3002\u90A3\u7B11\u58F0\u91CC\u6CA1\u6709\u5E73\u65F6\u7684\u793E\u4EA4\u5BA2\u5957\uFF0C\u800C\u662F\u4E00\u79CD\u68CB\u9022\u5BF9\u624B\u7684\u6FC0\u8D4F\u3002\u5979\u4FA7\u8FC7\u5934\uFF0C\u8DEF\u706F\u660F\u9EC4\u7684\u5149\u5F71\u5728\u5979\u7684\u77B3\u5B54\u91CC\u8DF3\u52A8\uFF0C\u50CF\u662F\u4E00\u56E2\u8DC3\u8DC3\u6B32\u8BD5\u7684\u706B\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u201C\u6495\u788E\u5B83\u2026\u2026\u5475\uFF0C\u771F\u6562\u8BF4\u554A\uFF0C\u6797\u6E21\u3002\u201D"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u8FD9\u6240\u5B66\u6821\u5230\u5904\u90FD\u662F\u60F3\u628A\u56F4\u680F\u52A0\u9AD8\u7684\u4EBA\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\u5F53\u7740\u6211\u7684\u9762\uFF0C\u8BF4\u8981\u628A\u5B83\u62C6\u6389\u7684\u4EBA\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u538B\u4F4E\u58F0\u97F3\uFF0C\u8EAB\u4F53\u5FAE\u5FAE\u5411\u6797\u6E21\u503E\u659C\uFF0C\u4F1E\u4E0B\u7684\u7A7A\u95F4\u663E\u5F97\u66F4\u52A0\u72ED\u7A84\u538B\u6291"
    - pageNumber: 6
      speakerName: "\u5468\u781A"
      text: "\u201C\u65E2\u7136\u60F3\u6405\u5C40\uFF0C\u90A3\u4F60\u5C31\u5F97\u722C\u5230\u6BD4\u4ED6\u4EEC\u66F4\u9AD8\u7684\u5730\u65B9\u3002\u8BB0\u4F4F\uFF0C\u6495\u788E\u89C4\u77E9\u7684\u65F6\u5019\uFF0C\u8BB0\u5F97\u6293\u7D27\u6211\u7684\u624B\u2014\u2014\u5728\u90A3\u4E2A\u9AD8\u5EA6\uFF0C\u4E00\u4E2A\u4EBA\u6389\u4E0B\u53BB\u53EF\u662F\u4F1A\u7C89\u8EAB\u788E\u9AA8\u7684\u3002\u201D"
    choices: []
  - documentId: M2-1-4-B
    title: M2-1-4-B
    sourceAssetPath: Assets/content1/M2/M2-1-4-B.docx
    chapterId: M2
