    finishLocationName: "\u673A\u623F/\u9009\u8BFE\u7CFB\u7EDF"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u6211\u505C\u4E0D\u4E0B\u6765\u3002\u6C88\u9752\u79BE\uFF0C\u5E26\u6211\u53BB\u4E2A\u6CA1\u6709\u5C4F\u5E55\u7684\u5730\u65B9\u5427\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u70B9\u4E86\u70B9\u5934\uFF0C\u4ED6\u6CA1\u6709\u8FDF\u7591\uFF0C\u5229\u843D\u5730\u5408\u4E0A\u6797\u6E21\u7684\u7535\u8111\u585E\u8FDB\u5305\u91CC\uFF0C\u62C9\u8D77\u5979\u7684\u624B\u8155\u8D70\u51FA\u4E86\u90A3\u95F4\u4EE4\u4EBA\u7A92\u606F\u7684\u9605\u89C8\u5BA4\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6DF1\u591C\u7684\u5FC3\u7406\u54A8\u8BE2\u4E2D\u5FC3\u706F\u706B\u5FAE\u4EAE\u3002\u95E8\u53E3\u7684\u9732\u53F0\u4E0A\uFF0C\u4E00\u4E2A\u7537\u751F\u6B63\u8E72\u5728\u5730\u4E0A\u4FEE\u7406\u4E00\u76C6\u67AF\u840E\u7684\u7EFF\u690D\u3002\u662F\u987E\u6F84\u3002"
    - pageNumber: 4
      speakerName: "\u987E\u6F84"
      text: "\u563F\uFF0C\u6C88\u5927\u624D\u5B50\uFF0C\u8FD9\u4E48\u665A\u8FD8\u5E26\u4EBA\u6765\u201C\u81EA\u9996\u201D\uFF1F"
    - pageNumber: 5
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u5979\u5FEB\u70E7\u574F\u4E86\u3002\u4EA4\u7ED9\u4F60\u4E86\uFF0C\u6211\u8FD8\u6709\u4E2A\u5B9E\u9A8C\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u6C88\u9752\u79BE\u677E\u5F00\u624B\uFF0C\u5BF9\u6797\u6E21\u70B9\u4E86\u4E0B\u5934\uFF0C\u8F6C\u8FC7\u8EAB\u6D88\u5931\u5728\u8D70\u5ECA\u5C3D\u5934\u3002\u4ED6\u7684\u80CC\u5F71\u5728\u51B7\u767D\u706F\u5149\u4E0B\u663E\u5F97\u5B64\u72EC\u800C\u575A\u786C\u3002\u987E\u6F84\u62CD\u4E86\u62CD\u624B\u4E0A\u7684\u6CE5\u571F\uFF0C\u5BF9\u7740\u6797\u6E21\u6E29\u548C\u5730\u7B11\u4E86\u4E00\u4E0B\u3002"
    - pageNumber: 7
      speakerName: "\u987E\u6F84"
      text: "\u5750\u5427\u3002\u8FD9\u513F\u6CA1\u6709\u7EE9\u70B9\uFF0C\u53EA\u6709\u8FD8\u6CA1\u7761\u7740\u7684\u98CE\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u987E\u5B66\u957F\u2026\u2026\u6211\u53EA\u662F\u89C9\u5F97\u81EA\u5DF1\u592A\u6CA1\u7528\u4E86\u3002\u5927\u5BB6\u90FD\u5728\u51B2\u523A\uFF0C\u53EA\u6709\u6211\u60F3\u9003\u8DD1\u3002"
    - pageNumber: 9
      speakerName: "\u987E\u6F84"
      text: "\u4EBA\u4E0D\u662F\u673A\u5668\uFF0C\u6797\u6E21\u3002\u673A\u5668\u8FC7\u70ED\u4E86\u8FD8\u4F1A\u5B95\u673A\uFF0C\u4F60\u51ED\u4EC0\u4E48\u8981\u6C42\u81EA\u5DF1\u4E00\u76F4\u5F00\u7740\uFF1F"
    - pageNumber: 10
      speakerName: 
      text: "\u987E\u6F84\u9012\u7ED9\u6797\u6E21\u4E00\u4E2A\u89E3\u538B\u634F\u634F\u4E50\uFF0C\u662F\u4E00\u4E2A\u8F6F\u7EF5\u7EF5\u7684\u5C0F\u4E91\u6735\u3002"
    - pageNumber: 11
      speakerName: "\u987E\u6F84"
      text: "\u6E2F\u4E2D\u6DF1\u7684\u8DEF\u5F88\u957F\uFF0C\u5982\u679C\u4F60\u5728\u7B2C\u4E00\u7AE0\u5C31\u628A\u6240\u6709\u7684\u6CB9\u90FD\u8017\u5149\u4E86\uFF0C\u540E\u9762\u90A3\u4E5D\u5341\u7AE0\u4F60\u6253\u7B97\u600E\u4E48\u8D70\uFF1F\u6709\u65F6\u5019\uFF0C\u505C\u4E0B\u6765\u770B\u4E00\u773C\u661F\u661F\uFF0C\u5E76\u4E0D\u662F\u5728\u6D6A\u8D39\u65F6\u95F4\uFF0C\u800C\u662F\u5728\u6821\u51C6\u822A\u5411\u3002"
    choices: []
  - documentId: M1-3-2B
    title: M1-3-2B
