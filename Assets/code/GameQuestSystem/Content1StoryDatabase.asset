    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u542C\u8D77\u6765\u50CF\u662F\u5E78\u5B58\u8005\u7684\u5938\u5927\u5176\u8BCD\uFF0C\u6211\u4F1A\u7528\u81EA\u5DF1\u7684\u65B9\u5F0F\u770B\u6E05\u695A\u8FD9\u91CC\u3002"
