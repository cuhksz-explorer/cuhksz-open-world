    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u5B8C\u6210\u4E86\u7B54\u8FA9\uFF0C\u5E76\u4E3A\u4E86\u524D\u9014\u7B7E\u4E0B\u4E86\u5BFC\u5E08\u7684\u534F\u8BAE\uFF0C\u4F46\u5728\u82CF\u7136\u6700\u9700\u8981\u6280\u672F\u80CC\u4E66\u7684\u65F6\u5019\u5173\u6389\u4E86\u624B\u673A\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u793E\u4F1A\u5B66\u8C03\u67E5\u9879\u76EE\u65E0\u6CD5\u901A\u8FC7\u542C\u8BC1\u4F1A\uFF0C\u56FD\u521B\u8D44\u91D1\u88AB\u5168\u989D\u51BB\u7ED3\uFF0C\u82CF\u7136\u80CC\u4E0A\u4E86\u5B66\u672F\u4E0D\u7AEF\u7684\u8B66\u544A\u5904\u5206\uFF0C\u4FDD\u7814\u540D\u989D\u88AB\u64A4\u9500\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u6DF1\u591C\uFF0C\u82CF\u7136\u53D1\u6765\u4E86\u4E00\u6761\u6781\u5176\u51B7\u9759\u7684\u77ED\u4FE1\uFF1A\u201C\u6211\u4EE5\u4E3A\u8DE8\u5B66\u79D1\u5408\u4F5C\u662F\u4E92\u76F8\u6210\u5C31\uFF0C\u4F46\u6211\u663E\u7136\u9AD8\u4F30\u4E86\u6211\u5728\u4F60\u65F6\u95F4\u8868\u91CC\u7684\u4F18\u5148\u7EA7\u3002\u5C31\u8FD9\u6837\u5427\uFF0C\u6211\u4E0D\u803D\u8BEF\u4F60\u7684\u5927\u597D\u524D\u7A0B\u3002\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u4E0B\u4E00\u6B21\u6797\u6E21\u5728\u5B66\u6821\u89C1\u5230\u82CF\u7136\u65F6\uFF0C\u672C\u6765\u60F3\u51B2\u4E0A\u53BB\u75AF\u72C2\u9053\u6B49\u627E\u8865\u6551\u63AA\u65BD\uFF0C\u4F46\u662F\u82CF\u7136\u770B\u4E86\u5979\u4E00\u773C\uFF0C\u52A0\u5FEB\u811A\u6B65\u8D70\u6389\u4E86\u3002"
    choices: []
