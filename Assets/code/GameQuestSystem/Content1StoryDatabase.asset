    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u54AC\u7D27\u7259\u5173\uFF0C\u5728\u6700\u540E\u4E00\u79D2\u53D6\u6D88\u4E86\u300A\u6218\u7565\u51B3\u7B56\u7BA1\u7406\u300B\uFF0C\u91CD\u91CD\u5730\u6309\u4E0B\u4E86\u300A\u96F6\u548C\u903B\u8F91\u300B\u7684\u786E\u8BA4\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u9875\u9762\u8F6C\u52A8\u4E86\u6F2B\u957F\u7684\u4E09\u79D2\u3002"
    - pageNumber: 4
      speakerName: "\u7CFB\u7EDF\u63D0\u793A"
      text: "\u3010\u9009\u8BFE\u6210\u529F\u3002\u9009\u8BFE\u4EBA\u6570\uFF1A15/15\u3002\u3011"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u62FF\u5230\u4E86\u2026\u2026\u6211\u662F\u6700\u540E\u4E00\u4E2A\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u8D1F\u4E00\u5C42\uFF1F\u90A3\u91CC\u4E0D\u662F\u6742\u7269\u95F4\u5417\uFF1F"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6240\u4EE5\u624D\u53EB\u5B83\u201C\u96F6\u53F7\u8BFE\u7A0B\u201D\u3002\u795D\u4F60\u597D\u8FD0\uFF0C\u6797\u6E21\u3002"
    - pageNumber: 8
      speakerName: "\u6881\u5609\u4E00"
      text: "\u4F60\u9009\u4E86\u90A3\u4E2A\u6CA1\u542C\u8BF4\u8FC7\u7684\u903B\u8F91\u8BFE\uFF1F\u6797\u6E21\uFF0C\u4F60\u75AF\u4E86\u5427\uFF0C\u90A3\u79CD\u8BFE\u8FDE\u8003\u7EB2\u90FD\u6CA1\u6709\uFF0C\u4F60\u5C31\u4E0D\u6015\u671F\u672B\u6302\u79D1\uFF1F"
    - pageNumber: 9
