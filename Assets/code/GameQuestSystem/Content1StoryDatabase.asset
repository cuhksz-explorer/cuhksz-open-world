    npcId: story_trigger
    locationId: 
    targetSceneName: 
    fallbackTargetPosition: {x: 0, y: 0, z: 0}
    rewardGold: 65
    finishLocationName: 
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u542C\u5230\u8D75\u5B87\u90A3\u8FD1\u4E4E\u65BD\u820D\u7684\u8BED\u6C14\uFF0C\u6797\u6E21\u653E\u5728\u952E\u76D8\u4E0A\u7684\u624B\u6307\u5FAE\u5FAE\u4E00\u987F\u3002\u5979\u773C\u89D2\u7684\u4F59\u5149\u770B\u5230\u4E86\u5468\u781A\u7D27\u9501\u7684\u7709\u5934\u2014\u2014\u5468\u781A\u8FD9\u79CD\u6027\u683C\uFF0C\u6700\u538C\u6076\u7684\u5C31\u662F\u88AB\u4EBA\u770B\u5230\u8F6F\u808B\uFF0C\u66F4\u4E0D\u9700\u8981\u5EC9\u4EF7\u7684\u540C\u60C5\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u8BF4\u8BDD\uFF0C\u4E5F\u6CA1\u6709\u8868\u73B0\u51FA\u591A\u4F59\u7684\u60C5\u7EEA\u3002\u5979\u53EA\u662F\u5B89\u9759\u5730\u7AD9\u8D77\u8EAB\uFF0C\u8D70\u5230\u996E\u6C34\u673A\u65C1\u63A5\u4E86\u4E00\u676F\u6E29\u6C34\uFF0C\u8F7B\u8F7B\u653E\u5728\u5468\u781A\u624B\u8FB9\u3002\u63A5\u7740\uFF0C\u5979\u987A\u624B\u5C06\u5468\u781A\u4E3B\u5C4F\u5E55\u4E0A\u90A3\u4E2A\u8DF3\u52A8\u7684\u6765\u7535\u663E\u793A\u7A97\u53E3\u7F29\u5C0F\u5230\u89D2\u843D\uFF0C\u7528\u4E00\u5F20\u6B63\u5728\u8FD0\u884C\u7684\u3001\u903B\u8F91\u4E25\u5BC6\u7684\u590D\u6742\u56FE\u8868\u8986\u76D6\u4E86\u5B83\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u7535\u8BDD\u6302\u65AD\u540E\uFF0C\u7814\u8BA8\u5BA4\u9677\u5165\u4E86\u4E00\u7247\u4EE4\u4EBA\u5FC3\u5B89\u7684\u5BC2\u9759\u3002\u6797\u6E21\u6458\u4E0B\u8033\u673A\uFF0C\u5E76\u6CA1\u6709\u8BE2\u95EE\u7535\u8BDD\u7684\u5185\u5BB9\uFF0C\u800C\u662F\u9012\u8FC7\u53BB\u4E00\u652F\u7B14\uFF0C\u6307\u4E86\u5C4F\u4E0A\u7684\u4E00\u4E2A\u6570\u636E\u8282\u70B9\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u7535\u8BDD\u6302\u65AD\u540E\uFF0C\u7814\u8BA8\u5BA4\u9677\u5165\u4E86\u4E00\u7247\u4EE4\u4EBA\u5FC3\u5B89\u7684\u5BC2\u9759\u3002\u6797\u6E21\u6458\u4E0B\u8033\u673A\uFF0C\u5E76\u6CA1\u6709\u8BE2\u95EE\u7535\u8BDD\u7684\u5185\u5BB9\uFF0C\u800C\u662F\u9012\u8FC7\u53BB\u4E00\u652F\u7B14\uFF0C\u6307\u4E86\u5C4F\u4E0A\u7684\u4E00\u4E2A\u6570\u636E\u8282\u70B9\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u56E0\u4E3A\u5728\u6211\u773C\u91CC\uFF0C\u4F60\u503C\u5F97\u4E00\u5957\u5E72\u5E72\u51C0\u51C0\u7684\u6210\u529F\uFF0C\u800C\u4E0D\u662F\u8FD9\u79CD\u5E26\u7740\u6CE5\u70B9\u7684\u4EA4\u6362\u3002\u201D"
    choices: []
  - documentId: "M2-3-2a\u6C88"
