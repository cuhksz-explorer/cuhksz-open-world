    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u4FBF\u5229\u5E97\u4E2D\uFF0C\u767D\u70BD\u706F\u7BA1\u53D1\u51FA\u7EC6\u5FAE\u7684\u55E1\u9E23\u58F0\uFF0C\u5728\u5BC2\u9759\u7684\u9ED1\u591C\u91CC\u663E\u5F97\u683C\u5916\u523A\u8033\u3002\u6797\u6E21\u5750\u5728\u6700\u89D2\u843D\u7684\u4F4D\u7F6E\uFF0C\u9762\u524D\u662F\u4E00\u676F\u65E9\u5DF2\u51B7\u900F\u7684\u9ED1\u5496\u5561\uFF0C\u8910\u8272\u7684\u6DB2\u9762\u4E0A\u5012\u6620\u7740\u5979\u5E03\u6EE1\u8840\u4E1D\u7684\u53CC\u773C\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u90A3\u4EFD\u4ECE\u65E7\u6863\u6848\u5BA4\u62FC\u6B7B\u62A2\u51FA\u6765\u7684\u6B8B\u7F3A\u540D\u5355\u5C31\u94FA\u5728\u684C\u4E0A\u3002\u96E8\u6C34\u6253\u6E7F\u4E86\u7EB8\u89D2\uFF0C\u539F\u672C\u51B7\u51B0\u51B0\u7684\u6253\u5370\u5B57\u4F53\u5728\u6C34\u6E0D\u4E0B\u5FAE\u5FAE\u6655\u5F00\uFF0C\u50CF\u662F\u4E00\u4E2A\u4E2A\u6323\u624E\u7684\u7075\u9B42\u3002\u6797\u6E21\u7528\u98A4\u6296\u7684\u624B\u6307\u5212\u8FC7\u90A3\u4E09\u4E2A\u88AB\u91CD\u7B14\u6807\u6CE8\u7684\u540D\u5B57\uFF1A\u9648\u5B50\u6DB5\u3001\u674E\u8587\u3001\u5F20\u94ED\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u8FD9\u771F\u7684\u662F\u4E00\u4EFD\u201C\u5904\u51B3\u540D\u5355\u201D\uFF0C\u90A3\u4E48\u5728\u8FD9\u4E2A\u6821\u56ED\u7684\u67D0\u4E2A\u89D2\u843D\uFF0C\u4E00\u5B9A\u8FD8\u7559\u7740\u4ED6\u4EEC\u5B58\u5728\u8FC7\u7684\u75D5\u8FF9\u3002\u7CFB\u7EDF\u53EF\u4EE5\u62B9\u9664\u6863\u6848\uFF0C\u4F46\u62B9\u4E0D\u6389\u4EBA\u7684\u8BB0\u5FC6\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5979\u6DF1\u5438\u4E00\u53E3\u6C14\uFF0C\u5F3A\u8FEB\u81EA\u5DF1\u51B0\u51B7\u7684\u5927\u8111\u91CD\u65B0\u8FD0\u8F6C\u3002\u5979\u5F00\u59CB\u5728\u90A3\u4E9B\u8352\u5E9F\u7684\u6821\u56ED\u8BBA\u575B\u3001\u5C18\u5C01\u7684\u793E\u56E2\u7FA4\u7EC4\u91CC\u68C0\u7D22\u3002\u5979\u53D1\u73B0\uFF0C\u771F\u76F8\u5F80\u5F80\u4E0D\u85CF\u5728\u5B98\u65B9\u7684\u53D9\u4E8B\u91CC\uFF0C\u800C\u85CF\u5728\u90A3\u4E9B\u5E78\u5B58\u8005\u7684\u6050\u60E7\u4E0E\u6C89\u9ED8\u4E4B\u95F4\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u6559\u6388\u5DF2\u8FD1\u9000\u4F11\uFF0C\u5934\u53D1\u82B1\u767D\uFF0C\u773C\u795E\u4E2D\u900F\u7740\u4E00\u79CD\u770B\u7834\u7EA2\u5C18\u7684\u5B64\u5BC2\u3002\u5F53\u6797\u6E21\u4EE5\u201C\u6574\u7406\u4F18\u79C0\u6821\u53CB\u8BBF\u8C08\u201D\u4E3A\u501F\u53E3\u63D0\u5230\u90A3\u4E2A\u540D\u5B57\u65F6\uFF0C\u738B\u6559\u6388\u6B63\u5728\u64E6\u62ED\u70E7\u676F\u7684\u624B\u7A81\u7136\u50F5\u4F4F\u4E86\u3002"
    - pageNumber: 6
      speakerName: "\u738B\u6559\u6388"
      text: "\u5B50\u6DB5\u554A\u2026\u2026\u4ED6\u662F\u4E2A\u592A\u8FFD\u6C42\u201C\u7EAF\u7CB9\u201D\u7684\u5B69\u5B50\u3002\u5728\u8FD9\u6240\u5B66\u6821\u91CC\uFF0C\u7EAF\u7CB9\u5F80\u5F80\u610F\u5473\u7740\u8106\u5F31\u3002"
    - pageNumber: 7
      speakerName: "\u738B\u6559\u6388"
      text: "\u90A3\u662F\u7CFB\u7EDF\u7ED9\u51FA\u7684\u6807\u51C6\u89E3\u91CA\u3002\u771F\u76F8\u662F\uFF0C\u4ED6\u5728\u6700\u540E\u90A3\u9879\u56FD\u5BB6\u7EA7\u8BFE\u9898\u4E2D\u53D1\u73B0\uFF0C\u6211\u4EEC\u7684\u6838\u5FC3\u7B97\u6CD5\u4E3A\u4E86\u8FCE\u5408\u9884\u671F\u7684\u6210\u529F\u7387\uFF0C\u88AB\u67D0\u79CD\u201C\u5916\u90E8\u529B\u91CF\u201D\u4EBA\u4E3A\u690D\u5165\u4E86\u504F\u5DEE\u3002\u4ED6\u62D2\u7EDD\u5728\u9020\u5047\u62A5\u544A\u4E0A\u7B7E\u5B57\uFF0C\u5E76\u8BD5\u56FE\u5411\u5B66\u672F\u59D4\u5458\u4F1A\u516C\u5F00\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u6240\u4EE5\u4ED6\u88AB\u62B9\u9664\u4E86\uFF1F"
    - pageNumber: 9
      speakerName: "\u738B\u6559\u6388"
      text: "\u6BD4\u90A3\u66F4\u6B8B\u9177\u3002\u4E00\u591C\u4E4B\u95F4\uFF0C\u4ED6\u7684\u5B9E\u9A8C\u6570\u636E\u88AB\u91CD\u7F6E\uFF0C\u4ED6\u7684\u5BFC\u5E08\u7EC4\u6210\u5458\u96C6\u4F53\u7F04\u9ED8\u3002\u5927\u5BB6\u90FD\u8BF4\u4ED6\u75AF\u4E86\uFF0C\u8BF4\u4ED6\u7531\u4E8E\u538B\u529B\u8FC7\u5927\u4EA7\u751F\u4E86\u5E7B\u89C9\u3002\u5F53\u4E00\u4E2A\u4EBA\u8BF4\u771F\u8BDD\u5374\u6CA1\u4EBA\u76F8\u4FE1\u65F6\uFF0C\u4ED6\u786E\u5B9E\u79BB\u75AF\u4E0D\u8FDC\u4E86\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u8D70\u51FA\u5B9E\u9A8C\u5BA4\u65F6\uFF0C\u6797\u6E21\u611F\u5230\u8D70\u5ECA\u91CC\u7684\u51B7\u6C14\u51C9\u5F97\u5F7B\u9AA8\u3002\u5979\u660E\u767D\u4E86\uFF0C\u9648\u5B50\u6DB5\u4E0D\u662F\u5931\u8D25\u8005\uFF0C\u4ED6\u662F\u62D2\u7EDD\u6210\u4E3A\u201C\u7CBE\u81F4\u7684\u4F2A\u9020\u8005\u201D\uFF0C\u4E8E\u662F\u88AB\u7CFB\u7EDF\u5224\u5B9A\u4E3A\u4E0D\u53EF\u4FEE\u590D\u7684\u5197\u4F59\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u7B2C\u4E8C\u4E2A\u540D\u5B57\uFF0C\u674E\u8587\u30022018 \u5C4A\u7ECF\u7BA1\u5B66\u9662\u7684\u4F7C\u4F7C\u8005\uFF0C\u66FE\u7ECF\u5DEE\u4E00\u70B9\u5C31\u6210\u4E86\u5B66\u751F\u4F1A\u4E3B\u5E2D\u3002\u6797\u6E21\u5728\u4E50\u5929\u697C\u9876\u5C42\u7684\u9732\u53F0\u4E0A\u627E\u5230\u4E86\u6B63\u5728\u72EC\u5904\u7684\u5468\u781A\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u665A\u98CE\u5439\u4E71\u4E86\u5468\u781A\u4E00\u4E1D\u4E0D\u82DF\u7684\u53D1\u578B\uFF0C\u4ED6\u770B\u7740\u6797\u6E21\u9012\u8FC7\u6765\u7684\u90A3\u4EFD\u6B8B\u9875\uFF0C\u5634\u89D2\u9732\u51FA\u4E00\u62B9\u82E6\u6DA9\u7684\u5F27\u5EA6\u3002"
    - pageNumber: 13
      speakerName: "\u5468\u781A"
      text: "\u4F60\u8FD8\u662F\u67E5\u5230\u5979\u4E86\u3002\u6797\u6E21\uFF0C\u6211\u544A\u8BC9\u8FC7\u4F60\uFF0C\u6709\u4E9B\u79D8\u5BC6\u9002\u5408\u7559\u5728\u96E8\u91CC\u3002"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "\u5979\u662F\u4F60\u7684\u7ADE\u4E89\u5BF9\u624B\uFF0C\u8FD8\u662F\u4F60\u7684\u76DF\u53CB\uFF1F"
    - pageNumber: 15
      speakerName: "\u5468\u781A"
      text: "\u5979\u662F\u6211\u7684\u955C\u5B50\u3002\u674E\u8587\u5F53\u5E74\u8BD5\u56FE\u63A8\u884C\u4E00\u5957\u5B8C\u5168\u900F\u660E\u7684\u8D44\u6E90\u5206\u914D\u7CFB\u7EDF\uFF0C\u5979\u60F3\u8BA9\u90A3\u4E9B\u6CA1\u6709\u80CC\u666F\u3001\u53EA\u4F1A\u8BFB\u4E66\u7684\u5B66\u751F\u4E5F\u80FD\u62FF\u5230\u9876\u7EA7\u7684\u5185\u63A8\u673A\u4F1A\u3002\u5979\u8BD5\u56FE\u6253\u7834\u8FD9\u6240\u5B66\u6821\u91CC\u6700\u9690\u79D8\u7684\u201C\u5206\u914D\u89C4\u5219\u201D\u3002"
    - pageNumber: 16
      speakerName: "\u6797\u6E21"
      text: "\u6240\u4EE5\uFF0C\u7CFB\u7EDF\u5224\u5B9A\u5979\u201C\u5A01\u80C1\u7A33\u6001\u201D\uFF1F"
    - pageNumber: 17
      speakerName: "\u5468\u781A"
      text: "\u5979\u592A\u5929\u771F\u4E86\u3002\u5979\u4EE5\u4E3A\u53EA\u8981\u89C4\u5219\u516C\u5E73\uFF0C\u6240\u6709\u4EBA\u90FD\u4F1A\u652F\u6301\u5979\u3002\u4F46\u5979\u4E0D\u77E5\u9053\uFF0C\u5F88\u591A\u4EBA\u6B63\u662F\u89C4\u5219\u4E0D\u516C\u5E73\u7684\u53D7\u76CA\u8005\u3002\u90A3\u4E00\u5E74\uFF0C\u5979\u56E0\u4E3A\u6240\u8C13\u7684\u201C\u4E2A\u4EBA\u64CD\u5B88\u95EE\u9898\u201D\u88AB\u533F\u540D\u4E3E\u62A5\uFF0C\u867D\u7136\u67E5\u65E0\u5B9E\u636E\uFF0C\u4F46\u5979\u7684\u540D\u58F0\u6BC1\u4E86\u3002\u7CFB\u7EDF\u5F15\u5BFC\u5979\u201C\u56E0\u75C5\u4F11\u5B66\u201D\uFF0C\u7136\u540E\u8FC5\u901F\u7528\u53E6\u4E00\u4E2A\u542C\u8BDD\u7684\u4EBA\u53D6\u4EE3\u4E86\u5979\u3002"
    - pageNumber: 18
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u5F53\u65F6\u4E5F\u5728\u90A3\u4E9B\u53D7\u76CA\u8005\u4E2D\u95F4\u5417\uFF0C\u5468\u781A\uFF1F"
    - pageNumber: 19
      speakerName: "\u5468\u781A"
      text: "\u2026\u2026\u6211\u53EA\u662F\u9009\u62E9\u4E86\u987A\u5E94\u89C4\u5219\u3002\u6797\u6E21\uFF0C\u5982\u679C\u4F60\u4E0D\u60F3\u6210\u4E3A\u7B2C\u4E8C\u4E2A\u674E\u8587\uFF0C\u73B0\u5728\u5C31\u70E7\u4E86\u90A3\u4EFD\u540D\u5355\u3002"
    - pageNumber: 20
      speakerName: 
      text: "\u5468\u781A\u8F6C\u8FC7\u8EAB\uFF0C\u80CC\u5F71\u5728\u4E07\u5BB6\u706F\u706B\u7684\u6620\u886C\u4E0B\u663E\u5F97\u5F02\u5E38\u5B64\u5355\u3002\u6797\u6E21\u770B\u7740\u5979\uFF0C\u610F\u8BC6\u5230\u5468\u781A\u7684\u201C\u535A\u5F08\u201D\u5176\u5B9E\u4E5F\u662F\u4E00\u79CD\u5728\u7CFB\u7EDF\u8FB9\u7F18\u7684\u6323\u624E\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u6797\u6E21\u5728\u795E\u4ED9\u6E56\u7554\u7684\u957F\u6905\u4E0A\u627E\u5230\u4E86\u987E\u6F84\u3002\u4ED6\u6B63\u51FA\u795E\u5730\u770B\u7740\u6E56\u9762\u4E0A\u8DF3\u8DC3\u7684\u9CDE\u5149\uFF0C\u624B\u91CC\u62FF\u7740\u4E00\u53EA\u5DF2\u7ECF\u574F\u6389\u7684\u80F6\u7247\u76F8\u673A\u3002"
    - pageNumber: 22
      speakerName: "\u987E\u6F84"
      text: "\u5F20\u94ED\u554A\uFF0C\u4ED6\u662F\u552F\u4E00\u4E00\u4E2A\u4F1A\u8DDF\u6211\u5728\u8FD9\u91CC\u5750\u4E00\u6574\u665A\uFF0C\u53EA\u4E3A\u4E86\u7B49\u90A3\u4E00\u9635\u201C\u4E0D\u5C5E\u4E8E\u8BFE\u8868\u201D\u7684\u665A\u98CE\u7684\u4EBA\u3002"
    - pageNumber: 23
      speakerName: "\u6797\u6E21"
      text: "\u5927\u5BB6\u90FD\u8BF4\u4ED6\u62FF\u4E86\u6EE1\u7EE9 4.0\uFF0C\u524D\u9014\u65E0\u91CF\u3002\u4ED6\u4E3A\u4EC0\u4E48\u8981\u8D70\uFF1F"
    - pageNumber: 24
      speakerName: "\u987E\u6F84"
      text: "\u56E0\u4E3A\u4ED6\u5728\u7B7E\u4E0B\u90A3\u4EFD\u5E74\u85AA\u767E\u4E07\u7684\u5408\u540C\u65F6\uFF0C\u7A81\u7136\u95EE\u6211\u2014\u2014\u201C\u987E\u6F84\uFF0C\u5982\u679C\u6211\u628A\u63A5\u4E0B\u6765\u7684\u56DB\u5341\u5E74\u90FD\u5356\u7ED9\u4E86\u8FD9\u4E2A\u7CFB\u7EDF\uFF0C\u90A3\u6211\u4EC0\u4E48\u65F6\u5019\u624D\u80FD\u4E3A\u81EA\u5DF1\u6D3B\u4E00\u79D2\u949F\uFF1F\u201D\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u6240\u4EE5\u4ED6\u9009\u62E9\u4E86\u6D88\u5931\uFF1F"
    - pageNumber: 26
      speakerName: "\u987E\u6F84"
      text: "\u4ED6\u628A\u90A3\u4EFD\u5408\u540C\u6298\u6210\u7EB8\u8239\uFF0C\u5C31\u5728\u8FD9\u91CC\uFF0C\u653E\u8FDB\u4E86\u795E\u4ED9\u6E56\u3002\u7CFB\u7EDF\u5224\u5B9A\u4ED6\u4E3A\u201C\u5FC3\u7406\u5371\u673A\u201D\uFF0C\u4F46\u6211\u89C9\u5F97\uFF0C\u4ED6\u662F\u552F\u4E00\u4E00\u4E2A\u771F\u6B63\u6E05\u9192\u7684\u4EBA\u3002\u4ED6\u526A\u788E\u4E86\u8EAB\u4E0A\u6240\u6709\u7684\u6807\u7B7E\uFF0C\u628A\u81EA\u5DF1\u8FD8\u7ED9\u4E86\u8352\u91CE\u3002"
    - pageNumber: 27
      speakerName: 
      text: "\u6797\u6E21\u5750\u5728\u987E\u6F84\u8EAB\u8FB9\uFF0C\u6E56\u9762\u7684\u98CE\u5439\u8FC7\uFF0C\u5E26\u8D70\u4E86\u5979\u8EAB\u4E0A\u4EC5\u5B58\u7684\u4E00\u70B9\u6696\u610F\u3002"
    - pageNumber: 28
      speakerName: 
      text: "\u4E09\u4E2A\u540D\u5B57\uFF0C\u4E09\u6761\u8DEF\u5F84\u3002\u9648\u5B50\u6DB5\u5B88\u536B\u4E86\u771F\u7406\uFF0C\u674E\u8587\u8FFD\u6C42\u4E86\u516C\u6B63\uFF0C\u5F20\u94ED\u627E\u56DE\u4E86\u81EA\u6211\u3002"
    - pageNumber: 29
      speakerName: 
      text: "\u4ED6\u4EEC\u90FD\u4E0D\u662F\u4E16\u4FD7\u610F\u4E49\u4E0A\u7684\u201C\u5931\u8D25\u8005\u201D\u3002\u6070\u6070\u76F8\u53CD\uFF0C\u4ED6\u4EEC\u662F\u56E0\u4E3A\u5728\u8FBE\u5230\u8FD9\u4E2A\u7CFB\u7EDF\u6240\u5B9A\u4E49\u7684\u5DC5\u5CF0\u4E4B\u540E\uFF0C\u4F9D\u7136\u4FDD\u7559\u4E86\u4F5C\u4E3A\u4EBA\u7684\u90A3\u90E8\u5206\u201C\u6742\u8D28\u201D\u3002"
    - pageNumber: 30
      speakerName: "\u6797\u6E21"
      text: "\u539F\u6765\uFF0C\u8FD9\u4EFD\u540D\u5355\u5E76\u4E0D\u662F\u201C\u5E9F\u7269\u540D\u5355\u201D\uFF0C\u5B83\u662F\u201C\u89C9\u9192\u8005\u540D\u5355\u201D\u3002"
    - pageNumber: 31
      speakerName: 
      text: "\u624B\u673A\u5728\u53E3\u888B\u91CC\u5267\u70C8\u9707\u52A8\u8D77\u6765\uFF0C\u5C4F\u5E55\u4E0A\u8DF3\u51FA\u4E86\u955C\u50CF\u6797\u6E21\u90A3\u5F20\u6BEB\u65E0\u8868\u60C5\u7684\u8138\u3002"
    - pageNumber: 32
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u62FC\u56FE\u51D1\u9F50\u4E86\u5417\uFF1F\u6797\u6E21\uFF0C\u4F60\u5E94\u8BE5\u5DF2\u7ECF\u53D1\u73B0\u4E86\u3002\u6C88\u9752\u79BE\u3001\u5468\u781A\u3001\u987E\u6F84\uFF0C\u4ED6\u4EEC\u6BCF\u4E2A\u4EBA\u90FD\u66FE\u6709\u673A\u4F1A\u6210\u4E3A\u540D\u5355\u4E0A\u7684\u4E00\u5458\u3002"
    - pageNumber: 33
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u6C88\u9752\u79BE\u53D1\u73B0\u4E86\u6570\u636E\u7684\u4F2A\u9020\uFF0C\u4F46\u5979\u9009\u62E9\u4E86\u901A\u8FC7\u903B\u8F91\u6765\u81EA\u6211\u9EBB\u75F9\uFF1B\u5468\u781A\u770B\u900F\u4E86\u6743\u529B\u7684\u80AE\u810F\uFF0C\u4F46\u4ED6\u9009\u62E9\u4E86\u6210\u4E3A\u6743\u529B\u7684\u4EE3\u7406\u4EBA\uFF1B\u987E\u6F84\u611F\u53D7\u5230\u4E86\u7075\u9B42\u7684\u67AF\u840E\uFF0C\u4F46\u4ED6\u9009\u62E9\u4E86\u5728\u5E7B\u89C9\u4E2D\u82DF\u5EF6\u6B8B\u5598\u3002"
    - pageNumber: 34
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u800C\u4F60\uFF0C\u6797\u6E21\u3002\u4F60\u662F\u8FD9\u56DB\u5E74\u6765\u6700\u5B8C\u7F8E\u7684\u4E00\u7EC4\u6570\u636E\u3002\u4F60\u7ECF\u5386\u4E86\u6240\u6709\u4ED6\u4EEC\u7684\u75DB\u82E6\uFF0C\u5374\u4F9D\u7136\u6CA1\u6709\u59A5\u534F\u3002"
    - pageNumber: 35
      speakerName: 
      text: "\u6797\u6E21\u7AD9\u8D77\u8EAB\uFF0C\u5C06\u90A3\u4EFD\u540D\u5355\u7D27\u7D27\u8D34\u5728\u80F8\u53E3\u3002\u5979\u611F\u5230\u5FC3\u810F\u7684\u8DF3\u52A8\u53D8\u5F97\u524D\u6240\u672A\u6709\u7684\u6709\u529B\uFF0C\u76D6\u8FC7\u4E86\u8FDC\u5904\u949F\u697C\u6C89\u95F7\u7684\u949F\u58F0\u3002"
    - pageNumber: 36
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u505A\u4E00\u4E2A\u201C\u5B8C\u6574\u7684\u4EBA\u201D\u5C31\u5FC5\u987B\u88AB\u8FD9\u4E2A\u7CFB\u7EDF\u5254\u9664\uFF0C\u90A3\u6211\u4E5F\u60F3\u770B\u770B\uFF0C\u8FD9\u7247\u5927\u6D77\u7684\u5E95\u8272\u5230\u5E95\u662F\u4EC0\u4E48\u3002"
    - pageNumber: 37
      speakerName: 
      text: "\u5929\u8FB9\u9690\u7EA6\u6CDB\u8D77\u4E86\u9C7C\u809A\u767D\uFF0C\u7167\u4EAE\u4E86\u9F99\u7FD4\u5927\u9053\u7684\u5C3D\u5934\u3002\u90A3\u4E9B\u5B8F\u4F1F\u7684\u5EFA\u7B51\u4F9D\u7136\u9759\u9ED8\uFF0C\u4F46\u5728\u6797\u6E21\u773C\u4E2D\uFF0C\u5B83\u4EEC\u5DF2\u7ECF\u4E0D\u518D\u662F\u77E5\u8BC6\u7684\u5723\u6BBF\uFF0C\u800C\u662F\u4E00\u5EA7\u5EA7\u7B49\u5F85\u88AB\u63A8\u5012\u7684\u65E7\u795E\u50CF\u3002"
    - pageNumber: 38
      speakerName: 
      text: "\u5979\u8F6C\u8FC7\u8EAB\uFF0C\u5927\u6B65\u8D70\u5411\u90A3\u4E2A\u901A\u5F80\u7EC8\u6781\u6289\u62E9\u7684\u884C\u653F\u4E2D\u5FC3\u3002\u5979\u7684\u80CC\u5F71\u5728\u6668\u96FE\u4E2D\u663E\u5F97\u5F02\u5E38\u5B64\u5355\uFF0C\u5374\u53C8\u5E26\u7740\u4E00\u79CD\u89C6\u6B7B\u5982\u5F52\u7684\u60B2\u58EE\u3002"
    choices: []
  - documentId: M5-3-1
    title: M5-3-1
    sourceAssetPath: Assets/content1/M5/M5-3-1.docx
    chapterId: M5
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m5_3_1
    npcId: "npc_\u955C\u50CF\u6797\u6E21"
    locationId: m5_flower_bed
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1359.56, y: 14.58, z: 1075.28}
    rewardGold: 25
    finishLocationName: "\u82B1\u575B\u4E2D\u5FC3"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u884C\u653F\u5927\u697C\u9876\u5C42\u7684\u9732\u53F0\uFF0C\u98CE\u58F0\u5982\u540C\u4E00\u5934\u88AB\u56F0\u5728\u6DF7\u51DD\u571F\u7F1D\u9699\u91CC\u7684\u56F0\u517D\uFF0C\u53D1\u51FA\u4F4E\u6C89\u800C\u51C4\u5389\u7684\u5486\u54EE\u3002\u96E8\u867D\u7136\u505C\u4E86\uFF0C\u4F46\u539A\u91CD\u7684\u4E91\u5C42\u4F9D\u7136\u4F4E\u4F4E\u5730\u538B\u5728\u6821\u56ED\u4E0A\u65B9\uFF0C\u4EFF\u4F5B\u53EA\u8981\u4F38\u624B\u5C31\u80FD\u89E6\u78B0\u5230\u90A3\u7247\u7070\u8272\u7684\u3001\u4EE4\u4EBA\u7A92\u606F\u7684\u5929\u5E55\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u7AD9\u5728\u5929\u53F0\u8FB9\u7F18\uFF0C\u72C2\u98CE\u5377\u8D77\u5979\u7684\u8863\u89D2\uFF0C\u730E\u730E\u4F5C\u54CD\u3002\u5979\u624B\u4E2D\u7D27\u7D27\u6525\u7740\u90A3\u4E2A\u5DF2\u7ECF\u6709\u4E9B\u7834\u635F\u7684\u725B\u76AE\u7EB8\u888B\uFF0C\u91CC\u9762\u88C5\u7740\u7684\u4E0D\u4EC5\u4EC5\u662F\u4E09\u4EFD\u88AB\u62B9\u9664\u7684\u4EBA\u751F\uFF0C\u66F4\u662F\u6574\u5EA7\u201C\u672A\u540D\u4E4B\u6D77\u201D\u6700\u6DF1\u5904\u7684\u6697\u7901\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u53EA\u8981\u518D\u5F80\u524D\u4E00\u6B65\uFF0C\u5979\u5C31\u80FD\u4FEF\u77B0\u6574\u5EA7\u9F99\u7FD4\u5927\u9053\u7684\u5168\u8C8C\u3002\u90A3\u4E9B\u5B8F\u4F1F\u7684\u6559\u5B66\u697C\u3001\u9519\u843D\u6709\u81F4\u7684\u8FDE\u5ECA\uFF0C\u5728\u660F\u6697\u7684\u5929\u5149\u4E0B\u663E\u5F97\u5982\u6B64\u8083\u7A46\u3001\u5982\u6B64\u4E0D\u53EF\u6311\u6218\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u9732\u53F0\u7684\u73BB\u7483\u95E8\u4E0A\u6620\u51FA\u4E86\u4E00\u4E2A\u6A21\u7CCA\u7684\u4EBA\u5F71\u3002\u6797\u6E21\u56DE\u8FC7\u5934\uFF0C\u770B\u89C1\u90A3\u4E2A\u548C\u81EA\u5DF1\u957F\u5F97\u4E00\u6A21\u4E00\u6837\u3001\u773C\u795E\u5374\u51B7\u5F97\u50CF\u51B0\u7684\u201C\u955C\u50CF\u201D\u6B63\u9760\u5728\u9634\u5F71\u91CC\u3002"
    - pageNumber: 5
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u624B\u91CC\u7684\u4E1C\u897F\u5F88\u91CD\u5427\uFF1F\u90A3\u4E0D\u662F\u51E0\u5F20\u7EB8\uFF0C\u90A3\u662F\u80FD\u8BA9\u8FD9\u7247\u6D77\u6CB8\u817E\u7684\u706B\u79CD\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u5230\u5E95\u5728\u671F\u5F85\u4EC0\u4E48\uFF1F\u671F\u5F85\u6211\u628A\u5B83\u6254\u4E0B\u53BB\uFF0C\u770B\u5B83\u5728\u98CE\u91CC\u788E\u6389\uFF1F\u8FD8\u662F\u671F\u5F85\u6211\u628A\u5B83\u53D1\u7ED9\u6240\u6709\u7684\u6821\u5185\u90AE\u4EF6\u5730\u5740\uFF0C\u770B\u8FD9\u4E2A\u7CFB\u7EDF\u77AC\u95F4\u762B\u75EA\uFF1F"
    - pageNumber: 7
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u7CFB\u7EDF\u4F1A\u6709\u4E00\u4E07\u79CD\u65B9\u6CD5\u8BA9\u4F60\u95ED\u5634\u3002\u5B83\u4F1A\u6CE8\u9500\u4F60\u7684\u5B66\u53F7\uFF0C\u64A4\u56DE\u4F60\u7684\u5165\u804C\u786E\u8BA4\uFF0C\u751A\u81F3\u4F1A\u5F15\u5BFC\u6240\u6709\u4EBA\u76F8\u4FE1\uFF0C\u4F60\u662F\u56E0\u4E3A\u538B\u529B\u8FC7\u5927\u800C\u4EA7\u751F\u4E86\u5984\u60F3\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u6211\u77E5\u9053\u3002\u9648\u5B50\u6DB5\u8BD5\u8FC7\u4E86\uFF0C\u674E\u8587\u4E5F\u8BD5\u8FC7\u4E86\u3002"
    - pageNumber: 9
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u90A3\u4F60\u5462\uFF1F\u4F60\u8FD8\u8981\u50CF\u4ED6\u4EEC\u4E00\u6837\uFF0C\u628A\u81EA\u5DF1\u53D8\u6210\u4E00\u4E32\u88AB\u7CFB\u7EDF\u683C\u5F0F\u5316\u7684\u4E71\u7801\u5417\uFF1F"
    - pageNumber: 10
      speakerName: 
      text: "\u5C31\u5728\u8FD9\u65F6\uFF0C\u901A\u5F80\u9876\u5C42\u9732\u53F0\u7684\u95E8\u518D\u6B21\u88AB\u63A8\u5F00\u3002\u6C89\u91CD\u7684\u811A\u6B65\u58F0\u4F34\u968F\u7740\u6025\u4FC3\u7684\u547C\u5438\u58F0\uFF0C\u4E09\u4E2A\u8EAB\u5F71\u5148\u540E\u51FA\u73B0\u5728\u4E86\u6797\u6E21\u7684\u89C6\u91CE\u91CC\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u9996\u5148\u8D70\u51FA\u6765\u7684\u662F\u6C88\u9752\u79BE\u3002\u4ED6\u4F9D\u7136\u7A7F\u7740\u90A3\u8EAB\u6574\u6D01\u7684\u886C\u886B\uFF0C\u624B\u4E2D\u7684\u5E73\u677F\u7535\u8111\u5C4F\u5E55\u4EAE\u7740\uFF0C\u4E0A\u9762\u8DF3\u52A8\u7740\u590D\u6742\u7684\u6570\u636E\u6D41\u3002"
    - pageNumber: 12
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6797\u6E21\uFF0C\u522B\u51B2\u52A8\u3002\u6211\u5DF2\u7ECF\u8FFD\u8E2A\u5230\u4E86\u4F60\u7684\u7EC8\u7AEF\u5F02\u5E38\u3002\u8FD9\u4EFD\u540D\u5355\u5982\u679C\u88AB\u5927\u8303\u56F4\u516C\u5F00\uFF0C\u5F15\u53D1\u7684\u7FA4\u4F53\u6027\u7126\u8651\u4F1A\u8D85\u51FA\u7CFB\u7EDF\u7684\u627F\u8F7D\u6781\u9650\u3002"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u9752\u79BE\uFF0C\u4F60\u65E9\u5C31\u77E5\u9053\u8FD9\u4EFD\u540D\u5355\u7684\u5B58\u5728\uFF0C\u5BF9\u5417\uFF1F"
    - pageNumber: 14
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u6211\u901A\u8FC7\u6A21\u578B\u63A8\u6F14\u8FC7\u5B83\u7684\u5B58\u5728\u6982\u7387\u3002\u4F46\u6797\u6E21\uFF0C\u6570\u636E\u544A\u8BC9\u6211\u4EEC\uFF0C\u4EFB\u4F55\u6781\u7AEF\u7684\u53D8\u9769\u90FD\u4F1A\u5E26\u6765\u66F4\u5927\u7684\u7834\u574F\u3002\u5982\u679C\u4F60\u60F3\u6539\u53D8\u8FD9\u4E2A\u7CFB\u7EDF\uFF0C\u4F60\u5E94\u8BE5\u7559\u4E0B\u6765\uFF0C\u8FDB\u5165\u7BA1\u7406\u5C42\uFF0C\u7528\u66F4\u7406\u6027\u7684\u65B9\u5F0F\u53BB\u4F18\u5316\u5B83\u3002"
    - pageNumber: 15
      speakerName: 
      text: "\u5468\u781A\u7D27\u968F\u5176\u540E\uFF0C\u5979\u4E00\u5411\u4ECE\u5BB9\u7684\u8138\u4E0A\u7F55\u89C1\u5730\u5E26\u4E86\u4E00\u4E1D\u7126\u8651\uFF0C\u9886\u5E26\u4E5F\u5FAE\u5FAE\u6B6A\u659C\u3002"
    - pageNumber: 16
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u542C\u9752\u79BE\u7684\u3002\u628A\u540D\u5355\u4EA4\u7ED9\u6211\uFF0C\u6211\u53EF\u4EE5\u5229\u7528\u6211\u7684\u6E20\u9053\uFF0C\u628A\u8FD9\u4EFD\u540D\u5355\u9012\u7ED9\u8463\u4E8B\u4F1A\u3002\u6211\u4EEC\u53EF\u4EE5\u901A\u8FC7\u5185\u90E8\u95ED\u95E8\u4F1A\u8BAE\uFF0C\u4E3A\u90A3\u4E9B\u6D88\u5931\u7684\u4EBA\u4E89\u53D6\u540D\u8A89\u8865\u507F\uFF0C\u751A\u81F3\u53EF\u4EE5\u63A8\u52A8\u8BC4\u4EF7\u4F53\u7CFB\u7684\u5FAE\u8C03\u3002"
    - pageNumber: 17
      speakerName: "\u6797\u6E21"
      text: "\u5185\u90E8\u95ED\u95E8\u4F1A\u8BAE\uFF1F\u7136\u540E\u5462\uFF1F\u8FD9\u4EFD\u540D\u5355\u4F9D\u7136\u4F1A\u88AB\u9501\u8FDB\u6863\u6848\u5BA4\uFF0C\u5916\u9762\u7684\u4EBA\u4F9D\u7136\u4F1A\u89C9\u5F97\u81EA\u5DF1\u751F\u6D3B\u5728\u4E00\u4E2A\u5B8C\u7F8E\u7684\u6EE4\u955C\u91CC\uFF0C\u5BF9\u5417\uFF1F"
    - pageNumber: 18
      speakerName: 
      text: "\u987E\u6F84\u8D70\u5728\u6700\u540E\u3002\u4ED6\u6CA1\u6709\u770B\u90A3\u4EFD\u540D\u5355\uFF0C\u53EA\u662F\u9759\u9759\u5730\u6CE8\u89C6\u7740\u6797\u6E21\uFF0C\u773C\u795E\u91CC\u5E26\u7740\u4E00\u79CD\u8FD1\u4E4E\u900F\u660E\u7684\u7EAF\u7CB9\u3002"
    - pageNumber: 19
      speakerName: "\u987E\u6F84"
      text: "\u6797\u6E21\uFF0C\u4F60\u8981\u60F3\u6E05\u695A\uFF0C\u8FD9\u4EFD\u540D\u5355\u4E0A\u7684\u4EBA\u2026\u2026\u4ED6\u4EEC\u8FD8\u60F3\u88AB\u62C9\u56DE\u5230\u8FD9\u4E2A\u7CFB\u7EDF\u91CC\u5417\uFF1F"
    - pageNumber: 20
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u4EC0\u4E48\u610F\u601D\uFF0C\u987E\u6F84\uFF1F"
    - pageNumber: 21
      speakerName: "\u987E\u6F84"
      text: "\u5F20\u94ED\u8DDF\u6211\u8BF4\u8FC7\uFF0C\u4ED6\u8D70\u7684\u90A3\u5929\uFF0C\u6700\u540E\u6094\u7684\u4E8B\u5C31\u662F\u6CA1\u6709\u4EB2\u624B\u70E7\u6389\u5173\u4E8E\u81EA\u5DF1\u7684\u6240\u6709\u8BB0\u5F55\u3002\u5982\u679C\u4F60\u516C\u5F00\u8FD9\u4EFD\u540D\u5355\uFF0C\u4ED6\u4EEC\u4F1A\u91CD\u65B0\u53D8\u6210\u522B\u4EBA\u8BA8\u8BBA\u7684\u8C08\u8D44\uFF0C\u53D8\u6210\u88AB\u7CFB\u7EDF\u53CD\u590D\u89E3\u5256\u7684\u6837\u672C\u3002"
    - pageNumber: 22
      speakerName: "\u987E\u6F84"
      text: "\u4E5F\u8BB8\u5BF9\u4ED6\u4EEC\u6765\u8BF4\uFF0C\u771F\u6B63\u7684\u4FDD\u62A4\u662F\u8BA9\u4ED6\u4EEC\u5F7B\u5E95\u6D88\u5931\u5728\u8FD9\u4E9B\u4EE3\u7801\u91CC\uFF0C\u628A\u4ED6\u4EEC\u7684\u6545\u4E8B\u7559\u7ED9\u771F\u6B63\u61C2\u5F97\u7684\u4EBA\uFF0C\u800C\u4E0D\u662F\u7559\u7ED9\u90A3\u4E9B\u53EA\u4F1A\u770B\u620F\u7684\u89C2\u4F17\u3002"
    - pageNumber: 23
      speakerName: 
      text: "\u6797\u6E21\u4F4E\u5934\u770B\u7740\u624B\u4E2D\u7684\u6863\u6848\u3002\u98CE\u66F4\u5927\u4E86\uFF0C\u7EB8\u9875\u5728\u888B\u5B50\u91CC\u53D1\u51FA\u6C99\u6C99\u7684\u58F0\u54CD\uFF0C\u4EFF\u4F5B\u662F\u9648\u5B50\u6DB5\u3001\u674E\u8587\u548C\u5F20\u94ED\u5728\u9694\u7740\u65F6\u7A7A\u5BF9\u5979\u8033\u8BED\u3002"
    - pageNumber: 24
      speakerName: 
      text: "\u4E09\u4E2A\u670B\u53CB\uFF0C\u4E09\u6761\u8DEF\u5F84\u3002\u516C\u5F00\u5168\u6821\uFF0C\u662F\u60E8\u70C8\u7684\u771F\u76F8\uFF1B\u63D0\u4EA4\u6821\u65B9\uFF0C\u662F\u6E29\u548C\u7684\u6539\u826F\uFF1B\u4FDD\u5BC6\u8BB0\u5F55\uFF0C\u662F\u6700\u540E\u7684\u5C0A\u91CD\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u56DB\u5E74\u6765\uFF0C\u6211\u4E00\u76F4\u5728\u7B97\u8FD9\u9053\u9898\u3002\u6211\u4EE5\u4E3A\u7B54\u6848\u5728\u7EE9\u70B9\u91CC\uFF0C\u5728\u7B80\u5386\u91CC\uFF0C\u5728\u8FD9\u4E9B\u6863\u6848\u91CC\u3002"
    - pageNumber: 26
      speakerName: "\u6797\u6E21"
      text: "\u53EF\u73B0\u5728\u6211\u53D1\u73B0\uFF0C\u8FD9\u9053\u9898\u6CA1\u6709\u6807\u51C6\u7B54\u6848\u3002\u53EA\u6709\u6211\u613F\u610F\u652F\u4ED8\u7684\u4EE3\u4EF7\u3002"
    - pageNumber: 27
      speakerName: 
      text: "\u955C\u50CF\u6797\u6E21\u7F13\u7F13\u8D70\u5230\u5979\u8EAB\u8FB9\uFF0C\u8EAB\u5F71\u4E0E\u6C88\u9752\u79BE\u3001\u5468\u781A\u3001\u987E\u6F84\u4EA4\u7EC7\u5728\u4E00\u8D77\uFF0C\u6784\u6210\u4E86\u4E00\u9053\u65E0\u5F62\u7684\u538B\u529B\u5899\u3002"
    - pageNumber: 28
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u65F6\u95F4\u5230\u4E86\uFF0C\u6797\u6E21\u3002\u884C\u653F\u697C\u7684\u4FE1\u53F7\u5E72\u6270\u5668\u5C06\u5728\u4E09\u5206\u949F\u540E\u542F\u52A8\u3002\u4F60\u8981\u4E48\u4E0A\u4F20\uFF0C\u8981\u4E48\u4EA4\u51FA\uFF0C\u8981\u4E48\u9500\u6BC1\u3002"
    - pageNumber: 29
      speakerName: "\u6797\u6E21"
      text: "\u6211\u66FE\u7ECF\u95EE\u8FC7 Null\uFF0C\u5982\u679C\u6CA1\u6709\u89C2\u4F17\uFF0C\u6211\u662F\u8C01\u3002"
    - pageNumber: 30
      speakerName: "\u6797\u6E21"
      text: "\u73B0\u5728\u6211\u7EC8\u4E8E\u77E5\u9053\u4E86\u3002\u6211\u662F\u90A3\u4E2A\u5728\u6EE1\u5206\u4E4B\u540E\uFF0C\u4F9D\u7136\u6562\u4E8E\u628A\u8BD5\u5377\u6495\u6389\u7684\u4EBA\u3002"
    - pageNumber: 31
      speakerName: 
      text: "\u6797\u6E21\u6DF1\u5438\u4E00\u53E3\u6C14\uFF0C\u51B0\u51B7\u7684\u7A7A\u6C14\u5145\u6EE1\u4E86\u5979\u7684\u80BA\u90E8\uFF0C\u5E26\u7ED9\u5979\u4E00\u79CD\u8FD1\u4E4E\u75DB\u695A\u7684\u6E05\u9192\u3002\u5979\u7684\u624B\u6307\u60AC\u505C\u5728\u624B\u673A\u5C4F\u5E55\u7684\u201C\u5168\u6821\u5E7F\u64AD\u201D\u6309\u952E\u4E0A\uFF0C\u53E6\u4E00\u53EA\u624B\u5219\u6309\u5728\u4E86\u5468\u781A\u4F38\u51FA\u7684\u624B\u5FC3\u4E0A\u65B9\uFF0C\u800C\u5979\u7684\u76EE\u5149\u5374\u505C\u7559\u5728\u4E86\u987E\u6F84\u90A3\u5F20\u4EE3\u8868\u7740\u81EA\u7531\u7684\u8138\u4E0A\u3002"
    - pageNumber: 32
      speakerName: "\u6797\u6E21"
      text: "\u9752\u79BE\uFF0C\u903B\u8F91\u4E0D\u662F\u4E07\u80FD\u7684\uFF1B\u5468\u781A\uFF0C\u5229\u76CA\u4E0D\u662F\u6C38\u6052\u7684\uFF1B\u987E\u6F84\uFF0C\u9003\u907F\u4E5F\u4E0D\u662F\u7EC8\u70B9\u3002"
    - pageNumber: 33
      speakerName: 
      text: "\u5979\u95ED\u4E0A\u773C\u775B\uFF0C\u8111\u6D77\u4E2D\u6D6E\u73B0\u51FA\u9648\u5B50\u6DB5\u88AB\u6E05\u7A7A\u7684\u5B9E\u9A8C\u65E5\u5FD7\uFF0C\u674E\u8587\u88AB\u64A4\u4E0B\u7684\u7ADE\u9009\u6D77\u62A5\uFF0C\u8FD8\u6709\u5F20\u94ED\u6F02\u6D6E\u5728\u6E56\u9762\u4E0A\u7684\u7EB8\u8239\u3002"
    - pageNumber: 34
      speakerName: 
      text: "\u4ED6\u4EEC\u7684\u540D\u5B57\u4E0D\u5E94\u8BE5\u53EA\u662F\u6CE8\u811A\u3002"
    - pageNumber: 35
      speakerName: 
      text: "\u6797\u6E21\u7684\u624B\u6307\u7528\u529B\u6309\u4E86\u4E0B\u53BB\u3002"
    - pageNumber: 36
      speakerName: 
      text: "\u6574\u5EA7\u884C\u653F\u5927\u697C\u7684\u7535\u5B50\u5C4F\u5E55\u77AC\u95F4\u95EA\u70C1\uFF0C\u539F\u672C\u64AD\u653E\u7740\u6821\u5E86\u5BA3\u4F20\u7247\u7684\u5DE8\u578B\u5C4F\u5E55\u7A81\u7136\u5B9A\u683C\uFF0C\u968F\u540E\u5F00\u59CB\u6EDA\u52A8\u51FA\u4E00\u884C\u884C\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u540D\u5355\u3002"
    - pageNumber: 37
      speakerName: 
      text: "\u90A3\u662F\u90A3\u4E9B\u6D88\u5931\u8005\u7684\u540D\u5B57\uFF0C\u662F\u4ED6\u4EEC\u7684\u7EE9\u70B9\uFF0C\u662F\u4ED6\u4EEC\u88AB\u7CFB\u7EDF\u62B9\u9664\u7684\u771F\u5B9E\u539F\u56E0\u3002"
    - pageNumber: 38
      speakerName: 
      text: "\u6C88\u9752\u79BE\u95ED\u4E0A\u4E86\u773C\u775B\uFF0C\u5468\u781A\u762B\u5012\u5728\u957F\u6905\u4E0A\uFF0C\u800C\u987E\u6F84\u9732\u51FA\u4E86\u4E00\u4E2A\u5982\u91CA\u91CD\u8D1F\u7684\u5FAE\u7B11\u3002"
    - pageNumber: 39
      speakerName: 
      text: "\u4F46\u5979\u7EC8\u4E8E\u542C\u5230\u4E86\u90A3\u4E2A\u6700\u771F\u5B9E\u7684\u58F0\u97F3\u3002"
    - pageNumber: 40
      speakerName: 
      text: "\u955C\u50CF\u6797\u6E21\u5728\u98CE\u4E2D\u9010\u6E10\u6DE1\u5316\uFF0C\u6700\u540E\u53D8\u6210\u4E86\u4E00\u9762\u900F\u660E\u7684\u955C\u5B50\u3002\u6797\u6E21\u5728\u955C\u5B50\u91CC\u770B\u5230\u4E86\u81EA\u5DF1\uFF0C\u4E0D\u518D\u662F\u90A3\u4E2A\u7A7F\u7740\u9ED1\u91D1\u5B66\u4F4D\u670D\u7684\u6EE1\u5206\u6BD5\u4E1A\u751F\uFF0C\u800C\u662F\u4E00\u4E2A\u773C\u795E\u6E05\u4EAE\u3001\u7EC8\u4E8E\u627E\u56DE\u4E86\u5F71\u5B50\u7684\u6F5C\u884C\u8005\u3002"
    - pageNumber: 41
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u624D\u662F\u2026\u2026\u7B2C\u4E00\u8BFE\u3002"
    - pageNumber: 42
      speakerName: 
      text: "\u949F\u697C\u7684\u949F\u58F0\u6BEB\u65E0\u5F81\u5146\u5730\u6572\u54CD\u4E86\u3002"
    - pageNumber: 43
      speakerName: 
      text: "\u4E00\u58F0\u3001\u4E24\u58F0\u3001\u4E09\u58F0\u3002"
    - pageNumber: 44
      speakerName: 
      text: "\u5F53\u7B2C\u56DB\u58F0\u949F\u54CD\u5728\u5BC2\u9759\u7684\u6821\u56ED\u4E0A\u7A7A\u56DE\u8361\u65F6\uFF0C\u6797\u6E21\u5E76\u6CA1\u6709\u56DE\u5934\uFF0C\u5979\u8D70\u5411\u4E86\u90A3\u9053\u901A\u5F80\u672A\u77E5\u6DF1\u5904\u7684\u697C\u68AF\u3002"
    choices: []
  - documentId: M5-4-1
    title: M5-4-1
    sourceAssetPath: Assets/content1/M5/M5-4-1.docx
    chapterId: M5
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m5_4_1
    npcId: "npc_\u955C\u50CF"
    locationId: m5_flagpole
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1359.56, y: 13.74, z: 1109.88}
    rewardGold: 25
    finishLocationName: "\u56FD\u65D7\u65D7\u6746\u4E0B"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u7B2C\u56DB\u58F0\u949F\u54CD\u5728\u5BC2\u9759\u7684\u6821\u56ED\u4E0A\u7A7A\u56DE\u8361\uFF0C\u90A3\u58F0\u97F3\u4E0D\u50CF\u662F\u91D1\u5C5E\u649E\u51FB\u7684\u4F59\u97F3\uFF0C\u5012\u66F4\u50CF\u662F\u67D0\u79CD\u6C89\u91CD\u7684\u94C1\u95E8\u5728\u6DF1\u6C34\u4E0B\u88AB\u7F13\u7F13\u63A8\u5F00\u3002\u6797\u6E21\u6CA1\u6709\u56DE\u5934\u770B\u4E00\u773C\u8EAB\u540E\u6DF7\u4E71\u7684\u884C\u653F\u5927\u697C\uFF0C\u4E5F\u6CA1\u6709\u770B\u90A3\u6EE1\u5C4F\u6EDA\u52A8\u7684\u540D\u5B57\u3002\u5979\u63A8\u5F00\u9876\u5C42\u90A3\u9053\u901A\u5F80\u9601\u697C\u7684\u7A84\u95E8\uFF0C\u8E0F\u4E0A\u4E86\u90A3\u9053\u9690\u85CF\u5728\u9634\u5F71\u4E2D\u3001\u4EFF\u4F5B\u901A\u5F80\u672A\u77E5\u6DF1\u5904\u7684\u87BA\u65CB\u697C\u68AF\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u53F0\u9636\u51B0\u51B7\u800C\u6E7F\u6ED1\uFF0C\u6BCF\u5411\u4E0B\u8D70\u4E00\u6B65\uFF0C\u8EAB\u540E\u7684\u5149\u4EAE\u5C31\u6D88\u51CF\u4E00\u5206\u3002\u6E10\u6E10\u5730\uFF0C\u6C34\u6CE5\u7684\u8D28\u611F\u6D88\u5931\u4E86\uFF0C\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u4E00\u79CD\u865A\u65E0\u7684\u3001\u5982\u540C\u8E29\u5728\u6DF1\u6D77\u955C\u9762\u4E0A\u7684\u9519\u89C9\u3002\u5F53\u6797\u6E21\u8D70\u5B8C\u6700\u540E\u4E00\u7EA7\u53F0\u9636\u65F6\uFF0C\u5979\u53D1\u73B0\u81EA\u5DF1\u7F6E\u8EAB\u4E8E\u4E00\u4E2A\u7EAF\u767D\u7684\u3001\u65E0\u8FB9\u65E0\u9645\u7684\u955C\u50CF\u7A7A\u95F4\u91CC\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u8FD9\u91CC\u6CA1\u6709\u91CD\u529B\uFF0C\u6CA1\u6709\u7A7A\u6C14\u7684\u6D41\u52A8\uFF0C\u53EA\u6709\u65E0\u6570\u9762\u5DE8\u5927\u7684\u955C\u5B50\u5728\u865A\u7A7A\u4E2D\u4EA4\u9519\u6392\u5217\uFF0C\u6BCF\u4E00\u9762\u955C\u5B50\u91CC\u90FD\u6620\u7167\u7740\u4E00\u4E2A\u4E0D\u540C\u4FA7\u9762\u7684\u6797\u6E21\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u4E09\u4E2A\u8EAB\u5F71\u7F13\u7F13\u4ECE\u955C\u9762\u7684\u6DF1\u5904\u8D70\u51FA\u6765\uFF0C\u5979\u4EEC\u957F\u7740\u548C\u6797\u6E21\u4E00\u6A21\u4E00\u6837\u7684\u8138\uFF0C\u5374\u6563\u53D1\u51FA\u622A\u7136\u4E0D\u540C\u7684\u6C14\u606F\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u7B2C\u4E00\u4E2A\u8D70\u51FA\u6765\u7684\u201C\u6797\u6E21\u201D\uFF0C\u7A7F\u7740\u90A3\u5957\u5728\u6BD5\u4E1A\u5178\u793C\u4E0A\u9884\u5B9A\u597D\u7684\u3001\u9886\u53E3\u7EE3\u7740\u91D1\u7EBF\u7684\u5B66\u4F4D\u670D\u3002\u5979\u624B\u4E2D\u6525\u7740\u90A3\u4EFD\u88AB\u6797\u6E21\u629B\u5F03\u7684\u9876\u7EA7\u54A8\u8BE2\u516C\u53F8\u5165\u804C\u534F\u8BAE\uFF0C\u773C\u795E\u51B7\u6F20\u5F97\u5982\u540C\u4E00\u9053\u7CBE\u786E\u7684\u516C\u5F0F\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u6211\u6254\u6389\u7684\u4E0D\u662F\u673A\u4F1A\uFF0C\u662F\u9501\u94FE\u3002"
    - pageNumber: 7
      speakerName: "\u955C\u50CF"
      text: "\u9501\u94FE\uFF1F\u6797\u6E21\uFF0C\u522B\u5929\u771F\u4E86\u3002\u5728\u8FD9\u4E2A\u4E16\u754C\u91CC\uFF0C\u53EA\u6709\u6210\u529F\u8005\u624D\u6709\u8D44\u683C\u8C08\u8BBA\u81EA\u7531\u3002\u4F60\u4E3A\u4E86\u90A3\u51E0\u5F20\u53D1\u9EC4\u7684\u65E7\u6863\u6848\uFF0C\u6BC1\u6389\u7684\u662F\u4F60\u672A\u6765\u4E8C\u5341\u5E74\u6240\u6709\u53EF\u4EE5\u9884\u89C1\u7684\u4F18\u6E25\u751F\u6D3B\u3002\u4F60\u73B0\u5728\u6210\u4E86\u4E00\u4E2A\u6CA1\u6709\u5B66\u4F4D\u7684\u75AF\u5B50\uFF0C\u4E00\u4E2A\u88AB\u6240\u6709\u540D\u4F01\u62C9\u9ED1\u7684\u9EBB\u70E6\u5236\u9020\u8005\u3002\u4F60\u4EE5\u4E3A\u4F60\u5728\u6551\u8D4E\u90A3\u4E9B\u201C\u6D88\u5931\u8005\u201D\uFF0C\u5176\u5B9E\u4F60\u53EA\u662F\u5728\u8FDB\u884C\u4E00\u573A\u611A\u8822\u7684\u81EA\u711A\u3002"
    - pageNumber: 8
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u90A3\u79CD\u201C\u4F18\u6E25\u201D\u9700\u8981\u5EFA\u7ACB\u5728\u5BF9\u540C\u7C7B\u7684\u62B9\u9664\u548C\u81EA\u6211\u7684\u9609\u5272\u4E0A\uFF0C\u90A3\u5B83\u672C\u8EAB\u5C31\u662F\u4E00\u573A\u9A97\u5C40\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u955C\u50CF\u731B\u5730\u5411\u524D\u4E00\u6B65\uFF0C\u903C\u89C6\u7740\u6797\u6E21\u3002\u6797\u6E21\u611F\u5230\u4E00\u9635\u5F3A\u70C8\u7684\u7729\u6655\uFF0C\u90A3\u4E9B\u66FE\u7ECF\u4E3A\u4E86\u540D\u5229\u800C\u5FC3\u8DF3\u52A0\u901F\u3001\u4E3A\u4E86\u7EE9\u70B9\u800C\u901A\u5BB5\u8FBE\u65E6\u7684\u753B\u9762\u50CF\u6F6E\u6C34\u822C\u6D8C\u6765\uFF0C\u8BD5\u56FE\u91CD\u65B0\u5C06\u5979\u6EBA\u6BD9\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u4EEC\u6068\u4E0D\u6068\u6211\u4E0D\u91CD\u8981\uFF0C\u91CD\u8981\u7684\u662F\uFF0C\u4ECE\u8FD9\u4E00\u79D2\u8D77\uFF0C\u6211\u4E0D\u7528\u518D\u4E3A\u4E86\u90A3\u4E2A\u8BE5\u6B7B\u7684\u6570\u5B57\u53BB\u8BA8\u597D\u4EFB\u4F55\u4EBA\uFF0C\u4E5F\u4E0D\u7528\u518D\u4E3A\u4E86\u4E00\u4E2A\u5B8C\u7F8E\u7684\u7B80\u5386\u53BB\u526A\u88C1\u6211\u7684\u7075\u9B42\u3002\u4F60\u8FD9\u79CD\u53EA\u4F1A\u6D3B\u5728\u671F\u671B\u503C\u91CC\u7684\u602A\u7269\uFF0C\u624D\u662F\u771F\u6B63\u7684\u56DA\u5F92\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u955C\u50CF\u53D1\u51FA\u4E00\u58F0\u5C16\u9510\u7684\u788E\u88C2\u58F0\uFF0C\u5316\u4F5C\u65E0\u6570\u9ED1\u8272\u7684\u6761\u5F62\u7801\uFF0C\u5D29\u89E3\u5728\u865A\u7A7A\u4E2D\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u7B2C\u4E8C\u4E2A\u201C\u6797\u6E21\u201D\u8D70\u4E86\u51FA\u6765\u3002\u5979\u7A7F\u7740\u5927\u4E00\u62A5\u5230\u65F6\u7684\u90A3\u4EF6\u65E7\u886C\u886B\uFF0C\u773C\u795E\u91CC\u6EE1\u662F\u75DB\u82E6\u548C\u8D1F\u7F6A\u611F\u3002\u5979\u7684\u811A\u4E0B\u6563\u843D\u7740\u6C88\u9752\u79BE\u7684\u5E73\u677F\u3001\u5468\u781A\u7684\u540D\u7247\u548C\u987E\u6F84\u7684\u76F8\u673A\u3002"
    - pageNumber: 13
      speakerName: "\u955C\u50CF"
      text: "\u4F60\u516C\u5F00\u4E86\u771F\u76F8\uFF0C\u6797\u6E21\u3002\u4F46\u4F60\u6709\u6CA1\u6709\u60F3\u8FC7\uFF0C\u5728\u8FD9\u4E2A\u8FC7\u7A0B\u4E2D\uFF0C\u4F60\u53D8\u6210\u4E86\u4F60\u6700\u8BA8\u538C\u7684\u90A3\u79CD\u4EBA\uFF1F"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "\u2026\u2026\u6211\u522B\u65E0\u9009\u62E9\u3002"
    - pageNumber: 15
      speakerName: "\u955C\u50CF"
      text: "\u522B\u65E0\u9009\u62E9\uFF1F\u4E3A\u4E86\u62FF\u5230\u90A3\u4EFD\u540D\u5355\uFF0C\u4F60\u5229\u7528\u4E86\u6C88\u9752\u79BE\u5BF9\u4F60\u7684\u903B\u8F91\u8BA4\u540C\uFF0C\u4F60\u660E\u77E5\u9053\u5979\u6700\u770B\u91CD\u79E9\u5E8F\uFF0C\u5374\u8BA9\u5979\u9677\u5165\u4E86\u6DF7\u4E71\u3002\u4F60\u5229\u7528\u4E86\u5468\u781A\u7684\u4EBA\u8109\uFF0C\u8BA9\u4ED6\u6210\u4E3A\u4E86\u4ED6\u6240\u4F9D\u9644\u7684\u6743\u529B\u7684\u80CC\u53DB\u8005\u3002\u4F60\u751A\u81F3\u5229\u7528\u4E86\u987E\u6F84\u7684\u5584\u826F\uFF0C\u8BA9\u4ED6\u4E0D\u5F97\u4E0D\u76F4\u9762\u4ED6\u6700\u60F3\u9003\u907F\u7684\u6B8B\u9177\u3002"
    - pageNumber: 16
      speakerName: "\u6797\u6E21"
      text: "\u6211\u6B20\u4ED6\u4EEC\u7684\uFF0C\u6211\u4F1A\u7528\u4F59\u751F\u53BB\u8FD8\u3002"
    - pageNumber: 17
      speakerName: "\u955C\u50CF"
      text: "\u8FD8\u5F97\u6E05\u5417\uFF1F\u4F60\u53E3\u53E3\u58F0\u58F0\u8BF4\u7CFB\u7EDF\u5728\u5403\u4EBA\uFF0C\u53EF\u4F60\u770B\u770B\u73B0\u5728\u7684\u4F60\uFF0C\u4E3A\u4E86\u8FBE\u6210\u4F60\u6240\u8C13\u7684\u201C\u6B63\u4E49\u201D\uFF0C\u4F60\u628A\u4F60\u7684\u670B\u53CB\u4EEC\u5F53\u6210\u4E86\u57AB\u811A\u77F3\u3002\u9648\u5B50\u6DB5\u597D\u4E0D\u5BB9\u6613\u5728\u6C89\u9ED8\u4E2D\u627E\u5230\u4E86\u5E73\u9759\uFF0C\u4F60\u5374\u5F3A\u884C\u628A\u4ED6\u7684\u4F24\u53E3\u6495\u5F00\u5C55\u793A\u7ED9\u5168\u6821\u770B\u3002\u6797\u6E21\uFF0C\u4F60\u771F\u7684\u5728\u6551\u4EBA\u5417\uFF1F\u8FD8\u662F\u4F60\u53EA\u662F\u5728\u4EAB\u53D7\u8FD9\u79CD\u201C\u4EE5\u4E00\u4EBA\u5BF9\u6297\u4E16\u754C\u201D\u7684\u60B2\u5267\u5FEB\u611F\uFF1F"
    - pageNumber: 18
      speakerName: 
      text: "\u955C\u50CF\u53D1\u51FA\u4E00\u9635\u51C4\u5389\u7684\u8D28\u95EE\u3002\u6797\u6E21\u611F\u5230\u4E00\u79CD\u6DF1\u5165\u9AA8\u9AD3\u7684\u5BD2\u610F\uFF0C\u90A3\u79CD\u8D1F\u7F6A\u611F\u6BD4\u4EFB\u4F55\u60E9\u7F5A\u90FD\u8981\u6C89\u91CD\u3002\u5979\u770B\u7740\u5730\u4E0A\u90A3\u4E9B\u5C5E\u4E8E\u670B\u53CB\u4EEC\u7684\u7269\u54C1\uFF0C\u611F\u5230\u5FC3\u810F\u88AB\u53CD\u590D\u63C9\u6413\u3002"
    - pageNumber: 19
      speakerName: 
      text: "\u6797\u6E21\u62AC\u8D77\u5934\uFF0C\u867D\u7136\u6CEA\u6C34\u5212\u8FC7\u8138\u988A\uFF0C\u4F46\u5979\u7684\u76EE\u5149\u7A7F\u900F\u4E86\u90A3\u4E9B\u865A\u5E7B\u7684\u6127\u759A\u3002"
    - pageNumber: 20
      speakerName: "\u955C\u50CF"
      text: "\u4F60\u771F\u662F\u4E2A\u75AF\u5B50\u2026\u2026"
    - pageNumber: 21
      speakerName: "\u6797\u6E21"
      text: "\u662F\u7684\u3002\u5728\u8FD9\u573A\u5173\u4E8E\u81EA\u6211\u7684\u535A\u5F08\u91CC\uFF0C\u5982\u679C\u4E0D\u75AF\u4E00\u70B9\uFF0C\u600E\u4E48\u80FD\u4ECE\u4F60\u4EEC\u5199\u597D\u7684\u7A0B\u5E8F\u91CC\u8DF3\u51FA\u6765\uFF1F"
    - pageNumber: 22
      speakerName: 
      text: "\u955C\u50CF\u5728\u4E00\u9635\u5267\u70C8\u7684\u6296\u52A8\u4E2D\u9010\u6E10\u900F\u660E\uFF0C\u6700\u7EC8\u5316\u4F5C\u4E00\u7F15\u8F7B\u70DF\uFF0C\u6D88\u5931\u5728\u7A7A\u95F4\u7684\u5C3D\u5934\u3002"
    - pageNumber: 23
      speakerName: 
      text: "\u6700\u540E\u8D70\u51FA\u6765\u7684\uFF0C\u662F\u4E00\u4E2A\u6CA1\u6709\u4EFB\u4F55\u670D\u9970\u3001\u6CA1\u6709\u4EFB\u4F55\u8868\u60C5\uFF0C\u751A\u81F3\u9762\u90E8\u8F6E\u5ED3\u90FD\u6709\u4E9B\u6A21\u7CCA\u7684\u201C\u6797\u6E21\u201D\u3002\u5979\u6CA1\u6709\u653B\u51FB\u6027\uFF0C\u53EA\u662F\u9759\u9759\u5730\u7AD9\u5728\u90A3\u91CC\uFF0C\u50CF\u662F\u4E00\u9762\u5F7B\u5E95\u6620\u7167\u51FA\u7A7A\u65E0\u7684\u6DF1\u6E0A\u3002"
    - pageNumber: 24
      speakerName: "\u955C\u50CF"
      text: "\u73B0\u5728\uFF0C\u4F60\u7684\u201C\u6210\u5C31\u201D\u788E\u4E86\uFF0C\u4F60\u7684\u201C\u7406\u60F3\u201D\u4E5F\u6EE1\u662F\u88C2\u75D5\u3002\u884C\u653F\u697C\u4E0B\u7684\u6821\u536B\u961F\u5DF2\u7ECF\u5C01\u9501\u4E86\u6240\u6709\u51FA\u53E3\uFF0C\u4F60\u7684\u6863\u6848\u6B63\u5728\u88AB\u7CFB\u7EDF\u6C38\u4E45\u6CE8\u9500\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u6211\u77E5\u9053\u3002"
    - pageNumber: 26
      speakerName: "\u955C\u50CF"
      text: "\u5982\u679C\u6CA1\u6709\u4E86\u90A3\u4E9B\u6807\u7B7E\uFF0C\u5982\u679C\u6CA1\u6709\u4E86\u90A3\u4E9B\u8D5E\u7F8E\u6216\u5492\u9A82\uFF0C\u5982\u679C\u6CA1\u6709\u4EBA\u518D\u770B\u89C1\u4F60\u3002"
    - pageNumber: 27
      speakerName: "\u955C\u50CF"
      text: "\u6797\u6E21\u3002\u4F60\u662F\u8C01\uFF1F"
    - pageNumber: 28
      speakerName: 
      text: "\u8FD9\u4E2A\u95EE\u9898\u50CF\u662F\u4E00\u4E2A\u65E0\u5E95\u7684\u9ED1\u6D1E\uFF0C\u77AC\u95F4\u5438\u5E72\u4E86\u5468\u56F4\u6240\u6709\u7684\u58F0\u97F3\u3002\u6797\u6E21\u7AD9\u5728\u7EAF\u767D\u7684\u7A7A\u95F4\u91CC\uFF0C\u611F\u5230\u4E86\u524D\u6240\u672A\u6709\u7684\u5B64\u72EC\u3002\u6CA1\u6709\u4E86\u5750\u6807\u7CFB\uFF0C\u6CA1\u6709\u4E86\u4EBA\u8109\u7F51\uFF0C\u6CA1\u6709\u4E86\u98CE\u666F\u7684\u886C\u6258\uFF0C\u5979\u53D1\u73B0\u81EA\u5DF1\u53EA\u662F\u4E00\u4E2A\u666E\u901A\u5230\u6781\u70B9\u7684\u3001\u5728\u9ED1\u591C\u91CC\u4F1A\u611F\u5230\u51B7\u3001\u5728\u7EDD\u5883\u4E2D\u4F1A\u611F\u5230\u6015\u7684\u7075\u9B42\u3002"
    - pageNumber: 29
      speakerName: "\u6797\u6E21"
      text: "\u6211\u662F\u8C01\u2026\u2026"
    - pageNumber: 30
      speakerName: 
      text: "\u5979\u95ED\u4E0A\u773C\u775B\uFF0C\u8111\u6D77\u4E2D\u6D6E\u73B0\u51FA\u5927\u4E00\u8FF7\u8DEF\u90A3\u5929\u770B\u5230\u7684\u51E4\u51F0\u6728\uFF0C\u60F3\u8D77\u90A3\u676F\u51B0\u53EF\u4E50\u7684\u5473\u9053\uFF0C\u60F3\u8D77\u795E\u4ED9\u6E56\u7554\u5FAE\u5F31\u7684\u98CE\u3002\u90A3\u4E9B\u77AC\u95F4\uFF0C\u5E76\u4E0D\u662F\u56E0\u4E3A\u201C\u6709\u7528\u201D\u624D\u5B58\u5728\uFF0C\u800C\u662F\u56E0\u4E3A\u5979\u5728\u90A3\u4E00\u523B\uFF0C\u771F\u5207\u5730\u611F\u53D7\u5230\u4E86\u751F\u547D\u3002"
    - pageNumber: 31
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4E0D\u662F\u7CFB\u7EDF\u7684\u6EE1\u5206\u751F\uFF0C\u6211\u4E5F\u4E0D\u662F\u5B8C\u7F8E\u7684\u6551\u4E16\u4E3B\u3002"
    - pageNumber: 32
      speakerName: "\u6797\u6E21"
      text: "\u6211\u53EA\u662F\u4E00\u4E2A\u2026\u2026\u5728\u672A\u540D\u4E4B\u6D77\u91CC\uFF0C\u5B66\u4F1A\u4E86\u7ED9\u81EA\u5DF1\u5212\u8239\u7684\u666E\u901A\u4EBA\u3002\u6211\u662F\u6797\u6E21\u3002\u4E0D\u662F\u4EFB\u4F55\u89C4\u5219\u7684\u7F29\u5199\uFF0C\u4E5F\u4E0D\u662F\u4EFB\u4F55\u4EBA\u7684\u6295\u5F71\u3002"
    - pageNumber: 33
      speakerName: 
      text: "\u6797\u6E21\u4F38\u51FA\u624B\uFF0C\u8F7B\u8F7B\u89E6\u78B0\u4E86\u90A3\u4E2A\u6A21\u7CCA\u7684\u5012\u5F71\u3002"
    - pageNumber: 34
      speakerName: 
      text: "\u5239\u90A3\u95F4\uFF0C\u6574\u7247\u7EAF\u767D\u7684\u7A7A\u95F4\u50CF\u662F\u4E00\u5757\u5DE8\u5927\u7684\u9632\u5F39\u73BB\u7483\u88AB\u91CD\u9524\u51FB\u4E2D\uFF0C\u77AC\u95F4\u5D29\u788E\u6210\u4EBF\u4E07\u7247\u6676\u83B9\u7684\u6B8B\u6E23\u3002"
    - pageNumber: 35
      speakerName: 
      text: "\u7A7A\u6C14\u91CD\u65B0\u6D8C\u5165\u4E86\u5979\u7684\u80BA\u90E8\uFF0C\u6797\u6E21\u731B\u5730\u7741\u5F00\u773C\u3002\u5979\u53D1\u73B0\u81EA\u5DF1\u5E76\u6CA1\u6709\u5728\u4EC0\u4E48\u201C\u672A\u77E5\u6DF1\u5904\u201D\uFF0C\u5979\u4F9D\u7136\u7AD9\u5728\u884C\u653F\u5927\u697C\u90A3\u9053\u65CB\u8F6C\u697C\u68AF\u7684\u5E95\u90E8\u3002"
    - pageNumber: 36
      speakerName: 
      text: "\u5149\u7EBF\u5F88\u6697\uFF0C\u53EA\u6709\u5E94\u6025\u706F\u5728\u95EA\u70C1\u3002\u697C\u68AF\u4E0A\u65B9\u4F20\u6765\u4E86\u5608\u6742\u7684\u547C\u558A\u58F0\u548C\u5954\u8DD1\u58F0\uFF0C\u90A3\u662F\u79E9\u5E8F\u6B63\u5728\u8BD5\u56FE\u4FEE\u8865\u88C2\u7F1D\u7684\u58F0\u97F3\u3002"
    - pageNumber: 37
      speakerName: 
      text: "\u955C\u50CF\u6797\u6E21\u5F7B\u5E95\u6D88\u5931\u4E86\u3002\u539F\u672C\u5E03\u6EE1\u7070\u5C18\u7684\u697C\u68AF\u95F4\u5899\u58C1\u4E0A\uFF0C\u6620\u51FA\u4E86\u4E00\u4E2A\u867D\u7136\u5355\u8584\u4F46\u65E0\u6BD4\u6E05\u6670\u7684\u8EAB\u5F71\u3002"
    - pageNumber: 38
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u5C31\u662F\u7EC8\u70B9\u5417\u3002"
    - pageNumber: 39
      speakerName: Null
      text: "\u7ED3\u8BFE\u8003\u8BD5\u901A\u8FC7\u3002\u4F60\u7ED9\u51FA\u7684\u7B54\u6848\uFF0C\u662F\u7CFB\u7EDF\u4ECE\u672A\u5F55\u5165\u8FC7\u7684\u968F\u673A\u503C\u3002"
    - pageNumber: 40
      speakerName: Null
      text: "\u6797\u6E21\u3002\u53BB\u8FC7\u90A3\u79CD\u2026\u2026\u4E0D\u88AB\u4EFB\u4F55\u4EBA\u5B9A\u4E49\u7684\u4EBA\u751F\u5427\u3002"
    - pageNumber: 41
      speakerName: 
      text: "\u6797\u6E21\u968F\u624B\u5C06\u624B\u673A\u653E\u8FDB\u4E86\u53E3\u888B\uFF0C\u5979\u7406\u4E86\u7406\u88AB\u98CE\u5439\u4E71\u7684\u5934\u53D1\uFF0C\u63A8\u5F00\u4E86\u901A\u5F80\u5730\u9762\u51FA\u53E3\u7684\u5927\u95E8\u3002"
    - pageNumber: 42
      speakerName: 
      text: "\u95E8\u5916\uFF0C\u7EA2\u84DD\u4EA4\u66FF\u7684\u8B66\u706F\u5728\u591C\u8272\u4E2D\u95EA\u70C1\uFF0C\u65E0\u6570\u53CC\u773C\u775B\u6B63\u5728\u6CE8\u89C6\u7740\u8FD9\u9053\u5927\u95E8\u3002\u6797\u6E21\u772F\u8D77\u773C\uFF0C\u8FCE\u7740\u90A3\u523A\u773C\u7684\u5149\u675F\uFF0C\u8FC8\u51FA\u4E86\u5979\u5728\u6E2F\u4E2D\u6DF1\u7684\u6700\u540E\u4E00\u6B65\u3002"
    - pageNumber: 43
      speakerName: 
      text: "\u5979\u7684\u811A\u6B65\u5F88\u8F7B\uFF0C\u5374\u6BCF\u4E00\u6B65\u90FD\u7A33\u7A33\u5730\u8E29\u5728\u4E86\u5927\u5730\u4E0A\u3002"
    choices: []
  - documentId: M5-5-1-A
    title: M5-5-1-A
    sourceAssetPath: Assets/content1/M5/M5-5-1-A.docx
    chapterId: M5
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m5_5_1_a
    npcId: "npc_\u5468\u781A"
    locationId: library_pool_m5_5_1_a
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -888.5, y: 14.25, z: 898.02}
    rewardGold: 25
    finishLocationName: "\u56FE\u4E66\u9986\u8FB9\u6C34\u6C60"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u884C\u653F\u5927\u697C\u7684\u7535\u5B50\u98CE\u66B4\u5728\u9ECE\u660E\u524D\u5915\u505C\u606F\u4E86\u3002\u9884\u60F3\u4E2D\u7684\u66B4\u70C8\u6E05\u7B97\u5E76\u6CA1\u6709\u5230\u6765\uFF0C\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u4E00\u79CD\u8FD1\u4E4E\u8083\u7A46\u7684\u3001\u5E9E\u5927\u7684\u6C89\u5BC2\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u8D70\u51FA\u90A3\u9053\u6C89\u91CD\u7684\u3001\u5DF2\u7ECF\u5931\u53BB\u7535\u529B\u9501\u95ED\u7684\u65CB\u8F6C\u95E8\u3002\u6E05\u6668\u4E94\u70B9\u7684\u7A7A\u6C14\u5FAE\u51C9\uFF0C\u5E26\u7740\u96E8\u540E\u8349\u6728\u7684\u82AC\u82B3\u3002\u9F99\u7FD4\u5927\u9053\u5728\u7A00\u8584\u7684\u6668\u66E6\u4E2D\u663E\u5F97\u65E0\u6BD4\u5BBD\u5E7F\uFF0C\u8FDC\u5904\u7684\u5C71\u8109\u8F6E\u5ED3\u9010\u6E10\u6E05\u6670\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5728\u56FE\u4E66\u9986\u524D\u7684\u55B7\u6CC9\u6C60\u8FB9\uFF0C\u4E00\u4E2A\u719F\u6089\u7684\u8EAB\u5F71\u6B63\u5750\u5728\u957F\u6905\u4E0A\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5468\u781A\u4ECA\u5929\u6CA1\u6709\u7A7F\u90A3\u8EAB\u65E0\u61C8\u53EF\u51FB\u7684\u897F\u88C5\uFF0C\u53EA\u7A7F\u4E86\u4E00\u4EF6\u7B80\u5355\u7684\u6DF1\u84DD\u8272\u536B\u8863\uFF0C\u957F\u53D1\u968F\u610F\u5730\u62AB\u5728\u80A9\u4E0A\u3002\u5979\u624B\u91CC\u62FF\u7740\u4E24\u7F50\u70ED\u5496\u5561\uFF0C\u5728\u767D\u96FE\u4E2D\u663E\u5F97\u6709\u4E9B\u67D4\u548C\u3002"
    - pageNumber: 5
      speakerName: "\u5468\u781A"
      text: "\u4F60\u6BD4\u6211\u60F3\u8C61\u4E2D\u51FA\u6765\u7684\u8981\u5FEB\u3002\u6211\u8FD8\u4EE5\u4E3A\u90A3\u4E9B\u8001\u5934\u5B50\u4F1A\u62C9\u7740\u4F60\u804A\u5230\u5929\u4EAE\u3002"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u4EEC\u53EA\u662F\u5728\u8BA8\u8BBA\u600E\u4E48\u5728\u4E0D\u60CA\u52A8\u5916\u754C\u7684\u524D\u63D0\u4E0B\uFF0C\u628A\u6211\u7684\u201C\u5B66\u7C4D\u201D\u5904\u7406\u5F97\u50CF\u4ECE\u672A\u5B58\u5728\u8FC7\u4E00\u6837\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u5468\u781A\uFF0C\u6211\u7684 4.0 \u6CA1\u4E86\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u5468\u781A\u7AD9\u8D77\u8EAB\uFF0C\u8D70\u5230\u6797\u6E21\u9762\u524D\u3002\u5979\u6CA1\u6709\u50CF\u5F80\u5E38\u90A3\u6837\u8FDB\u884C\u5229\u76CA\u5206\u6790\uFF0C\u800C\u662F\u4F38\u51FA\u624B\uFF0C\u6307\u5C16\u8F7B\u8F7B\u8E6D\u8FC7\u6797\u6E21\u8138\u988A\u4E0A\u7684\u4E00\u62B9\u7070\u5C18\u3002"
    - pageNumber: 9
      speakerName: "\u5468\u781A"
      text: "\u6EE1\u5206\u7EE9\u70B9\u53EA\u662F\u7CFB\u7EDF\u53D1\u7ED9\u542C\u8BDD\u5B69\u5B50\u7684\u4EE3\u91D1\u5238\u3002\u73B0\u5728\u4F60\u4E0D\u9700\u8981\u53BB\u5B83\u7684\u8D85\u5E02\u91CC\u4E70\u4E1C\u897F\u4E86\uFF0C\u8981\u90A3\u5F20\u5238\u5E72\u4EC0\u4E48\uFF1F"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4EEC\u7684\uFF1F"
    - pageNumber: 11
      speakerName: 
      text: "\u5468\u781A\u9732\u51FA\u4E00\u4E2A\u6781\u5176\u707F\u70C2\u3001\u751A\u81F3\u5E26\u70B9\u53DB\u9006\u8272\u5F69\u7684\u7B11\u5BB9\u3002\u5979\u4ECE\u515C\u91CC\u638F\u51FA\u4E00\u5F20\u76B1\u5DF4\u5DF4\u7684\u7EB8\u2014\u2014\u90A3\u662F\u5979\u4E00\u76F4\u968F\u8EAB\u643A\u5E26\u7684\u3001\u67D0\u79CD\u8C61\u5F81\u7740\u6743\u529B\u7684\u5408\u4F19\u4EBA\u534F\u8BAE\uFF0C\u73B0\u5728\u4E0A\u9762\u88AB\u5979\u80E1\u4E71\u6D82\u9E26\u4E86\u4E00\u4E2A\u5DE8\u5927\u7684\u53C9\u3002"
    - pageNumber: 12
      speakerName: "\u5468\u781A"
      text: "\u6211\u4E5F\u8F9E\u804C\u4E86\u3002\u65E2\u7136\u4F60\u628A\u8FD9\u7247\u6D77\u6405\u5F97\u5929\u7FFB\u5730\u8986\uFF0C\u6211\u603B\u4E0D\u80FD\u8FD8\u7559\u5728\u5CB8\u4E0A\u5F53\u770B\u5BA2\u5427\uFF1F"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u662F\u8BA4\u771F\u7684\u5417\uFF1F\u4F60\u4E3A\u4E86\u966A\u6211\uFF0C\u653E\u5F03\u4E86\u4F60\u7ECF\u8425\u4E86\u56DB\u5E74\u7684\u9635\u5730\uFF1F"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u4E0D\uFF0C\u6797\u6E21\u3002\u6211\u4E0D\u662F\u4E3A\u4E86\u966A\u4F60\u3002\u6211\u662F\u53D1\u73B0\uFF0C\u8DDF\u4F60\u5728\u4E00\u8D77\u7684\u90A3\u79CD\u201C\u4E0D\u53EF\u8BA1\u7B97\u7684\u504F\u822A\u201D\uFF0C\u6BD4\u5750\u5728\u529E\u516C\u5BA4\u91CC\u770B\u62A5\u8868\u6709\u8DA3\u4E00\u4E07\u500D\u3002"
    - pageNumber: 15
      speakerName: 
      text: "\u4E24\u4EBA\u5E76\u80A9\u8D70\u5728\u9F99\u7FD4\u5927\u9053\u4E0A\u3002\u867D\u7136\u8DEF\u8FB9\u7684\u7535\u5B50\u516C\u544A\u724C\u4E0A\u5DF2\u7ECF\u62B9\u53BB\u4E86\u6797\u6E21\u7684\u6240\u6709\u8363\u8A89\uFF0C\u4F46\u5979\u4EEC\u8D70\u8FC7\u65F6\uFF0C\u8DEF\u65C1\u7684\u4E00\u4E9B\u7A97\u53E3\u6084\u6084\u6253\u5F00\u4E86\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u6709\u5B66\u751F\u5728\u9633\u53F0\u4E0A\u5BF9\u5979\u4EEC\u9ED8\u9ED8\u62DB\u624B\uFF0C\u6709\u4EBA\u5728\u7559\u8A00\u5899\u4E0A\u8D34\u4E86\u4E00\u6735\u65E0\u540D\u7684\u5C0F\u82B1\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u9648\u5B50\u6DB5\u3001\u674E\u8587\u3001\u5F20\u94ED\u2026\u2026\u90A3\u4E9B\u88AB\u62B9\u9664\u7684\u540D\u5B57\uFF0C\u6B64\u523B\u6B63\u4EE5\u4E00\u79CD\u975E\u6B63\u5F0F\u7684\u65B9\u5F0F\uFF0C\u5728\u6570\u5343\u540D\u5B66\u751F\u7684\u624B\u673A\u548C\u8033\u8BED\u4E2D\u590D\u6D3B\u3002\u7CFB\u7EDF\u4FEE\u8865\u4E86\u6F0F\u6D1E\uFF0C\u5374\u6CA1\u6CD5\u4FEE\u8865\u4EBA\u4EEC\u5DF2\u7ECF\u89C9\u9192\u7684\u8BB0\u5FC6\u3002"
    - pageNumber: 18
      speakerName: "\u6797\u6E21"
      text: "\u6C88\u9752\u79BE\u548C\u987E\u6F84\u5462\uFF1F"
    - pageNumber: 19
      speakerName: "\u5468\u781A"
      text: "\u9752\u79BE\u5728\u5E2E\u6821\u65B9\u91CD\u6784\u903B\u8F91\u6846\u67B6\uFF0C\u4ED6\u8BD5\u56FE\u4ECE\u5185\u90E8\u628A\u201C\u7B2C\u96F6\u8BFE\u201D\u8FD9\u79CD\u6E05\u7406\u7A0B\u5E8F\u53D8\u6210\u771F\u6B63\u7684\u201C\u5FC3\u7406\u652F\u6301\u7CFB\u7EDF\u201D\u3002\u81F3\u4E8E\u987E\u6F84\u2026\u2026\u4ED6\u5E26\u7740\u76F8\u673A\u53BB\u897F\u85CF\u4E86\uFF0C\u4ED6\u8BF4\u8981\u66FF\u5F20\u94ED\u62CD\u4E00\u5F20\u6CA1\u6709\u96FE\u6C14\u7684\u7ECF\u5E61\u3002"
    - pageNumber: 20
      speakerName: 
      text: "\u5979\u4EEC\u8D70\u5230\u4E86\u6E2F\u4E2D\u6DF1\u7684\u5927\u95E8\u53E3\u3002\u6821\u95E8\u53E3\u7684\u77F3\u7891\u4F9D\u7136\u8038\u7ACB\uFF0C\u201C\u535A\u6587\u7EA6\u793C\u201D\u7684\u6821\u8BAD\u5728\u9633\u5149\u4E0B\u71A0\u71A0\u751F\u8F89\u3002"
    - pageNumber: 21
      speakerName: "\u5468\u781A"
      text: "\u6D41\u6D6A\u6C49\uFF1F"
    - pageNumber: 22
      speakerName: 
      text: "\u5979\u62C9\u8D77\u6797\u6E21\u7684\u624B\uFF0C\u5341\u6307\u7D27\u6263\uFF0C\u529B\u9053\u575A\u5B9A\u4E14\u6E29\u6696"
    - pageNumber: 23
      speakerName: "\u5468\u781A"
      text: "\u6211\u4EEC\u624B\u91CC\u6709\u6574\u4E2A\u4E16\u754C\u7684\u5E95\u5C42\u4EE3\u7801\uFF0C\u6709\u8FD9\u4E2A\u65F6\u4EE3\u6700\u6E05\u9192\u7684\u5934\u8111\uFF0C\u8FD8\u6709\u5F7C\u6B64\u3002"
    - pageNumber: 24
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u65E2\u7136\u65E7\u7684\u5267\u672C\u88AB\u4F60\u6495\u4E86\uFF0C\u90A3\u63A5\u4E0B\u6765\u7684\u620F\uFF0C\u6211\u4EEC\u81EA\u5DF1\u5199\u3002"
    - pageNumber: 25
      speakerName: 
      text: "\u6797\u6E21\u56DE\u5934\u770B\u4E86\u4E00\u773C\u90A3\u5EA7\u9AD8\u8038\u7684\u949F\u697C\u3002"
    - pageNumber: 26
      speakerName: 
      text: "\u9633\u5149\u5F7B\u5E95\u62E8\u5F00\u4E86\u4E91\u96FE\uFF0C\u91D1\u8272\u7684\u5149\u8F89\u6D12\u5728\u6559\u5B66\u697C\u7684\u73BB\u7483\u5E55\u5899\u4E0A\uFF0C\u6298\u5C04\u51FA\u4E07\u5343\u6D41\u5149\u3002\u8FD9\u4E0D\u518D\u662F\u4E00\u5EA7\u7981\u9522\u7075\u9B42\u7684\u5821\u5792\uFF0C\u800C\u662F\u4E00\u4E2A\u66FE\u7ECF\u505C\u7559\u8FC7\u7684\u3001\u5373\u5C06\u544A\u522B\u7684\u6E2F\u53E3\u3002"
    - pageNumber: 27
      speakerName: "\u6797\u6E21"
      text: "\u8D70\u5427\uFF0C\u5468\u781A\u3002"
    - pageNumber: 28
      speakerName: 
      text: "\u5979\u4EEC\u8E0F\u4E0A\u5DF4\u58EB\u3002\u8F66\u8F6E\u8F6C\u52A8\uFF0C\u5E26\u7740\u5979\u4EEC\u9A76\u79BB\u8FD9\u5EA7\u53F0\u5730\u5F0F\u7684\u8FF7\u5BAB\uFF0C\u9A76\u5411\u90A3\u4E2A\u5145\u6EE1\u672A\u77E5\u3001\u5145\u6EE1\u98CE\u9669\u3001\u5374\u4E5F\u5145\u6EE1\u65E0\u9650\u53EF\u80FD\u6027\u7684\u672A\u6765\u3002"
    - pageNumber: 29
      speakerName: 
      text: "\u5DF4\u58EB\u7A7F\u8FC7\u9F99\u5C97\u7684\u8857\u9053\uFF0C\u9633\u5149\u659C\u659C\u5730\u7167\u8FDB\u8F66\u7A97\u3002\u6797\u6E21\u9760\u5728\u5468\u781A\u7684\u80A9\u8180\u4E0A\uFF0C\u611F\u53D7\u7740\u5BF9\u65B9\u6C89\u7A33\u7684\u5FC3\u8DF3\u3002"
    - pageNumber: 30
      speakerName: 
      text: "\u624B\u673A\u6700\u540E\u4E00\u6B21\u9707\u52A8\uFF0C\u662F Null \u53D1\u6765\u7684\uFF0C\u4F46\u8FD9\u6B21\u53EA\u6709\u4E00\u5F20\u7167\u7247\u3002"
    - pageNumber: 31
      speakerName: 
      text: "\u7167\u7247\u4E0A\u662F\u56DB\u5E74\u524D\u5979\u4EEC\u7B2C\u4E00\u6B21\u5728\u96E8\u4E2D\u5E76\u80A9\u7684\u80CC\u5F71\uFF0C\u914D\u6587\u662F\uFF1A\u201C\u795D\u8D3A\u4F60\u4EEC\uFF0C\u627E\u5230\u4E86\u90A3\u6761\u4E0D\u88AB\u5B9A\u4E49\u7684\u8DEF\u5F84\u3002\u201D"
    - pageNumber: 32
      speakerName: 
      text: "\u6797\u6E21\u5173\u6389\u624B\u673A\uFF0C\u628A\u5B83\u6254\u8FDB\u4E86\u5EA7\u4F4D\u7684\u7F1D\u9699\u91CC\u3002"
    - pageNumber: 33
      speakerName: 
      text: "\u7A97\u5916\uFF0C\u5927\u9E4F\u6E7E\u7684\u6D77\u6C34\u5728\u9633\u5149\u4E0B\u6CE2\u5149\u7CBC\u7CBC\uFF0C\u90A3\u662F\u771F\u6B63\u81EA\u7531\u3001\u771F\u6B63\u672A\u540D\u7684\u6D77\u3002"
    - pageNumber: 34
      speakerName: 
      text: "\uFF08\u5168\u5267\u7EC8\uFF09"
    choices: []
