    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u51CC\u6668\u56DB\u70B9\uFF0C\u56FE\u4E66\u9986\u5916\u7684\u51E4\u51F0\u6728\u5728\u5FAE\u98CE\u4E2D\u6447\u66F3\u3002\u6797\u6E21\u8D70\u5728\u56DE\u5BBF\u820D\u7684\u5C0F\u8DEF\u4E0A\uFF0C\u5F71\u5B50\u88AB\u8DEF\u706F\u62C9\u5F97\u5F88\u957F\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u5979\u4E0D\u77E5\u9053\u81EA\u5DF1\u662F\u5728\u5F80\u524D\u8D70\uFF0C\u8FD8\u662F\u53EA\u662F\u60EF\u6027\u5730\u65CB\u8F6C\u3002\u5979\u5F00\u59CB\u4EA7\u751F\u4E00\u79CD\u9519\u89C9\uFF1A\u5468\u56F4\u7684\u6559\u5B66\u697C\u4F3C\u4E4E\u5728\u4E00\u70B9\u70B9\u5347\u9AD8\uFF0C\u53D8\u6210\u5DE8\u5927\u7684\u5893\u7891\uFF0C\u4E0A\u9762\u523B\u6EE1\u4E86\u5BC6\u5BC6\u9EBB\u9EBB\u7684\u6210\u7EE9\u6392\u540D\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u201C\u6797\u6E21\uFF0C\u6B22\u8FCE\u6765\u5230\u671F\u4E2D\u5468\u3002\u73B0\u5728\u7684\u4F60\uFF0C\u8FD8\u5269\u591A\u5C11\u2018\u81EA\u5DF1\u2019\uFF1F\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u6643\u4E86\u6643\u8111\u888B\uFF0C\u90A3\u80A1\u4E0D\u8BE6\u7684\u9884\u611F\u8D8A\u6765\u8D8A\u91CD\u3002\u5979\u610F\u8BC6\u5230\uFF0C\u4ECA\u665A\u7684\u5D29\u6E83\u53EA\u662F\u4E2A\u5E8F\u66F2\u3002\u67D0\u79CD\u540D\u4E3A\u201C\u5747\u5206\u201D\u7684\u602A\u7269\uFF0C\u6B63\u5728\u5979\u7684\u610F\u8BC6\u6DF1\u5904\u7F13\u7F13\u7741\u5F00\u773C\u3002"
    choices: []
  - documentId: M1-4-1
    title: M1-4-1
    sourceAssetPath: Assets/content1/M1/M1-4-1.docx
