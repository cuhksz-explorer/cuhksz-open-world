    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u66B4\u96E8\u5982\u6CE8\uFF0C\u7A7A\u6C14\u4E2D\u5F25\u6F2B\u7740\u6F6E\u6E7F\u7684\u6CE5\u571F\u6C14\u3002\u5468\u781A\u521A\u7ECF\u5386\u4E86\u4E00\u573A\u5546\u4E1A\u535A\u5F08\uFF0C\u867D\u80DC\u72B9\u75B2\u3002\u5979\u7AD9\u5728\u5C4B\u6A90\u4E0B\uFF0C\u6DF1\u7070\u8272\u897F\u88C5\u886C\u5F97\u5979\u8EAB\u59FF\u633A\u62D4\uFF0C\u5374\u4E5F\u900F\u51FA\u4E00\u4E1D\u4E0D\u5408\u65F6\u5B9C\u7684\u5B64\u5BC2\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u60F3\u5230\u4F1A\u5728\u79D1\u6280\u56ED\u78B0\u5230\u5468\u781A\uFF0C\u8FD8\u662F\u5728\u96E8\u4E0B\u5F97\u8FD9\u4E48\u5927\u7684\u65F6\u5019\u3002\u6491\u5F00\u9ED1\u8272\u7684\u957F\u67C4\u4F1E\uFF0C\u8D70\u5230\u5468\u781A\u8EAB\u8FB9\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5468\u603B\uFF0C\u8FD9\u79CD\u96E8\u7B49\u8F66\u81F3\u5C11\u8981\u534A\u5C0F\u65F6\u3002\u4E0D\u4ECB\u610F\u7684\u8BDD\uFF0C\u6211\u4EEC\u4E00\u8D77\u56DE\u5B66\u6821\uFF1F\u201D"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF0C\u6211\u4EEC\u80FD\u540C\u65F6\u51FA\u73B0\u5728\u8FD9\u91CC\u4E5F\u662F\u5F88\u6709\u7F18\u4E86\u3002\u4F60\u4E00\u5411\u5F88\u4F1A\u6311\u65F6\u673A\u3002\u90A3\u6211\u5C31\u4E0D\u5BA2\u6C14\u4E86\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u8E0F\u5165\u4F1E\u4E0B\uFF0C\u4E24\u4EBA\u8DDD\u79BB\u77AC\u95F4\u62C9\u8FD1\u3002\u4F60\u80FD\u95FB\u5230\u5979\u8EAB\u4E0A\u6DE1\u6DE1\u7684\u51B7\u6749\u9999\u6C14\uFF0C\u6DF7\u6742\u7740\u96E8\u6C34\u7684\u51C9\u610F\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u96E8\u58F0\u63A9\u76D6\u4E86\u5916\u754C\u7684\u55A7\u56A3\uFF0C\u4F1E\u4E0B\u6210\u4E3A\u4E86\u4E00\u4E2A\u4E34\u65F6\u7684\u7EDD\u5BF9\u9886\u57DF\u3002\u5468\u781A\u770B\u5411\u524D\u65B9\uFF0C\u8BED\u6C14\u5E73\u9759\u5730\u629B\u51FA\u4E86\u5979\u7684\u8BD5\u63A2\u3002"
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u201C\u521A\u624D\u8D44\u65B9\u8981\u6211\u4FDD\u8BC1\uFF0C\u4E3A\u4E86\u5229\u6DA6\u53EF\u4EE5\u968F\u65F6\u4FEE\u6539\u7B97\u6CD5\u6743\u91CD\u3002\u6797\u6E21\uFF0C\u5982\u679C\u4F60\u662F\u6211\uFF0C\u4F60\u4F1A\u4E3A\u4E86\u6D3B\u4E0B\u53BB\u800C\u53D8\u5F97\u2018\u5E73\u5EB8\u2019\u5417\uFF1F\u201D"
    choices:
    - label: "\u503E\u5411\uFF1A\u7406\u6027"
