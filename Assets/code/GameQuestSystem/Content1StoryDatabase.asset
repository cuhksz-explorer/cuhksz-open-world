    - pageNumber: 1
      speakerName: 
      text: "\u5C31\u5728\u4E24\u4EBA\u4E4B\u95F4\u7684\u7A7A\u6C14\u88AB\u8FD9\u51E0\u53E5\u5BF9\u8BDD\u62C9\u626F\u5230\u6781\u5176\u7D27\u7EF7\u7684\u4E34\u754C\u70B9\u65F6\u2014\u2014"
    - pageNumber: 2
      speakerName: 
      text: "\u201C\u55E1\u2014\u2014\u201D\u4F34\u968F\u7740\u4E00\u58F0\u6C89\u95F7\u7684\u7535\u6D41\u58F0\uFF0C\u8D70\u5ECA\u4E0A\u7684\u767D\u70BD\u706F\u77AC\u95F4\u4EAE\u8D77\uFF0C\u523A\u76EE\u7684\u5149\u7EBF\u586B\u6EE1\u4E86\u6574\u4E2A\u697C\u68AF\u95F4\u3002\u673A\u623F\u91CC\u6C89\u5BC2\u7684\u670D\u52A1\u5668\u91CD\u65B0\u53D1\u51FA\u4E86\u8F70\u9E23\u58F0\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u73B0\u5B9E\u4E16\u754C\u7684\u89C4\u5219\u548C\u5149\u7EBF\u91CD\u65B0\u964D\u4E34\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6C88\u9752\u79BE\u5FAE\u5FAE\u772F\u8D77\u773C\u775B\u9002\u5E94\u4E86\u4E00\u4E0B\u5149\u7EBF\u3002\u4ED6\u7AD9\u8D77\u8EAB\uFF0C\u62CD\u4E86\u62CD\u88E4\u817F\uFF0C\u4F4E\u5934\u770B\u7740\u8FD8\u5750\u5728\u53F0\u9636\u4E0A\u7684\u6797\u6E21\u3002\u521A\u624D\u5728\u9ED1\u6697\u4E2D\u90A3\u79CD\u79C1\u5BC6\u611F\u88AB\u706F\u5149\u9A71\u6563\uFF0C\u4F46\u4ED6\u770B\u6797\u6E21\u7684\u773C\u795E\uFF0C\u5DF2\u7ECF\u548C\u505C\u7535\u524D\u5B8C\u5168\u4E0D\u540C\u4E86\u3002"
    - pageNumber: 5
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u7535\u6765\u4E86\u3002\u4F60\u7684\u9879\u76EE\u6CA1\u4FDD\u5B58\uFF0C\u73B0\u5728\u56DE\u53BB\uFF0C\u5E94\u8BE5\u8FD8\u80FD\u4ECE\u81EA\u52A8\u5907\u4EFD\u91CC\u62A2\u6551\u56DE\u6765\u5927\u534A\u3002\u201D"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u201C\u653E\u5FC3\uFF0C\u6211\u6709\u968F\u65F6\u968F\u5730\u5B58\u76D8\u7684\u597D\u4E60\u60EF\u3002\u201D"
    - pageNumber: 7
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4E25\u8C28\u7684\u597D\u4E60\u60EF\u3002\u201D"
    - pageNumber: 8
      speakerName: 
      text: "\u4ED6\u63A8\u5F00\u697C\u68AF\u95F4\u7684\u9632\u706B\u95E8\uFF0C\u5728\u8D70\u51FA\u53BB\u4E4B\u524D\uFF0C\u505C\u4E0B\u4E86\u811A\u6B65\u3002"
    - pageNumber: 9
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6797\u6E21\uFF0C\u5173\u4E8E\u4F60\u521A\u624D\u8BF4\u7684\u90A3\u4E2A\u2018\u6253\u7834\u7A33\u5B9A\u7684\u610F\u5916\u2019\u2026\u2026\u6211\u4F1A\u8BA4\u771F\u8003\u8651\u7684\u3002\u201D"
    - pageNumber: 10
