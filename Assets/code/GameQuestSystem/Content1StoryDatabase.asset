      text: "\u5979\u5E76\u4E0D\u5728\u4E4E\u6743\u529B\u548C\u793E\u4EA4\uFF0C\u52A0\u5165\u793E\u56E2\u62C5\u4EFB\u8D22\u52A1\u7EAF\u7CB9\u662F\u4E3A\u4E86\u78E8\u7EC3\u81EA\u5DF1\u7684\u5BA1\u8BA1\u76F4\u89C9\u3002\u5979\u662F\u4F60\u5728\u793E\u56E2\u5185\u90E8\u6BD4\u8F83\u4EB2\u8FD1\u7684\u4EBA\u3002"
    - pageNumber: 3
      speakerName: "\u8D75\u627F\u52CB"
      text: "\u793E\u56E2\u5916\u8054\u90E8\u90E8\u957F\uFF0C\u5229\u5DF1\u4E3B\u4E49\u8005\uFF0C\u4ED6\u6781\u5176\u64C5\u957F\u5728\u89C4\u5219\u7684\u7070\u8272\u5730\u5E26\u8DF3\u821E\u3002\u5728\u4ED6\u770B\u6765\uFF0C\u632A\u7528\u4E00\u70B9\u793E\u56E2\u9884\u7B97\u6765\u7EF4\u62A4\u4ED6\u5E9E\u5927\u7684\u6821\u5185\u5916\u4EBA\u8109\u7F51\uFF0C\u662F\u201C\u8D44\u6E90\u7684\u5408\u7406\u7F6E\u6362\u201D\u3002"
    - pageNumber: 4
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u6797\u6E21\uFF0C\u522B\u5728\u90A3\u513F\u7FFB\u4E86\u3002\u4F60\u8981\u627E\u7684\u5F80\u5E74\u51B3\u7B97\u8868\u5E94\u8BE5\u5728\u90A3\u4E2A\u6807\u7740\u2018\u5916\u8054\u90E8\u5BF9\u63A5\u2019\u7684\u84DD\u5939\u5B50\u91CC\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u627E\u5230\u4E86\u3002\u4E0D\u8FC7\u2026\u2026\u8FD9\u4EFD\u51B3\u7B97\u8868\u7684\u6700\u540E\u5BA1\u6838\u4EBA\uFF0C\u7B7E\u5B57\u7684\u662F\u8D75\u627F\u52CB\uFF1F"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u89C1\u9E7F\uFF0C\u8FD9\u4EFD\u7531\u8D75\u90E8\u957F\u4EB2\u81EA\u5BA1\u6838\u7684\u8868\u91CC\uFF0C\u201C\u7406\u7531\u201D\u6050\u6015\u8FDE\u4F60\u81EA\u5DF1\u90FD\u4E0D\u4FE1\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u3010\u53BB\u5E74 11 \u6708 11 \u65E5\u652F\u51FA 3500 \u5143\u8D2D\u4E70\u201C\u4E13\u4E1A\u955C\u5934\u7EC4\u201D\uFF0C\u4F46\u793E\u56E2\u8D44\u4EA7\u6E05\u5355\u91CC\u53EA\u6709\u4E8C\u624B\u7684\u5165\u95E8\u673A\u3002\u3011"
    - pageNumber: 8
      speakerName: 
      text: "\u3010\u5BD2\u5047\u671F\u95F4\u51FA\u73B0\u4E00\u7B14\u201C\u6821\u9645\u4EA4\u6D41\u5DEE\u65C5\u8D39\u201D\uFF0C\u53EF\u90A3\u65F6\u5019\u5168\u6821\u90FD\u5728\u5C01\u5BDD\uFF0C\u62A5\u9500\u4EBA\u4E00\u680F\u8D6B\u7136\u5199\u7740\u8D75\u627F\u52CB\u3002\u3011"
    - pageNumber: 9
      speakerName: "\u6797\u89C1\u9E7F"
      text: "\u2026\u2026\u600E\u4E48\u4F1A\u662F\u4ED6\uFF1F\u4ED6\u4E00\u76F4\u8DDF\u6211\u8BF4\uFF0C\u8FD9\u4E9B\u662F\u7ED9\u793E\u56E2\u62C9\u8D5E\u52A9\u5FC5\u987B\u57AB\u4ED8\u7684\u201C\u516C\u5173\u6210\u672C\u201D\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u662F\u7EAF\u7CB9\u7684\u79C1\u541E\u7ECF\u8D39\u5427\u3002"
    - pageNumber: 11
      speakerName: "\u8D75\u627F\u52CB"
      text: "\u8FD8\u6CA1\u5FD9\u5B8C\uFF1F\u6797\u6E21\uFF0C\u7B56\u5212\u6848\u6539\u5F97\u600E\u4E48\u6837\u4E86\uFF1F"
    - pageNumber: 12
      speakerName: 
      text: "\u3010\u5185\u5BA1\u3011\u8FD8\u662F\u3010\u66DD\u5149\u3011\uFF1F"
    choices:
    - label: "\u79C1\u4E0B\u535A\u5F08"
      targetDocumentId: M3-2-1R
    - label: "\u5F7B\u5E95\u66DD\u5149"
      targetDocumentId: M3-2-2a
  - documentId: M3-2-1R
    title: M3-2-1R
    sourceAssetPath: "Assets/content1/M3/M3-2-1R\uFF08\u5185\u7F6E\uFF09.txt"
    chapterId: M3
    category: 0
    isRootTask: 1
    isBranchDocument: 0
