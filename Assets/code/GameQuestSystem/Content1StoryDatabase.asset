      text: "\u7B2C\u4E8C\u5929\u6DF1\u591C\uFF0C\u6797\u6E21\u6B63\u5728\u8DD1\u6700\u540E\u4E00\u6BB5\u4EE3\u7801\u6D4B\u8BD5\uFF0C\u624B\u673A\u5C4F\u5E55\u7A81\u7136\u4EAE\u4E86\u3002\u7FA4\u91CC\u5F39\u51FA\u5B59\u54F2\u7684\u4E00\u6761\u957F\u6D88\u606F\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u7814\u8BA8\u5BA4\u91CC\u5B89\u9759\u5F97\u53EA\u80FD\u542C\u5230\u673A\u7BB1\u98CE\u6247\u7684\u55E1\u55E1\u58F0\u3002\u6797\u6E21\u770B\u7740\u624B\u673A\uFF0C\u6C89\u9ED8\u4E86\u4E00\u4F1A\u513F\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u5B59\u54F2\u9000\u961F\u4E86\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u695A\u5929\u731B\u5730\u8F6C\u8FC7\u8F6C\u6905\uFF0C\u590F\u6797\u4E5F\u505C\u4E0B\u4E86\u753B\u7B14\u3002"
    - pageNumber: 5
      speakerName: "\u695A\u5929"
      text: "\u9A6C\u4E0A\u5C31\u8981\u4EA4\u521D\u7A3F\u4E86\uFF0C\u4ED6\u8FD9\u4E2A\u65F6\u5019\u8D70\uFF1F"
    - pageNumber: 6
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u5BFC\u5E08\u4E34\u65F6\u63A5\u4E86\u4E2A\u56FD\u5BB6\u7EA7\u91CD\u70B9\u8BFE\u9898\uFF0C\u70B9\u540D\u8981\u4ED6\u9A6C\u4E0A\u8FDB\u7EC4\u5C01\u95ED\u5E72\u6D3B\u3002\u4ED6\u4E0D\u53EF\u80FD\u4E3A\u4E86\u4E00\u4E2A\u5B66\u751F\u6BD4\u8D5B\u53BB\u62D2\u7EDD\u81EA\u5DF1\u5BFC\u5E08\u7684\u91CD\u70B9\u9879\u76EE\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u4ED6\u5BFC\u5E08\u4E34\u65F6\u63A5\u4E86\u4E2A\u56FD\u5BB6\u7EA7\u91CD\u70B9\u8BFE\u9898\uFF0C\u70B9\u540D\u8981\u4ED6\u9A6C\u4E0A\u8FDB\u7EC4\u5C01\u95ED\u5E72\u6D3B\u3002\u4ED6\u4E0D\u53EF\u80FD\u4E3A\u4E86\u4E00\u4E2A\u5B66\u751F\u6BD4\u8D5B\u53BB\u62D2\u7EDD\u81EA\u5DF1\u5BFC\u5E08\u7684\u91CD\u70B9\u9879\u76EE\u3002"
    - pageNumber: 8
      speakerName: "\u590F\u6797"
      text: "\u90A3\u6211\u4EEC\u7684\u8DEF\u6F14\u600E\u4E48\u529E\uFF1F\u5546\u4E1A\u8BA1\u5212\u4E66\u8FD8\u53EA\u662F\u4E00\u5806\u7A7A\u58F3\uFF0C\u73B0\u5728\u53BB\u54EA\u627E\u4E00\u4E2A\u61C2\u6211\u4EEC\u8FD9\u5957\u7B97\u6CD5\uFF0C\u53C8\u80FD\u4E0A\u53F0\u53BB\u8BB2\u5546\u4E1A\u6A21\u5F0F\u7684\u4EBA\uFF1F"
    - pageNumber: 9
      speakerName: 
      text: "\u9762\u4E34\u6838\u5FC3\u8DEF\u6F14\u4EBA\u5458\u7684\u7A81\u53D1\u6D41\u5931\uFF0C\u6BD4\u8D5B\u7684\u8FD0\u8F6C\u8282\u594F\u88AB\u5F7B\u5E95\u6253\u4E71\u3002\u4F60\u5FC5\u987B\u7ACB\u523B\u6572\u5B9A\u8865\u6551\u65B9\u6848\u3002"
