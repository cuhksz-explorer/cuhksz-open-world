      text: "\u201C\u5982\u679C\u4F60\u6C38\u8FDC\u4E0D\u6562\u63A5\u53D7\u4E00\u70B9\u4E0D\u53EF\u63A7\u7684\u53D8\u5316\uFF0C\u4F60\u5C31\u6C38\u8FDC\u4E0D\u77E5\u9053\u5916\u9762\u6709\u4EC0\u4E48\u3002\u201D"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u5FAE\u5FAE\u503E\u8EAB\uFF0C\u5728\u8FD9\u4E2A\u660F\u6697\u7684\u697C\u68AF\u95F4\u91CC\uFF0C\u76EE\u5149\u76F4\u767D\u5730\u770B\u7740\u4ED6\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6C88\u5B66\u957F\uFF0C\u8981\u4E0D\u8981\u8BD5\u7740\uFF0C\u628A\u6211\u4E5F\u7B97\u8FDB\u4F60\u7684\u751F\u6D3B\u91CC\u770B\u770B\uFF1F\u201D"
    - pageNumber: 4
      speakerName: 
      text: "\u6C88\u9752\u79BE\u7684\u547C\u5438\u5728\u8FD9\u4E00\u77AC\u95F4\u51FA\u73B0\u4E86\u6781\u5176\u8F7B\u5FAE\u7684\u505C\u6EDE\u3002\u4ED6\u4E00\u5411\u4E25\u5BC6\u7684\u751F\u6D3B\u9632\u7EBF\uFF0C\u7B2C\u4E00\u6B21\u906D\u9047\u4E86\u5982\u6B64\u76F4\u767D\u7684\u6572\u95E8\u58F0\u3002\u4ED6\u6CA1\u6709\u540E\u9000\uFF0C\u800C\u662F\u7528\u90A3\u53CC\u6DF1\u9083\u7684\u773C\u775B\u7D27\u7D27\u76EF\u7740\u6797\u6E21\uFF0C\u4EFF\u4F5B\u5728\u91CD\u65B0\u8BC4\u4F30\u773C\u524D\u8FD9\u4E2A\u5927\u4E00\u65B0\u751F\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u4ED6\u58F0\u97F3\u5FAE\u54D1\uFF0C\u4F46\u8BED\u6C14\u4F9D\u7136\u8BD5\u56FE\u4FDD\u6301\u4E00\u8D2F\u7684\u9547\u5B9A\uFF1A\u201C\u6797\u6E21\uFF0C\u63A5\u53D7\u4E00\u4E2A\u5168\u65B0\u7684\u4EBA\u8FDB\u5165\u751F\u6D3B\uFF0C\u662F\u8981\u627F\u62C5\u5F88\u5927\u98CE\u9669\u7684\u2026\u2026\u4F60\u5982\u6B64\u4FE1\u4EFB\u6211\u5417\uFF1F\u201D"
