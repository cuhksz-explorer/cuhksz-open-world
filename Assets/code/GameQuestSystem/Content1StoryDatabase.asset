    - pageNumber: 3
      speakerName: 
      text: "\u6DF1\u591C\u5DF2\u7ECF\u5173\u95E8\u7684\u661F\u5DF4\u514B\u3002\u4F60\u8D70\u5230\u5BA4\u5916\u53D1\u4EAE\u5149\u7684\u684C\u5B50\u65C1\uFF0C\u8D75\u627F\u52CB\u624B\u91CC\u7684\u5E73\u677F\u4EAE\u7740\uFF0C\u5C4F\u5E55\u6620\u51FA\u4ED6\u6BEB\u65E0\u6CE2\u6F9C\u7684\u8138\u3002"
    - pageNumber: 4
