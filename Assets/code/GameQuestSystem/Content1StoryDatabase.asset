      text: "\u5982\u679C\u5546\u7528\u4EF7\u503C\u7684\u997C\u753B\u4E0D\u5706\uFF0C\u90A3\u6211\u4EEC\u5C31\u6362\u4E2A\u8D5B\u9053\u3002\u628A\u5546\u4E1A\u5E94\u7528\u6539\u6210\u793E\u4F1A\u516C\u76CA\u5E94\u7528\u3002\u6211\u53BB\u8054\u7CFB\u987E\u6F84\u3002"
    - pageNumber: 2
      speakerName: "\u590F\u6797"
      text: "\u987E\u6F84\uFF1F\u4ED6\u4E0D\u662F\u5728\u641E\u90A3\u4E2A\u652F\u6559\u56E2\u5417\uFF1F"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u6211\u4EEC\u7684\u65E0\u76D1\u7763\u5B66\u4E60\u6A21\u578B\u53EF\u4EE5\u7528\u6765\u505A\u8D44\u6E90\u5206\u914D\u7684\u4F18\u5316\u3002\u5982\u679C\u6211\u4EEC\u628A\u8FD9\u5957\u7B97\u6CD5\u7684\u5E94\u7528\u573A\u666F\u5B9A\u4F4D\u5728\u201C\u504F\u8FDC\u5730\u533A\u6559\u80B2\u8D44\u6E90\u7CBE\u51C6\u5339\u914D\u201D\u4E0A\uFF0C\u987E\u6F84\u6BD4\u4EFB\u4F55\u4EBA\u90FD\u80FD\u628A\u8FD9\u4E2A\u6545\u4E8B\u8BB2\u5F97\u52A8\u4EBA\u3002\u5728\u8FD9\u4E2A\u904D\u5730\u90FD\u662F\u5546\u4E1A\u53D8\u73B0\u7684\u6BD4\u8D5B\u91CC\uFF0C\u4EBA\u6587\u5173\u6000\u53CD\u800C\u80FD\u6253\u51FA\u5DEE\u5F02\u5316\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u627E\u6765\u4E86\u5B8C\u5168\u4E0D\u61C2\u6280\u672F\u7684\u987E\u6F84\u3002\u987E\u6F84\u7528\u6781\u5177\u6E29\u5EA6\u548C\u540C\u7406\u5FC3\u7684\u6F14\u8BF4\uFF0C\u5C06\u4E00\u4E2A\u51B7\u786C\u7684\u7B97\u6CD5\u6A21\u578B\u5305\u88C5\u6210\u4E86\u5145\u6EE1\u793E\u4F1A\u8D23\u4EFB\u611F\u7684\u79D1\u6280\u63D0\u6848\u3002\u8FD9\u5957\u6253\u6CD5\u5251\u8D70\u504F\u950B\uFF0C\u6210\u529F\u5438\u5F15\u4E86\u8BC4\u59D4\u7EC4\u4E2D\u503E\u5411\u4E8E\u793E\u4F1A\u4EF7\u503C\u6295\u8D44\u7684\u4E13\u5BB6\u3002"
    choices: []
