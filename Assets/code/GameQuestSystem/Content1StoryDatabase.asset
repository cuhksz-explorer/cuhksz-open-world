    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1014.69, y: 14.22, z: 979.67}
    rewardGold: 65
    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u201C\u53EA\u6709\u4E0D\u5B89\u5206\u7684\u4EBA\u624D\u80FD\u5728\u96E8\u591C\u5E76\u80A9\u8D70\u5728\u4E00\u8D77\u3002\u6211\u4E0D\u559C\u6B22\u592A\u542C\u8BDD\u7684\u5267\u672C\u3002\u201D"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u505C\u4E0B\u4E86\u811A\u6B65\u3002\u96E8\u58F0\u5608\u6742\uFF0C\u4F46\u5728\u8FD9\u67C4\u9ED1\u8272\u7684\u96E8\u4F1E\u4E0B\uFF0C\u4E16\u754C\u9759\u5F97\u8FDE\u5F7C\u6B64\u7684\u547C\u5438\u58F0\u90FD\u6E05\u6670\u53EF\u95FB\u3002\u5979\u6CA1\u6709\u770B\u6797\u6E21\uFF0C\u800C\u662F\u76EF\u7740\u4F1E\u5C16\u6ED1\u843D\u7684\u4E00\u4E32\u96E8\u6EF4\uFF0C\u773C\u795E\u91CC\u7684\u950B\u8292\u7B2C\u4E00\u6B21\u5728\u6797\u6E21\u9762\u524D\u5F7B\u5E95\u5378\u4E86\u4E0B\u6765\uFF0C\u900F\u51FA\u4E00\u4E1D\u75B2\u60EB\u7684\u5E95\u8272\u3002"
    - pageNumber: 3
      speakerName: "\u5468\u781A"
      text: "\u201C\u5267\u672C\u2026\u2026\u662F\u554A\uFF0C\u6211\u6F14\u4E86\u592A\u4E45\u7684\u2018\u4F18\u79C0\u6A21\u677F\u2019\uFF0C\u6F14\u5230\u5FEB\u8981\u5FD8\u4E86\u4E0D\u6309\u53F0\u8BCD\u8BF4\u8BDD\u662F\u4EC0\u4E48\u611F\u89C9\u4E86\u3002\u201D"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u539F\u672C\u6211\u4EE5\u4E3A\uFF0C\u4F60\u53EA\u662F\u6211\u8BA1\u5212\u91CC\u7684\u4E00\u4E2A\u53D8\u91CF\u3002\u4F46\u73B0\u5728\u770B\u6765\u2026\u2026\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u81EA\u5632\u5730\u7B11\u4E86\u7B11\uFF0C\u66FF\u6797\u6E21\u7406\u4E86\u7406\u88AB\u98CE\u5439\u4E71\u7684\u9B13\u89D2"
    - pageNumber: 6
      speakerName: "\u5468\u781A"
      text: "\u201C\u65E2\u7136\u4F60\u4E0D\u559C\u6B22\u90A3\u4E2A\u5267\u672C\uFF0C\u90A3\u4ECA\u665A\u8FD9\u6BB5\u8DEF\uFF0C\u6211\u4EEC\u5C31\u8D70\u6162\u4E00\u70B9\u3002\u8BA9\u90A3\u4E9B\u2018\u5B88\u89C4\u77E9\u7684\u4EBA\u2019\u53BB\u8D76\u8DEF\u5427\uFF0C\u6211\u4EEC\u8981\u53BB\u7684\u5730\u65B9\uFF0C\u4E0D\u5728\u4ED6\u4EEC\u7684\u5730\u56FE\u4E0A\u3002\u201D"
    choices: []
