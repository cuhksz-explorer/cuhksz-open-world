    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: M2-3-2b\u6C88
    - pageNumber: 1
      speakerName: 
      text: "\u6797\u6E21\u9000\u540E\u4E24\u6B65\uFF0C\u6253\u91CF\u7740\u4ED6\uFF0C\u6545\u610F\u5439\u4E86\u4E2A\u53E3\u54E8\uFF0C\u7136\u540E\u62CD\u4E86\u62CD\u4ED6\u7684\u80A9\u8180\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5E05\u5446\u4E86\uFF0C\u6C88\u5927\u5E05\u54E5\u3002\u8D70\u51FA\u8FD9\u4E2A\u95E8\uFF0C\u4F30\u8BA1\u4F1A\u6709\u4EBA\u95EE\u4F60\u8981\u8054\u7CFB\u65B9\u5F0F\u3002\u5230\u65F6\u5019\u4F60\u53EF\u522B\u53C8\u50CF\u521A\u624D\u90A3\u6837\uFF0C\u5C34\u5C2C\u5F97\u8FDE\u8DEF\u90FD\u4E0D\u4F1A\u8D70\u4E86\u3002\u201D"
    - pageNumber: 3
      speakerName: 
      text: "\u6C88\u9752\u79BE\u6709\u4E9B\u7A98\u8FEB\u5730\u6293\u4E86\u6293\u5934\u53D1\uFF0C\u628A\u536B\u8863\u7684\u5E3D\u5B50\u6263\u5728\u5934\u4E0A\uFF0C\u8BD5\u56FE\u906E\u4F4F\u81EA\u5DF1\u53D1\u70EB\u7684\u8138\u3002"
    - pageNumber: 4
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6211\u2026\u2026\u6211\u4E0D\u4F1A\u7ED9\u4ED6\u4EEC\u7684\u3002\u6211\u4E5F\u6CA1\u90A3\u4E48\u2026\u2026\u4E0D\u4F1A\u8D70\u8DEF\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u6C88\u9752\u79BE\u7D27\u7EF7\u7684\u8EAB\u4F53\u677E\u5F1B\u4E86\u4E0B\u6765\uFF0C\u4ED6\u610F\u8BC6\u5230\u5728\u6797\u6E21\u9762\u524D\uFF0C\u4ED6\u53EF\u4EE5\u4E0D\u7528\u975E\u5F97\u90A3\u4E2A\u201C\u4E0D\u51FA\u9519\u7684\u5B66\u957F\u201D\u3002"
    choices: []
  - documentId: M2-3-3
    title: M2-3-3
    sourceAssetPath: Assets/content1/M2/M2-3-3.docx
    chapterId: M2
    category: 0
