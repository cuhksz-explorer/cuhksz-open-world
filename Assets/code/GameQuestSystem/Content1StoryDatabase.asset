    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6DF1\u5733\u516B\u6708\u7684\u8749\u9E23\uFF0C\u6BD4\u60F3\u8C61\u4E2D\u66F4\u52A0\u5C16\u9510\u3002\u7A7A\u6C14\u91CC\u88F9\u631F\u7740\u6D77\u6D0B\u7684\u54B8\u6E7F\u548C\u67CF\u6CB9\u8DEF\u88AB\u6652\u5316\u540E\u7684\u82E6\u5473\uFF0C\u8FD9\u5C31\u662F\u201C\u672A\u540D\u4E4B\u6D77\u201D\u7ED9\u6797\u6E21\u7684\u7B2C\u4E00\u5370\u8C61\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u6E21\u62D6\u7740\u6C89\u91CD\u7684\u884C\u674E\u7BB1\uFF0C\u7AD9\u5728\u9999\u6E2F\u4E2D\u6587\u5927\u5B66\u7684\u5927\u95E8\u53E3\u3002\u773C\u524D\u7684\u5EFA\u7B51\u7EBF\u6761\u51CC\u5389\u800C\u73B0\u4EE3\uFF0C\u50CF\u662F\u4E00\u5EA7\u4E25\u5BC6\u7684\u7CBE\u5BC6\u4EEA\u5668\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u4E0D\u8FDC\u5904\uFF0C\u51E0\u4E2A\u8EAB\u7A7F\u6DF1\u84DD\u8272\u5FD7\u613F\u8005\u9A6C\u7532\u7684\u5B66\u751F\u6B63\u7A7F\u68AD\u5728\u4EBA\u7FA4\u4E2D\u3002\u4E00\u4E2A\u6234\u7740\u9ED1\u6846\u773C\u955C\u3001\u770B\u8D77\u6765\u6709\u4E9B\u75B2\u60EB\u7684\u5B66\u957F\u6CE8\u610F\u5230\u4E86\u6B63\u5728\u770B\u5730\u56FE\u7684\u6797\u6E21\u3002"
    - pageNumber: 4
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u540C\u5B66\uFF0C\u662F\u65B0\u751F\u5427\uFF1F\u522B\u770B\u5730\u56FE\u4E86\uFF0C\u90A3\u662F\u7ED9\u5916\u5BBE\u770B\u7684\u3002\u4F60\u8981\u53BB\u62A5\u5230\u70B9\u7684\u8BDD\uFF0C\u987A\u7740\u8FD9\u6761\u5761\u4E00\u76F4\u5F80\u4E0A\u8D70\u3002"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u8C22\u8C22\u5B66\u957F\u3002\u8BF7\u95EE\u2026\u2026\u62A5\u5230\u9886\u5361\u662F\u5728\u90A3\u8FB9\u7684\u4F53\u80B2\u9986\u5417\uFF1F"
    - pageNumber: 6
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u5BF9\u3002\u53BB\u5427\uFF0C\u8D81\u7740\u73B0\u5728\u8FD8\u6CA1\u6392\u8D77\u957F\u961F\u3002\u5BF9\u4E86\uFF0C\u6821\u56ED\u5361\u5C31\u662F\u4F60\u7684\u547D\u6839\u5B50\uFF0C\u5403\u996D\u3001\u8FDB\u95E8\u3001\u6253\u5370\u8BB2\u4E49\uFF0C\u751A\u81F3\u53BB\u56FE\u4E66\u9986\u62A2\u4F4D\u5B50\u90FD\u9760\u5B83\u3002"
    - pageNumber: 7
      speakerName: 
      text: "\u6797\u6E21\u987A\u7740\u5B66\u957F\u6307\u7684\u65B9\u5411\u8D70\u53BB\u3002\u70C8\u65E5\u4E0B\uFF0C\u4ED6\u611F\u89C9\u81EA\u5DF1\u50CF\u662F\u6B63\u5728\u8FDB\u5165\u67D0\u79CD\u5DE8\u5927\u7684\u7CFB\u7EDF\uFF0C\u6BCF\u4E00\u4E2A\u64E6\u80A9\u800C\u8FC7\u7684\u5B66\u751F\u90FD\u6B65\u5C65\u5306\u5306\uFF0C\u4EFF\u4F5B\u8EAB\u540E\u6709\u770B\u4E0D\u89C1\u7684\u5012\u8BA1\u65F6\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u4F53\u80B2\u9986\u5185\uFF0C\u51B7\u6C14\u4E0E\u55A7\u56A3\u540C\u65F6\u88AD\u6765\u3002\u6797\u6E21\u5728\u62A5\u5230\u7A97\u53E3\u524D\u7AD9\u5B9A\u3002"
    - pageNumber: 9
      speakerName: "\u62A5\u5230\u8001\u5E08"
      text: "\u59D3\u540D\uFF0C\u8EAB\u4EFD\u8BC1\u53F7\u3002"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u6797\u6E21\u3002440..."
    - pageNumber: 11
      speakerName: 
      text: "\u6797\u6E21\u63A5\u8FC7\u90A3\u5F20\u8584\u8584\u7684\u5851\u6599\u5361\u7247\uFF0C\u6307\u5C16\u8FD8\u80FD\u611F\u53D7\u5230\u5236\u5361\u673A\u7559\u4E0B\u7684\u4F59\u6E29\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u518D\u6B21\u56DE\u5230\u6821\u95E8\u65F6\uFF0C\u521A\u624D\u90A3\u4F4D\u5B66\u957F\u6B63\u5750\u5728\u53F0\u9636\u4E0A\u559D\u6C34\uFF0C\u4ED6\u8F6C\u5934\u770B\u5411\u6797\u6E21\uFF0C\u773C\u795E\u91CC\u5E26\u7740\u4E00\u79CD\u8BF4\u4E0D\u6E05\u7684\u5BA1\u89C6\u3002"
    - pageNumber: 13
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u5361\u9886\u5230\u4E86\uFF1F\u606D\u559C\uFF0C\u4F60\u6B63\u5F0F\u6210\u4E3A\u8FD9\u53F0\u7CBE\u5BC6\u673A\u5668\u91CC\u7684\u4E00\u4E2A\u96F6\u4EF6\u4E86\u3002"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "\u5B66\u957F\uFF0C\u4E3A\u4EC0\u4E48\u5927\u5BB6\u770B\u8D77\u6765\u90FD\u8FD9\u4E48\u2026\u2026\u6025\uFF1F"
    - pageNumber: 15
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u6025\uFF1F\u8FD9\u53EA\u662F\u70ED\u8EAB\u3002\u6797\u6E21\uFF0C\u4F60\u4EE5\u540E\u4F1A\u660E\u767D\u7684\u2014\u2014\u5F88\u591A\u4EBA\u4EE5\u4E3A\u5927\u5B66\u662F\u4EBA\u751F\u7684\u907F\u98CE\u6E2F\uFF0C\u662F\u52AA\u529B\u7684\u7EC8\u70B9\u3002"
    - pageNumber: 16
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u4F46\u5728\u8FD9\u91CC\uFF0C\u5927\u5B66\u53EA\u662F\u4E00\u4E2A\u653E\u5927\u955C\u3002"
    - pageNumber: 17
      speakerName: "\u8FCE\u65B0\u5B66\u957F"
      text: "\u5B83\u4F1A\u653E\u5927\u4F60\u7684\u91CE\u5FC3\uFF0C\u4E5F\u4F1A\u653E\u5927\u4F60\u7684\u5E73\u5EB8\u3002\u5B83\u4F1A\u628A\u4F60\u7684\u7126\u8651\u5207\u6210\u788E\u7247\uFF0C\u518D\u585E\u8FDB\u6BCF\u4E00\u79D2\u7684\u8BFE\u8868\u91CC\u3002"
    choices:
    - label: "\u793C\u8C8C\u56DE\u5E94"
      targetDocumentId: M0-1-2-A
