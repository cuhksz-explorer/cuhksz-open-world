    - pageNumber: 2
      speakerName: 
      text: "\u4ED6\u773C\u4E2D\u7684\u9632\u5907\u5F7B\u5E95\u5378\u4E0B\uFF0C\u53D6\u800C\u4EE3\u4E4B\u7684\u662F\u4E00\u79CD\u627E\u5230\u6781\u5C11\u6570\u201C\u540C\u7C7B\u201D\u7684\u6DF1\u5C42\u8BA4\u540C\u3002\u4ED6\u5F88\u5C11\u5728\u522B\u4EBA\u9762\u524D\u8868\u73B0\u51FA\u8FD9\u79CD\u7EDD\u5BF9\u7684\u653E\u677E\u3002"
    - pageNumber: 3
