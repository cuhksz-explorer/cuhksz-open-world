    fallbackTargetPosition: {x: -3.91, y: 0.95, z: -23.67}
    rewardGold: 25
    finishLocationName: "\u673A\u623F/\u9009\u8BFE\u7CFB\u7EDF"
    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u65F6\u95F4\u786E\u5B9E\u6765\u4E0D\u53CA\u4E86\u3002\u65E2\u7136\u6893\u7487\u6709\u73B0\u6210\u7684\u6846\u67B6\uFF0C\u6211\u4EEC\u5C31\u2026\u2026\u7528\u5427\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u6797\u89C1\u9E7F\u539F\u672C\u6B63\u8981\u64CD\u4F5C\u9F20\u6807\u7684\u624B\u50F5\u4F4F\u4E86\uFF0C\u5979\u770B\u7740\u6797\u6E21\uFF0C\u773C\u795E\u91CC\u95EA\u8FC7\u4E00\u4E1D\u5931\u671B\uFF0C\u968F\u540E\u9ED8\u9ED8\u5730\u5782\u4E0B\u4E86\u5934\uFF0C\u5408\u4E0A\u4E86\u81EA\u5DF1\u7684\u7535\u8111\u3002"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u4F46\u6893\u7487\uFF0C\u4F60\u5FC5\u987B\u4FDD\u8BC1\u6539\u5F97\u8DB3\u591F\u5F7B\u5E95\u3002\u6240\u6709\u7684\u53D8\u91CF\u540D\u3001\u903B\u8F91\u987A\u5E8F\u3001\u751A\u81F3\u8FDE\u91CC\u9762\u7684\u810F\u6570\u636E\u5904\u7406\u65B9\u5F0F\u90FD\u8981\u91CD\u5199\u3002"
    - pageNumber: 4
      speakerName: "\u8D75\u6893\u7487"
      text: "\u653E\u5FC3\u5427\uFF0C\u8FD9\u79CD\u4E8B\u6211\u4E0D\u662F\u7B2C\u4E00\u6B21\u505A\u4E86\u3002\u6797\u6E21\uFF0C\u76F8\u4FE1\u6211\uFF0C\u5230\u4E86\u671F\u672B\u4F60\u770B\u5230\u6210\u7EE9\u5355\u65F6\uFF0C\u4F60\u4F1A\u611F\u8C22\u6211\u4ECA\u665A\u7684\u51B3\u65AD\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u90A3\u4E00\u665A\uFF0C\u8BA8\u8BBA\u5BA4\u91CC\u53EA\u6709\u952E\u76D8\u75AF\u72C2\u6572\u51FB\u7684\u58F0\u97F3\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u6B21\u65E5\u7684\u7B54\u8FA9\u3002"
    - pageNumber: 7
      speakerName: "\u6559\u6388"
      text: "\u4F60\u4EEC\u7684\u9884\u6D4B\u51C6\u786E\u7387\u5F88\u9AD8\uFF0C\u751A\u81F3\u8D85\u8FC7\u4E86\u4E00\u4E9B\u9AD8\u5E74\u7EA7\u7684\u6C34\u5E73\u3002"
    - pageNumber: 8
      speakerName: 
      text: "\u6559\u6388\u76EF\u7740\u5C4F\u5E55\u4E0A\u7684\u66F2\u7EBF\uFF0C\u7709\u5934\u5FAE\u5FAE\u76B1\u8D77\uFF0C\u773C\u795E\u5728\u56DB\u4E2A\u5973\u751F\u8138\u4E0A\u626B\u8FC7\u3002"
    - pageNumber: 9
      speakerName: "\u6559\u6388"
      text: "\u8FD9\u4E2A\u7279\u5F81\u63D0\u53D6\u7684\u601D\u8DEF\u5F88\u65B0\u9896\uFF0C\u80FD\u8BE6\u7EC6\u8BB2\u8BB2\u4F60\u4EEC\u662F\u600E\u4E48\u63A8\u5BFC\u51FA\u6765\u7684\u5417\uFF1F"
    - pageNumber: 10
      speakerName: "\u8D75\u6893\u7487"
      text: "\u662F\u6211\u4E3B\u7B14\u7684\uFF0C\u6211\u4EEC\u53C2\u8003\u4E86\u53BB\u5E74\u7684\u2026\u2026"
    - pageNumber: 11
      speakerName: 
      text: "\u8D75\u6893\u7487\u5BF9\u7B54\u5982\u6D41\uFF0C\u4F46\u6797\u6E21\u6CE8\u610F\u5230\u5750\u5728\u65C1\u8FB9\u7684\u6797\u89C1\u9E7F\uFF0C\u5168\u7A0B\u6CA1\u6709\u770B\u8FC7\u5C4F\u5E55\u4E00\u773C\u3002"
    choices: []
  - documentId: M1-2-2B
