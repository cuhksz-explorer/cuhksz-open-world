    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u8BB2\u5546\u4E1A\u6545\u4E8B\u4E0D\u4E00\u5B9A\u975E\u8981\u627E\u90A3\u79CD\u4F1A\u717D\u60C5\u7684\u4EBA\u3002\u8BC4\u59D4\u90FD\u662F\u8D44\u65B9\uFF0C\u4ED6\u4EEC\u6BD4\u8C01\u90FD\u7CBE\uFF0C\u8BB2\u60C5\u6000\u6CA1\u7528\uFF0C\u5F97\u770B\u8D26\u672C\u3002\u6211\u53BB\u8054\u7CFB\u6797\u89C1\u9E7F\u3002"
    - pageNumber: 2
      speakerName: "\u695A\u5929"
      text: "\u90A3\u4E2A\u5B66\u4F1A\u8BA1\u7684\u6797\u89C1\u9E7F\uFF1F\u5979\u505A\u8D22\u52A1\u5BA1\u8BA1\u786E\u5B9E\u5389\u5BB3\uFF0C\u4F46\u5546\u4E1A\u8BA1\u5212\u4E66\u9700\u8981\u753B\u5927\u997C\uFF0C\u5979\u90A3\u79CD\u4E00\u677F\u4E00\u773C\u7684\u6027\u683C\u80FD\u884C\u5417\uFF1F"
    - pageNumber: 3
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u6211\u4EEC\u8DEF\u6F14\u7684\u65F6\u5019\uFF0C\u7ED9\u4ED6\u4EEC\u5C55\u793A\u4E00\u4EFD\u627E\u4E0D\u51FA\u903B\u8F91\u6F0F\u6D1E\u3001\u6210\u672C\u548C\u9884\u671F\u6536\u76CA\u7B97\u5F97\u5408\u60C5\u5408\u7406\u7684\u8D22\u52A1\u6A21\u578B\uFF0C\u5C31\u80FD\u9547\u4F4F\u573A\u5B50\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u6797\u6E21\u8FDE\u591C\u8BF7\u6765\u4E86\u6797\u89C1\u9E7F\u3002\u6797\u89C1\u9E7F\u4E8C\u8BDD\u4E0D\u8BF4\u5730\u63A5\u7BA1\u4E86\u5546\u4E1A\u8BA1\u5212\u4E66\u7684\u7F16\u5199\u3002\u5728\u8DEF\u6F14\u65F6\uFF0C\u5979\u7528\u6BEB\u65E0\u7834\u7EFD\u7684\u8D22\u52A1\u6570\u636E\u6D41\u642D\u914D\u6797\u6E21\u7684\u7B97\u6CD5\uFF0C\u8BA9\u8BC4\u59D4\u611F\u53D7\u5230\u4E86\u6781\u9AD8\u7684\u4E13\u4E1A\u4FE1\u4EFB\u5EA6\u3002"
    choices: []
