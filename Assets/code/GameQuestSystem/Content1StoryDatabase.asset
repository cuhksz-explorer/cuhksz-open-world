    finishLocationName: "\u56FE\u4E66\u9986\u516C\u5171\u9605\u8BFB\u533A"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u4E24\u4EBA\u5947\u8FF9\u822C\u5730\u5728\u5348\u591C\u524D\u907F\u5F00\u4E86\u4EBA\u7FA4\uFF0C\u767B\u4E0A\u4E86\u6797\u6E21\u63D0\u524D\u9884\u7EA6\u597D\u7684\u4E00\u8258\u5FEB\u8247\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u8F6E\u8239\u7F13\u7F13\u9A76\u5411\u7EF4\u591A\u5229\u4E9A\u6E2F\u7684\u4E2D\u5FC3\uFF0C\u5468\u56F4\u662F\u6F06\u9ED1\u7684\u6D77\u6C34\uFF0C\u8FDC\u5904\u662F\u6E2F\u5C9B\u7480\u74A8\u7684\u706F\u706B\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u63A5\u8FD1 24:00 \u65F6\uFF0C\u4E24\u4EBA\u5750\u5728\u7532\u677F\u8FB9\u7F18\u3002\u665A\u98CE\u5439\u62C2\u7740\u9762\u988A\uFF0C\u5BF9\u5CB8\u5927\u697C\u4E0A\u7684\u5DE8\u578B\u5C4F\u5E55\u5DF2\u7ECF\u5F00\u59CB\u4E86\u6700\u540E\u7684\u5012\u8BA1\u65F6\u3002\u4E24\u4EBA\u624B\u91CC\u5404\u62FF\u7740\u4E00\u74F6\u5728\u7801\u5934\u4FBF\u5229\u5E97\u4E70\u7684\u73BB\u7483\u6A3D\u88C5\u6A58\u5B50\u6C7D\u6C34\u3002\u73BB\u7483\u74F6\u58C1\u4E0A\u51DD\u7ED3\u7740\u7EC6\u5BC6\u7684\u6C34\u73E0\u3002"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u597D\u50CF\u5DF2\u7ECF\u5F88\u4E45\u6CA1\u6709\u5728\u4E00\u4E2A\u4E0D\u7528\u5DE5\u4F5C\u7684\u591C\u665A\uFF0C\u4EC0\u4E48\u90FD\u4E0D\u60F3\uFF0C\u5C31\u4E3A\u4E86\u4E00\u4E2A\u6728\u5934\u76D2\u5B50\u7684\u673A\u5173\u6216\u8005\u4E00\u74F6\u6C7D\u6C34\u8F83\u52B2\u4E86\u3002\u751A\u81F3\u2026\u2026\u8FDE\u70DF\u82B1\u8FD8\u6CA1\u653E\uFF0C\u6211\u90FD\u89C9\u5F97\u4ECA\u665A\u8D62\u4E86\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u611F\u89C9\u600E\u4E48\u6837\uFF1F\u662F\u4E0D\u662F\u6BD4\u770B\u90A3\u4E9B\u865A\u62A5\u7684\u8D22\u52A1\u62A5\u8868\u6709\u610F\u601D\uFF1F\u201D"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u8F6C\u5934\u770B\u5411\u6797\u6E21\uFF0C\u7EF4\u6E2F\u7684\u706F\u706B\u6620\u5728\u5979\u6DF1\u9083\u7684\u773C\u5E95\uFF0C\u90A3\u5C42\u540D\u4E3A\u201C\u9886\u5BFC\u8005\u201D\u7684\u786C\u58F3\u5DF2\u7ECF\u5B8C\u5168\u6D88\u5931."
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u201C\u9664\u4E86\u88AB\u4F60\u7528\u90A3\u79CD\u79BB\u8C31\u7684\u65B9\u5F0F\u6253\u7834\u4E86\u6211\u7684\u8FD0\u7B97\u903B\u8F91\u4E4B\u5916\uFF0C\u5176\u4ED6\u90FD\u5F88\u597D\u3002\u201D"
    - pageNumber: 8
      speakerName: "\u968F\u7740\u201C00"
      text: "00\u201D\u7684\u5012\u6570\u7ED3\u675F\uFF0C\u6F2B\u5929\u7684\u70DF\u82B1\u5728\u6D77\u9762\u4E0A\u8F70\u7136\u70B8\u88C2\uFF0C\u91D1\u8272\u7684\u96E8\u548C\u7D2B\u8272\u7684\u6D41\u661F\u7167\u4EAE\u4E86\u6574\u7247\u591C\u7A7A\u3002"
    - pageNumber: 9
      speakerName: 
      text: "\u5468\u781A\u5728\u5DE8\u5927\u7684\u70DF\u82B1\u58F0\u4E2D\u51D1\u8FD1\u6797\u6E21\uFF0C\u628A\u624B\u91CC\u7684\u73BB\u7483\u74F6\u5411\u6797\u6E21\u7684\u65B9\u5411\u8F7B\u8F7B\u4E00\u78B0\uFF0C\u53D1\u51FA\u6E05\u8106\u7684\u201C\u53EE\u201D\u58F0\u3002"
    - pageNumber: 10
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF0C\u5143\u65E6\u5FEB\u4E50\u3002\u8C22\u8C22\u4F60\u2026\u2026\u5E26\u6211\u504F\u79BB\u4E86\u884C\u7A0B\uFF0C\u5374\u627E\u5230\u4E86\u65B0\u822A\u5411\u3002\u201D"
    - pageNumber: 11
      speakerName: 
      text: "\u6797\u6E21\u4E3E\u8D77\u74F6\u5B50\u4E0E\u5979\u78B0\u676F\uFF0C\u5927\u58F0\u7B11\u7740\u56DE\u5E94\u3002"
    - pageNumber: 12
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5143\u65E6\u5FEB\u4E50\uFF0C\u5468\u781A\uFF01\u987A\u4FBF\u8BF4\u4E00\u53E5\uFF0C\u4F60\u521A\u624D\u5728\u626D\u86CB\u673A\u524D\u90A3\u5F20\u7834\u9632\u7684\u7167\u7247\uFF0C\u6211\u5DF2\u7ECF\u9694\u7A7A\u6295\u9001\u7ED9\u4F60\u4E86\uFF0C\u90A3\u662F\u6211\u8FD9\u4E00\u5E74\u6700\u91CD\u8981\u7684\u6536\u85CF\uFF01\u201D"
    - pageNumber: 13
      speakerName: 
      text: "\u5468\u781A\u5148\u662F\u6123\u4E86\u4E00\u79D2\uFF0C\u968F\u540E\u7ACB\u523B\u653E\u4E0B\u6C7D\u6C34\uFF0C\u4F5C\u52BF\u8981\u53BB\u62A2\u6797\u6E21\u88C5\u5728\u5927\u8863\u53E3\u888B\u91CC\u7684\u624B\u673A\u3002"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF01\u4F60\u521A\u624D\u5C45\u7136\u5077\u62CD\u4E86\uFF1F\uFF01\u8D81\u70DF\u82B1\u8FD8\u6CA1\u653E\u5B8C\uFF0C\u7ACB\u523B\u7ED9\u6211\u5220\u6389\uFF01\u201D"
    - pageNumber: 15
      speakerName: 
      text: "\u6797\u6E21\u7075\u6D3B\u5730\u95EA\u8EAB\u8EB2\u5230\u7532\u677F\u7684\u53E6\u4E00\u8FB9\uFF0C\u5BF9\u7740\u6EE1\u5929\u7684\u70DF\u82B1\u5927\u558A\u3002"
    - pageNumber: 16
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5220\u4E0D\u4E86\u5220\u4E0D\u4E86\uFF0C\u6211\u5DF2\u7ECF\u4E91\u5907\u4EFD\u4E86\u5468\u8001\u677F\uFF01\u201D"
    choices: []
