    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u53EA\u8981\u80FD\u8BA9\u6211\u63A5\u89E6\u5230\u6700\u6838\u5FC3\u7684\u4EE3\u7801\u5E93\uFF0C\u5403\u7684\u4E0D\u7B97\u4EC0\u4E48\u3002\u6211\u60F3\u770B\u770B\u5927\u6A21\u578B\u5728\u5782\u76F4\u9886\u57DF\u7684\u6781\u9650\u5230\u5E95\u5728\u54EA\uFF0C\u800C\u4E0D\u662F\u53BB\u505A\u8D5B\u535A\u6D41\u6C34\u7EBF\u4E0A\u7684\u4E8B\u60C5\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\uFF08\u6691\u5047\uFF09\u6797\u6E21\u5F00\u59CB\u4E86\u4E00\u6BB5\u6E05\u82E6\u800C\u9AD8\u5F3A\u5EA6\u7684\u5F00\u53D1\u751F\u6D3B\u3002\u5979\u5728\u5C0F\u56E2\u961F\u4E2D\u627F\u62C5\u4E86\u8FDC\u8D85\u5B9E\u4E60\u751F\u8303\u7574\u7684\u6838\u5FC3\u804C\u8D23\uFF0C\u6280\u672F\u80FD\u529B\u5728\u77ED\u65F6\u95F4\u5185\u5B9E\u73B0\u4E86\u8D28\u7684\u98DE\u8DC3\u3002"
    choices: []
  - documentId: M4-3-3
