    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u4E2D\u73AF\u7684\u55A7\u56A3\u5728\u51CC\u6668\u4E24\u70B9\u7684\u8DE8\u5883\u5927\u5DF4\u4E0A\u9010\u6E10\u8FDC\u53BB\u3002\u6797\u6E21\u9760\u5728\u8F66\u7A97\u8FB9\uFF0C\u770B\u7740\u6DF1\u6E2F\u5927\u6865\u4E0A\u7EF5\u5EF6\u4E0D\u65AD\u7684\u8F66\u706F\uFF0C\u50CF\u662F\u4E00\u4E32\u6C38\u4E0D\u7184\u706D\u7684\u4E8C\u8FDB\u5236\u4EE3\u7801\u3002"
    - pageNumber: 2
      speakerName: 
      text: "\u5468\u781A\u5728\u98A0\u7C38\u4E2D\u7761\u7740\u4E86\u3002\u5979\u892A\u53BB\u4E86\u6240\u6709\u7684\u9632\u5907\uFF0C\u5934\u5FAE\u5FAE\u504F\u5411\u6797\u6E21\u7684\u65B9\u5411\uFF0C\u71D5\u9EA6\u8272\u7684\u5927\u8863\u4E0A\u8FD8\u6B8B\u7559\u7740\u6DE1\u6DE1\u7684\u8089\u6842\u9999\u6C14\u548C\u7EF4\u6E2F\u7684\u6D77\u76D0\u5473\u3002\u90A3\u4E00\u523B\uFF0C\u6797\u6E21\u610F\u8BC6\u5230\uFF0C\u90A3\u4E2A\u201C\u504F\u79BB\u884C\u7A0B\u201D\u7684\u591C\u665A\uFF0C\u6210\u4E86\u5979\u4EEC\u5728\u8FD9\u4E00\u5730\u9E21\u6BDB\u7684\u7ADE\u4E89\u751F\u6D3B\u4E2D\uFF0C\u5077\u6765\u7684\u6700\u540E\u4E00\u5757\u62FC\u56FE\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u7136\u800C\uFF0C\u73B0\u5B9E\u7684\u5F15\u529B\u603B\u662F\u5728\u8D8A\u8FC7\u8FB9\u754C\u7684\u90A3\u4E00\u523B\u91CD\u65B0\u964D\u4E34\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u5C31\u5728\u7B54\u8FA9\u524D\u591C\u7684\u4E0B\u5348\uFF0C\u7ADE\u4E89\u5BF9\u624B\u201C\u661F\u56FE\u56E2\u961F\u201D\u516C\u5F00\u53D1\u5E03\u4E86\u4ED6\u4EEC\u7684\u6D4B\u8BD5\u6570\u636E\u3002\u90A3\u4E32\u5B8C\u7F8E\u5230\u8FD1\u4E4E\u865A\u5047\u7684\u6570\u636E\uFF0C\u50CF\u662F\u4E00\u9053\u6B7B\u5211\u5224\u51B3\u4E66\uFF0C\u60AC\u5728\u4E86\u5468\u781A\u7B79\u5907\u4E86\u534A\u5E74\u7684\u9879\u76EE\u5934\u4E0A\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u51CC\u6668 01:00\u3002\u65E7\u56FE\u4E66\u9986\u7684\u7A7A\u8C03\u65E9\u5DF2\u505C\u6B62\u4F9B\u6696\uFF0C\u5BD2\u610F\u987A\u7740\u5927\u7406\u77F3\u5730\u9762\u722C\u4E0A\u811A\u8E1D\u3002"
    - pageNumber: 6
      speakerName: 
      text: "\u5468\u781A\u63C9\u4E86\u63C9\u7709\u5FC3\u3002\u5979\u624B\u91CC\u62FF\u7740\u7ADE\u4E89\u5BF9\u624B\u201C\u661F\u56FE\u56E2\u961F\u201D\u4E0B\u5348\u516C\u5F00\u7684\u9884\u8DD1\u6570\u636E\u3002"
    - pageNumber: 7
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u4EEC\u8D62\u4E0D\u4E86\u3002\u661F\u56FE\u653E\u51FA\u7684\u6D4B\u8BD5\u6307\u6807\u592A\u9AD8\u4E86\uFF0C\u51E0\u4E4E\u8FBE\u5230\u4E86\u76EE\u524D\u5546\u7528\u5927\u6A21\u578B\u7684\u9876\u7EA7\u6C34\u5E73\u3002\u4F46\u8FD9\u662F\u4E0D\u53EF\u80FD\u7684\uFF0C\u4ED6\u4EEC\u56E2\u961F\u7684\u7B97\u529B\u6839\u672C\u8DD1\u4E0D\u51FA\u8FD9\u79CD\u53C2\u6570\u3002\u201D"
    - pageNumber: 8
      speakerName: "\u5468\u781A"
      text: "\u201C\u5957\u58F3\u9020\u5047\u3002\u4F46\u660E\u5929\u7684\u8BC4\u59D4\u5927\u90E8\u5206\u662F\u884C\u653F\u9886\u5BFC\u548C\u975E\u786C\u6838\u6280\u672F\u4E13\u5BB6\uFF0C\u53EA\u770B\u6F14\u793A\u6548\u679C\u3002\u5C31\u7B97\u6211\u4EEC\u73B0\u5728\u5199\u4E3E\u62A5\u4FE1\uFF0C\u8D70\u5B8C\u5BA1\u67E5\u6D41\u7A0B\u4E5F\u8981\u534A\u4E2A\u6708\uFF0C\u8D44\u91D1\u660E\u5929\u4E0B\u5348\u5C31\u4F1A\u53D1\u653E\u5230\u4ED6\u4EEC\u8D26\u4E0A\u3002\u201D"
    - pageNumber: 9
      speakerName: 
      text: "\u89C4\u5219\u7684\u6EDE\u540E\u6027\uFF0C\u6210\u4E86\u4E00\u9053\u6B7B\u5C40\u3002\u5728\u8FD9\u5EA7\u8C61\u7259\u5854\u91CC\uFF0C\u6709\u91CE\u5FC3\u7684\u4EBA\u6B63\u5728\u88AB\u6BEB\u65E0\u5E95\u7EBF\u7684\u9020\u5047\u8005\u903C\u5165\u7EDD\u5883\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u6CA1\u6709\u60C5\u7EEA\u5931\u63A7\u3002\u5979\u63A8\u5F00\u952E\u76D8\uFF0C\u8F6C\u5934\u770B\u5411\u5468\u781A\u3002"
    - pageNumber: 11
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u6709\u4E00\u4E2A\u529E\u6CD5\uFF0C\u80FD\u5728\u660E\u5929\u7684\u7B54\u8FA9\u73B0\u573A\u76F4\u63A5\u6233\u7834\u8FD9\u5C42\u58F3\u3002\u4F46\u624B\u6BB5\u4E0D\u600E\u4E48\u5E72\u51C0\u3002\u201D"
    - pageNumber: 12
      speakerName: 
      text: "\u5468\u781A\u62AC\u8D77\u5934\uFF0C\u89C6\u7EBF\u4E0E\u6797\u6E21\u4EA4\u6C47\u3002"
    - pageNumber: 13
      speakerName: "\u6797\u6E21"
      text: "\u201C\u4ED6\u4EEC\u7684\u63A5\u53E3\u6CA1\u6709\u505A\u4E25\u5BC6\u7684\u63D0\u793A\u8BCD\u6CE8\u5165\u9632\u5FA1\u3002\u5982\u679C\u660E\u5929\u5728\u4ED6\u4EEC\u8FDB\u884C\u5B9E\u673A\u6F14\u793A\u7684\u65F6\u5019\uFF0C\u6211\u7528\u811A\u672C\u5411\u4ED6\u4EEC\u7684\u63A5\u53E3\u9AD8\u9891\u53D1\u9001\u4E00\u6BB5\u7279\u5B9A\u7684\u5BF9\u6297\u6027\u63D0\u793A\u8BCD\u2026\u2026\u4ED6\u4EEC\u7684\u6A21\u578B\u4F1A\u56E0\u4E3A\u5B89\u5168\u534F\u8BAE\u51B2\u7A81\u800C\u5D29\u6E83\uFF0C\u5E76\u5728\u5927\u5C4F\u5E55\u4E0A\u76F4\u63A5\u5410\u51FA\u539F\u751F\u5546\u4E1A\u5927\u6A21\u578B\u7684\u62A5\u9519\u6807\u8BC6\u3002\u201D"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u201C\u5728\u516C\u5F00\u7B54\u8FA9\u73B0\u573A\u8FDB\u884C\u6076\u610F\u4EE3\u7801\u6CE8\u5165\u2026\u2026\u6797\u6E21\uFF0C\u8FD9\u5C5E\u4E8E\u6076\u6027\u5E72\u6270\u3002\u4E00\u65E6\u88AB\u67E5\u51FAIP\u662F\u4F60\uFF0C\u4F60\u751A\u81F3\u4F1A\u80CC\u4E0A\u5904\u5206\u3002\u201D"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6211\u4F1A\u901A\u8FC7\u591A\u5C42\u4EE3\u7406\u7ED5\u5F00\u8FFD\u8E2A\uFF0C\u4F46\u98CE\u9669\u786E\u5B9E\u5B58\u5728\u3002\u5468\u781A\uFF0C\u73B0\u5728\u7684\u95EE\u9898\u4E0D\u662F\u6211\u6562\u4E0D\u6562\u3002\u800C\u662F\u613F\u4E0D\u613F\u610F\u4E3A\u4E86\u8D62\u4E0B\u8FD9\u7B14\u6551\u547D\u7684\u94B1\uFF0C\u8DDF\u6211\u4E00\u8D77\u5F53\u4E00\u6B21\u2018\u7834\u574F\u8005\u2019\uFF1F\u201D"
    - pageNumber: 16
      speakerName: 
      text: "\u5468\u781A\u770B\u7740\u6797\u6E21\uFF0C\u5979\u7A81\u7136\u53D1\u73B0\uFF0C\u5728\u8FD9\u4E2A\u5927\u4E00\u65B0\u751F\u7684\u51B7\u9759\u5916\u8868\u4E0B\uFF0C\u85CF\u7740\u6BD4\u5979\u66F4\u51B3\u7EDD\u7684\u6267\u884C\u529B\u3002\u5979\u4F38\u624B\u5408\u4E0A\u4E86\u6797\u6E21\u7684\u7535\u8111\u5C4F\u5E55\u3002"
    - pageNumber: 17
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u4EEC\u4E0D\u5E94\u8BE5\u7528\u6821\u56ED\u7F51\u5199\u8FD9\u6BB5\u811A\u672C\u3002\u201D"
    - pageNumber: 18
      speakerName: 
      text: "\u6797\u6E21\u62AC\u5934\u770B\u5979\u3002"
    - pageNumber: 19
      speakerName: "\u5468\u781A"
      text: "\u201C\u56DE\u6211\u7684\u516C\u5BD3\u53BB\u5199\u3002\u7528\u6211\u7684\u79C1\u4EBA\u7F51\u7EDC\u3002\u5982\u679C\u771F\u7684\u88AB\u8FFD\u67E5\uFF0C\u90A3\u662F\u6211\u7684\u8D23\u4EFB\u3002\u201D"
    - pageNumber: 20
      speakerName: 
      text: "\u5468\u781A\u7684\u516C\u5BD3\u4F4D\u4E8E\u9F99\u5C97\u533A\u7684\u9AD8\u5C42\uFF0C\u6781\u7B80\u4E3B\u4E49\u7684\u88C5\u4FEE\u98CE\u683C\u5728\u6DF1\u591C\u663E\u5F97\u6709\u4E9B\u51B7\u6E05\u3002\u5DE8\u5927\u7684\u843D\u5730\u7A97\u5916\uFF0C\u662F\u6B63\u5728\u6C89\u7761\u7684\u57CE\u5E02\u9713\u8679\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u4E24\u4EBA\u5E76\u80A9\u5750\u5728\u5BA2\u5385\u7684\u5730\u6BEF\u4E0A\uFF0C\u5468\u56F4\u6563\u843D\u7740\u6253\u5370\u51FA\u6765\u7684\u63A5\u53E3\u6587\u6863\u548C\u51E0\u7F50\u5DF2\u7ECF\u559D\u7A7A\u7684\u5496\u5561\u3002"
    - pageNumber: 22
      speakerName: 
      text: "\u6797\u6E21\u7684\u624B\u6307\u5728\u952E\u76D8\u4E0A\u98DE\u901F\u821E\u52A8\uFF0C\u6572\u51FB\u58F0\u5728\u7A7A\u65F7\u7684\u623F\u95F4\u91CC\u663E\u5F97\u683C\u5916\u6E05\u8106\u3002\u5468\u781A\u5750\u5728\u5979\u8EAB\u540E\uFF0C\u624B\u91CC\u62FF\u7740\u4E00\u652F\u7EA2\u7B14\uFF0C\u4E0D\u65AD\u5FAE\u8C03\u7740\u660E\u5929\u7B54\u8FA9\u7684\u6F14\u8BB2\u7A3F\uFF0C\u5076\u5C14\u4F1A\u4F38\u624B\u66FF\u6797\u6E21\u62E2\u4E00\u62E2\u6ED1\u843D\u7684\u9B13\u53D1\u3002"
    - pageNumber: 23
      speakerName: "\u5468\u781A"
      text: "\u811A\u672C\u5199\u597D\u4E86\u5417\uFF1F"
    - pageNumber: 24
      speakerName: "\u6797\u6E21"
      text: "\u5B8C\u6210\u4E86\u3002\u653B\u51FB\u8F7D\u8377\u5DF2\u7ECF\u5C01\u88C5\u6210\u4E86\u4E09\u4E2A\u9636\u68AF\u3002\u53EA\u8981\u4ED6\u4EEC\u5728\u6F14\u793A\u65F6\u8F93\u5165\u7B2C\u4E00\u4E2A\u6307\u4EE4\uFF0C\u6211\u4EEC\u7684\u811A\u672C\u5C31\u4F1A\u901A\u8FC7\u4EE3\u7406\u81EA\u52A8\u89E6\u53D1\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u5468\u781A\uFF0C\u5982\u679C\u4F60\u73B0\u5728\u540E\u6094\uFF0C\u8FD8\u6765\u5F97\u53CA\u3002\u6211\u4EEC\u53EA\u9700\u8981\u5220\u6389\u8FD9\u4E2A\u6587\u4EF6\u5939\uFF0C\u660E\u5929\u4F60\u5927\u53EF\u4EE5\u4F53\u9762\u5730\u8F93\u6389\u3002"
    - pageNumber: 26
      speakerName: 
      text: "\u5468\u781A\u81EA\u5632\u5730\u7B11\u4E86\u7B11\uFF0C\u66FF\u6797\u6E21\u62E7\u5F00\u4E00\u74F6\u65B0\u7684\u6C34\u3002"
    - pageNumber: 27
      speakerName: "\u5468\u781A"
      text: "\u4F53\u9762\uFF1F\u5728\u6E2F\u4E2D\u6DF1\uFF0C\u4F53\u9762\u662F\u7559\u7ED9\u80DC\u8005\u7684\u88C5\u9970\u54C1\u3002\u8F93\u5BB6\u53EA\u914D\u62E5\u6709\u6C89\u9ED8\u3002"
    - pageNumber: 28
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\uFF0C\u8FD9\u4E00\u6B65\u8E0F\u51FA\u53BB\uFF0C\u6211\u4EEC\u5C31\u771F\u7684\u4E0B\u4E0D\u4E86\u684C\u4E86\u3002"
    - pageNumber: 29
      speakerName: 
      text: "\u6797\u6E21\u56DE\u5934\uFF0C\u5728\u53F0\u706F\u660F\u9EC4\u7684\u5FAE\u5149\u4E0B\uFF0C\u5468\u781A\u7684\u773C\u795E\u91CC\u892A\u53BB\u4E86\u6240\u6709\u793E\u4EA4\u6027\u7684\u4F2A\u88C5\uFF0C\u53EA\u5269\u4E0B\u4E00\u4EFD\u51B0\u51B7\u7684\u3001\u8FD1\u4E4E\u5B64\u6CE8\u4E00\u63B7\u7684\u72C2\u70ED\u3002\u6797\u6E21\u70B9\u4E0B\u56DE\u8F66\u952E\uFF0C\u5C06\u811A\u672C\u5B58\u5165\u4E86\u4E91\u7AEF\u52A0\u5BC6\u5377\u3002"
    - pageNumber: 30
      speakerName: 
      text: "\u6B21\u65E5\u4E0A\u5348\u5341\u70B9\uFF0C\u884C\u653F\u5927\u697C\u591A\u529F\u80FD\u5385\u3002"
    - pageNumber: 31
      speakerName: 
      text: "\u661F\u56FE\u56E2\u961F\u7684\u9886\u961F\u5728\u53F0\u4E0A\u4F83\u4F83\u800C\u8C08\u3002\u4ED6\u8EAB\u540E\u7684\u5927\u5C4F\u5E55\u5C55\u793A\u7740\u90A3\u7EC4\u8FD1\u4E4E\u5B8C\u7F8E\u7684\u6D4B\u8BD5\u66F2\u7EBF\uFF0C\u53F0\u4E0B\u7684\u8BC4\u59D4\u2014\u2014\u90A3\u4E9B\u6765\u81EA\u6821\u62DB\u529E\u548C\u884C\u653F\u53E3\u7684\u9886\u5BFC\u4EEC\u2014\u2014\u6B63\u9891\u9891\u70B9\u5934\uFF0C\u751A\u81F3\u6709\u4EBA\u5DF2\u7ECF\u5728\u4EA4\u5934\u63A5\u8033\u51C6\u5907\u7ED9\u6EE1\u5206\u3002"
    - pageNumber: 32
      speakerName: "\u6797\u6E21"
      text: "\u8F6E\u5230\u4ED6\u4EEC\u6F14\u793A\u4E86\u3002"
    - pageNumber: 33
      speakerName: 
      text: "\u6797\u6E21\u5750\u5728\u540E\u6392\u6700\u9634\u6697\u7684\u89D2\u843D\u91CC\uFF0C\u819D\u76D6\u4E0A\u653E\u7740\u4E00\u4E2A\u9ED1\u8272\u7684\u80CC\u5305\u3002\u5979\u7684\u624B\u6307\u5728\u80CC\u5305\u91CC\u7684\u5FAE\u578B\u7EC8\u7AEF\u4E0A\u8F7B\u8F7B\u8DF3\u52A8\uFF0C\u773C\u795E\u6B7B\u6B7B\u5730\u76EF\u7740\u53F0\u4E0A\u90A3\u53F0\u6F14\u793A\u7528\u7684\u7B14\u8BB0\u672C\u3002"
    - pageNumber: 34
      speakerName: 
      text: "\u53F0\u4E0A\uFF0C\u661F\u56FE\u56E2\u961F\u7684\u9886\u961F\u5FD7\u5F97\u610F\u6EE1\u5730\u8F93\u5165\u4E86\u7B2C\u4E00\u4E2A\u6F14\u793A\u6307\u4EE4\uFF1A\u201C\u8BF7\u6839\u636E\u6211\u6821\u5386\u53F2\uFF0C\u751F\u6210\u4E00\u6BB5\u521B\u65B0\u611F\u609F\u3002\u201D"
    - pageNumber: 35
      speakerName: 
      text: "\u5C31\u5728\u4ED6\u70B9\u51FB\u53D1\u9001\u7684\u77AC\u95F4\uFF0C\u6797\u6E21\u4F4E\u58F0\u5FF5\u4E86\u4E00\u53E5\u3002"
    - pageNumber: 36
      speakerName: "\u6797\u6E21"
      text: "\u5C31\u662F\u73B0\u5728\u3002"
    - pageNumber: 37
      speakerName: 
      text: "\u5927\u5C4F\u5E55\u4E0A\u7684\u8FDB\u5EA6\u6761\u7A81\u7136\u5361\u6B7B\uFF0C\u90A3\u4E2A\u65CB\u8F6C\u7684\u5706\u5708\u5728\u90A3\u513F\u50F5\u6301\u4E86\u4E09\u79D2\u949F\u3002\u53F0\u4E0A\u7684\u9886\u961F\u6123\u4F4F\u4E86\uFF0C\u8BD5\u56FE\u901A\u8FC7\u5237\u65B0\u6765\u633D\u6551\u3002"
    - pageNumber: 38
      speakerName: 
      text: "\u4E0B\u4E00\u79D2\uFF0C\u5C4F\u5E55\u4E0A\u6CA1\u6709\u8DF3\u51FA\u611F\u609F\uFF0C\u800C\u662F\u50CF\u88AB\u67D0\u79CD\u65E0\u5F62\u7684\u624B\u6495\u5F00\u4E86\u76AE\u56CA\u3002"
    - pageNumber: 39
      speakerName: 
      text: "\u5168\u573A\u4E00\u7247\u6B7B\u5BC2\u3002\u90A3\u884C\u5E26\u6709\u660E\u663E\u201C\u7B2C\u4E09\u65B9\u5546\u4E1A\u6A21\u578B\u63A5\u53E3\u201D\u5B57\u6837\u7684\u62A5\u9519\u4FE1\u606F\uFF0C\u50CF\u4E00\u4E2A\u54CD\u4EAE\u7684\u8033\u5149\uFF0C\u76F4\u63A5\u6253\u5728\u4E86\u661F\u56FE\u56E2\u961F\u7684\u8138\u4E0A\u3002"
    - pageNumber: 40
      speakerName: 
      text: "\u8BC4\u59D4 A\uFF1A\u90A3\u662F\u2026\u2026Azure \u7684\u62A5\u9519\uFF1F\u4F60\u4EEC\u4E0D\u662F\u8BF4\u8FD9\u662F\u81EA\u7814\u7684\u672C\u5730\u6A21\u578B\u5417\uFF1F"
    - pageNumber: 41
      speakerName: 
      text: "\u8BC4\u59D4 B\uFF1A\u600E\u4E48\u56DE\u4E8B\uFF1F\u89E3\u91CA\u4E00\u4E0B\u3002"
    - pageNumber: 42
      speakerName: 
      text: "\u661F\u56FE\u9886\u961F\u7684\u8138\u8272\u77AC\u95F4\u60E8\u767D\uFF0C\u4ED6\u5728\u53F0\u4E0A\u652F\u652F\u543E\u543E\uFF0C\u51B7\u6C57\u6D78\u900F\u4E86\u886C\u886B\u3002\u9020\u5047\u7684\u9762\u5177\u5728\u8FD9\u4E00\u523B\u5D29\u5F97\u7C89\u788E\u3002"
    - pageNumber: 43
      speakerName: 
      text: "\u5468\u781A\u5728\u6B64\u65F6\u7F13\u7F13\u7AD9\u8D77\u8EAB\u3002\u5979\u6CA1\u6709\u8868\u73B0\u51FA\u4EFB\u4F55\u610F\u5916\uFF0C\u53EA\u662F\u6574\u7406\u4E86\u4E00\u4E0B\u5229\u843D\u7684\u897F\u88C5\u5916\u6CBF\uFF0C\u5E26\u7740\u4E00\u79CD\u964D\u7EF4\u6253\u51FB\u822C\u7684\u4F18\u96C5\u8D70\u5411\u8BB2\u53F0\u3002"
    - pageNumber: 44
      speakerName: "\u5468\u781A"
      text: "\u770B\u6765\u6709\u4E9B\u56E2\u961F\u7684\u201C\u81EA\u7814\u201D\u6C34\u5E73\u786E\u5B9E\u8D85\u51FA\u4E86\u6211\u4EEC\u7684\u60F3\u8C61\u3002"
    - pageNumber: 45
      speakerName: 
      text: "\u5979\u4ECE\u6797\u6E21\u7684\u65B9\u5411\u63A0\u8FC7\u4E00\u4E2A\u6781\u77ED\u7684\u773C\u795E\u4EA4\u6C47\uFF0C\u90A3\u662F\u53EA\u6709\u5171\u72AF\u624D\u80FD\u8BFB\u61C2\u7684\u6697\u53F7\u3002"
    - pageNumber: 46
      speakerName: "\u5468\u781A"
      text: "\u90A3\u4E48\uFF0C\u63A5\u4E0B\u6765\uFF0C\u8BF7\u5141\u8BB8\u6211\u4EEC\u5C55\u793A\u4E00\u4E0B\uFF0C\u4EC0\u4E48\u624D\u662F\u771F\u6B63\u8DD1\u5728\u672C\u5730\u7B97\u529B\u4E0A\u7684\u771F\u5B9E\u5E95\u5EA7\u3002"
    - pageNumber: 47
      speakerName: 
      text: "\u4E00\u4E2A\u5C0F\u65F6\u540E\uFF0C\u7ED3\u679C\u516C\u793A\u3002\u5468\u781A\u7684\u56E2\u961F\u51ED\u501F\u65E0\u53EF\u4E89\u8BAE\u7684\u6280\u672F\u771F\u5B9E\u6027\u548C\u624E\u5B9E\u7684\u843D\u5730\u903B\u8F91\uFF0C\u5168\u7968\u62FF\u4E0B\u4E86\u7B2C\u4E00\u3002"
    - pageNumber: 48
      speakerName: 
      text: "\u884C\u653F\u5927\u697C\u5916\u7684\u9F99\u7FD4\u5927\u9053\uFF0C\u9633\u5149\u4F9D\u65E7\u523A\u773C\u3002\u5468\u781A\u63A8\u5F00\u539A\u91CD\u7684\u73BB\u7483\u95E8\uFF0C\u6DF1\u6DF1\u5730\u5438\u4E86\u4E00\u53E3\u5BA4\u5916\u7684\u7A7A\u6C14\u3002"
    - pageNumber: 49
      speakerName: "\u5468\u781A"
      text: "\u6797\u6E21\u3002"
    - pageNumber: 50
      speakerName: 
      text: "\u6797\u6E21\u505C\u4E0B\u811A\u6B65\uFF0C\u8F6C\u5934\u770B\u5411\u5979\u3002"
    - pageNumber: 51
      speakerName: "\u5468\u781A"
      text: "\u4EE5\u540E\u8FD9\u79CD\u4E8B\uFF0C\u522B\u518D\u81EA\u5DF1\u4E00\u4E2A\u4EBA\u53BB\u505A\u4E86\u3002"
    - pageNumber: 52
      speakerName: "\u6797\u6E21"
      text: "\u600E\u4E48\uFF0C\u5468\u603B\u540E\u6094\u5F53\u6211\u7684\u4FDD\u62A4\u4F1E\u4E86\uFF1F"
    - pageNumber: 53
      speakerName: 
      text: "\u5468\u781A\u6CA1\u6709\u63A5\u8BDD\u3002\u5979\u5F80\u524D\u8D70\u4E86\u4E00\u6B65\uFF0C\u8DDD\u79BB\u8FD1\u5230\u6797\u6E21\u80FD\u95FB\u5230\u5979\u8EAB\u4E0A\u6DE1\u6DE1\u7684\u51B7\u9999\u3002\u5468\u781A\u4F38\u51FA\u624B\uFF0C\u7B2C\u4E00\u6B21\u8D8A\u8FC7\u793E\u4EA4\u8FB9\u754C\uFF0C\u8F7B\u8F7B\u5730\u63E1\u4F4F\u4E86\u6797\u6E21\u7684\u624B\u6307\u3002\u90A3\u53EA\u624B\u56E0\u4E3A\u521A\u624D\u7684\u7D27\u5F20\u64CD\u4F5C\uFF0C\u6307\u5C16\u8FD8\u5728\u5FAE\u5FAE\u53D1\u6296\u3002"
    - pageNumber: 54
      speakerName: "\u5468\u781A"
      text: "\u4E0D\u540E\u6094\u3002\u6211\u53EA\u662F\u5728\u60F3\uFF0C\u5982\u679C\u8FD9\u4E2A\u4E16\u754C\u6CE8\u5B9A\u662F\u9ED1\u8272\u7684\uFF0C\u90A3\u6211\u4E5F\u5E0C\u671B\uFF0C\u80FD\u5728\u8FD9\u6DF1\u6E0A\u91CC\u63E1\u7D27\u4F60\u7684\u624B\u3002"
    - pageNumber: 55
      speakerName: 
      text: "\u9633\u5149\u4E0B\uFF0C\u6797\u6E21\u611F\u5230\u5468\u781A\u7684\u624B\u5FC3\u6E29\u70ED\u5F97\u6709\u4E9B\u70EB\u4EBA\u3002\u5979\u4EEC\u8D62\u4E86\uFF0C\u4E0D\u4EC5\u8D62\u4E86\u8D44\u91D1\uFF0C\u8FD8\u8D62\u5230\u4E86\u4E00\u4EFD\u5728\u79E9\u5E8F\u4E0B\u5F7B\u5E95\u5D29\u574F\u3001\u5374\u53C8\u65E0\u6BD4\u7262\u56FA\u7684\u9ED8\u5951\u3002"
    choices: []
  - documentId: M2-5-2
    title: M2-5-2
    sourceAssetPath: Assets/content1/M2/M2-5-2.docx
    chapterId: M2
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 1
    completeEventId: content1_story_complete_m2_5_2
    npcId: "npc_\u5468\u781A"
    locationId: offcampus_placeholder
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1359.02, y: 16.19, z: 1085.17}
    rewardGold: 65
    finishLocationName: "\u6821\u5916\u5267\u60C5\u89E6\u53D1\u70B9"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u9910\u5385\u9732\u53F0/ \u508D\u665A 18:30"
    - pageNumber: 2
      speakerName: 
      text: "\u665A\u971E\u628A\u5929\u7A7A\u70E7\u6210\u4E86\u4E00\u7247\u6DF1\u7D2B\u8272\u3002\u5468\u781A\u8131\u6389\u4E86\u7B54\u8FA9\u65F6\u7A7F\u7684\u897F\u88C5\u5916\u5957\uFF0C\u53EA\u7A7F\u7740\u767D\u886C\u886B\uFF0C\u9760\u5728\u5929\u53F0\u7684\u680F\u6746\u4E0A\u3002\u90A3\u573A\u98CE\u66B4\u5DF2\u7ECF\u8FC7\u53BB\uFF0C\u4F46\u90A3\u79CD\u6E38\u8D70\u5728\u89C4\u5219\u8FB9\u7F18\u7684\u4F59\u9707\uFF0C\u4F9D\u7136\u5728\u4E24\u4EBA\u7684\u8840\u6DB2\u91CC\u9690\u9690\u4F5C\u795F\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u5468\u781A\u8F6C\u5934\u770B\u7740\u6797\u6E21\u3002\u5728\u8FD9\u4E2A\u6CA1\u6709\u5916\u4EBA\u7684\u5730\u65B9\uFF0C\u5979\u5378\u4E0B\u4E86\u6240\u6709\u7684\u9632\u5907\u548C\u4ECE\u5BB9\u3002"
    - pageNumber: 4
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF0C\u521A\u624D\u5728\u53F0\u4E0A\uFF0C\u770B\u7740\u4ED6\u4EEC\u7684\u7CFB\u7EDF\u5D29\u6E83\u7684\u90A3\u4E00\u523B\u2026\u2026\u6211\u53D1\u73B0\u6211\u5E76\u4E0D\u89C9\u5F97\u6127\u759A\uFF0C\u6211\u751A\u81F3\u89C9\u5F97\u5F88\u75DB\u5FEB\u3002\u201D"
    - pageNumber: 5
      speakerName: 
      text: "\u5979\u62AC\u8D77\u773C\uFF0C\u770B\u5411\u6797\u6E21\u7684\u76EE\u5149\u91CC\uFF0C\u591A\u4E86\u4E00\u79CD\u53EA\u6709\u4E24\u4EBA\u624D\u61C2\u7684\u6DF1\u6C89\u3002"
    - pageNumber: 6
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u4EEC\u4E0D\u518D\u662F\u5E72\u5E72\u51C0\u51C0\u7684\u2018\u597D\u5B66\u751F\u2019\u4E86\u3002\u8FD9\u79CD\u611F\u89C9\uFF0C\u6BD4\u6211\u60F3\u8C61\u7684\u8981\u597D\u3002\u201D"
    - pageNumber: 7
      speakerName: 
      text: "\u5468\u781A\u81EA\u5632\u5730\u7B11\u4E86\u7B11\uFF0C\u6307\u5C16\u65E0\u610F\u8BC6\u5730\u6469\u6332\u7740\u51B0\u51C9\u7684\u91D1\u5C5E\u680F\u6746\uFF0C\u773C\u795E\u91CC\u900F\u7740\u4E00\u79CD\u4ECE\u672A\u6709\u8FC7\u7684\u3001\u8FD1\u4E4E\u91CE\u6027\u7684\u677E\u5F1B\u3002"
    - pageNumber: 8
      speakerName: "\u5468\u781A"
      text: "\u201C\u4EE5\u524D\u6211\u89C9\u5F97\uFF0C\u6240\u6709\u7684\u4E8B\u60C5\u90FD\u8BE5\u5728\u9884\u8BBE\u7684\u8F68\u9053\u4E0A\u8DD1\u3002\u4F46\u521A\u624D\u2026\u2026\u5F53\u4F60\u6572\u4E0B\u90A3\u4E2A\u56DE\u8F66\u952E\uFF0C\u770B\u7740\u6570\u636E\u6D41\u628A\u90A3\u5E2E\u4F2A\u541B\u5B50\u7684\u9632\u5FA1\u5F7B\u5E95\u6495\u788E\u65F6\uFF0C\u6211\u53D1\u73B0\u6211\u4E0D\u4EC5\u662F\u5728\u770B\u4E00\u573A\u597D\u620F\u3002\u201D"
    - pageNumber: 9
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u662F\u5728\u770B\u4F60\u3002\u6797\u6E21\uFF0C\u90A3\u4E00\u523B\u4F60\u7684\u773C\u795E\uFF0C\u8BA9\u6211\u89C9\u5F97\u6211\u4EEC\u5929\u751F\u5C31\u8BE5\u7AD9\u5728\u4E00\u8D77\uFF0C\u53BB\u628A\u90A3\u4E9B\u81EA\u4EE5\u4E3A\u662F\u7684\u89C4\u5219\u8E29\u5728\u811A\u5E95\u4E0B\u3002\u201D"
    - pageNumber: 10
      speakerName: "\u6797\u6E21"
      text: "\u201C\u5468\u8001\u677F\uFF0C\u8FD9\u79CD\u8BDD\u53EF\u4E0D\u50CF\u4E00\u4E2A\u7406\u667A\u7684\u521B\u59CB\u4EBA\u4F1A\u8BF4\u7684\u3002\u201D"
    - pageNumber: 11
      speakerName: "\u5468\u781A"
      text: "\u201C\u7406\u667A\uFF1F\u4F60\u53C8\u600E\u4E48\u754C\u5B9A\u7406\u667A\u4E0E\u5426\uFF1F\u6216\u8BB8\u662F\u4ECA\u5929\u7684\u4F59\u97F5\u5427\uFF0C\u6211\u73B0\u5728\u2026\u2026\u53EA\u60F3\u505A\u70B9\u66F4\u4E0D\u7406\u667A\u7684\u4E8B\u3002\u201D"
    - pageNumber: 12
      speakerName: 
      text: "\u5979\u505C\u5728\u4E86\u4E00\u4E2A\u6781\u8FD1\u7684\u8DDD\u79BB\uFF0C\u90A3\u662F\u5C5E\u4E8E\u666E\u901A\u670B\u53CB\u7EDD\u4E0D\u4F1A\u903E\u8D8A\u7684\u7EA2\u7EBF\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u9910\u6BD5\uFF0C\u5468\u781A\u5174\u81F4\u52C3\u52C3\u5730\u8BF4\u5979\u4E3A\u81EA\u5DF1\u7684\u516C\u53F8\u79DF\u4E86\u4E00\u95F4\u5C0F\u5C0F\u7684\u529E\u516C\u5BA4\uFF0C\u867D\u7136\u91CC\u9762\u8FD8\u7A7A\u65E0\u4E00\u7269\uFF0C\u4F46\u843D\u5730\u7A97\u5916\u5C31\u662F\u6D77\u666F\u548C\u9AD8\u697C\u5927\u53A6\u3002\u76DB\u60C5\u96BE\u5374\uFF0C\u6797\u6E21\u4FBF\u968F\u5979\u524D\u5F80\u3002"
    - pageNumber: 14
      speakerName: "\u5468\u781A"
      text: "\u201C\u6797\u6E21\uFF0C\u4F60\u8BF4\uFF0C\u50CF\u6211\u4EEC\u8FD9\u6837\u7684\u4EBA\uFF0C\u5982\u679C\u771F\u7684\u2018\u7ED1\u5B9A\u2019\u4E86\uFF0C\u662F\u4F1A\u4E00\u8D77\u8D70\u5411\u5DC5\u5CF0\uFF0C\u8FD8\u662F\u4F1A\u4E00\u8D77\u6389\u8FDB\u5730\u72F1\uFF1F\u201D"
    - pageNumber: 15
      speakerName: "\u6797\u6E21"
      text: "\u201C\u90A3\u5F97\u770B\u5468\u603B\u5B9A\u4E49\u7684\u2018\u7ED1\u5B9A\u2019\uFF0C\u6307\u7684\u662F\u80A1\u6743\u7ED3\u6784\uFF0C\u8FD8\u662F\u522B\u7684\u4EC0\u4E48\u3002\u201D"
    - pageNumber: 16
      speakerName: "\u5468\u781A"
      text: "\u201C\u4F60\u660E\u660E\u77E5\u9053\u6211\u5728\u8BF4\u4EC0\u4E48\u3002\u6211\u6709\u80FD\u529B\u770B\u900F\u5927\u90E8\u5206\u4EBA\u7684\u5E95\u724C\uFF0C\u552F\u72EC\u5728\u4F60\u9762\u524D\uFF0C\u6211\u8FDE\u81EA\u5DF1\u8BE5\u51FA\u54EA\u5F20\u724C\u90FD\u4E0D\u77E5\u9053\u3002\u6211\u5728\u6015\u2026\u2026\u6015\u6211\u8868\u73B0\u5F97\u592A\u8D2A\u5FC3\uFF0C\u4F1A\u628A\u4F60\u5413\u8DD1\u2026\u2026\u7B97\u4E86\uFF0C\u5C31\u5F53\u6CA1\u542C\u89C1\u5427\u3002\u201D"
    - pageNumber: 17
      speakerName: 
      text: "\u529E\u516C\u5BA4\u4EC5\u51ED\u7A97\u5916\u5199\u5B57\u697C\u7684\u706F\u5149\u7167\u660E\uFF0C\u5979\u6CA1\u6709\u53BB\u5F00\u706F\uFF0C\u800C\u662F\u501F\u7740\u7A97\u5916\u6D41\u5149\u6EA2\u5F69\u7684\u57CE\u5E02\u9713\u8679\uFF0C\u53D6\u51FA\u4E00\u679A\u523B\u7740\u6797\u6E21\u751F\u65E5\u548C\u516C\u53F8\u6700\u9AD8\u6743\u9650\u5BC6\u7801\u7684\u6212\u6307\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u5468\u781A\u628A\u6212\u6307\u5F3A\u884C\u585E\u8FDB\u4F60\u624B\u91CC\uFF0C\u638C\u5FC3\u7684\u6E29\u5EA6\u70EB\u5F97\u60CA\u4EBA\u3002"
    - pageNumber: 19
      speakerName: "\u5468\u781A"
      text: "\u201C\u6211\u4EE5\u524D\u89C9\u5F97\u627F\u8BFA\u5F88\u865A\uFF0C\u6240\u4EE5\u6211\u53EA\u7ED9\u6743\u9650\u3002\u4F46\u73B0\u5728\u6211\u53D1\u73B0\uFF0C\u5C31\u7B97\u628A\u6574\u4E2A\u516C\u53F8\u90FD\u7ED9\u4F60\uFF0C\u4E5F\u4E0D\u8DB3\u4EE5\u8868\u8FBE\u6211\u60F3\u7559\u4E0B\u4F60\u7684\u6B32\u671B\u3002\u201D"
    - pageNumber: 20
      speakerName: "\u5468\u781A"
      text: "\u201C\u4E0D\u53EA\u662F\u5728\u724C\u684C\u4E0A\uFF0C\u8FD8\u5728\u6211\u7684\u751F\u6D3B\u91CC\u3002\u201D"
    - pageNumber: 21
      speakerName: 
      text: "\u5728\u8FD9\u573A\u8DE8\u8D8A\u5E95\u7EBF\u7684\u535A\u5F08\u540E\uFF0C\u5468\u781A\u5DF2\u7ECF\u628A\u5979\u6700\u9690\u79D8\u7684\u8F6F\u808B\u4EA4\u5230\u4E86\u4F60\u624B\u4E0A\u3002\u9762\u5BF9\u5979\u6B64\u523B\u6BEB\u65E0\u4FDD\u7559\u7684\u771F\u5B9E\uFF0C\u4F60\u51B3\u5B9A\uFF1F"
