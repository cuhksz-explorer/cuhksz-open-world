  - documentId: M5-1-1
    title: M5-1-1
    sourceAssetPath: Assets/content1/M5/M5-1-1.docx
    chapterId: M5
    category: 0
    isRootTask: 1
    isBranchDocument: 0
    needsLocationConfirmation: 0
    completeEventId: content1_story_complete_m5_1_1
    npcId: "npc_\u955C\u50CF\u6797\u6E21"
    locationId: admin_rooftop_placeholder
    targetSceneName: undergarden
    fallbackTargetPosition: {x: -1575.23, y: 23.51, z: 949.07}
    rewardGold: 25
    finishLocationName: "\u9038\u592B\u56FD\u9645\u4F1A\u8BAE\u4E2D\u5FC3\u524D"
    pages:
    - pageNumber: 1
      speakerName: 
      text: "\u6BD5\u4E1A\u5B63\u7684\u5915\u9633\u5C06\u9F99\u7FD4\u5927\u9053\u7684\u7816\u9762\u67D3\u6210\u4E86\u4E00\u79CD\u8FD1\u4E4E\u5E72\u6DB8\u7684\u8840\u8272\u3002\u6797\u6E21\u7AD9\u5728\u56FE\u4E66\u9986\u6700\u9AD8\u5C42\u7684\u9732\u53F0\u4E0A\uFF0C\u542C\u7740\u697C\u4E0B\u4F20\u6765\u7684\u6B22\u547C\u58F0\u548C\u76F8\u673A\u5FEB\u95E8\u7684\u5494\u5693\u58F0\u3002\u90A3\u4E9B\u7A7F\u7740\u9ED1\u91D1\u914D\u8272\u5B66\u4F4D\u670D\u7684\u8EAB\u5F71\u5728\u8349\u576A\u4E0A\u5954\u8DD1\uFF0C\u65B9\u5E3D\u5B50\u88AB\u629B\u5411\u7A7A\u4E2D\uFF0C\u53C8\u5982\u65AD\u7FC5\u7684\u9E1F\u513F\u822C\u5760\u843D\u3002"
    - pageNumber: 2
      speakerName: "\u6797\u6E21"
      text: "\u62FF\u5230\u4E86\u6240\u6709\u4EBA\u60F3\u8981\u7684\u4E1C\u897F\uFF0C\u53EF\u4E3A\u4EC0\u4E48\u6211\u611F\u89C9\u81EA\u5DF1\u50CF\u4E2A\u88AB\u638F\u7A7A\u7684\u6F02\u6D41\u74F6\uFF1F"
    - pageNumber: 3
      speakerName: 
      text: "\u98CE\u5377\u8D77\u5979\u7684\u53D1\u4E1D\uFF0C\u7A7A\u6C14\u4E2D\u5F25\u6F2B\u7740\u96E8\u540E\u6CE5\u571F\u7684\u54B8\u6E7F\u5473\u3002\u81EA\u4ECE\u90A3\u573A\u60E8\u70C8\u7684\u7ADE\u8D5B\u51B3\u8D5B\u7ED3\u675F\u540E\uFF0C\u5979\u603B\u89C9\u5F97\u80CC\u540E\u6709\u4E00\u53CC\u773C\u775B\u5728\u6CE8\u89C6\u7740\u81EA\u5DF1\u3002\u6BCF\u4E00\u4E2A\u770B\u4F3C\u5076\u7136\u7684\u673A\u4F1A\uFF0C\u6BCF\u4E00\u6B21\u6B7B\u91CC\u9003\u751F\u7684\u53CD\u8F6C\uFF0C\u73B0\u5728\u56DE\u60F3\u8D77\u6765\uFF0C\u90FD\u5E26\u7740\u4E00\u79CD\u88AB\u7CBE\u5FC3\u7F16\u6392\u8FC7\u7684\u751F\u786C\u611F\u3002"
    - pageNumber: 4
      speakerName: 
      text: "\u53E3\u888B\u91CC\u7684\u624B\u673A\u53D1\u51FA\u4E86\u6C89\u95F7\u7684\u9707\u52A8\u3002\u90A3\u662F\u5979\u4E13\u95E8\u4E3A\u201C\u90A3\u4E2A\u8D26\u53F7\u201D\u8BBE\u7F6E\u7684\u7279\u6B8A\u9891\u7387\u3002"
    - pageNumber: 5
      speakerName: 
      text: "\u5C4F\u5E55\u4E0A\uFF0C\u90A3\u4E2A\u7A7A\u767D\u7684\u5BF9\u8BDD\u6846\u5728\u66AE\u8272\u4E2D\u663E\u5F97\u683C\u5916\u523A\u773C\u3002"
    - pageNumber: 6
      speakerName: Null
      text: "\u606D\u559C\u3002\u4F60\u7EC8\u4E8E\u767B\u9876\u4E86\u3002\u73B0\u5728\u7684\u4F60\uFF0C\u662F\u8FD9\u6240\u5B66\u6821\u6700\u5F15\u4EE5\u4E3A\u50B2\u7684\u4F5C\u54C1\u3002"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u4F60\u662F\u6765\u5E86\u795D\u7684\uFF0C\u8FD8\u662F\u6765\u6536\u7F51\u7684\uFF1F"
    - pageNumber: 8
      speakerName: Null
      text: "\u6211\u662F\u6765\u7ED9\u4F60\u770B\u8BC1\u636E\u7684\u3002\u4F60\u8FFD\u67E5\u4E86\u56DB\u5E74\u7684\u7B54\u6848\uFF0C\u5C31\u5728\u65E7\u6821\u533A\u884C\u653F\u697C\u7684\u5730\u4E0B\u4E00\u5C42\u3002\u90A3\u662F\u5168\u6821\u6570\u5B57\u5316\u8F6C\u578B\u65F6\u552F\u4E00\u9057\u6F0F\u7684\u89D2\u843D\u3002"
    - pageNumber: 9
      speakerName: Null
      text: "\u53BB\u770B\u770B\u5427\u3002\u53BB\u770B\u770B\u5728\u4F60\u4E4B\u524D\uFF0C\u90A3\u4E9B\u540C\u6837\u62FF\u5230\u6EE1\u5206\u3001\u540C\u6837\u98CE\u5149\u65E0\u9650\u7684\u4EBA\uFF0C\u6700\u540E\u90FD\u53BB\u4E86\u54EA\u91CC\u3002"
    - pageNumber: 10
      speakerName: 
      text: "\u6797\u6E21\u7684\u547C\u5438\u6709\u4E00\u77AC\u7684\u505C\u6EDE\u3002\u5979\u8F6C\u8FC7\u5934\uFF0C\u770B\u5411\u6821\u56ED\u897F\u4FA7\u90A3\u5EA7\u51E0\u4E4E\u88AB\u5E38\u9752\u85E4\u8986\u76D6\u7684\u65E7\u697C\u3002\u90A3\u91CC\u66FE\u662F\u5B66\u6821\u521D\u521B\u65F6\u7684\u6838\u5FC3\uFF0C\u5982\u4ECA\u5374\u50CF\u4E00\u4E2A\u88AB\u65F6\u4EE3\u629B\u5F03\u7684\u5B88\u5893\u4EBA\uFF0C\u5728\u96FE\u6C14\u4E2D\u6C89\u6CA1\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u5979\u6CA1\u6709\u56DE\u5BBF\u820D\u53C2\u52A0\u6BD5\u4E1A\u805A\u9910\uFF0C\u800C\u662F\u987A\u7740\u4E0B\u56ED\u7684\u659C\u5761\uFF0C\u501F\u7740\u5C42\u5C42\u53E0\u53E0\u7684\u53F0\u5730\u9634\u5F71\u5411\u897F\u4FA7\u6F5C\u884C\u3002\u96E8\u540E\u7684\u5761\u9053\u6709\u4E9B\u6E7F\u6ED1\uFF0C\u6BCF\u4E00\u58F0\u811A\u6B65\u7684\u4F59\u97F3\u90FD\u5728\u63D0\u9192\u5979\uFF0C\u5979\u6B63\u5728\u80CC\u79BB\u90A3\u6761\u88AB\u6240\u6709\u4EBA\u795D\u798F\u7684\u5EB7\u5E84\u5927\u9053\u3002"
    - pageNumber: 12
      speakerName: 
      text: "\u5230\u8FBE\u65E7\u884C\u653F\u697C\u65F6\uFF0C\u6821\u56ED\u7684\u706F\u5149\u5DF2\u7ECF\u663E\u5F97\u6709\u4E9B\u9065\u8FDC\u3002\u6797\u6E21\u907F\u5F00\u4E86\u6B63\u9762\u90A3\u6247\u6302\u7740\u94C1\u94FE\u7684\u5927\u95E8\uFF0C\u7ED5\u5411\u540E\u65B9\u6559\u804C\u5458\u5DE5\u901A\u9053\u7684\u4E00\u4E2A\u6B7B\u89D2\u3002\u5979\u62E8\u5F00\u4E1B\u751F\u7684\u6742\u8349\uFF0C\u63A8\u5F00\u90A3\u6247\u56E0\u4E3A\u95E8\u8F74\u8001\u5316\u800C\u65E0\u6CD5\u95ED\u5408\u7684\u4FA7\u95E8\uFF0C\u4FA7\u8EAB\u94BB\u4E86\u8FDB\u53BB\u3002"
    - pageNumber: 13
      speakerName: 
      text: "\u9ED1\u6697\u77AC\u95F4\u541E\u6CA1\u4E86\u4E00\u5207\u3002\u65E7\u697C\u5185\u90E8\u5F25\u6F2B\u7740\u4E00\u80A1\u9648\u8150\u7684\u7EB8\u5F20\u5473\uFF0C\u6DF7\u5408\u7740\u67D0\u79CD\u8001\u5F0F\u673A\u623F\u6563\u53D1\u51FA\u7684\u81ED\u6C27\u5473\u3002\u6797\u6E21\u6CA1\u6709\u5F00\u542F\u624B\u7535\u7B52\uFF0C\u800C\u662F\u501F\u7740\u7A97\u5916\u5212\u8FC7\u7684\u95EA\u7535\u5149\u4EAE\uFF0C\u907F\u5F00\u5730\u4E0A\u7684\u5E9F\u5F03\u684C\u6905\u3002"
    - pageNumber: 14
      speakerName: "\u6797\u6E21"
      text: "Null\uFF0C\u6211\u5DF2\u7ECF\u8FDB\u6765\u4E86\u3002\u8FD9\u91CC\u7684\u7ED3\u6784\u6BD4\u6211\u60F3\u8C61\u4E2D\u8981\u590D\u6742\u3002"
    - pageNumber: 15
      speakerName: Null
      text: "\u5411\u4E0B\u8D70\u3002\u53BB\u90A3\u4E2A\u6CA1\u6709\u6807\u8BB0\u7684\u94C1\u95E8\u524D\u3002\u8BB0\u4F4F\uFF0C\u5F53\u4F60\u770B\u5230\u771F\u76F8\u65F6\uFF0C\u4E0D\u8981\u8BD5\u56FE\u5C16\u53EB\uFF0C\u7CFB\u7EDF\u4F1A\u8BC6\u522B\u9AD8\u9891\u6CE2\u6BB5\u7684\u566A\u97F3\u3002"
    - pageNumber: 16
      speakerName: 
      text: "\u6797\u6E21\u611F\u5230\u638C\u5FC3\u6EE1\u662F\u51B7\u6C57\u3002\u8FD9\u79CD\u751F\u7406\u4E0A\u7684\u6218\u6817\u8BA9\u5979\u611F\u5230\u4E00\u79CD\u4E45\u8FDD\u7684\u771F\u5B9E\u3002\u6BD4\u8D77\u5916\u9762\u90A3\u4E2A\u793C\u8C8C\u3001\u9AD8\u6548\u3001\u5374\u865A\u4F2A\u5F97\u4EE4\u4EBA\u7A92\u606F\u7684\u6BD5\u4E1A\u5B63\uFF0C\u8FD9\u91CC\u7684\u9634\u51B7\u548C\u538B\u6291\u53CD\u5012\u8BA9\u5979\u89C9\u5F97\u81EA\u5DF1\u8FD8\u6D3B\u7740\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u5979\u8E29\u7740\u79EF\u6C34\u7684\u5730\u9762\uFF0C\u6765\u5230\u4E86\u8D70\u5ECA\u5C3D\u5934\u3002\u90A3\u6247\u751F\u94C1\u95E8\u5728\u624B\u7535\u7B52\u5FAE\u5F31\u7684\u5149\u675F\u4E0B\u6CDB\u7740\u9752\u5149\uFF0C\u95E8\u7F1D\u91CC\u585E\u7740\u53D1\u9ED1\u7684\u5BC6\u5C01\u6761\u3002"
    - pageNumber: 18
      speakerName: 
      text: "\u5979\u4ECE\u5305\u91CC\u53D6\u51FA\u90A3\u5F20\u5979\u5192\u7740\u5DE8\u5927\u98CE\u9669\uFF0C\u4ECE\u5BFC\u5E08\u529E\u516C\u5BA4\u610F\u5916\u83B7\u53D6\u7684\u78C1\u5361\u3002\u5979\u5C4F\u4F4F\u547C\u5438\uFF0C\u6307\u5C16\u98A4\u6296\u7740\u5C06\u5361\u7247\u5212\u8FC7\u611F\u5E94\u533A\u3002"
    - pageNumber: 19
      speakerName: 
      text: "\u201C\u54D2\u201D\u3002"
    - pageNumber: 20
      speakerName: 
      text: "\u95E8\u9501\u54AC\u5408\u4EF6\u8F6C\u52A8\u7684\u58F0\u97F3\u5728\u7A7A\u65F7\u7684\u5730\u4E0B\u5BA4\u91CC\u6FC0\u8D77\u4E86\u91CD\u91CD\u56DE\u54CD\u3002\u6797\u6E21\u7528\u529B\u63A8\u5F00\u95E8\uFF0C\u9709\u5473\u6251\u9762\u800C\u6765\uFF0C\u5979\u5267\u70C8\u5730\u54B3\u55FD\u4E86\u51E0\u58F0\uFF0C\u968F\u5373\u88AB\u773C\u524D\u7684\u666F\u8C61\u5B9A\u5728\u4E86\u539F\u5730\u3002"
    - pageNumber: 21
      speakerName: 
      text: "\u623F\u95F4\u91CC\u5E76\u4E0D\u662F\u60F3\u8C61\u4E2D\u7684\u6742\u4E71\uFF0C\u53CD\u800C\u6574\u9F50\u5F97\u4EE4\u4EBA\u6BDB\u9AA8\u609A\u7136\u3002\u6570\u5341\u4E2A\u94C1\u76AE\u67DC\u5982\u5893\u7891\u822C\u4F2B\u7ACB\uFF0C\u67DC\u95E8\u4E0A\u8D34\u7740\u53D1\u9EC4\u7684\u5E74\u4EFD\u6807\u7B7E\u3002"
    - pageNumber: 22
      speakerName: "\u6797\u6E21"
      text: "\u8FD9\u5C31\u662F\u2026\u2026\u201C\u6D88\u5931\u8005\u201D\u7684\u5F52\u5BBF\uFF1F"
    - pageNumber: 23
      speakerName: 
      text: "\u5979\u98A4\u6296\u7740\u62C9\u5F00\u6807\u6709\u201C\u5F02\u5E38\u8F68\u8FF9\u8BB0\u5F55\u201D\u7684\u62BD\u5C49\uFF0C\u53D6\u51FA\u4E86\u4E00\u4EFD\u539A\u91CD\u7684\u725B\u76AE\u7EB8\u888B\u3002\u68C9\u7EBF\u5DF2\u7ECF\u53D1\u8106\uFF0C\u5728\u5979\u6307\u5C16\u65AD\u88C2\u3002"
    - pageNumber: 24
      speakerName: "\u6797\u6E21"
      text: "\u9648\u5B50\u6DB5\uFF0C2015 \u5C4A\uFF0C\u6EE1\u5206\u7EE9\u70B9\u3002\u5904\u7406\u610F\u89C1\uFF1A\u89C9\u9192\u7A0B\u5EA6\u8FC7\u9AD8\uFF0C\u65E0\u6CD5\u88AB\u793E\u4F1A\u7CFB\u7EDF\u91CD\u6784\uFF0C\u6267\u884C\u201C\u9759\u9ED8\u5316\u201D\u5904\u7406\u3002"
    - pageNumber: 25
      speakerName: "\u6797\u6E21"
      text: "\u674E\u8587\uFF0C2018 \u5C4A\uFF0C\u7ECF\u7BA1\u5B66\u9662\u3002\u5904\u7406\u610F\u89C1\uFF1A\u8BD5\u56FE\u5EFA\u7ACB\u53BB\u4E2D\u5FC3\u5316\u8BC4\u4EF7\u4F53\u7CFB\uFF0C\u5A01\u80C1\u7A33\u6001\uFF0C\u5F15\u5BFC\u5176\u201C\u56E0\u75C5\u4F11\u5B66\u201D\u3002"
    - pageNumber: 26
      speakerName: 
      text: "\u6797\u6E21\u7FFB\u52A8\u7740\u90A3\u4E9B\u540D\u518C\uFF0C\u90A3\u4E9B\u66FE\u5728\u6821\u56ED\u4F20\u8BF4\u91CC\u95EA\u70C1\u8FC7\u3001\u5374\u53C8\u7A81\u7136\u6D88\u5931\u7684\u5929\u624D\u3002\u5979\u60F3\u8D77\u4E86\u5468\u781A\u66FE\u7ECF\u4E91\u6DE1\u98CE\u8F7B\u5730\u8BF4\uFF0C\u90A3\u4E9B\u4EBA\u53EA\u662F\u201C\u9009\u62E9\u4E86\u53E6\u4E00\u6761\u8DEF\u201D\u3002\u539F\u6765\uFF0C\u90A3\u6761\u8DEF\u4E00\u76F4\u901A\u5411\u8FD9\u95F4\u6697\u65E0\u5929\u65E5\u7684\u5BC6\u5BA4\u3002"
    - pageNumber: 27
      speakerName: "\u6797\u6E21"
      text: "\u62DF\u89C2\u5BDF\u540D\u5355\u2026\u2026\u6797\u6E21\u3002"
    - pageNumber: 28
      speakerName: 
      text: "\u6797\u6E21\u611F\u5230\u5589\u5499\u50CF\u662F\u88AB\u585E\u8FDB\u4E86\u4E00\u5757\u51B0\u3002\u90A3\u884C\u51B7\u51B0\u51B0\u7684\u5B57\u8FF9\u5199\u7740\uFF1A\u201C\u8BE5\u5BF9\u8C61\u5DF2\u901A\u8FC7\u6240\u6709\u538B\u529B\u6D4B\u8BD5\uFF0C\u8868\u73B0\u51FA\u6781\u9AD8\u7684\u903B\u8F91\u9002\u5E94\u6027\u3002\u4F46\u5176\u6838\u5FC3\u610F\u8BC6\u4ECD\u5BF9\u7CFB\u7EDF\u4FDD\u6301\u654C\u610F\u3002\u73B0\u5F15\u5BFC\u5176\u8FDB\u5165\u6700\u540E\u7684\u9A8C\u8BC1\u73AF\u8282\uFF0C\u8BC4\u4F30\u5176\u662F\u5426\u5177\u5907\u88AB\u2018\u56DE\u6536\u2019\u6216\u2018\u62B9\u9664\u2019\u7684\u4EF7\u503C\u3002\u201D"
    - pageNumber: 29
      speakerName: 
      text: "\u201C\u5F15\u5BFC\u5176\u8FDB\u5165\u201D\u3002"
    - pageNumber: 30
      speakerName: 
      text: "\u8FD9\u4E94\u4E2A\u5B57\u50CF\u662F\u4E00\u8BB0\u91CD\u9524\uFF0C\u7838\u788E\u4E86\u6797\u6E21\u5FC3\u4E2D\u6700\u540E\u7684\u4E00\u4E1D\u4FA5\u5E78\u3002"
    - pageNumber: 31
      speakerName: "\u6797\u6E21"
      text: "\u539F\u6765\uFF0C\u6211\u4EE5\u4E3A\u7684\u81EA\u4E3B\u8C03\u67E5\uFF0C\u6211\u4EE5\u4E3A\u7684\u6F5C\u5165\u53CD\u6297\u2026\u2026\u5168\u90FD\u662F\u4F60\u4EEC\u5199\u597D\u7684\u5267\u672C\uFF1F"
    - pageNumber: 32
      speakerName: 
      text: "\u5C31\u5728\u8FD9\u65F6\uFF0C\u8D44\u6599\u5BA4\u91CC\u7684\u65E5\u5149\u706F\u7BA1\u7A81\u7136\u53D1\u51FA\u4E86\u5267\u70C8\u7684\u6ECB\u6ECB\u58F0\uFF0C\u60E8\u767D\u7684\u5149\u77AC\u95F4\u586B\u6EE1\u4E86\u623F\u95F4\u3002"
    - pageNumber: 33
      speakerName: 
      text: "\u8D44\u6599\u5BA4\u5899\u4E0A\u7684\u90A3\u9762\u6574\u8EAB\u955C\u91CC\uFF0C\u6620\u5C04\u51FA\u4E86\u6797\u6E21\u7684\u8EAB\u5F71\u3002\u4F46\u90A3\u4E2A\u8EAB\u5F71\u5E76\u6CA1\u6709\u968F\u7740\u5979\u7684\u540E\u9000\u800C\u79FB\u52A8\uFF0C\u800C\u662F\u4FDD\u6301\u7740\u7FFB\u9605\u6863\u6848\u7684\u59FF\u52BF\uFF0C\u7F13\u7F13\u62AC\u8D77\u5934\u3002"
    - pageNumber: 34
      speakerName: 
      text: "\u5F71\u5B50\u9732\u51FA\u4E00\u5F20\u548C\u6797\u6E21\u4E00\u6A21\u4E00\u6837\u3001\u5374\u6CA1\u6709\u4EFB\u4F55\u8868\u60C5\u7684\u8138\u3002"
    - pageNumber: 35
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u4F60\u6BD4\u9884\u8BA1\u7684\u65F6\u95F4\u5FEB\u4E86\u4E09\u5206\u949F\u3002\u770B\u6765\uFF0C\u4F60\u7684\u6C42\u77E5\u6B32\u8D85\u8FC7\u4E86\u4F60\u7684\u6050\u60E7\u611F\u3002"
    - pageNumber: 36
      speakerName: "\u6797\u6E21"
      text: "\u2026\u2026\u4F60\u5C31\u662F Null\uFF1F\u8FD8\u662F\u8FD9\u4E2A\u7CFB\u7EDF\u7684\u610F\u5FD7\uFF1F"
    - pageNumber: 37
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u6211\u5C31\u662F\u4F60\u3002\u90A3\u4E2A\u5728\u65E0\u6570\u6B21\u8003\u8BD5\u4E2D\u60F3\u8FC7\u6495\u6BC1\u8BD5\u5377\u7684\u4F60\uFF0C\u90A3\u4E2A\u5728\u65E0\u6570\u6B21\u793E\u4EA4\u4E2D\u60F3\u8FC7\u63ED\u7A7F\u8C0E\u8A00\u7684\u4F60\u3002\u73B0\u5728\uFF0C\u4F60\u770B\u5230\u7EC8\u70B9\u4E86\u5417\uFF1F"
    - pageNumber: 38
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u6797\u6E21\uFF0C\u6210\u529F\u662F\u8BBE\u8BA1\u7684\uFF0C\u6EE1\u5206\u4E5F\u662F\u8BBE\u8BA1\u7684\u3002\u5728\u8FD9\u4E2A\u6821\u56ED\u91CC\uFF0C\u4F60\u662F\u4E00\u4E2A\u6570\u636E\u5305\uFF0C\u800C\u6211\uFF0C\u662F\u4F60\u7684\u6821\u9A8C\u503C\u3002"
    - pageNumber: 39
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u73B0\u5728\uFF0C\u4F60\u62FF\u5230\u4E86\u8FD9\u4EFD\u540D\u5355\u3002\u4F60\u662F\u6253\u7B97\u8D70\u51FA\u8FD9\u6247\u95E8\uFF0C\u7EE7\u7EED\u53BB\u90A3\u5BB6\u516C\u53F8\u62A5\u5230\uFF0C\u6210\u4E3A\u6211\u4EEC\u7684\u4E00\u90E8\u5206\uFF1F\u8FD8\u662F\u6253\u7B97\u2026\u2026\u5F7B\u5E95\u6D88\u5931\uFF1F"
    - pageNumber: 40
      speakerName: 
      text: "\u6797\u6E21\u611F\u5230\u4E00\u9635\u5F3A\u70C8\u7684\u7729\u6655\uFF0C\u5979\u9760\u5728\u51B0\u51B7\u7684\u94C1\u67DC\u4E0A\uFF0C\u540D\u518C\u4ECE\u6307\u5C16\u6ED1\u843D\uFF0C\u50CF\u662F\u4E00\u5730\u7834\u788E\u7684\u68A6\u5883\u3002"
    - pageNumber: 41
      speakerName: "\u6797\u6E21"
      text: "\u5982\u679C\u6211\u7684\u6240\u6709\u75DB\u82E6\u548C\u6323\u624E\u90FD\u662F\u88AB\u7B97\u8BA1\u597D\u7684\uFF0C\u90A3\u6211\u7684\u610F\u5FD7\u5230\u5E95\u7B97\u4EC0\u4E48\uFF1F"
    - pageNumber: 42
      speakerName: "\u955C\u50CF\u6797\u6E21"
      text: "\u8FD9\u6B63\u662F\u4F60\u63A5\u4E0B\u6765\u8981\u5B66\u4E60\u7684\u5185\u5BB9\u3002\u4F46\u5728\u90A3\u4E4B\u524D\uFF0C\u4F60\u5F97\u5148\u5B66\u4F1A\u5982\u4F55\u5728\u77E5\u9053\u81EA\u5DF1\u662F\u201C\u56DA\u5F92\u201D\u7684\u60C5\u51B5\u4E0B\uFF0C\u8FD8\u80FD\u8D70\u51FA\u8FD9\u680B\u5927\u697C\u3002"
    - pageNumber: 43
      speakerName: 
      text: "\u8D70\u5ECA\u5916\u4F20\u6765\u4E86\u6574\u9F50\u5212\u4E00\u7684\u673A\u68B0\u811A\u6B65\u58F0\uFF0C\u90A3\u662F\u5DE1\u903B\u7CFB\u7EDF\u88AB\u6FC0\u6D3B\u7684\u4FE1\u53F7\u3002\u6797\u6E21\u610F\u8BC6\u5230\uFF0C\u5982\u679C\u5979\u7EE7\u7EED\u5F85\u5728\u539F\u5730\uFF0C\u5979\u4E5F\u4F1A\u53D8\u6210\u6863\u6848\u888B\u91CC\u7684\u4E00\u5F20\u5E9F\u7EB8\u3002"
    - pageNumber: 44
      speakerName: 
      text: "\u5979\u731B\u5730\u6293\u8D77\u90A3\u4EFD\u540D\u5355\uFF0C\u773C\u795E\u91CC\u900F\u51FA\u4E00\u79CD\u8FD1\u4E4E\u75AF\u72C2\u7684\u6E05\u9192\u3002"
    - pageNumber: 45
      speakerName: "\u6797\u6E21"
      text: "\u65E2\u7136\u4F60\u4EEC\u559C\u6B22\u8BA1\u7B97\u6982\u7387\u2026\u2026\u90A3\u6211\u5C31\u7ED9\u4F60\u4EEC\u4E00\u4E2A\u65E0\u6CD5\u88AB\u5B9A\u4E49\u7684\u7ED3\u5C40\u3002"
    - pageNumber: 46
      speakerName: 
      text: "\u5979\u51B2\u51FA\u8D44\u6599\u5BA4\uFF0C\u6D88\u5931\u5728\u5E7D\u6697\u7684\u8D70\u5ECA\u5C3D\u5934\u3002\u5728\u5979\u8EAB\u540E\uFF0C\u955C\u50CF\u6797\u6E21\u4F9D\u7136\u7AD9\u5728\u955C\u5B50\u91CC\uFF0C\u53D1\u51FA\u4E00\u58F0\u82E5\u6709\u82E5\u65E0\u7684\u8F7B\u53F9\uFF0C\u4EFF\u4F5B\u5728\u6CE8\u89C6\u7740\u53C8\u4E00\u4E2A\u5373\u5C06\u788E\u88C2\u7684\u96F6\u4EF6\u3002"
    choices: []
  - documentId: M5-2-1
