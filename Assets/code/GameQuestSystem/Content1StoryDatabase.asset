    pages:
    - pageNumber: 1
      speakerName: "\u6797\u6E21"
      text: "\u8BA9\u987E\u6F84\u5229\u4ED6\u7684\u51B3\u5FC3\u5C55\u73B0\u5728\u6587\u4E66\u4E0A\uFF0C\u662F\u76EE\u524D\u9879\u76EE\u5BA1\u6279\u901A\u8FC7\u7684\u5173\u952E\u3002\u6211\u8FD9\u4E48\u505A\uFF0C\u4E00\u90E8\u5206\u4E5F\u662F\u4E3A\u4E86\u5373\u5C06\u83B7\u76CA\u7684\u5B69\u5B50\u4EEC\u5427\u3002"
    - pageNumber: 2
