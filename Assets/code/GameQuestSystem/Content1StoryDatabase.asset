    - pageNumber: 1
      speakerName: 
      text: "\u56FE\u4E66\u9986\u4E94\u697C\xB7\u7814\u8BA8\u533A / \u665A\u4E0A
        21:00"
    - pageNumber: 2
      speakerName: 
      text: "\u6C88\u9752\u79BE\u5360\u636E\u4E86\u9760\u7A97\u7684\u957F\u684C\uFF0C\u9762\u524D\u5806\u7740\u51E0\u672C\u7B97\u6CD5\u4E66\u548C\u4ED6\u7684\u7B14\u8BB0\u672C\u3002\u6797\u6E21\u5750\u5728\u4ED6\u5BF9\u9762\uFF0C\u6B63\u5728\u8349\u7A3F\u7EB8\u4E0A\u753B\u7740\u6570\u636E\u6D41\u5411\u56FE\u3002"
    - pageNumber: 3
      speakerName: 
      text: "\u4E3A\u4E86\u51C6\u5907\u534A\u4E2A\u6708\u540E\u7684\u6570\u5B66\u5EFA\u6A21\u5927\u8D5B\uFF0C\u6C88\u9752\u79BE\u63A5\u53D7\u4E86\u6797\u6E21\u7684\u7EC4\u961F\u3002\u8FD9\u4E24\u4E2A\u6781\u5EA6\u770B\u91CD\u6548\u7387\u7684\u4EBA\uFF0C\u51D1\u5728\u4E00\u8D77\u51FA\u5947\u5730\u5408\u62CD\u3002"
    - pageNumber: 4
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u5B98\u65B9\u7ED9\u7684\u539F\u59CB\u6570\u636E\u91CC\uFF0C\u5F02\u5E38\u6781\u503C\u592A\u591A\u3002\u5982\u679C\u7528\u5E38\u89C4\u7B97\u6CD5\u5F3A\u884C\u5E73\u6ED1\uFF0C\u4F1A\u5403\u6389\u8FD9\u7EC4\u6570\u636E\u7684\u7279\u5F81\u3002\u201D"
    - pageNumber: 5
      speakerName: "\u6797\u6E21"
      text: "\u201C\u65E2\u7136\u5F02\u5E38\u70B9\u672C\u8EAB\u4E5F\u5E26\u4FE1\u606F\u91CF\uFF0C\u90A3\u5C31\u4E0D\u8981\u5E73\u6ED1\u3002\u628A\u6570\u636E\u964D\u7EF4\uFF0C\u6295\u5F71\u5230\u6B63\u4EA4\u7A7A\u95F4\u91CC\uFF0C\u628A\u504F\u79FB\u8FC7\u5927\u7684\u5411\u91CF\u76F4\u63A5\u9694\u79BB\u51FA\u6765\u505A\u5907\u7528\u5BF9\u7167\u3002\u201D"
    - pageNumber: 6
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u4E0D\u7528\u6DF1\u5EA6\u5B66\u4E60\u53BB\u7B97\u6743\u91CD\uFF0C\u76F4\u63A5\u7528\u57FA\u7840\u7684\u51E0\u4F55\u964D\u7EF4\u907F\u5F00\u7B97\u529B\u74F6\u9888\uFF1F\u201D"
    - pageNumber: 7
      speakerName: "\u6797\u6E21"
      text: "\u201C\u6700\u7B80\u5355\u7684\u5F80\u5F80\u6700\u7A33\u5065\u3002\u201D"
    - pageNumber: 8
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6309\u4F60\u8BF4\u7684\u8BD5\u3002\u201D"
    - pageNumber: 9
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6797\u6E21\uFF0C\u5173\u4E8E\u4F60\u521A\u624D\u8BF4\u7684\u90A3\u4E2A\u2018\u6253\u7834\u7A33\u5B9A\u7684\u610F\u5916\u2019\u2026\u2026\u6211\u4F1A\u8BA4\u771F\u8003\u8651\u7684\u3002\u201D"
    - pageNumber: 10
      speakerName: 
      text: "\u5927\u95E8\u5173\u4E0A\uFF0C\u811A\u6B65\u58F0\u5411\u8D70\u5ECA\u6DF1\u5904\u8FDC\u53BB\u3002"
    - pageNumber: 11
      speakerName: 
      text: "\u5C31\u5728\u4E24\u4EBA\u8FDB\u5EA6\u6781\u5FEB\u65F6\uFF0C\u4E00\u4E2A\u80CC\u7740\u53CC\u80A9\u5305\u7684\u7537\u751F\uFF08\u6C88\u9752\u79BE\u8BFE\u9898\u7EC4\u7684\u7814\u4E8C\u5E08\u5144\uFF09\u8D70\u4E86\u8FC7\u6765\uFF0C\u62C9\u5F00\u6905\u5B50\u5750\u5728\u4E86\u6C88\u9752\u79BE\u65C1\u8FB9\u3002"
    - pageNumber: 12
      speakerName: "\u7814\u4E8C\u5E08\u5144"
      text: "\u201C\u9752\u79BE\uFF0C\u53EF\u7B97\u627E\u7740\u4F60\u4E86\u3002\u6211\u660E\u5929\u8981\u6295\u4E00\u7BC7\u6838\u5FC3\u8BBA\u6587\uFF0C\u6709\u4E00\u7EC4\u5B9E\u9A8C\u6570\u636E\u600E\u4E48\u90FD\u8DD1\u4E0D\u51FA\u6211\u60F3\u8981\u7684\u7ED3\u679C\u3002\u4F60\u4EE3\u7801\u5199\u5F97\u5FEB\uFF0C\u5E2E\u6211\u5199\u4E2A\u811A\u672C\u8FC7\u6EE4\u4E00\u4E0B\u5427\uFF0C\u987A\u4FBF\u5E2E\u6211\u628A\u56FE\u51FA\u4E86\u3002\u4ECA\u665A\u5C31\u8981\u3002\u201D"
    - pageNumber: 13
      speakerName: 
      text: "\u8FD9\u79CD\u8981\u6C42\u5728\u5B9E\u9A8C\u5BA4\u91CC\u5C61\u89C1\u4E0D\u9C9C\u2014\u2014\u6253\u7740\u201C\u540C\u95E8\u4E92\u52A9\u201D\u7684\u65D7\u53F7\uFF0C\u7406\u6240\u5F53\u7136\u5730\u5360\u7528\u522B\u4EBA\u7684\u65F6\u95F4\u548C\u52B3\u52A8\u6210\u679C\u3002"
    - pageNumber: 14
      speakerName: "\u6C88\u9752\u79BE"
      text: "\u201C\u6211\u6B63\u5728\u6253\u5EFA\u6A21\u6BD4\u8D5B\uFF0C\u8FDB\u5EA6\u6392\u6EE1\u4E86\u3002\u800C\u4E14\u6211\u4E0D\u4E86\u89E3\u4F60\u751F\u5316\u5B9E\u9A8C\u7684\u5E95\u5C42\u903B\u8F91\uFF0C\u6CA1\u6CD5\u4E71\u5199\u3002\u201D"
    - pageNumber: 15
      speakerName: "\u7814\u4E8C\u5E08\u5144"
      text: "\u201C\u6BD4\u8D5B\u4EC0\u4E48\u65F6\u5019\u6253\u4E0D\u884C\uFF1F\u6211\u8FD9\u7BC7\u8BBA\u6587\u53EF\u662F\u5BFC\u5E08\u76EF\u7D27\u7684\u91CD\u70B9\u8003\u6838\u6307\u6807\u3002\u4F60\u7A0D\u5FAE\u5957\u4E2A\u73B0\u6210\u7684\u6A21\u677F\u5E2E\u6211\u8DD1\u4E00\u4E0B\uFF0C\u803D\u8BEF\u4E0D\u4E86\u4F60\u534A\u5C0F\u65F6\u3002\u4F60\u8981\u662F\u8FD9\u70B9\u5FD9\u90FD\u4E0D\u5E2E\uFF0C\u5BFC\u5E08\u8981\u662F\u77E5\u9053\u4F60\u7F3A\u4E4F\u2018\u56E2\u961F\u5927\u5C40\u89C2\u2019\uFF0C\u4EE5\u540E\u600E\u4E48\u5E26\u4F60\uFF1F\u201D"
    - pageNumber: 16
      speakerName: 
      text: "\u6C88\u9752\u79BE\u63E1\u7740\u9F20\u6807\u7684\u624B\u7D27\u4E86\u7D27\u3002\u4ED6\u6700\u538C\u6076\u8FD9\u79CD\u7528\u201C\u4EBA\u9645\u5173\u7CFB\u201D\u6765\u7834\u574F\u4ED6\u5DE5\u4F5C\u6D41\u7684\u884C\u4E3A\uFF0C\u8FD9\u79CD\u6BEB\u65E0\u903B\u8F91\u7684\u9053\u5FB7\u7ED1\u67B6\u8BA9\u4ED6\u611F\u5230\u751F\u7406\u6027\u7684\u70E6\u8E81\uFF0C\u4F46\u4ED6\u53C8\u4E0D\u5C51\u4E8E\u5728\u8FD9\u79CD\u4E8B\u60C5\u4E0A\u6D6A\u8D39\u53E3\u820C\u4E89\u8BBA\u3002"
    - pageNumber: 17
      speakerName: 
      text: "\u9762\u5BF9\u8FD9\u79CD\u201C\u9053\u5FB7\u65BD\u538B\u201D\uFF0C\u6797\u6E21\u51B3\u5B9A\u5982\u4F55\u7528\u81EA\u5DF1\u7684\u65B9\u5F0F\u5E2E\u6C88\u9752\u79BE\u6390\u65AD\u8FD9\u6BB5\u566A\u97F3\uFF1F"
    choices:
    - label: "\u501F\u529B\u6253\u529B"
      targetDocumentId: M2-2-2-A
    - label: "\u7269\u7406\u963B\u65AD"
      targetDocumentId: "M2-2-2a\u6C88"
