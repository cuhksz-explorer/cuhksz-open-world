# Copy to .env.lguhub.local (gitignored) for run_server.cmd

# 与 LGUHUB 云端 .env 中 GAME_SSO_SECRET 保持一致（游戏登录必须能访问主站）
GAME_SSO_SECRET=

# LGUHUB 主站公网地址（游戏登录/注册均依赖此地址）
LGUHUB_BASE_URL=https://lguhub.cn

# 若本机 curl/Python 访问 lguhub.cn 出现 TLS 被重置（游戏登录 503），请改用一键隧道启动：
#   双击 run_server_with_tunnel.cmd 或 一键启动_隧道与GameServer.cmd
# 脚本会把 LGUHUB_BASE_URL 设为 http://127.0.0.1:5001（经 ssh lguhub 转发），无需改本文件。

# 可选：仅允许这些 IP 调用 /api/sso/*（逗号分隔，LGUHUB 云服务器公网 IP）
# GAME_SSO_ALLOWED_IPS=1.2.3.4

# 可选：SSO 一次性票据有效期（秒）
# SSO_TICKET_TTL_SEC=300
