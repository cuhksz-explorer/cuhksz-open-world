      shortDescription: "\u6309V\u5207\u6362\u7B2C\u4E00/\u7B2C\u4E09\u4EBA\u79F0\uFF0C\u5E76\u6253\u5F00\u5DE6\u4E0A\u89D2\u8BBE\u7F6E\u9762\u677F\u3002"
      longDescription: "\u8BF7\u6309 V\u5207\u6362\u89C6\u89D2\uFF0C\u7136\u540E\u6253\u5F00\u5DE6\u4E0A\u89D2\u8BBE\u7F6E\uFF08\u753B\u8D28/\u65F6\u95F4\uFF09\u9762\u677F\u3002"
