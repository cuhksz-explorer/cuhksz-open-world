  questChains:
  - questId: dorm_placement_tutorial
    questName: "\u5BDD\u5BA4\u4E0E\u5E03\u7F6E\u5165\u95E8"
    category: 0
    shortDescription: "\u5B66\u4E60\u6253\u5F00\u5BDD\u5BA4\u5546\u57CE\u3001\u8D2D\u4E70\u5546\u54C1\u3001\u4ECE\u80CC\u5305\u8FDB\u5165\u653E\u7F6E\u5E76\u5B8C\u6210\u4E00\u6B21\u6446\u653E\u3002"
    longDescription: "\u672C\u4EFB\u52A1\u4EC5\u5728 dorm \u5BDD\u5BA4\u573A\u666F\u63A8\u8FDB\u3002\n1\uFF09\u8D70\u5230\u5BDD\u5BA4\u5F15\u5BFC\u70B9\u9644\u8FD1\uFF1B\n2\uFF09\u6309
      T \u6253\u5F00\u5BDD\u5BA4\u5546\u57CE\uFF1B\n3\uFF09\u8D2D\u4E70\u4EFB\u610F\u5546\u54C1\uFF1B\n4\uFF09\u6309
      B \u6253\u5F00\u80CC\u5305\u786E\u8BA4\u7269\u54C1\uFF1B\n5\uFF09\u70B9\u51FB\u7269\u54C1\u8FDB\u5165\u653E\u7F6E\u6A21\u5F0F\uFF1B\n6\uFF09\u5BF9\u51C6\u8868\u9762\u540E\u6309\u9F20\u6807\u53F3\u952E\u5B8C\u6210\u653E\u7F6E\u3002"
    finalRewardGold: 120
    subTasks:
    - subTaskId: dorm_01
      subTaskName: "\u5230\u8FBE\u5BDD\u5BA4\u5F15\u5BFC\u70B9"
      shortDescription: "\u8D70\u5230\u6807\u8BB0\u70B9\u9644\u8FD1\uFF08\u7EA6 5
        \u7C73\u5185\uFF09\u3002\u5230\u8FBE\u540E\u8BF7\u6309 T \u6253\u5F00\u5BDD\u5BA4\u5546\u57CE\u3002"
      longDescription: "\u8FDB\u5165 dorm \u573A\u666F\u540E\uFF0C\u8D70\u5230\u60A8\u7684\u5BDD\u5BA4\u51FA\u751F\u70B9\u9644\u8FD1\u5373\u53EF\u5B8C\u6210\u4EFB\u52A1\u3002"
      triggerType: 0
      triggerEventId: 
      targetSceneName: dorm
      targetTransform: {fileID: 0}
      fallbackTargetPosition: {x: -606.65, y: 5.5, z: -218.45}
      autoCompleteDistance: 5
      targetCount: 1
      rewardGold: 15
      finishLocationName: "\u5BDD\u5BA4\u5F15\u5BFC\u70B9"
    - subTaskId: dorm_02
      subTaskName: "\u6253\u5F00\u5BDD\u5BA4\u5546\u57CE"
      shortDescription: "\u6309 T \u952E\u6253\u5F00\u5BDD\u5BA4\u5546\u57CE\u754C\u9762\u3002"
      longDescription: "\u5BDD\u5BA4\u5546\u57CE\uFF08DormMall\uFF09\u7528\u4E8E\u8D2D\u4E70\u53EF\u653E\u5165\u80CC\u5305\u4E0E\u5E03\u7F6E\u7684\u7269\u54C1\u3002"
