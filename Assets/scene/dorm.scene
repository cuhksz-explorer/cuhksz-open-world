      shortDescription: "\u6309 B \u6253\u5F00\u80CC\u5305\uFF0C\u5217\u8868\u4E2D\u5E94\u51FA\u73B0\u521A\u8D2D\u4E70\u7684\u7269\u54C1\u3002"
      longDescription: "\u7CFB\u7EDF\u4F1A\u68C0\u6D4B\u80CC\u5305\u4E2D\u662F\u5426\u81F3\u5C11\u6709\u4E00\u4EF6\u7269\u54C1\u3002"
