    - subTaskId: dorm_03
      subTaskName: "\u8D2D\u4E70\u4E00\u4EF6\u5546\u54C1"
      shortDescription: "\u5728\u5546\u57CE\u4E2D\u8D2D\u4E70\u4EFB\u610F\u4E00\u4EF6\u7269\u54C1\u3002"
      longDescription: "\u9009\u62E9\u5546\u54C1\u5E76\u5B8C\u6210\u652F\u4ED8\uFF0C\u7269\u54C1\u4F1A\u8FDB\u5165\u80CC\u5305\u3002"
