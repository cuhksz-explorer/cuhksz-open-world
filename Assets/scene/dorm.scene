      shortDescription: "\u5728\u80CC\u5305\u4E2D\u70B9\u51FB\u5546\u54C1\u7684\u653E\u7F6E\u6309\u94AE\uFF0C\u8FDB\u5165\u6446\u653E\u6A21\u5F0F\u3002"
      longDescription: "\u8FDB\u5165\u540E\u53EF\u7528\u9F20\u6807\u79FB\u52A8\u89C6\u89D2\uFF0C\u53F3\u952E\u786E\u8BA4\u653E\u7F6E\uFF0CEsc
