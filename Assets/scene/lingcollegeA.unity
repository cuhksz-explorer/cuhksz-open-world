  - questId: main_new_user_tutorial
    questName: "\u65B0\u624B\u6559\u5B66"
    category: 0
    shortDescription: "\u5B66\u4E60\u79FB\u52A8\u3001\u4F53\u529B\u3001\u89C6\u89D2\u3001\u4EA4\u4E92\u4E0E\u80CC\u5305\u3002"
    longDescription: "\u5B8C\u6210\u516D\u4E2A\u65B0\u624B\u6B65\u9AA4\uFF0C\u719F\u6089\u6E38\u620F\u57FA\u7840\u64CD\u4F5C\u4E0E\u529F\u80FD\u3002"
    finalRewardGold: 60
    subTasks:
    - subTaskId: tutorial_01_move
      subTaskName: "\u5B66\u4E60\u79FB\u52A8"
      shortDescription: "\u4F7F\u7528 WASD \u79FB\u52A8\uFF0C\u4E0A\u4E0B\u7BAD\u5934\u8D77\u98DE\uFF0C\u524D\u5F80\u5F15\u5BFC\u70B9\u3002"
      longDescription: "\u8BF7\u5148\u719F\u6089\u79FB\u52A8\u64CD\u4F5C\uFF0C\u7136\u540E\u62B5\u8FBE\u6307\u5B9A\u5730\u70B9\u5B8C\u6210\u7B2C\u4E00\u6B65\u6559\u5B66\u3002"
      triggerType: 0
      triggerEventId: 
      targetSceneName: undergarden
      targetTransform: {fileID: 0}
      fallbackTargetPosition: {x: -981.44, y: 3.82, z: 1285.55}
      autoCompleteDistance: 5
      targetCount: 1
      rewardGold: 10
      finishLocationName: "\u5F15\u5BFC\u70B9"
    - subTaskId: tutorial_02_sprint_jump
      subTaskName: "\u5B66\u4E60\u75BE\u8DD1\u4E0E\u8DF3\u8DC3"
      shortDescription: "\u6309\u4E0BShift\u75BE\u8DD1\u3001\u6309\u4E0BSpace\u8DF3\u8DC3\uFF08\u5747\u6D88\u8017\u4F53\u529B\uFF09\u3002"
      longDescription: "\u8BF7\u5C1D\u8BD5\u6309\u4E00\u6B21 Shift \u548C\u4E00\u6B21
        Space\uFF0C\u5B66\u4F1A\u75BE\u8DD1\u4E0E\u8DF3\u8DC3\u3002"
      triggerType: 1
