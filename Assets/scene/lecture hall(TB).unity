    - subTaskId: dorm_06
      subTaskName: "\u5B8C\u6210\u4E00\u6B21\u653E\u7F6E"
      shortDescription: "\u5C06\u7269\u54C1\u6446\u653E\u5230\u60A8\u7684\u5BDD\u5BA4\u533A\u57DF\u5185\uFF0C\u6309\u9F20\u6807\u53F3\u952E\u786E\u8BA4\u3002"
      longDescription: "\u9884\u89C8\u4E3A\u7EFF\u8272\u8868\u793A\u53EF\u653E\u7F6E\uFF1B\u786E\u8BA4\u540E\u7269\u54C1\u4F1A\u56FA\u5B9A\u5230\u5BDD\u5BA4\u5E76\u81EA\u52A8\u4FDD\u5B58\u3002"
