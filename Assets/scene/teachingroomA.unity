  - questId: content1_m0
    questName: "M0 \u4E3B\u7EBF\u5267\u60C5"
    category: 0
    shortDescription: "\u63A8\u8FDB\u6797\u6E21\u5728\u672A\u540D\u4E4B\u6D77\u4E2D\u7684\u4E3B\u7EBF\u65C5\u7A0B\u3002"
    longDescription: "\u6765\u81EA content1/M0 \u7684\u5267\u60C5\u4EFB\u52A1\u94FE\u3002\u6BCF\u4E2A\u8282\u70B9\u901A\u8FC7\u5BF9\u5E94
      NPC \u7684\u5206\u9875\u5BF9\u8BDD\u5B8C\u6210\u3002"
    finalRewardGold: 180
    subTasks:
    - subTaskId: story_m0_1_1
      subTaskName: M0-1-1
      shortDescription: "\u4E0E \u8FCE\u65B0\u5B66\u957F \u5BF9\u8BDD\uFF0C\u9605\u8BFB\u5267\u60C5\u300AM0-1-1\u300B\u3002"
      longDescription: "\u524D\u5F80 \u6821\u95E8\uFF0C\u4E0E\u5267\u60C5 NPC \u4EA4\u4E92\u3002\u5BF9\u767D\u6309\u9875\u63A8\u8FDB\uFF0C\u5206\u652F\u9009\u9879\u53EA\u4F1A\u89E6\u53D1\u4E00\u6B21\u5956\u52B1\u3002"
      triggerType: 1
      triggerEventId: content1_story_complete_m0_1_1
      targetSceneName: undergarden
      targetTransform: {fileID: 0}
      fallbackTargetPosition: {x: -1378.63, y: 3.16, z: 1336.04}
      autoCompleteDistance: 5
      targetCount: 1
      rewardGold: 25
      finishLocationName: "\u6821\u95E8"
    - subTaskId: story_m0_1_3
      subTaskName: M0-1-3
      shortDescription: "\u4E0E \u8FCE\u65B0\u5B66\u957F \u5BF9\u8BDD\uFF0C\u9605\u8BFB\u5267\u60C5\u300AM0-1-3\u300B\u3002"
      longDescription: "\u524D\u5F80 \u4E0A\u56ED\u5BBF\u820D\u533A\uFF0C\u4E0E\u5267\u60C5
        NPC \u4EA4\u4E92\u3002\u5BF9\u767D\u6309\u9875\u63A8\u8FDB\uFF0C\u5206\u652F\u9009\u9879\u53EA\u4F1A\u89E6\u53D1\u4E00\u6B21\u5956\u52B1\u3002"
      triggerType: 1
