    - subTaskId: tutorial_03_bag
      subTaskName: "\u5B66\u4E60\u80CC\u5305"
      shortDescription: "\u6309 B \u6253\u5F00\u80CC\u5305\uFF0C\u5E76\u70B9\u51FB\u5173\u95ED\u3002"
      longDescription: "\u5546\u57CE\u548C\u80CC\u5305\u662F\u6838\u5FC3\u529F\u80FD\uFF0C\u6309
