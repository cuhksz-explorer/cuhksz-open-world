    - subTaskId: tutorial_02_intercom
      subTaskName: "\u5B66\u4E60\u4EA4\u4E92"
      shortDescription: "\u51FA\u73B0\u4E8B\u4EF6UI\u65F6\uFF0C\u6309 F\u89E6\u53D1\u4EA4\u4E92\u4E8B\u4EF6\u3002"
      longDescription: "\u5B8C\u6210\u7B2C\u4E00\u6B65\u540E\uFF0C\u89C2\u5BDF\u53F3\u4FA7\u5BF9\u8BB2\u673A\u63D0\u793A\u5E76\u6309
        F \u8FDB\u884C\u4EA4\u4E92\u3002"
      triggerType: 1
